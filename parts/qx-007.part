/* ═══════ 免费版：所有功能直接开放，无售卖与授权校验 ═══════ */

/* 移动端首次提示：点左上角三条横杠打开侧边栏 */
function mobileHint(){
  try{
    if(sessionStorage.getItem('pp_hint_done')||sessionStorage.getItem('pp_nav_guide_closed'))return;
    if(window.innerWidth>860)return;
    var h=document.getElementById('mobileSidebarHint');
    if(h){
      h.style.display='block';
      /* 不再几秒自动消失，改为"打开过侧边栏或手动关闭"后才隐藏，避免新用户错过入口 */
      function doneOnce(){
        setTimeout(function(){
          try{sessionStorage.setItem('pp_hint_done','1');}catch(e){}
          if(h)h.style.display='none';
        },400);
        var b=document.querySelector('.mobile-toggle');if(b)b.removeEventListener('click',doneOnce,{capture:true});
        var o=document.getElementById('sidebarOverlay');if(o)o.removeEventListener('click',doneOnce);
      }
      var b=document.querySelector('.mobile-toggle');if(b)b.addEventListener('click',doneOnce);
      var o=document.getElementById('sidebarOverlay');if(o)o.addEventListener('click',doneOnce);
      var c=h.querySelector('span[onclick]');if(c)c.addEventListener('click',doneOnce);
    }
  }catch(e){}
}

/* ═══════ 用户反馈（作者直接收到，其他人不可见） ═══════ */
/* 作者接收反馈的邮箱（绑定后用户提交反馈自动转发到此邮箱）。
   填入你的邮箱即可启用自动送达，例如：var AUTHOR_EMAIL='you@example.com';
   无需后端，使用免费邮件表单服务转发（提交量每天有限，个人产品足够）。 */
var AUTHOR_EMAIL='2725754457@qq.com';  /* 作者邮箱：用户反馈自动转发到这里 */
function sendFeedback(){
  var txt=document.getElementById('fbText');var t=txt?txt.value.trim():'';
  if(!t){flash('请先写下你的反馈内容');return;}
  var contact=document.getElementById('fbContact');var c=contact?contact.value.trim():'';
  var typeSel=document.getElementById('fbType');var ty=typeSel?typeSel.value:'建议';
  var time=new Date().toLocaleString();
  var list=[];try{list=JSON.parse(localStorage.getItem('pp_feedback')||'[]')||[];}catch(e){list=[];}
  list.push({type:ty,text:t,contact:c,time:time});
  localStorage.setItem('pp_feedback',JSON.stringify(list));
  var msg=document.getElementById('fbMsg');
  var sent=false;
  if(AUTHOR_EMAIL){
    try{
      fetch('https://formsubmit.co/ajax/'+AUTHOR_EMAIL,{
        method:'POST',
        headers:{'Content-Type':'application/json','Accept':'application/json'},
        body:JSON.stringify({_subject:'【栖匣】用户反馈',类型:ty,内容:t,联系方式:c||'未留',时间:time})
      }).then(function(r){return r.json()}).then(function(){sent=true;done();}).catch(function(){done();});
    }catch(e){done();}
    function done(){
      if(sent){if(msg)msg.innerHTML='<strong style="color:var(--primary)">✓ 已送达作者</strong>，感谢你的反馈！';flash('反馈已送达作者，感谢支持！');}
      else{if(msg)msg.innerHTML='<strong style="color:var(--primary)">✓ 已保存在本地</strong>（作者邮箱未配置，可点「复制反馈内容」直接发给作者）';flash('反馈已保存');}
    }
  }else{
    if(msg)msg.innerHTML='<strong style="color:var(--primary)">✓ 已保存在本设备</strong>，可点「复制反馈内容」直接发给作者';
    flash('反馈已保存，感谢支持！');
  }
  if(txt)txt.value='';
  if(contact)contact.value='';
}
function copyFeedback(){
  var txt=document.getElementById('fbText');var t=txt?txt.value.trim():'';
  var contact=document.getElementById('fbContact');var c=contact?contact.value.trim():'';
  var typeSel=document.getElementById('fbType');var ty=typeSel?typeSel.value:'建议';
  if(!t){flash('请先写下反馈内容再复制');return;}
  var text='【栖匣 用户反馈】\n类型：'+ty+'\n内容：'+t+(c?'\n联系方式：'+c:'')+'\n时间：'+new Date().toLocaleString();
  navigator.clipboard.writeText(text).then(function(){flash('已复制，可直接发给作者');},function(){
    var ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);flash('已复制，可直接发给作者');
  });
}
function showMyFeedback(){
  var list=[];try{list=JSON.parse(localStorage.getItem('pp_feedback')||'[]')||[];}catch(e){list=[];}
  var box=document.getElementById('fbHistory');
  if(!box)return;
  if(!list.length){box.innerHTML='<p style="font-size:12.5px;color:var(--hint)">还没有提交过反馈。</p>';return;}
  box.innerHTML=list.slice().reverse().map(function(f){
    return '<div style="border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:8px;font-size:13px;background:var(--bg)">'+
      '<b style="color:var(--primary)">['+f.type+']</b> '+escapeHtml(f.text)+
      (f.contact?'<div style="font-size:12px;color:var(--hint);margin-top:4px">联系方式：'+escapeHtml(f.contact)+'</div>':'')+
      '<div style="font-size:11px;color:var(--hint);margin-top:4px">'+f.time+'</div></div>';
  }).join('');
}


/* ═══════ 专项模板板块（免费版：直接开放，无需激活） ═══════ */
function renderTpl(){
  var content=document.getElementById('tplContent');
  if(content)content.style.display='block';
}
function switchTpl(k){
  var cap={'ky':'Ky','gk':'Gk','fk':'Fk','fx':'Fx','lw':'Lw'};
  ['ky','gk','fk','fx','lw'].forEach(function(x){var el=document.getElementById('tpl'+cap[x]);if(el)el.style.display=(x===k)?'block':'none';});
  var map={'ky':0,'gk':1,'fk':2,'fx':3,'lw':4};
  var btns=document.querySelectorAll('#view-tpl .tabs .btn');
  for(var i=0;i<btns.length;i++){btns[i].className='btn btn-sm'+(map[k]===i?' btn-primary':'');}
}

function shareProduct(){
  var url='https://lumenplexus.github.io/centrove/';
  var txt='分享一个我刚用上的「栖匣」——把成长岁月安放好的收纳匣。\n它是一个网页，双击就能打开，不用下载 App、不用注册，数据只存在你自己设备上，不上传不收集，用着很安心。\n里面把大学几年常用的都装好了：今日规划、学业目标、时间管理、理财记账、运动打卡、心灵成长……对准大一新生也特别友好。\n免费的，纯工具，不夹带广告。如果你也在琢磨大学怎么过得更顺一点，可以点开看看，有用的话留着，不合适关掉就行：'+url+'\n\n—— 原创「栖匣」· © 作者：尹平平';
  var html='<div id="shareMask" style="position:fixed;inset:0;background:rgba(6,14,10,.5);z-index:80;display:flex;align-items:center;justify-content:center;padding:20px" onclick="if(event.target===this)document.getElementById(\'shareMask\').remove()">'+
    '<div style="background:var(--card);border:1px solid var(--border);border-radius:14px;width:calc(100% - 32px);max-width:420px;max-height:80vh;overflow:auto;padding:18px 16px;box-sizing:border-box;box-shadow:0 12px 40px rgba(0,0,0,.35)">'+
    '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><div style="font-size:16px;font-weight:700;color:var(--text)">分享给朋友</div><button onclick="document.getElementById(\'shareMask\').remove()" style="border:none;background:none;font-size:22px;color:var(--hint);cursor:pointer;line-height:1">×</button></div>'+
    '<div style="font-size:12px;color:var(--muted);margin-bottom:12px">下面这段可以直接复制，发到微信 / QQ / 朋友圈 / 群聊都行。</div>'+
    '<div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px 14px;font-size:13.5px;color:var(--text);white-space:pre-wrap;word-break:break-all;overflow-wrap:anywhere;line-height:1.8;margin-bottom:14px">'+txt.replace(/</g,'&lt;').replace(/\n/g,'<br>')+'</div>'+
    '<button onclick="copyShareText(this)" data-txt="'+encodeURIComponent(txt)+'" style="width:100%;border:none;color:#fff;background:linear-gradient(120deg,#5C4030,#6E4F37);border-radius:8px;padding:11px;font-size:13.5px;cursor:pointer;font-weight:600">📋 复制文案 + 链接</button>'+
    '<button onclick="window.open(\''+url+'\',\'_blank\');flash(\'已在新窗口打开网站\')" style="width:100%;border:1px solid var(--coral);color:var(--primary);background:var(--card);border-radius:8px;padding:11px;font-size:13.5px;cursor:pointer;font-weight:600;margin-top:8px">🔗 直接打开网站</button>'+
    '</div></div>';
  /* 若浏览器支持原生分享（手机/桌面均可用），优先走系统分享面板（可存收藏、发微信等） */
  if(navigator.share){
    var tryNative=function(){
      try{
        navigator.share({title:'栖匣 · 心有所栖匣纳成长',text:txt,url:url}).catch(function(){/* 用户取消则保留弹窗 */});
      }catch(e){}
    };
    html=html.replace(
      'onclick="copyShareText(this)',
      'onclick="tryNativeShare();copyShareText(this)'
    );
  }
  window.tryNativeShare=function(){ if(navigator.share){ try{ navigator.share({title:'栖匣 · 心有所栖匣纳成长',text:txt,url:url}); }catch(e){} } };
  var old=document.getElementById('shareMask');if(old)old.remove();
  document.body.insertAdjacentHTML('beforeend',html);
}
function copyShareText_direct(txt){
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){flash('已复制文案+链接，可粘贴到微信/QQ');},function(){prompt('复制下面内容：',txt);});
  }else{prompt('复制下面内容：',txt);}
}
function copyShareText(btn){
  var txt=decodeURIComponent(btn.getAttribute('data-txt'));
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){
      var old=btn.textContent;btn.textContent='已复制 ✓';btn.style.color='#6E4F37';btn.style.borderColor='#6E4F37';
      setTimeout(function(){btn.textContent=old;btn.style.color='';btn.style.borderColor='';},1500);
    },function(){prompt('复制下面内容：',txt);});
  }else{prompt('复制下面内容：',txt);}
}

function saveTodayGoal(){
  var inp=document.getElementById('todayGoalInput');
  var show=document.getElementById('todayGoalShow');
  var v=inp?inp.value.trim():'';
  var key='pp_today_goal_'+new Date().toISOString().slice(0,10);
  try{localStorage.setItem(key,v);}catch(e){}
  if(v){
    if(show){show.style.display='block';show.innerHTML='✅ 今日目标已记下：<b>'+v.replace(/</g,'&lt;')+'</b>　（每天自动重置，专注当下就好）';}
    if(inp)inp.value='';
  }else if(show){show.style.display='none';}
}
function loadTodayGoal(){
  var inp=document.getElementById('todayGoalInput');
  var show=document.getElementById('todayGoalShow');
  var key='pp_today_goal_'+new Date().toISOString().slice(0,10);
  var v='';
  try{v=localStorage.getItem(key)||'';}catch(e){}
  if(v && inp){inp.value=v; if(show){show.style.display='block';show.innerHTML='📌 今天的目标：<b>'+v.replace(/</g,'&lt;')+'</b>';}}
}

/* ═══════ 轻松一下（情绪放松·不尬·不鸡汤） ═══════ */

/* —— 1. 情绪气象台：选心情，回一句不评判的话 —— */
var MOODS=[
  {k:'平静',e:['挺好的，今天没什么大风大浪，就这样稳稳过。','平稳也是一种运气，别小看它。']},
  {k:'开心',e:['那就把这份好状态记一下，别让它溜走。','开心不需要理由，享受就好。']},
  {k:'累',e:['累不是软弱，是今天真的动了很多。允许自己瘫一会儿。','累了就歇，不是所有事都要今天做完。']},
  {k:'焦虑',e:['焦虑常常是因为你在认真想未来。先深吸一口气，今晚的事明早再说。','把最担心的那件写下来，剩下的交给时间，它比你想象中能扛。']},
  {k:'丧',e:['丧和开心一样，都是会过去的天气，不用硬撑。','今天就这样吧，躺平也是一种恢复。']},
  {k:'emo',e:['emo 不是矫情，是心里有点空。找首歌，或者发会儿呆。','这种说不清的情绪，允许它待一会，它自己会走。']},
  {k:'无聊',e:['无聊说明你暂时没什么要紧事——这其实是种奢侈。','去楼下走走？或者翻翻这个页面的别的板块。']},
  {k:'想家',e:['想家的时候，给家里发条消息，他们也在想你。','距离远不代表不亲，今晚打个电话吧。']}
];
function renderMood(){
  var box=document.getElementById('moodBtns');
  if(!box)return;
  box.innerHTML='';
  MOODS.forEach(function(m){
    var b=document.createElement('button');
    b.className='btn btn-ghost btn-sm';
    b.textContent=m.k;
    b.onclick=function(){
      var echo=document.getElementById('moodEcho');
      echo.style.display='block';
      echo.textContent=m.e[Math.floor(Math.random()*m.e.length)];
      /* 打卡：记录今天的心情词，用于趋势图 */
      try{localStorage.setItem('pp_mood_'+new Date().toISOString().slice(0,10),m.k);}catch(e){}
      var t=document.getElementById('moodTrend');
      if(t)renderMoodTrend();
    };
    box.appendChild(b);
  });
  var t=document.getElementById('moodTrend');
  if(t)renderMoodTrend();
}
function _moodColor(k){
  var map={'平静':'#9A7348','开心':'#F2B441','累':'#A29484','焦虑':'#B07F63','丧':'#8A6A2D','emo':'#7E6A3A','无聊':'#6B7267','想家':'#C49A66'};
  return map[k]||'#A29484';
}
function renderMoodTrend(){
  var el=document.getElementById('moodTrend');
  if(!el)return;
  /* 最近 35 天（5 周 × 7 天），GitHub contribution 风格热力矩阵 */
  var days=[];
  for(var i=34;i>=0;i--){
    var d=new Date(Date.now()-i*86400000);
    var key=d.toISOString().slice(0,10);
    var k=localStorage.getItem('pp_mood_'+key);
    days.push({label:(d.getMonth()+1)+'/'+d.getDate(),k:k});
  }
  var has=days.some(function(x){return x.k;});
  if(!has){
    el.innerHTML='<div style="font-size:12px;color:var(--hint);padding:4px 0">还没有打卡记录——选一个心情，就开始记录你的情绪天气啦。连续打卡越久，越能看清自己的情绪节律。</div>';
    return;
  }
  /* 连续天数统计 */
  var streak=0;
  for(var s=0;s<35;s++){
    var dk=new Date(Date.now()-s*86400000).toISOString().slice(0,10);
    if(localStorage.getItem('pp_mood_'+dk))streak++; else break;
  }
  var cols=7, gap=5, cell=15, gridW=cols*(cell+gap);
  var rows=Math.ceil(days.length/cols);
  var svg='<svg viewBox="0 0 '+(gridW+4)+' '+(rows*(cell+gap)+4)+'" width="100%" style="max-width:280px;display:block">';
  days.forEach(function(x,i){
    var r=Math.floor(i/cols), c=i%cols;
    var x0=2+c*(cell+gap), y0=2+r*(cell+gap);
    var col=x.k?_moodColor(x.k):'#EFE8D8';
    svg+='<rect x="'+x0+'" y="'+y0+'" width="'+cell+'" height="'+cell+'" rx="3" fill="'+col+'"><title>'+x.label+(x.k?(' · '+x.k):' · 未打卡')+'</title></rect>';
  });
  svg+='</svg>';
  var lg='';
  var present={};
  days.forEach(function(x){if(x.k)present[x.k]=_moodColor(x.k);});
  Object.keys(present).forEach(function(k){
    lg+='<span style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--muted);margin-right:10px"><span style="width:9px;height:9px;border-radius:2px;background:'+present[k]+'"></span>'+k+'</span>';
  });
  el.innerHTML='<div style="font-size:12px;color:var(--primary);margin-bottom:6px">🔥 已连续记录 <b>'+streak+'</b> 天 · 最近 35 天情绪天气</div>'+svg+'<div style="margin-top:8px;display:flex;flex-wrap:wrap">'+lg+'</div>';
}

/* —— 2. 三件小确幸：本地保存，可回看 —— */
function renderBlessInputs(){
  var box=document.getElementById('blessInputs');
  if(!box)return;
  box.innerHTML='';
  for(var i=0;i<3;i++){
    var inp=document.createElement('input');
    inp.className='input';
    inp.placeholder='第 '+(i+1)+' 件小事…';
    inp.id='bless'+i;
    box.appendChild(inp);
  }
}
var _blessMood=0;
function renderBlessMood(){
  var box=document.getElementById('blessMood');
  if(!box)return;
  box.innerHTML='';
  for(var s=1;s<=5;s++){
    (function(star){
      var sp=document.createElement('span');
      sp.textContent='★';
      sp.style.cssText='font-size:22px;cursor:pointer;color:'+(star<=_blessMood?'#E8A33D':'#D6D1C3');
      sp.onclick=function(){
        _blessMood=star;
        renderBlessMood();
      };
      box.appendChild(sp);
    })(s);
  }
  if(_blessMood===0){
    var hint=document.createElement('span');
    hint.style.cssText='font-size:12px;color:var(--hint);align-self:center;margin-left:4px';
    hint.textContent='（不选也可只记小事）';
    box.appendChild(hint);
  }
}
function blessKey(d){d=d||new Date().toISOString().slice(0,10);return 'pp_bless_'+d;}
function blessStreak(){
  var n=0;
  for(var i=0;i<400;i++){
    var d=new Date(Date.now()-i*86400000).toISOString().slice(0,10);
    if(localStorage.getItem(blessKey(d))){n++;}else if(i>0){break;}
  }
  return n;
}
function saveBless(){
  var arr=[];
  for(var i=0;i<3;i++){
    var v=document.getElementById('bless'+i).value.trim();
    if(v)arr.push(v.replace(/</g,'&lt;'));
  }
  if(!arr.length){flash('写点什么再保存吧～');return;}
  var obj={items:arr,mood:_blessMood};
  try{localStorage.setItem(blessKey(),JSON.stringify(obj));}catch(e){}
  _blessMood=0;
  flash('今天的小确幸已记下 ✨');
  renderBlessInputs();renderBlessMood();renderBlessStreak();
}
function renderBlessStreak(){
  var el=document.getElementById('blessStreak');
  if(!el)return;
  var n=blessStreak();
  el.textContent=n>0?('🔥 已连续记录 '+n+' 天，继续保持～'):'';
}
function renderBlessHistory(){
  var box=document.getElementById('blessHistory');
  if(!box)return;
  var html='<div style="font-size:12px;color:var(--hint);margin-bottom:6px">最近记下的（点 ✕ 可删除某天）：</div>';
  var lines=[];
  try{
    for(var i=0;i<10;i++){
      var d=new Date(Date.now()-i*86400000).toISOString().slice(0,10);
      var raw=localStorage.getItem('pp_bless_'+d);
      if(raw){
        var o=JSON.parse(raw);
        var items=Array.isArray(o)?o:o.items;
        var mood=o.mood?'　'+'★'.repeat(o.mood):'';
        lines.push('<div style="font-size:13px;margin:4px 0;display:flex;align-items:center;gap:6px"><b style="color:var(--primary)">'+d+'</b>'+mood+'：'+items.join(' ／ ')+'<span style="cursor:pointer;color:var(--coral);font-weight:700;margin-left:auto" onclick="delBless(\''+d+'\')" title="删除这天">✕</span></div>');
      }
    }
  }catch(e){}
  box.innerHTML=lines.length?html+lines.join(''):'<div style="font-size:13px;color:var(--muted)">还没有记录，今天写第一份吧。</div>';
}
function delBless(d){
  try{localStorage.removeItem('pp_bless_'+d);}catch(e){}
  renderBlessHistory();renderBlessStreak();
  flash('已移除 '+d+' 的记录');
}

/* —— 3. 声景：WebAudio 合成，不联网 —— */
var _audioCtx=null,_soundNodes=null,_soundName=null;
function _ensureCtx(){
  if(!_audioCtx){
    try{_audioCtx=new (window.AudioContext||window.webkitAudioContext)();}catch(e){return null;}
  }
  if(_audioCtx.state==='suspended')_audioCtx.resume();
  return _audioCtx;
}
function stopSound(){
  if(_soundNodes){
    try{_soundNodes.forEach(function(n){if(n.stop)n.stop();if(n.disconnect)n.disconnect();});}catch(e){}
    _soundNodes=null;
  }
  _soundName=null;
  var tip=document.getElementById('soundTip');
  if(tip)tip.textContent='已停止。点上面的按钮可以再放。';
}
function playSound(name){
  var ctx=_ensureCtx();
  if(!ctx){flash('你的浏览器不支持音频播放');return;}
  stopSound();
  _soundNodes=[];
  if(name==='rain'){
    var bufSize=2*ctx.sampleRate, buf=ctx.createBuffer(1,bufSize,ctx.sampleRate), data=buf.getChannelData(0);
    for(var i=0;i<bufSize;i++)data[i]=(Math.random()*2-1)*0.5;
    var noise=ctx.createBufferSource();noise.buffer=buf;noise.loop=true;
    var bp=ctx.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1200;bp.Q.value=0.6;
    var g=ctx.createGain();g.gain.value=0.25;
    noise.connect(bp);bp.connect(g);g.connect(ctx.destination);noise.start();
    _soundNodes.push(noise);_soundNodes.push(bp);
  }else if(name==='wave'){
    var bufSize2=2*ctx.sampleRate, buf2=ctx.createBuffer(1,bufSize2,ctx.sampleRate), d2=buf2.getChannelData(0);
    for(var j=0;j<bufSize2;j++)d2[j]=(Math.random()*2-1)*0.4;
    var n2=ctx.createBufferSource();n2.buffer=buf2;n2.loop=true;
    var lp=ctx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=500;
    var g2=ctx.createGain();g2.gain.value=0.3;
    n2.connect(lp);lp.connect(g2);g2.connect(ctx.destination);n2.start();
    _soundNodes.push(n2);_soundNodes.push(lp);
  }else if(name==='focus'){
    var o=ctx.createOscillator();o.type='sine';o.frequency.value=180;
    var o2=ctx.createOscillator();o2.type='sine';o2.frequency.value=184;
    var gg=ctx.createGain();gg.gain.value=0.08;
    o.connect(gg);o2.connect(gg);gg.connect(ctx.destination);o.start();o2.start();
    _soundNodes.push(o);_soundNodes.push(o2);
  }else if(name==='wind'){
    var bs=2*ctx.sampleRate, b3=ctx.createBuffer(1,bs,ctx.sampleRate), dd=b3.getChannelData(0);
    for(var k=0;k<bs;k++)dd[k]=(Math.random()*2-1)*0.3;
    var ns=ctx.createBufferSource();ns.buffer=b3;ns.loop=true;
    var hp=ctx.createBiquadFilter();hp.type='highpass';hp.frequency.value=400;
    var lfo=ctx.createOscillator();lfo.frequency.value=0.2;var lfg=ctx.createGain();lfg.gain.value=300;
    lfo.connect(lfg);lfg.connect(hp.frequency);lfo.start();
    var g3=ctx.createGain();g3.gain.value=0.22;
    ns.connect(hp);hp.connect(g3);g3.connect(ctx.destination);ns.start();
    _soundNodes.push(ns);_soundNodes.push(hp);_soundNodes.push(lfo);
  }else if(name==='cafe'){
    /* 低频嗡鸣(空调/人声底噪) + 偶发杯碟脆响 */
    var on=ctx.createOscillator();on.type='sine';on.frequency.value=110;
    var og=ctx.createGain();og.gain.value=0.05;
    on.connect(og);og.connect(ctx.destination);on.start();
    var bufSize3=2*ctx.sampleRate, buf3=ctx.createBuffer(1,bufSize3,ctx.sampleRate), d3=buf3.getChannelData(0);
    for(var c=0;c<bufSize3;c++)d3[c]=(Math.random()*2-1)*0.15;
    var nb=ctx.createBufferSource();nb.buffer=buf3;nb.loop=true;
    var lp2=ctx.createBiquadFilter();lp2.type='lowpass';lp2.frequency.value=900;
    var g4=ctx.createGain();g4.gain.value=0.12;
    nb.connect(lp2);lp2.connect(g4);g4.connect(ctx.destination);nb.start();
    _soundNodes.push(on);_soundNodes.push(nb);_soundNodes.push(lp2);
  }else if(name==='fire'){
    /* 篝火：低频轰鸣 + 高频"噼啪"噪声脉冲 */
    var bs2=2*ctx.sampleRate, b4=ctx.createBuffer(1,bs2,ctx.sampleRate), d4=b4.getChannelData(0);
    for(var f=0;f<bs2;f++)d4[f]=(Math.random()*2-1)*0.25;
    var n3=ctx.createBufferSource();n3.buffer=b4;n3.loop=true;
    var lp3=ctx.createBiquadFilter();lp3.type='lowpass';lp3.frequency.value=700;
    var g5=ctx.createGain();g5.gain.value=0.18;
    n3.connect(lp3);lp3.connect(g5);g5.connect(ctx.destination);n3.start();
    /* 噼啪：用LFO调制滤波频率制造闪烁感 */
    var lfo2=ctx.createOscillator();lfo2.type='square';lfo2.frequency.value=3;
    var lfg2=ctx.createGain();lfg2.gain.value=400;
    lfo2.connect(lfg2);lfg2.connect(lp3.frequency);lfo2.start();
    _soundNodes.push(n3);_soundNodes.push(lp3);_soundNodes.push(lfo2);
  }else if(name==='window'){
    /* 雨打窗：雨声底噪 + 间隔"啪嗒"水滴脉冲（用LFO调制增益制造不均节奏） */
    var bs3=2*ctx.sampleRate, b5=ctx.createBuffer(1,bs3,ctx.sampleRate), d5=b5.getChannelData(0);
    for(var wn=0;wn<bs3;wn++)d5[wn]=(Math.random()*2-1)*0.35;
    var n4=ctx.createBufferSource();n4.buffer=b5;n4.loop=true;
    var bp2=ctx.createBiquadFilter();bp2.type='bandpass';bp2.frequency.value=1400;bp2.Q.value=0.5;
    var g6=ctx.createGain();g6.gain.value=0.22;
    n4.connect(bp2);bp2.connect(g6);g6.connect(ctx.destination);n4.start();
    /* 水滴：高频短脉冲经LFO节律触发 */
    var drop=ctx.createOscillator();drop.type='triangle';drop.frequency.value=2400;
    var dg=ctx.createGain();dg.gain.value=0.0;
    var dlfo=ctx.createOscillator();dlfo.type='sine';dlfo.frequency.value=2.2;
    var dlfg=ctx.createGain();dlfg.gain.value=0.04;
    dlfo.connect(dlfg);dlfg.connect(dg.gain);dlfo.start();
    drop.connect(dg);dg.connect(ctx.destination);drop.start();
    _soundNodes.push(n4);_soundNodes.push(bp2);_soundNodes.push(drop);_soundNodes.push(dlfo);
  }else if(name==='stream'){
    /* 溪流：带通噪声 + 轻微起伏（LFO调制滤波频率 + 增益） */
    var bs4=2*ctx.sampleRate, b6=ctx.createBuffer(1,bs4,ctx.sampleRate), d6=b6.getChannelData(0);
    for(var sn=0;sn<bs4;sn++)d6[sn]=(Math.random()*2-1)*0.5;
    var n5=ctx.createBufferSource();n5.buffer=b6;n5.loop=true;
    var bp3=ctx.createBiquadFilter();bp3.type='bandpass';bp3.frequency.value=900;bp3.Q.value=0.8;
    var slfo=ctx.createOscillator();slfo.type='sine';slfo.frequency.value=0.15;
    var slfg=ctx.createGain();slfg.gain.value=350;
    slfo.connect(slfg);slfg.connect(bp3.frequency);slfo.start();
    var g7=ctx.createGain();g7.gain.value=0.2;
    var glfo=ctx.createOscillator();glfo.type='sine';glfo.frequency.value=0.1;
    var glfg=ctx.createGain();glfg.gain.value=0.06;
    glfo.connect(glfg);glfg.connect(g7.gain);glfo.start();
    n5.connect(bp3);bp3.connect(g7);g7.connect(ctx.destination);n5.start();
    _soundNodes.push(n5);_soundNodes.push(bp3);_soundNodes.push(slfo);_soundNodes.push(glfo);
  }else if(name==='key'){
    /* 键盘白噪音：不规则"嗒嗒"脉冲串，模拟敲键盘的专注底噪 */
    var kbGain=ctx.createGain();kbGain.gain.value=0.0;kbGain.connect(ctx.destination);
    var kbOsc=ctx.createOscillator();kbOsc.type='square';kbOsc.frequency.value=1800;
    var kbEnv=ctx.createGain();kbEnv.gain.value=0.0;
    kbOsc.connect(kbEnv);kbEnv.connect(kbGain);kbOsc.start();
    /* 用 setInterval 制造不规则敲击声，停止时清理 */
    var kbTimer=setInterval(function(){
      try{
        var t=ctx.currentTime;
        kbEnv.gain.cancelScheduledValues(t);
        kbEnv.gain.setValueAtTime(0.06,t);
        kbEnv.gain.exponentialRampToValueAtTime(0.0001,t+0.04);
        kbOsc.frequency.setValueAtTime(1400+Math.random()*1400,t);
      }catch(e){}
    },140);
    _soundNodes.push({stop:function(){clearInterval(kbTimer);try{kbOsc.stop();}catch(e){}}});
    _soundNodes.push(kbGain);_soundNodes.push(kbOsc);
  }else if(name==='fireplace'){
    /* 壁炉：低频轰鸣 + 间歇木柴"噼啪"爆裂 */
    var fpNoiseSize=2*ctx.sampleRate, fpBuf=ctx.createBuffer(1,fpNoiseSize,ctx.sampleRate), fpD=fpBuf.getChannelData(0);
    for(var fp=0;fp<fpNoiseSize;fp++)fpD[fp]=(Math.random()*2-1)*0.3;
    var fpN=ctx.createBufferSource();fpN.buffer=fpBuf;fpN.loop=true;
    var fpLp=ctx.createBiquadFilter();fpLp.type='lowpass';fpLp.frequency.value=420;
    var fpG=ctx.createGain();fpG.gain.value=0.22;
    fpN.connect(fpLp);fpLp.connect(fpG);fpG.connect(ctx.destination);fpN.start();
    /* 噼啪爆裂：随机高频短脉冲 */
    var fpCrack=ctx.createOscillator();fpCrack.type='triangle';fpCrack.frequency.value=3200;
    var fpCrackG=ctx.createGain();fpCrackG.gain.value=0.0;
    fpCrack.connect(fpCrackG);fpCrackG.connect(ctx.destination);fpCrack.start();
    var fpTimer=setInterval(function(){
      try{
        var t=ctx.currentTime;
        fpCrackG.gain.cancelScheduledValues(t);
        fpCrackG.gain.setValueAtTime(0.05+Math.random()*0.05,t);
        fpCrackG.gain.exponentialRampToValueAtTime(0.0001,t+0.05);
        fpCrack.frequency.setValueAtTime(2600+Math.random()*1600,t);
      }catch(e){}
    },360);
    _soundNodes.push({stop:function(){clearInterval(fpTimer);try{fpCrack.stop();}catch(e){}}});
    _soundNodes.push(fpN);_soundNodes.push(fpLp);
  }
  _soundName=name;
  var tip=document.getElementById('soundTip');
  var names={rain:'雨声',wave:'海浪',focus:'低频专注',wind:'风声',cafe:'咖啡馆',fire:'篝火',window:'雨打窗',stream:'溪流',key:'键盘白噪音',fireplace:'壁炉'};
  if(tip)tip.textContent='正在播放：'+names[name]+'　（再点一次同款可停止）';
}
function renderSoundBtns(){
  var box=document.getElementById('soundBtns');
  if(!box)return;
  var list=[['rain','🌧 雨声'],['wave','🌊 海浪'],['focus','🎯 低频专注'],['wind','🍃 风声'],['cafe','☕ 咖啡馆'],['fire','🔥 篝火'],['window','☔ 雨打窗'],['stream','🌊 溪流'],['key','⌨ 键盘白噪音'],['fireplace','🪵 壁炉']];
  box.innerHTML='';
  list.forEach(function(it){
    var b=document.createElement('button');
    b.className='btn btn-ghost btn-sm';
    b.textContent=it[1];
    b.onclick=function(){
      if(_soundName===it[0]){stopSound();return;}
      playSound(it[0]);
    };
    box.appendChild(b);
  });
}

/* —— 4. 一句温柔的话：随机短句，不鸡汤 —— */
var SOFT_LINES=[
  '你今天已经做得够多了，剩下的明天再说。',
  '不是每件事都要有意义，发会儿呆也是正经事。',
  '别人在跑，你在走，也没关系，路是自己的。',
  '允许自己今天不优秀。',
  '你不需要向谁证明你过得很好。',
  '难熬的时候，喝水、睡觉、吃饭，这三件先做。',
  '你现在站的这个地方，已经比昨天远了。',
  '有人在乎你，哪怕他没说。',
  '把今天走稳，长路自成。',
  '今天的你，已经很努力了，这就够了。',
  '不想说话就别说话，沉默也很正常。',
  '把手机放下五分钟，看看窗外，也挺好。',
  '你不必永远坚强，偶尔软一下不是错。',
  '累的时候就停，世界不会因为你歇一会就塌。',
  '你比你自己以为的，更能扛。'
];
var _lastSoft=-1;
function nextSoftLine(){
  var el=document.getElementById('softLine');
  if(!el)return;
  var i;
  do{ i=Math.floor(Math.random()*SOFT_LINES.length); }while(i===_lastSoft && SOFT_LINES.length>1);
  _lastSoft=i;
  el.textContent=SOFT_LINES[i];
}
/* —— 专项模板可填写空白表：本地保存 + 打印 —— */
function saveTplForm(id){
  var box=document.getElementById(id);
  if(!box)return;
  var vals={};
  box.querySelectorAll('input,textarea').forEach(function(el){
    if(el.id)vals[el.id]=el.value;
  });
  try{localStorage.setItem('pp_tpl_'+id,JSON.stringify(vals));}catch(e){}
  flash('已妥善收入匣中，下次打开还在 ✏️');
}
function loadTplForm(id){
  var box=document.getElementById(id);
  if(!box)return;
  var raw;try{raw=localStorage.getItem('pp_tpl_'+id);}catch(e){return;}
  if(!raw)return;
  try{var vals=JSON.parse(raw);}catch(e){return;}
  box.querySelectorAll('input,textarea').forEach(function(el){
    if(el.id&&vals[el.id]!=null)el.value=vals[el.id];
  });
}
function printTpl(id){
  var box=document.getElementById(id);
  if(!box)return;
  var html='<html><head><meta charset="utf-8"><title>打印</title><style>'
    +'body{font-family:system-ui,"Microsoft YaHei",sans-serif;padding:24px;color:#3A4038}'
    +'h2{color:#6E4F37}table{width:100%;border-collapse:collapse;margin:10px 0}'
    +'td,th{border:1px solid #ccc;padding:8px;font-size:14px}input,textarea{border:none;outline:none;width:100%;font-size:14px;font-family:inherit}'
    +'textarea{resize:none}.tip{color:#888;font-size:12px}</style></head><body>'
    +'<h2>栖匣 · 学习计划表</h2>'+box.innerHTML
    +'<p class="tip">由「栖匣 · 心有所栖 · 匣纳成长」生成</p></body></html>';
  var w=window.open('','_blank');
  w.document.write(html);w.document.close();
  setTimeout(function(){w.print();},300);
}
/* —— 桌面便签：本地保存，多张可增删 —— */
function addNote(){
  var inp=document.getElementById('noteInput');
  if(!inp)return;
  var v=inp.value.trim();
  if(!v){flash('写点什么再贴～');return;}
  var color=document.querySelector('input[name="noteColor"]:checked');
  var bg=color?color.value:'#FFF4D6';
  var arr=[];try{arr=JSON.parse(localStorage.getItem('pp_notes')||'[]');}catch(e){}
  arr.push({t:v.replace(/</g,'&lt;'),c:bg});
  try{localStorage.setItem('pp_notes',JSON.stringify(arr));}catch(e){}
  inp.value='';
  renderNotes();
}
function renderNotes(){
  var box=document.getElementById('noteWall');
  if(!box)return;
  var arr=[];try{arr=JSON.parse(localStorage.getItem('pp_notes')||'[]');}catch(e){}
  if(!arr.length){box.innerHTML='<span style="font-size:13px;color:var(--hint)">还没有便签，贴第一张吧～</span>';return;}
  var palette={'#FFF4D6':'#E8B84B','#EFE8D8':'#8A6D48','#F1EBDD':'#9A7348','#EFE7CF':'#C2A15E','#FBEEE6':'#B07F63'};
  box.innerHTML=arr.map(function(n,i){
    var bg=n.c||'#FFF4D6';
    var dot=palette[bg]||'#E8B84B';
    return '<div style="background:'+bg+';border:1px solid rgba(0,0,0,.06);border-radius:10px;padding:10px 12px;max-width:200px;font-size:13px;color:var(--text);position:relative;box-shadow:0 1px 3px rgba(0,0,0,.06)">'+escapeHtml(n.t)+'<span style="position:absolute;top:4px;right:8px;cursor:pointer;color:var(--coral);font-weight:700" onclick="delNote('+i+')" title="删除">✕</span></div>';
  }).join('');
}
function delNote(i){
  var arr=[];try{arr=JSON.parse(localStorage.getItem('pp_notes')||'[]');}catch(e){}
  arr.splice(i,1);
  try{localStorage.setItem('pp_notes',JSON.stringify(arr));}catch(e){}
  renderNotes();
}
/* —— 导出当前板块为 PDF（利用浏览器打印，打印样式只显示激活视图）—— */
function exportCurrentPDF(){
  var active=document.querySelector('.view.active');
  if(!active){flash('没有可导出的内容');return;}
  var head=active.querySelector('.page-head h1');
  var name=head?head.textContent.replace(/[^一-龥A-Za-z0-9 ]/g,'').trim():'栖匣';
  var clone=active.cloneNode(true);
  clone.className='view active';
  clone.style.display='block';
  // 移除克隆里的可编辑/按钮等无关元素，保持干净
  clone.querySelectorAll('button,.btn,.icon-btn,.modal').forEach(function(el){el.remove();});
  clone.querySelectorAll('[contenteditable]').forEach(function(el){el.removeAttribute('contenteditable');});
  // textarea 的当前值不在 innerHTML 里，需手动写入
  clone.querySelectorAll('textarea').forEach(function(el){
    var v=el.value||el.getAttribute('data-init')||'';
    el.textContent=v;el.removeAttribute('placeholder');
  });
  /* 图片相对路径修正：预览用 iframe srcdoc/新窗口没有基准路径，相对 src 会加载失败。
     将克隆内所有相对路径图片与内联背景图统一转为绝对地址；data:/blob: 图片保持原样。 */
  function absUrl(s){ if(!s)return s; if(/^(data:|blob:|http:|https:|file:|\/)/i.test(s))return s; try{return new URL(s,location.href).href;}catch(e){return s;} }
  clone.querySelectorAll('img').forEach(function(im){ var s=im.getAttribute('src'); if(s)im.setAttribute('src',absUrl(s)); });
  clone.querySelectorAll('[style]').forEach(function(el){
    ['background','backgroundImage'].forEach(function(p){
      var v=el.style.getPropertyValue(p);
      if(v&&/url\(/i.test(v)){
        var nv=v.replace(/url\(\s*(['"]?)((?!data:|blob:|https?:|\/).+?)\1\s*\)/gi,function(m,q,u){return 'url("'+absUrl(u.replace(/["']/g,''))+'")';});
        el.style.setProperty(p,nv);
      }
    });
  });
  var style='<style>@page{margin:12mm 10mm}/* ===== 全局基础 ===== */*{box-sizing:border-box}body{font-family:-apple-system,"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif;color:#2E2A24;line-height:1.82;font-size:15px;padding:0;margin:0;background:#FCF8EC}/* ===== 页面标题区 ===== */.page-head{margin-bottom:20px;padding:18px 20px;background:linear-gradient(135deg,#6E4F37 0%,#4A3427 100%);color:#fff;border-radius:14px;box-shadow:0 4px 16px rgba(122,115,99,.18)}.page-head h1{font-size:23px;margin:0 0 8px;color:#fff;display:flex;align-items:center;gap:9px}.page-head h1 svg{width:26px;height:26px;flex-shrink:0;filter:brightness(0) invert(1)}.page-head p{color:rgba(255,255,255,.78);margin:0;font-size:14.5px;line-height:1.65}/* ===== 网格布局 ===== */.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}/* ===== 卡片容器（每个区块都有边框+圆角+阴影） ===== */.card{border:1.5px solid #DAD5C6;border-radius:13px;padding:20px;margin-bottom:18px;break-inside:avoid;background:#fff;box-shadow:0 2px 8px rgba(44,52,64,.05),0 .5px 1px rgba(44,52,64,.03);position:relative;overflow:hidden}.card::before{content:"";position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(180deg,#6E4F37,#8A6D48);border-radius:13px 0 0 13px}/* ===== 标题 ===== */.card h3{font-size:17.5px;color:#4A3427;margin:0 0 14px;font-weight:700;padding-bottom:10px;border-bottom:1.5px dashed #EFE8D8;display:flex;align-items:center;gap:7px}.card h3:first-child{margin-top:0}.card h4{font-size:16px;color:#4A3427;margin:14px 0 10px;font-weight:700}/* ===== 段落与文字 ===== */.card p{font-size:15px;line-height:1.85;margin:10px 0;color:#3A4038}/* ===== 列表（带装饰性项目符号和分隔线） ===== */.card ul,.card ol{margin:12px 0;padding-left:0;list-style:none}.card ul>li,.card ol>li{position:relative;padding:10px 12px 10px 30px;margin:6px 0;font-size:15px;line-height:1.8;color:#3A4038;border:1px solid #EFE8D8;border-radius:9px;background:#FCF8EC;transition:.15s}.card ul>li::before{content:"";position:absolute;left:11px;top:50%;transform:translateY(-50%);width:7px;height:7px;border-radius:50%;background:#6E4F37;flex-shrink:0}.card ol>li{counter-increment:list-num;padding-left:32px}.card ol>li::before{content:counter(list-num);position:absolute;left:10px;top:50%;transform:translateY(-50%);width:22px;height:22px;border-radius:50%;background:#6E4F37;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;line-height:1}.card ol{counter-reset:list-num}/* ===== 嵌套列表 ===== */.card ul ul,.card ol ol{margin:6px 0 0 12px}.card ul ul>li,.card ol ol>li{padding:7px 10px 7px 24px;margin:4px 0;font-size:14px;border-color:#EFE8D8;background:#fff}/* ===== Callout 提示框（更醒目） ===== */.callout{border-radius:11px;padding:16px 18px;margin-top:14px;font-size:15px;line-height:1.78;background:linear-gradient(135deg,#EFE8D8,#F5EFE2);border:1.5px solid #E2D8C4;border-left:5px solid #6E4F37;color:#4A5D2E;box-shadow:0 2px 6px rgba(122,115,99,.08)}/* ===== 标签 ===== */.tag{border:1.5px solid #D2CCBC;border-radius:999px;padding:4px 14px;font-size:13px;color:#4A3427;background:#EEF1E5;font-weight:500;display:inline-block;margin:2px 3px}/* ===== 输入框/文本域 ===== */.textarea,.card textarea{width:100%;border:1.5px solid #DAD5C6;border-radius:10px;padding:13px 14px;font-size:15px;line-height:1.75;font-family:inherit;white-space:pre-wrap;min-height:100px;color:#2E2A24;background:#FDFBF7;transition:.15s}textarea{resize:none}/* ===== 表格（斑马纹+粗表头） ===== */table{border-collapse:separate;border-spacing:0;width:100%;font-size:14px;border:1.5px solid #DAD5C6;border-radius:10px;overflow:hidden}.card table{margin:12px 0}th,td{border:1px solid #E1DCCE;padding:10px 8px;text-align:center;line-height:1.55}th{background:linear-gradient(180deg,#4A3427,#4A3427);color:#fff;font-weight:700;font-size:13.5px;letter-spacing:.3px}tr:nth-child(even) td{background:#EFE8D8}td{color:#3A4038}/* ===== SVG 图标 ===== */svg{max-width:24px;max-height:24px}/* ===== 分隔线装饰 ===== */hr,.divider{border:none;height:1.5px;background:linear-gradient(90deg,transparent,#DAD5C6 20%,#DAD5C6 80%,transparent);margin:16px 0}/* ===== 报告品牌头/页脚 ===== */.pdf-brandbar{display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,#4A3427 0%,#4A3427 45%,#6E4F37 100%);color:#fff;padding:16px 22px;border-radius:14px;margin-bottom:22px;box-shadow:0 6px 18px rgba(74,58,40,.22);position:relative;overflow:hidden;page-break-inside:avoid}.pdf-brandbar::after{content:"";position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.14),transparent 62%)}.pb-logo{flex-shrink:0;z-index:1;width:40px;height:40px;border-radius:9px;background:linear-gradient(135deg,#8A6D48,#6E4F37);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:20px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.2)}.pb-logo::before{content:"匣";line-height:1;transform:translateY(1px)}.pb-logo img{width:100%;height:100%;border-radius:9px;display:block}.pb-info{display:flex;flex-direction:column;min-width:0;z-index:1}.pb-info b{font-size:18px;letter-spacing:.5px}.pb-info span{font-size:12px;opacity:.82;margin-top:3px}.pb-meta{margin-left:auto;text-align:right;z-index:1;display:flex;flex-direction:column;align-items:flex-end;gap:4px}.pb-meta .pb-name{font-size:12.5px;opacity:.92;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);padding:2px 12px;border-radius:999px}.pb-meta .pb-date{font-size:11.5px;opacity:.8}.pdf-footer{margin-top:28px;padding-top:18px;border-top:1.5px dashed #BAB5A6;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px;line-height:1.8;color:#8C7863;text-align:center;page-break-inside:avoid}.pdf-footer div{background:#EFE8D8;border-radius:999px;padding:6px 16px}.pdf-brandbar,.pdf-footer{-webkit-print-color-adjust:exact;print-color-adjust:exact}@page{size:A4;margin:13mm 11mm}/* ===== 打印隐藏 ===== */@media print{.no-print{display:none!important}}/* ===== 手机端适配 ===== */@media(max-width:600px){body{font-size:15.5px;padding:0 4px}.page-head{padding:14px 16px;border-radius:11px}.page-head h1{font-size:21px}.page-head h1 svg{width:22px;height:22px}.page-head p{font-size:14px}.grid{grid-template-columns:1fr;gap:12px}.card{padding:16px 14px;margin-bottom:14px;border-radius:11px}.card h3{font-size:16.5px;padding-bottom:8px}.card h4{font-size:15.5px}.card p,.card ul>li,.card ol>li,.callout,.textarea,.card textarea{font-size:14.5px}.card ul>li,.card ol>li{padding:9px 10px 9px 26px}.tag{font-size:12.5px;padding:3px 11px}table{font-size:13px}th,td{padding:8px 6px}}</style>';
  var nowD=new Date(),taskList=document.querySelector('.view.active')?null:'';
  var ds=(''+nowD.getFullYear())+'-'+('0'+(nowD.getMonth()+1)).slice(-2)+'-'+('0'+nowD.getDate()).slice(-2);
  var html='<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><title>'+name+' · 栖匣</title>'+style+'</head><body>'
    +'<div class="pdf-brandbar"><div class="pb-logo"><img src="'+absUrl('./pwa/logo-chest20260911.png')+'" alt="匣" onerror="this.style.display=\'none\'" loading="eager"></div><div class="pb-info"><b>栖匣 · 心有所栖 · 匣纳成长</b><span>个人成长报告 · 数据仅存于你的设备</span></div><div class="pb-meta"><span class="pb-name">'+name+'</span><span class="pb-date">导出于 '+ds+'</span></div></div>'
    +clone.innerHTML
    +'<div class="pdf-footer"><div>由「栖匣 · 心有所栖 · 匣纳成长」生成</div><div>个人资料 · 私密导出 · '+ds+'</div></div>'
    +'</body></html>';
  /* 在当前页面打开全屏预览：直接看到结果，不受弹窗拦截影响，可随时打印/另存为 PDF */
  var ov=document.getElementById('pdfPreview');
  if(!ov){
    ov=document.createElement('div');ov.id='pdfPreview';
    ov.innerHTML='<div class="pp-bar"><strong>🗎 '+name+' · 报告预览</strong><span class="pp-tip">预览即所见 · 可直接查看，也可「复制全文 / 打印另存为 PDF」</span><div class="pp-btns"><button class="pp-btn copy" id="ppCopyBtn" onclick="copyPreviewText()" style="display:none">📋 复制全文</button><button class="pp-btn print" onclick="printPreview()">🖨 打印 / 另存为 PDF</button><button class="pp-btn close" onclick="closePreview()">✕ 关闭</button></div></div><iframe id="ppFrame" title="报告预览"></iframe>';
    document.body.appendChild(ov);
  }
  /* 更新标题栏里的报告名 */
  var ovStrong=ov.querySelector('.pp-bar>strong');if(ovStrong)ovStrong.textContent='🗎 '+name+' · 报告预览';
  ov.style.display='flex';
  var fr=document.getElementById('ppFrame');
  window._ppReportHtml=html;
  fr.srcdoc=html;   /* srcdoc 隔离样式，原样渲染 */
  fr.onload=function(){try{fr.contentDocument.body.classList.add('pp-rendered');}catch(e){}};
  flash('已生成「'+name+'」报告预览，可直接查看或打印/另存为 PDF');
}
/* 打印/另存为PDF：新窗口打开报告并调用打印（比 iframe 内 print 在微信/移动端更稳，能正常出「另存为 PDF」） */
function printPreview(){
  var html=window._ppReportHtml||'';
  if(!html){flash('暂无可打印内容，请先重新生成报告');return;}
  if(navigator.userAgent&&/MicroMessenger/i.test(navigator.userAgent)){
    flash('微信内置浏览器暂不支持打印，请在页面右上角「在浏览器中打开」后，点击预览里的打印/另存为 PDF，或在浏览器菜单用「打印」保存为 PDF');
    return;
  }
  try{
    var pw=window.open('','_blank','width=860,height=1000,noopener');
    if(!pw||pw.closed){flash('打印窗口被浏览器拦截，请允许本页弹窗后重试，或在预览里按「✕」后从浏览器菜单打印');return;}
    pw.document.open();pw.document.write(html);pw.document.close();
    var h=setInterval(function(){
      try{
        if(pw.document.readyState==='complete'){
          clearInterval(h);
          setTimeout(function(){try{pw.focus();pw.print();flash('已调起打印，选择「另存为 PDF」即可保存');}catch(e){flash('请在打印窗口里手动选择「打印/另存为 PDF」');}},200);
        }
      }catch(e){clearInterval(h);}
    },180);
  }catch(e){flash('打印未成功，可在预览区域按浏览器菜单「打印/另存为 PDF」');}
}
/* 关闭报告预览 */
function closePreview(){
  var ov=document.getElementById('pdfPreview');
  if(ov){ov.style.display='none';var fr=document.getElementById('ppFrame');if(fr)fr.srcdoc='';}
  var cb=document.getElementById('ppCopyBtn');if(cb)cb.style.display='none';
  window._ppCopyText=null;
  window._ppReportHtml=null;
  flash('已关闭报告预览');
}
/* 复制报告全文（微信等内嵌浏览器也能用） */
function copyPreviewText(){
  var t=window._ppCopyText;if(!t)return;
  function fallback(){
    try{
      var ta=document.createElement('textarea');ta.value=t;
      ta.style.position='fixed';ta.style.opacity='0';ta.style.top='-100px';
      document.body.appendChild(ta);ta.focus();ta.select();
      var ok=document.execCommand('copy');document.body.removeChild(ta);
      flash(ok?'已复制全文，可粘贴到微信 / 备忘录':'复制未成功，可长按预览内容手动复制');
    }catch(e){flash('复制未成功，可长按预览内容手动复制');}
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(t).then(function(){flash('已复制全文，可粘贴到微信 / 备忘录');}).catch(fallback);
  }else{fallback();}
}
/* 在页面内直接展示报告预览（不下载文件 → 微信/移动端浏览器也能即开即看） */
function showPdfReport(name, html, copyText){
  var ov=document.getElementById('pdfPreview');
  if(!ov){
    ov=document.createElement('div');ov.id='pdfPreview';
    ov.innerHTML='<div class="pp-bar"><strong>🗎 '+name+' · 报告预览</strong><span class="pp-tip">预览即所见 · 可直接查看，也可「复制全文 / 打印另存为 PDF」</span><div class="pp-btns"><button class="pp-btn copy" id="ppCopyBtn" onclick="copyPreviewText()" style="display:none">📋 复制全文</button><button class="pp-btn print" onclick="printPreview()">🖨 打印 / 另存为 PDF</button><button class="pp-btn close" onclick="closePreview()">✕ 关闭</button></div></div><iframe id="ppFrame" title="报告预览"></iframe>';
    document.body.appendChild(ov);
  }
  var ovStrong=ov.querySelector('.pp-bar>strong');if(ovStrong)ovStrong.textContent='🗎 '+name+' · 报告预览';
  ov.style.display='flex';
  window._ppCopyText=copyText||null;
  window._ppReportHtml=html;
  var cb=document.getElementById('ppCopyBtn');if(cb)cb.style.display=(copyText?'inline-block':'none');
  var fr=document.getElementById('ppFrame');
  fr.srcdoc=html;
  fr.onload=function(){try{fr.contentDocument.body.classList.add('pp-rendered');}catch(e){}};
  flash('已生成预览，点开即可直接查看「'+name+'」');
}
/* —— 侧边栏板块搜索过滤 —— */
function filterNav(q){
  q=(q||'').trim();
  var items=document.querySelectorAll('.sidebar .nav-item');
  items.forEach(function(it){
    var txt=it.textContent.replace(/\s/g,'');
    if(!q){it.style.display='';return;}
    it.style.display=txt.indexOf(q)>=0?'':'none';
  });
  /* 隐藏没有匹配项的分组标题 */
  document.querySelectorAll('.sidebar .nav-section').forEach(function(sec){
    var prev=sec.nextElementSibling;
    var any=false;
    while(prev && prev.classList && prev.classList.contains('nav-item')){
      if(prev.style.display!=='none')any=true;
      prev=prev.nextElementSibling;
    }
    sec.style.display=any?'':'none';
  });
}
/* —— 今日鼓励语（首页按日期轮换，不鸡汤不制造焦虑）—— */
var _curEncIdx=-1;var _curQuoteIdx=-1;
var ENCOURAGE=[
  '今天也是值得被爱的一天。',
  '你已经做得很好了，比昨天更好。',
  '允许自己偶尔停下来，休息也是前进的一部分。',
  '不必每件事都追求完美，完成比完美更重要。',
  '你的每一次尝试，都在为未来积累可能性。',
  '今天哪怕只进步了一点点，也是在向上走。',
  '相信过程，结果往往会在意想不到的时候到来。',
  '累了就歇一歇，满血复活后再出发。',
  '你比自己想象中更坚强、更有韧性。',
  '今天的阳光和你一样温暖。',
  '一步一个脚印，稳稳地走向你想去的地方。',
  '别和别人比进度，每个人的时区不一样。',
  '你的努力也许暂时看不到回报，但它从未白费。',
  '深呼吸，然后继续往前走，你能搞定。',
  '今天的选择，就是未来的答案。'
];
/* 不重复选取：本轮刷新内用过的索引记录在 localStorage，换完一轮自动重置，保证每次都不重复 */
function _unusedIndex(arr,key){
  try{
    var used=(JSON.parse(localStorage.getItem(key)||'[]'))||[];
    if(used.length>=arr.length){used=[];}
    var pool=[];for(var i=0;i<arr.length;i++){if(used.indexOf(i)<0)pool.push(i);}
    var pick=pool[Math.floor(Math.random()*pool.length)];
    used.push(pick);localStorage.setItem(key,JSON.stringify(used));
    return pick;
  }catch(e){return Math.floor(Math.random()*arr.length);}
}
function renderDailyEncourage(refresh){
  var idx=refresh?(_unusedIndex(ENCOURAGE,'pp_enc_used')):(Math.floor(Date.now()/86400000)%ENCOURAGE.length);
  _curEncIdx=idx;
  var e=document.getElementById('dailyEncourage');
  if(e)e.textContent=ENCOURAGE[idx];
  renderTodayGreeting();
}
/* 日期问候（独立函数，供今日心语与每日刷新共用） */
function renderTodayGreeting(){
  var g=document.getElementById('dailyGreeting');
  if(!g)return;
  var d=new Date();var h=d.getHours();
  var part=h<6?'夜深了，':(h<11?'早上好，':(h<14?'中午好，':(h<18?'下午好，':'晚上好，')));
  var wd='日一二三四五六'[d.getDay()];
  g.textContent=part+'今天是 '+(d.getMonth()+1)+'月'+d.getDate()+'日 星期'+wd+'。新的一天，稳稳走，向前行。';
}
/* ═══════ 今日心语：金句＋鼓励合成一卡（手选 · 按日轮换 · 换一句不重复） ═══════ */
var MINDS=[
  '把今天走稳，把长路走远',
  '把今天过好，就是对未来最好的准备',
  '不必急着证明什么，你只需要比昨天的自己更懂自己',
  '那些看似不起波澜的日复一日，会在某天让你看到坚持的意义',
  '真正的成长，是把「我应该」慢慢换成「我选择」',
  '允许自己被看见，也允许自己偶尔停下来',
  '你读过的书、走过的路，都会在恰当的时候派上用场',
  '专注本身就是一种稀缺的能力，今天练习一次就好',
  '别把「忙」和「进步」划等号，安静的积累更有力量',
  '哪怕今天只做了一道题、背了一组词，也已经是在向前',
  '把焦虑换成行动，把比较换成专注，把自己还给自己',
  '今天的小步，是明天大步的地基；走稳，就是快',
  '不必事事都说明白，攒下的力气用来把事做漂亮',
  '情绪会路过你，但决定整天心情的，是你怎么接住它',
  '先把手头这一件事做好，世界会慢慢为你让路',
  '你不需要成为别人，你需要成为更完整的自己',
  '早睡一小时，胜过深夜的自我感动',
  '每一个「再做一遍」的耐心，都在悄悄拉开你和过去的距离',
  '别用「准备不充分」拖延开始，用「先做一点点」代替等待',
  '今天总有件小事能让你进步，去做它，就赢了今天'
];
/* 今日心语渲染：manual=true 手选不重复；false 按日期轮换 */
function refreshMind(manual){
  var idx=manual?_unusedIndex(MINDS,'pp_mind_used'):(Math.floor(Date.now()/86400000)%MINDS.length);
  var m=document.getElementById('dailyMind');
  if(m&&MINDS[idx]){var t=MINDS[idx];if(t.indexOf('“')!==0)t='“'+t+'”';m.textContent=t;}
  renderTodayGreeting();
}
function spinMindReload(){
  var b=document.querySelector('.mind-refresh');
  if(!b)return;
  b.classList.remove('spinning');void b.offsetWi