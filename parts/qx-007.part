  box.innerHTML=ws.slice(-10).reverse().map(function(w){
    return '<div style="padding:8px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px"><span class="tag tag-coral">'+escapeHtml(w.type)+'</span> <span style="font-size:13px">'+escapeHtml(w.desc)+'</span><div style="font-size:11px;color:var(--hint);margin-top:4px">'+escapeHtml(w.date)+'</div></div>'
  }).join('');
}
