  <!-- ═══════════ 栖匣 助手 · 本地 Agent（纯前端、无后端，话术为预置回应） ═══════════ -->
  <section class="view" id="view-agent">
<div class="section-intro">陪你走好每一步的成长搭档：帮助规划、执行、复盘，情绪只是配套而非前置门槛。</div>
    <div class="page-head">
      <h1><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a7 7 0 0 0-4 12.74V17h8v-2.26A7 7 0 0 0 12 2z"></path><path d="M9 17h6v3H9z"></path><circle cx="9" cy="11.5" r=".5" fill="currentColor"></circle><circle cx="15" cy="11.5" r=".5" fill="currentColor"></circle></svg>栖匣 助手</h1>
      <p>打开即可开始规划与执行，不必先「调整好心态」再做事。</p>
    </div>

    <div class="card" style="display:flex;flex-direction:column;overflow:hidden">
      <div id="agentChat" style="height:320px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;background:var(--bg);border:1px solid var(--border);border-radius:12px;scroll-behavior:smooth">
        <div class="agent-bubble agent-in"><b>🪵 栖匣 助手</b><div style="margin-top:4px">你好，欢迎来到栖匣。<br>我是陪你规划当下、记录成长的助手。你可以直接告诉我：是想规划备考 / 绩点 / 保研 / 考证路线，拆解目标和任务、安排时间、准备简历面试，还是想整理复盘、记录这段时期的想法。<br><br>你今天想从哪里开始？</div></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:6px;margin:12px 2px 8px">
        <span style="font-size:11px;color:var(--hint);line-height:1.9">快速选择一种场景：</span>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(0)">目标太多·压力大</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(1)">拖延·迟迟不动</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(2)">复盘·觉得没产出</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(3)">保研·学业规划</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(4)">实习·求职·简历</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(5)">财务·记账·省钱</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(6)">健康·作息·运动</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(7)">人际·宿舍·情绪</button>
        <button class="btn btn-sm" style="border-color:var(--border-strong);background:var(--card);color:var(--text)" onclick="agentScenario(8)">过度消耗·想喘口气</button>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <input id="agentInput" type="text" placeholder="输入你的情况，比如：我有点焦虑" style="flex:1;min-width:0;padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);font-size:14px;outline:none" onkeydown="if(event.key===&#39;Enter&#39;)agentSend()">
        <button class="btn btn-primary btn-sm" style="padding:10px 16px" onclick="agentSend()">发送</button>
      </div>
      <div style="margin-top:10px;font-size:12px;color:var(--hint);line-height:1.7">💬 栖匣 助手完全在你的浏览器本地运行，不联网、不上传任何内容；你的每一次倾诉与提问都只留在当前这台设备里。</div>
    </div>
  </section>

    </main>
  </div>

<div class="flash" id="flash">✅ 已复制【完整文案+链接】，去微信/QQ 粘贴发送吧～</div>

<!-- 番茄钟全屏专注覆盖层 -->
<div id="pomoFullscreen" style="position:fixed;inset:0;z-index:9998;background:linear-gradient(135deg,#4A3427 0%,#6E4F37 100%);color:#fff;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px">
  <div style="font-size:14px;letter-spacing:3px;opacity:.8;margin-bottom:10px">深度专注模式</div>
  <div id="pomoFsTask" style="font-size:22px;font-weight:600;margin-bottom:24px;max-width:600px">专注中</div>
  <div id="pomoFsTime" style="font-size:120px;font-family:ui-monospace,Consolas,monospace;font-weight:700;line-height:1;margin-bottom:30px">25:00</div>
  <div style="font-size:14px;opacity:.75;margin-bottom:30px;max-width:480px;line-height:1.7">放下手机，只做眼前这一件事。<br>想分心时，把念头写在纸上，继续专注。</div>
  <button onclick="pomoToggle()" style="background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.4);padding:12px 32px;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer">暂停 / 退出专注</button>
</div>

<script>
/* 成长档案实时刷新调度：任何 DB.set 后都会在防抖窗口内自动重算成长档案与首页统计，
   从而做到「打卡/勾选待办/结束番茄/修改任务」后数字立即同步，无需刷新页面。 */
var _dbRefreshTimer=null,_storageWarned=false;
function scheduleStatsRefresh(){
  try{
    clearTimeout(_dbRefreshTimer);
    _dbRefreshTimer=setTimeout(function(){
      try{ if(typeof updateStats==='function') updateStats(); }catch(e){}
      try{ if(typeof refreshHomeStats==='function') refreshHomeStats(); }catch(e){}
    },120);
    /* 存储失败提示：近乎占满 / 无痕关闭清空等，只提醒一次并引导导出备份 */
    if(!_storageWarned){
      try{
        var _est=0;
        for(var _i=0;_i<localStorage.length;_i++){var _k=localStorage.key(_i);var _v=localStorage.getItem(_k);_est+=((_k?_k.length:0)+(_v?_v.length:0))*2;}
        if(_est>3800000){
          _storageWarned=true;
          setTimeout(function(){try{if(window.flash)flash('⚠️ 本地存储已接近容量上限（约'+Math.round(_est/1024/1024*10)/10+'MB）。为避免数据丢失，请立即「导出全部数据」并定期备份。');}catch(e){}},600);
        }
      }catch(e){}
    }
  }catch(e){}
}
var DB={
  get:function(k,d){try{var v=localStorage.getItem('pp_'+k);if(v===null||v==='')return d;var p=JSON.parse(v);return p===null||p===undefined?d:p}catch(e){return d}},
  set:function(k,v){
    try{localStorage.setItem('pp_'+k,JSON.stringify(v)); scheduleStatsRefresh();}
    catch(e){
      /* 存储失败（无痕模式 / 容量占满 / 被禁用）：绝不让数据静默丢失，至少提示用户 */
      try{
        if(!DB._warn){DB._warn=true;
          setTimeout(function(){
            try{ if(window.flash) flash('⚠️ 本地存储写入失败：当前为无痕/隐私模式或存储已满，本次改动可能无法保存。请退出无痕模式，或立即「导出全部数据」备份。'); }catch(e2){}
          },400);
        }
      }catch(e2){}
    }
  },
  del:function(k){try{localStorage.removeItem('pp_'+k)}catch(e){}}
};

function todayKey(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}


/* ═══════ 高分作文模板库（每日刷新 + 历史记录） ═══════ */
var ESSAY_TPLS=[
  {type:'现象阐释型',scene:'议论文 / 图画题 / 现象评论',
   body:'Recently, there has been a growing concern over [现象]. When it comes to this phenomenon, opinions vary from person to person.\n\nFrom my perspective, [我的观点]. On the one hand, [理由一]. On the other hand, [理由二]. What\'s more, [递进理由].\n\nTaking all these factors into consideration, we may safely draw the conclusion that [重申观点]. Only in this way can we [升华].',
   sentences:['倒装：Only by doing so can we...','强调：It is ... that ...','虚拟：Were it not for..., we would...']},
  {type:'观点对比型',scene:'议论文 / AB观点对比',
   body:'When asked about [话题], different people hold different views. Some people argue that [观点A], while others believe that [观点B].\n\nAs far as I am concerned, I am in favor of [我的立场]. For one thing, [理由一]. For another, [理由二]. Additionally, [补充理由].\n\nIn conclusion, [重申观点]. Only when we [做法] can we [升华].',
   sentences:['对比：While... others believe that...','递进：Additionally / Furthermore','收束：Only when... can we...']},
  {type:'问题解决型',scene:'议论文 / 社会问题',
   body:'Nowadays, [问题现象] has become a matter of great concern. It not only [危害一], but also [危害二].\n\nTo address this issue, several measures should be taken. First and foremost, [措施一]. Moreover, [措施二]. Last but not least, [措施三].\n\nOnly through the joint efforts of [主体] can we [升华]. As a college student, I will [个人行动].',
   sentences:['危害：not only... but also...','措施：First / Moreover / Last but not least','升华：Only through... can we...']},
  {type:'图表描述型',scene:'议论文 / 图表题',
   body:'As is vividly revealed in the chart, [图表描述总体趋势]. Specifically, [数据细节一], while [数据细节二]. What accounts for this phenomenon?\n\nSeveral factors contribute to this trend. To begin with, [原因一]. In addition, [原因二]. Furthermore, [原因三].\n\nFrom what has been discussed above, we may safely predict that [预测趋势].',
   sentences:['描述：As is revealed in the chart...','分析：To begin with / In addition / Furthermore','预测：we may safely predict that...']},
  {type:'书信应用型',scene:'应用文 / 建议信 / 投诉信 / 邀请信',
   body:'Dear [收件人],\n\nI am writing to express my [concern/suggestion/invitation] regarding [事由]. [说明背景或缘由].\n\nTo begin with, [建议一]. In addition, [建议二]. I would appreciate it if you could [请求].\n\nI am looking forward to your reply at your earliest convenience.\n\nYours sincerely,\n[Your Name]',
   sentences:['开头：I am writing to express...','请求：I would appreciate it if you could...','结尾：looking forward to your reply']},
  {type:'谚语阐释型',scene:'议论文 / 名言警句',
   body:'"[谚语]" is a well-known proverb that conveys a profound truth. Simple as it is, it tells us that [阐释].\n\nTake [例子] for example. [具体论证]. Another case in point is [例子二]. [论证二].\n\nIn a word, we should [做法]. Only by doing so can we [升华].',
   sentences:['引出：conveys a profound truth','举例：Take... for example','收束：Only by doing so can we...']},
  {type:'叙事抒情型',scene:'记叙文 / 个人经历',
   body:'There is one experience that I will never forget. It happened [时间地点] when [事件起因].\n\nTo my surprise, [发展]. What moved me most was that [最打动人的细节]. Eventually, [结局].\n\nLooking back, I realize that [感悟]. This experience has taught me that [升华].',
   sentences:['引子：There is one experience...','高潮：What moved me most was that...','感悟：has taught me that...']}
];

function todayEssayIdx(){var day=Math.floor(Date.now()/86400000);return day%ESSAY_TPLS.length;}
function renderEssay(forceIdx){
  var idx=(typeof forceIdx==='number')?forceIdx:todayEssayIdx();
  var e=ESSAY_TPLS[idx];
  var typeBox=document.getElementById('essayType');
  if(!typeBox)return;
  typeBox.textContent=e.type+' · '+e.scene;
  document.getElementById('essayBody').textContent=e.body;
  document.getElementById('essaySentences').innerHTML=e.sentences.map(function(s){return '<li>'+s+'</li>';}).join('');
  var hist=getEssayHistory();
  var today=todayKey();
  hist=hist.filter(function(h){return h.date!==today;});
  hist.unshift({date:today,idx:idx,type:e.type});
  if(hist.length>30)hist=hist.slice(0,30);
  try{localStorage.setItem('essayHistory',JSON.stringify(hist));}catch(e){}
}
function getEssayHistory(){
  try{var s=localStorage.getItem('essayHistory');return s?JSON.parse(s):[];}catch(e){return [];}
}
function nextEssayTpl(){
  var rnd=Math.floor(Math.random()*ESSAY_TPLS.length);
  renderEssay(rnd);
  flash('已换一篇');
}
function toggleEssayHistory(){
  var box=document.getElementById('essayHistoryBox');
  var list=document.getElementById('essayHistoryList');
  if(box.style.display==='none'){
    var hist=getEssayHistory();
    if(!hist.length){list.innerHTML='<span style="color:var(--hint)">暂无历史记录</span>';}
    else{
      list.innerHTML=hist.map(function(h){
        return '<div style="padding:8px 10px;border-left:3px solid var(--primary);margin-bottom:6px;background:var(--bg)">'
          +'<strong style="color:var(--primary)">'+h.date+'</strong> · '+h.type
          +'<button class="btn btn-sm" style="float:right" onclick="renderEssay('+h.idx+')">查看</button></div>';
      }).join('');
    }
    box.style.display='block';
  }else{box.style.display='none';}
}

var QUOTES=[
  "星光不问赶路人，时光不负有心人",
  "半山腰太挤了，我们要去山顶看看",
  "你的坚持，终将美好",
  "与其仰望星空，不如去做那颗摘星的人",
  "每一个不曾起舞的日子，都是对生命的辜负",
  "真正的优秀不是优于别人，而是优于过去的自己",
  "把简单的事做好就是不简单，把平凡的事做精就是不平凡",
  "你现在的努力，是未来你想要的生活的入场券",
  "不要因为走得太远，而忘记为什么出发",
  "生活明朗，万物可爱，人间值得，未来可期",
  "自律给我自由",
  "种一棵树最好的时间是十年前，其次是现在",
  "你若盛开，蝴蝶自来",
  "乾坤未定，你我皆是黑马",
  "热爱可抵岁月漫长",
  "前路浩浩荡荡，万事尽可期待",
  "保持热爱，奔赴山海",
  "少年心事当拏云，谁念幽寒坐呜呃",
  "追风赶月莫停留，平芜尽处是春山",
  "博观而约取，厚积而薄发",
  "靡不有初，鲜克有终——所以坚持本身就是一种能力",
  "海阔凭鱼跃，天高任鸟飞",
  "路虽远，行则将至；事虽难，做则必成",
  "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生",
  "大鹏一日同风起，扶摇直上九万里",
  "长风破浪会有时，直挂云帆济沧海",
  "莫愁前路无知己，天下谁人不识君",
  "会当凌绝顶，一览众山小",
  "千淘万漉虽辛苦，吹尽狂沙始到金",
  "宝剑锋从磨砺出，梅花香自苦寒来",
  "不经一番寒彻骨，怎得梅花扑鼻香",
  "世上无难事，只要肯登攀"
];

var LAWS=[
  {t:"久坐的危害",d:"久坐超过1小时，新陈代谢下降、血液循环变慢。建议每45分钟起身活动5分钟，伸腰、走动、远眺，能显著降低颈椎病和腰椎间盘突出风险。",src:"健康小知识"},
  {t:"睡眠周期",d:"一个完整睡眠周期约90分钟，包含浅睡→深睡→REM。睡满4-5个周期（6-7.5小时）比硬凑8小时但频繁中断更解乏。固定起床时间是调节生物钟的关键。",src:"健康小知识"},
  {t:"喝水时机",d:"晨起一杯温水唤醒代谢；饭前30分钟喝水有助消化；运动前后补水防脱水；睡前1小时少喝水防夜起。成人每天建议1.5-2升，别等渴了才喝。",src:"健康小知识"},
  {t:"20-20-20护眼法",d:"每用眼20分钟，看20英尺（约6米）外的物体20秒，能有效缓解屏幕疲劳、预防近视加深。大学生日均盯屏超8小时，这是最低成本的护眼法。",src:"健康小知识"},
  {t:"深呼吸减压",d:"4-7-8呼吸法：吸气4秒→屏息7秒→呼气8秒，循环4次。能激活副交感神经，快速降低焦虑、助眠。考前/面试前紧张时尤其有效。",src:"健康小知识"},
  {t:"午睡时长",d:"10-20分钟短时午睡能恢复精力、提升下午专注力；超过30分钟易进入深睡，醒来更昏沉。定好闹钟，别睡过头。",src:"健康小知识"},
  {t:"饭前喝水",d:"饭前喝300ml温水可增加饱腹感、减少进食量；充足水分还促进代谢。但别用含糖饮料代替，那是反向操作。",src:"健康小知识"},
  {t:"屏幕蓝光",d:"睡前1小时少用手机，蓝光会抑制褪黑素分泌、推迟入睡。需要看就用夜间模式或暖光。",src:"健康小知识"},
  {t:"拉伸放松",d:"久坐人群每天做3分钟颈肩腰拉伸，预防僵硬酸痛。学习间隙顺手做，成本低收益高。",src:"健康小知识"}
];

var FINANCES=[
  {t:"复利的力量",d:"每月定投100元，年化5%，30年后约8.3万。其中本金3.6万，利息4.7万。时间是普通人最大的杠杆，越早开始复利效应越惊人。"},
  {t:"应急金原则",d:"应急金=3-6个月生活费，单独存放，只在失业/疾病/意外时动用。备用金符合这个原则，别动它去投资。"},
  {t:"4%法则",d:"若你年支出的25倍本金，按4%年化提取，本金可永续不缩水。这是FIRE运动的财务自由公式。完全自由门槛因人而异，自行测算。"},
  {t:"记账是理财第一步",d:"不记账的人永远不知道钱去哪了。建议用APP记录每笔支出，月底分类复盘，找出'拿铁因子'（不知不觉漏掉的小钱）。"},
  {t:"区分资产与负债",d:"资产=把钱放进你口袋的（基金/收租房/技能）；负债=把钱从口袋拿走的（超出消费能力的车/奢侈品）。多买资产，少买负债。"},
  {t:"指数基金定投",d:"普通人首选宽基指数基金（如沪深300）定期定额，分散风险、省心。长期持有、不追涨杀跌，是参与市场最稳的方式。",src:"理财常识"},
  {t:"先储蓄后消费",d:"钱到账先划出储蓄/投资部分，剩下的才用于消费（'先付钱给自己'）。反过来'先花后存'往往存不下钱。",src:"理财常识"},
  {t:"不要借钱投资",d:"任何形式的杠杆/借贷投资都会放大风险，一次波动就可能爆仓。应急备用金要单独存放，绝不动用。",src:"理财常识"},
  {t:"警惕高收益骗局",d:"承诺'保本且年化10%+'的基本是骗局。收益与风险永远对等，天上不会掉馅饼。",src:"理财常识"},
  {t:"消费主义陷阱",d:"'买了就变好'是错觉：新手机不会让你更自律，健身卡不会替你运动。下单前问一句：没有它，我的生活真的会变差吗？",src:"财商"},
  {t:"信用是隐形资产",d:"信用卡/花呗按时还款，就是在积累征信——未来贷款买房、找工作都可能查征信。逾期一次，修复要5年。",src:"财商"},
  {t:"五险一金别忽略",d:"医保、养老、公积金都是强制储蓄。同样的工资，五险一金交得足的公司，实际待遇更好。入职先问清楚缴纳基数。",src:"财商"},
  {t:"保险先保大后保小",d:"优先买医疗险和重疾险（防'病一场回到解放前'），有余力再考虑理财型保险。别本末倒置去买'既能保障又能赚钱'的复杂产品。",src:"财商"}
];

/* 今日认知升级：思维模型与认知方法（每天轮换 · 可执行） */
var COGNITIONS=[
  {t:"沉没成本",d:"已经投入的时间/金钱/感情收不回来，就不是决策的依据。判断标准只有一个：继续做下去，未来是赚是亏？\"再坚持一下就能回本\"是最贵的幻觉。今天做：给一件\"舍不得放弃\"的事设一个止损点（如再试3次就停）。"},
  {t:"锚定效应",d:"人容易被第一个出现的数字带跑。商家标\"原价599现价199\"，599就是锚。砍价、谈薪资、买东西，先报一个比你预期更低/更高的数，让锚由你定。今天做：下次购物先查历史价，再决定要不要被\"原价\"锚住。"},
  {t:"幸存者偏差",d:"你只看到成功者，没看到大量失败者——所以容易高估\"别人行我也行\"。网红、学霸、创业故事同理。今天做：看到任何\"成功案例\"，先追问一句：没做成的人占多少？"},
  {t:"帕累托法则",d:"80%的结果来自20%的投入。一天里真正重要的事通常只有1-2件，把它们找出来、集中精力做完，比把时间摊给10件事高效得多。今天做：列出今天所有任务，圈出最重要的20%，先做它们。"},
  {t:"损失厌恶",d:"失去100元的痛苦约等于得到200元的快乐，所以人会死守亏损、拒绝止损。投资、感情、职业都如此。今天做：审视一件\"因为怕失去而一直拖着\"的事，用理性算笔账。"},
  {t:"机会成本",d:"做任何选择的真实代价，是放弃的那个选项。\"免费\"的东西也要花时间，时间的价值就是机会成本。今天做：睡前问自己：今天刷掉的2小时，如果用来学习/运动/陪伴，值多少？"},
  {t:"达克效应",d:"能力越低的人越容易高估自己，能力越高的人反而越谦虚。因为\"不知道自己不知道\"。今天做：对某个自以为很懂的话题，去听一个反对者的观点，检验自己是不是真懂。"},
  {t:"确认偏误",d:"人只愿意看支持自己观点的信息，越看越坚定，越坚定越偏激。今天做：主动搜索一个\"自己不喜欢\"的观点，读完再判断，你会比大多数人清醒。"},
  {t:"峰终定律",d:"人对一段体验的记忆，只由最高潮和结尾决定，过程好坏反而记不清。所以：工作汇报结尾强调成果、旅行最后一天安排惊喜、考试前多复习易得分点。今天做：把今天最重要的一件事安排到最后，留下好结尾。"},
  {t:"心理账户",d:"大脑把钱分类记账：吃饭的钱、买书的钱、投资的钱，互不流通。所以人会在\"买书\"上大方、在\"吃饭\"上抠门。今天做：检查你的心理账户——有没有把钱花在自我感觉良好、实际没用的类别上？"},
  {t:"首因与近因效应",d:"第一印象和最后印象最深刻。面试前5分钟决定成败、演讲结尾决定评分。今天做：下次自我介绍，把最亮眼的成果放第一句。"},
  {t:"破窗效应",d:"环境里一个小破洞不修，很快会引来更大的破坏。房间乱→人变懒→计划崩盘，是同一逻辑。今天做：花5分钟修掉一个\"破窗\"（整理桌面/关掉一个通知/还掉一笔小钱）。"},
  {t:"均值回归",d:"极好或极差的表现在长期都会回到平均水平。考试超常发挥别当真、偶尔低迷也别恐慌。今天做：把一次成功或失败都当作\"波动\"，回到你该做的日常节奏。"},
  {t:"复利曲线",d:"每天进步1%，一年后是37倍；每天退步1%，一年后只剩3%。前期的努力看起来没效果，是因为复利在底部爬行。今天做：选一个能日拱一卒的事（背词/阅读/练字），坚持30天再回头看曲线。"},
  {t:"金字塔原理",d:"表达先说结论，再给理由，最后补充细节。对方3秒内听不懂你在说什么，就是失败的沟通。今天做：回消息/汇报时，第一句先写结论，再展开。"},
  {t:"互惠原理",d:"人收了小恩小惠就不好意思拒绝对方的大要求。商家送试用装、免费课都是这个套路。今天做：收到\"免费\"邀请时，问自己：他想要什么回报？"},
  {t:"斯多葛控制二分法",d:"分清哪些你能控制（努力、态度），哪些你不能（结果、评价）。把精力全放在可控的，不可控的随它去，焦虑会大幅减少。今天做：为一件正在焦虑的事，写下\"可控/不可控\"两栏，只处理左边。"},
  {t:"决策疲劳",d:"每做一次选择都消耗意志力，选择太多的人到晚上更容易冲动消费、放纵。今天做：把重复的小决定提前定好（吃什么/穿什么/几点运动），给重要决策留清醒时间。"},
  {t:"心流启动法",d:"专注状态不是等来的，是\"启动\"来的：先做5分钟，大脑的抗拒会在开始后消退。最难的不是做，是开始。今天做：面对拖延的任务，只承诺自己\"先做5分钟\"。"},
  {t:"10-10-10法则",d:"做重大决定前，问自己：10分钟后怎么看？10个月后怎么看？10年后怎么看？拉长时间线，很多纠结瞬间清晰。今天做：对一个纠结的选择套用这个法则，写下三个答案。"}
];

/* 今日社会常识：每个人该知道的生存常识（每天轮换 · 打破信息差） */
var LIFE_TIPS=[
  {t:"五险一金到底是什么",d:"五险=养老+医疗+失业+工伤+生育，一金=住房公积金。公司不交或少交是违法的，入职一定要确认缴纳基数和比例。医保断缴超3个月，连续缴费年限清零、报销比例下降。今天做：打开你的工资条，核对五险一金是否到账。"},
  {t:"劳动合同必看5条",d:"①试用期最长6个月，且只能约定一次；②工资写清楚，低于当地最低工资违法；③加班费标准：平时1.5倍、周末2倍、法定假日3倍；④违约金只限两种情况（培训服务期、竞业限制），其他违约金条款无效；⑤离职提前30天书面通知即可，公司无权扣你工资。今天做：翻出你的合同，对照检查一遍。"},
  {t:"医保报销怎么用",d:"门诊：起付线内自付，超过后按比例报；住院：比例更高；异地就医：先备案（国家医保服务平台APP）再报销。医保卡只借本人使用，外借他人属于骗保。今天做：把\"国家医保服务平台\"APP装好，确认已激活电子医保码。"},
  {t:"身份证复印件要写用途",d:"复印件不注明用途会被冒用办卡、贷款。正确写法：在身份证复印件空白处手写\"仅限办理XXX使用，他用无效\"，并写上日期，字迹跨过身份证边缘。今天做：以后每次交复印件都加这行字。"},
  {t:"高铁/飞机退改签省钱",d:"开车前8天以上退票免费；8天内按梯次收费。飞机：起飞前4小时改签通常免费，临时改签可能收全价差额。买票前看清退改规则，别买\"特惠不退\"票。今天做：出行前确认车票/机票退改规则，行程不确定就买可退票。"},
  {t:"个人征信怎么查",d:"每人每年可在央行征信中心官网免费查2次。征信记录影响房贷、车贷、入职背调。逾期一次记录保留5年。别乱点网贷产品（每点一次查一次征信）。今天做：认准官网（中国人民银行征信中心）查一次自己的征信。"},
  {t:"租房合同必看5条",d:"①押金退还条件写清楚；②物业费/取暖费谁交；③房屋维修责任（电器坏了房东修）；④能否转租；⑤提前退租违约金怎么算。签约前拍下房间现状视频留证。今天做：租房先看房东房产证原件，确认他是真房东。"},
  {t:"紧急情况处理",d:"火警119、急救120、报警110、交通事故122。燃气泄漏：先开窗通风、别开灯别按开关、撤到室外再报警。家用灭火器应放在厨房门口，不是灶台边。今天做：确认家人手机里都存了紧急联系人+报警电话。"},
  {t:"网购7天无理由的例外",d:"7天无理由不适用于：定制商品、鲜活易腐、拆封的音像/软件、已激活的电子类。\"七天无理由\"包来回运费，买家承担退货运费。今天做：大额商品下单前截图页面承诺，为售后留证。"},
  {t:"银行利息怎么算",d:"活期约0.2%、定期1年约1.5%、大额存单（20万起）略高。10万放活期一年约200元，放定期一年约1500元——差别很大。今天做：把超过3个月不用的钱从活期挪到定期或货基。"},
  {t:"公积金能干什么",d:"公积金可提取：租房（多数城市每月可提）、买房、还房贷、退休。不买房也能取。利率比商贷低约1个点，组合贷更划算。今天做：查你所在城市的公积金提取条件，别让钱躺在账户里贬值。"},
  {t:"交通事故处理流程",d:"①立即停车、开双闪、放三角牌（高速150米外）；②拍照留证（全景/碰撞点/车牌）；③有伤亡先报警打120；④无争议小额走快处快赔；⑤不私了严重事故。今天做：把\"拍全景+局部+车牌\"记进手机备忘录。"},
  {t:"被骗后的黄金30分钟",d:"①马上报警（110）；②要求冻结对方账户（银行客服/支付平台客服均可，报出对方账号最快）；③保存聊天记录、转账凭证；④去派出所做笔录并拿回执。今天做：把报警电话和冻结话术记在备忘录里，宁可永远用不上。"},
  {t:"数字人民币 vs 微信支付宝",d:"数字人民币是法定货币（央行发行），微信/支付宝是支付工具。数字人民币支付不经过平台，商家不能拒收；可\"碰一碰\"离线支付。今天做：在\"数字人民币APP\"开个钱包体验一下，别被柜台推销绑架。"},
  {t:"个人所得税怎么算",d:"起征点5000元/月，另有五险一金和专项附加扣除（子女教育/房贷/租房/赡养老人/继续教育，每项每月可抵几百到两千）。年收入12万以下通常不用操心汇算。今天做：在\"个人所得税APP\"里把专项附加扣除填报齐全，能退税。"},
  {t:"未成年充值退费规则",d:"8周岁以下充值一律无效可退；8岁以上需证明\"与其年龄智力不相适应\"（如小学生在游戏里充几千元）。家长举证：孩子独立操作、家长不知情。今天做：游戏/视频APP开启未成年人模式+支付二次验证。"},
  {t:"二手交易防骗",d:"闲鱼/转转三大坑：先款后货、面交改网交、诱导脱离平台。正确姿势：平台内交易、收货验货再确认、贵重物品当面交易或走验货宝。今天做：二手交易前把\"绝不脱离平台\"写进你的交易习惯。"},
  {t:"社保断缴的影响",d:"断缴医保次月不能报销；断缴养老影响累计年限；很多城市买房、摇号、落户要求连续社保。换工作尽量无缝衔接（离职当月续缴）。今天做：换工作前确认新单位缴纳时间，避免断档。"},
  {t:"银行卡安全三不",d:"不点陌生短信链接、不扫来历不明二维码、不把验证码告诉任何人（包括\"客服\"）。银行客服绝不会问你要验证码和密码。今天做：给银行卡设置单笔限额，开通动账提醒。"},
  {t:"报警以外的求助渠道",d:"12345政务服务热线（城市问题）、12315（消费投诉）、12333（社保问题）、12348（免费法律咨询）、96110（反诈专线，来电必须接）。今天做：把这5个号码存进手机通讯录。"}
];

function flash(msg){var f=document.getElementById('flash');f.textContent=msg;f.classList.add('show');setTimeout(function(){f.classList.remove('show')},2200)}
function uiConfirm(msg,onYes){
  var o=document.getElementById('uiModal');
  if(!o){
    o=document.createElement('div');
    o.id='uiModal';
    o.setAttribute('style','position:fixed;inset:0;background:rgba(45,34,22,.50);z-index:99999;display:none;align-items:center;justify-content:center');
    o.innerHTML='<div style="background:var(--card,#ffffff);border-radius:16px;padding:24px 26px;max-width:340px;width:88%;text-align:center;box-shadow:0 12px 48px rgba(0,0,0,.35);border:1px solid var(--border,#E1DCCE)">'+
      '<div id="uiModalMsg" style="font-size:14px;line-height:1.7;margin-bottom:18px;color:var(--text,#3A4038);white-space:pre-wrap"></div>'+
      '<div style="display:flex;gap:10px;justify-content:center">'+
        '<button id="uiModalNo" class="btn" style="flex:1">取消</button>'+
        '<button id="uiModalYes" class="btn btn-primary" style="flex:1">确认</button>'+
      '</div></div>';
    document.body.appendChild(o);
  }
  document.getElementById('uiModalMsg').textContent=msg;
  o.style.display='flex';
  var yes=document.getElementById('uiModalYes'),no=document.getElementById('uiModalNo');
  if(no)no.style.display='inline-block';
  function done(v){o.style.display='none';yes.onclick=null;no.onclick=null;if(v&&onYes)onYes();}
  yes.onclick=function(){done(true)};
  no.onclick=function(){done(false)};
}
function uiAlert(msg){
  uiConfirm(msg,function(){});
  var no=document.getElementById('uiModalNo');if(no)no.style.display='none';
}

var _curView='home';
function switchView(name){
  _curView=name;
  try{localStorage.setItem('pp_last_view',name);localStorage.setItem('pp_last_scroll',window.scrollY);}catch(e){}
  document.querySelectorAll('.view').forEach(function(v){v.classList.remove('active')});
  var vv=document.getElementById('view-'+name);if(vv)vv.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active')});
  var ni=document.querySelector('.nav-item[data-view="'+name+'"]');if(ni)ni.classList.add('active');
  var sb=document.getElementById('sidebar');if(sb)sb.classList.remove('show');
  var ov=document.getElementById('sidebarOverlay');if(ov)ov.classList.remove('show');
  if(name==='journal')loadJournal();
  window.scrollTo(0,0);
  applyStoredTab(name);
  /* Hash 锚点路由回写：切换板块时同步 URL hash，复制的链接可直接定位本板块，
     浏览器后退/前进也会在板块间正常跳转（hashchange 由 routeHash 统一接管）。 */
  try{
    var want='#view-'+name;
    if(location.hash!==want){location.hash=want;}
  }catch(e){}
}
/* ─── Hash 路由统一接管：浏览器后退/前进、或直接打开带 #view-… 的链接时能正确切换板块 ─── */
function routeHash(){
  try{
    var h=''+(location.hash||'');
    h=h.replace(/^#view-/,'');
    if(h&&h!=='home'&&document.getElementById('view-'+h)){
      switchView(h);
    }else{
      /* 无 hash 或 hash 指向首页/非法板块时，回到首页 */
      switchView('home');
    }
  }catch(e){}
}
window.routeHash=window.routeHash||routeHash;
if(window.addEventListener)window.addEventListener('hashchange',routeHash);

function openSidebar(){
  var sb=document.getElementById('sidebar');
  var ov=document.getElementById('sidebarOverlay');
  /* 桌面宽屏(>=769px)：改用"展开侧边栏"（移去收起态），不再用遮罩层 */
  if(window.matchMedia&&window.matchMedia('(min-width:769px)').matches){
    document.body.classList.remove('sidebar-collapsed');
    return;
  }
  if(sb)sb.classList.add('show');
  if(ov)ov.classList.add('show');
  /* 移动端锁住背景滚动，否则在侧边栏上滑动会带动内容区一起滚 */
  if(window.matchMedia&&window.matchMedia('(max-width:768px)').matches){
    document.body.classList.add('sidebar-open');
  }
}
function toggleSidebar(){
  var sb=document.getElementById('sidebar');
  /* 桌面宽屏：汉堡按钮 = 折叠/展开侧边栏 的开关 */
  if(window.matchMedia&&window.matchMedia('(min-width:769px)').matches){
    var collapsed=document.body.classList.toggle('sidebar-collapsed');
    try{localStorage.setItem('pp_sidebar_collapsed',collapsed?'1':'0');}catch(e){}
    return;
  }
  if(sb&&sb.classList.contains('show')){closeSidebar();return;}
  openSidebar();
}
function closeSidebar(){
  var sb=document.getElementById('sidebar');
  if(sb)sb.classList.remove('show');
  var ov=document.getElementById('sidebarOverlay');
  if(ov)ov.classList.remove('show');
  document.body.classList.remove('sidebar-open');
}
function setTbMore(open){
  var m=document.getElementById('tbMoreMenu');
  var b=document.getElementById('tbMoreBtn');
  if(!m)return;
  if(open){
    m.classList.add('show'); m.style.display='flex';
    if(b)b.classList.add('is-open');
  }else{
    m.classList.remove('show'); m.style.display='none';
    if(b)b.classList.remove('is-open');
  }
}
window.setTbMore=window.setTbMore||setTbMore;
function toggleTbMore(){
  var m=document.getElementById('tbMoreMenu');
  setTbMore(!(m&&m.classList.contains('show')));
}
window.toggleTbMore=window.toggleTbMore||toggleTbMore;
/* ─── 三点菜单权威入口：文档级捕获监听，同时响应 click 与 pointerdown(触摸)，
       避免内嵌 WebView 触摸不触发 click 而“点了没反应”。时间窗去重防双重切换。─── */
(function(){
  if(window.__tbmoreReady)return;   /* 独立启动器已接管，这里不再重复绑定，防开了又关 */
  window.__tbmoreReady=true;
  var lastTs=0;
  function isMoreBtn(e){ try{ return !!(e&&e.target&&e.target.closest&&e.target.closest('#tbMoreBtn')); }catch(err){ return false; } }
  function handle(e){
    if(!isMoreBtn(e))return;
    var now=Date.now();
    if(now-lastTs<350)return;   // pointerdown 与 click 同源去重
    lastTs=now;
    toggleTbMore();
    try{ if(e.preventDefault)e.preventDefault(); }catch(err){}
  }
  document.addEventListener('click', handle, true);
  document.addEventListener('pointerdown', handle, true);
})();
/* 顶栏搜索图标：优先打开升级版「全屏搜索覆盖层」（可一次搜遍所有板块与个人记录）；
   若 upgrade.js 尚未就绪则回退为聚焦侧栏搜索框。移动端先展开侧栏再聚焦。 */
window.tbSearchGo=function(){
  try{
    if(window.QixiaUpgrade && typeof window.QixiaUpgrade.openSearch==='function'){
      window.QixiaUpgrade.openSearch();
      return;
    }
    if(window.matchMedia&&matchMedia('(min-width:769px)').matches){
      if(document.body.classList.contains('sidebar-collapsed')){
        document.body.classList.remove('sidebar-collapsed');
        try{localStorage.setItem('pp_sidebar_collapsed','0');}catch(e){}
      }
    }else if(typeof window.openSidebar==='function'){ window.openSidebar(); }
    var b=document.getElementById('navSearch');
    setTimeout(function(){ if(b){ b.focus(); b.select(); } },80);
  }catch(e){}
};
/* 重置本地数据：清空 localStorage 后恢复默认示例，解决旧缓存导致的“内容变了”问题 */
function resetLocalData(){
  if(!confirm('确定清空本地保存的所有数据（计划、目标、日记等），恢复到默认示例吗？此操作不可撤销。'))return;
  try{localStorage.clear();}catch(e){}
  location.reload();
}
/* 点击空白处关闭“更多”菜单 */
document.addEventListener('click',function(e){
  var m=document.getElementById('tbMoreMenu');
  var tb=document.getElementById('tbMore');
  if(m && m.classList.contains('show') && (!tb || !tb.contains(e.target))){
    setTbMore(false);
  }
});
/* ─────── 外链安全直达 ───────
   微信/QQ 等内嵌浏览器打开外链(尤其政府/官方站)会白屏或先弹“风险”页，体验差且吓人。
   做法：在普通浏览器里,外链照常新标签页直接打开；在内嵌浏览器里,弹出友好面板,
   自动复制官网地址 + 一键搜索直达,避免白屏与风险弹窗,让用户用得放心。           */
function isInAppBrowser(){
  var u=(navigator.userAgent||'');
  return /MicroMessenger|wxwork|QQ\/(\d+\.\d+)|MQQBrowser|UCBrowser|UCWEB|AliApp|AlipayClient|Alipaydef|Baidu|DingTalk|Toutiao|NewsArticle|Sinaweibo|MotoricAPP/i.test(u);
}
function showOutlink(url){
  var host='';
  try{host=new URL(url).host}catch(e){host=url.replace(/^https?:\/\//,'').split('/')[0]}
  var overlay=document.createElement('div');
  overlay.id='extOverlay';
  overlay.setAttribute('style','position:fixed;inset:0;background:rgba(45,34,22,.55);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif');
  overlay.innerHTML=
    '<div style="background:var(--card);border-radius:18px;padding:26px 22px 20px;max-width:340px;width:100%;text-align:center;box-shadow:0 16px 60px rgba(0,0,0,.4);border:1px solid var(--border)">'+
      '<div style="width:52px;height:52px;border-radius:50%;background:linear-gradient(140deg,#FDF6E8,#E2D8C4);display:inline-flex;align-items:center;justify-content:center;font-size:24px;margin-bottom:12px">🔒</div>'+
      '<div style="font-size:17px;font-weight:800;color:var(--text);letter-spacing:.02em">外链安全直达</div>'+
      '<div style="font-size:12px;color:var(--muted);margin:6px 0 14px">本页在外链跳转前已自动复制官网地址</div>'+
      '<div style="font-size:12px;font-weight:700;color:var(--text);background:var(--primary-light);border:1px solid var(--border-strong);border-radius:10px;padding:8px 10px;margin-bottom:12px;word-break:break-all">'+escapeHtml(host)+'</div>'+
      '<div style="font-size:12.5px;color:var(--muted);line-height:1.8;text-align:left;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:16px">'+
        '微信/QQ 内打开官方站常白屏或弹风险页（是站点限制，与本产品无关）。'+
        '地址号码已复制，建议：<b>①</b> 点下方「搜索直达」在当前页找官方入口；'+
        '<b>②</b> 或打开手机自带浏览器粘贴打开。'+
      '</div>'+
      '<div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">'+
        '<button id="extSearch" style="flex:1;min-width:120px;padding:11px 0;border:none;border-radius:10px;background:linear-gradient(120deg,#5C4030,#6E4F37);color:#fff;font-size:14px;font-weight:700;cursor:pointer">搜索直达</button>'+
        '<button id="extCopy" style="flex:1;min-width:96px;padding:11px 0;border:1px solid var(--coral);background:var(--card);color:var(--primary);font-size:14px;border-radius:10px;cursor:pointer">复制链接</button>'+
        '<button id="extClose" style="width:100%;padding:9px 0;border:none;background:transparent;color:var(--hint);font-size:12.5px;margin-top:6px;cursor:pointer">知道了</button>'+
      '</div>'+
    '</div>';
  document.body.appendChild(overlay);
  function copyFallback(){
    try{var ta=document.createElement('textarea');ta.value=url;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);flash('已复制官网地址');}catch(e){flash('请长按网址复制');}
  }
  function copyLink(){
    try{
      if(navigator.clipboard&&navigator.clipboard.writeText){
        navigator.clipboard.writeText(url).then(function(){flash('已复制官网地址')},copyFallback);
      }else copyFallback();
    }catch(e){copyFallback()}
  }
  function close(){var o=document.getElementById('extOverlay');if(o)o.parentNode&&o.parentNode.removeChild(o);}
  document.getElementById('extSearch').onclick=function(){
    close();
    window.open('https://cn.bing.com/search?q='+encodeURIComponent(host),'_blank','noopener');
  };
  document.getElementById('extCopy').onclick=copyLink;
  document.getElementById('extClose').onclick=close;
  overlay.addEventListener('click',function(e){if(e.target===overlay)close()});
  copyLink();
}
  /* 外链直接打开（普通浏览器）：新窗口/新标签，本应用页始终存活可返回。
     用 data-ext-skip 标记程序创建的临时 <a>，避免被下方全局点击处理器再次拦截造成无限递归。 */
  function openExternalDirect(href){
    if(!href)return;
    try{
      var a=document.createElement('a');
      a.href=href; a.target='_blank'; a.rel='noopener noreferrer';
      a.setAttribute('data-ext-skip','1');
      a.style.display='none';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      return;
    }catch(e){}
    try{ window.open(href,'_blank','noopener'); }catch(e){}
  }
  /* 统一外链处理器（取代原先互相冲突、且会无限递归爆栈的两套点击处理器）：
     ① 覆盖全部外链（不限是否带 target=_blank）；② http 明文自动升级 https；
     ③ 普通浏览器 → 新标签直达官方站；④ 内嵌/微信等浏览器 → 弹「安全直达」面板（复制+搜索），
        规避白屏与风险弹窗，确保「点击即达官方正规站点、无风险、不白屏」。 */
  document.addEventListener('click',function(e){
    if(e.defaultPrevented)return;
    var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;
    if(!a)return;
    if(a.getAttribute('data-ext-skip'))return;             // 程序创建的临时打开链接，跳过
    var h=(a.getAttribute('href')||'').trim();
    if(h.indexOf('http://')===0){ h='https://'+h.slice(7); try{a.setAttribute('href',h);}catch(e){} }  // http→https
    if(!/^https?:/i.test(h))return;                         // 站内锚点/JS/其它不拦截
    var same=false;
    try{var u=new URL(h);same=(u.host===location.host&&u.protocol===location.protocol);}catch(e){return;}
    if(same)return;                                         // 同站不拦截
    e.preventDefault();e.stopPropagation();
    /* 外链一律新标签页直接打开：去掉旧的「外链安全直达 / 搜索直达」中间弹窗，
       保证点击即直达官方正规站点（微信等内嵌浏览器按系统默认处理，不再被我方拦截）。 */
    openExternalDirect(h);
  });
/* 切到外链/其它标签页时，记录当前所在板块与滚动位置（返回时自动恢复） */
document.addEventListener('visibilitychange',function(){
  if(document.hidden){
    try{localStorage.setItem('pp_last_view',_curView);localStorage.setItem('pp_last_scroll',window.scrollY);}catch(e){}
  }
});
/* 实时记录滚动位置（节流）：用户在本板块内滚动时也不断更新，返回外链后回到的是「刚停留的部位」而非板块顶部 */
(function(){
  var _lastSave=0, _pending=0;
  function save(){
    try{ if(typeof _curView!=='undefined') localStorage.setItem('pp_last_view',_curView); localStorage.setItem('pp_last_scroll',window.scrollY); }catch(e){}
  }
  window.addEventListener('scroll',function(){
    var now=Date.now();
    if(now-_lastSave>250){ _lastSave=now; save(); _pending=0; }
    else{ if(!_pending){ _pending=setTimeout(function(){ _pending=0; save(); },300); } }
  },{passive:true});
  window.addEventListener('pagehide',save);
  if(document.hidden===false){ /* 空占位，保证 es6 判定简洁 */ }
})();

function switchTab(el,id){
  el.parentNode.querySelectorAll('.tab').forEach(function(t){t.classList.remove('active')});
  el.classList.add('active');
  el.parentNode.parentNode.querySelectorAll('.tab-pane').forEach(function(p){p.classList.remove('active')});
  document.getElementById(id).classList.add('active');
  rememberActiveTab(id);
}
/* 记住本板块当前激活的标签页：切外链/刷新/返回再回来时，仍停留在刚才那个标签（如六级），而不是重置回第一个（四级） */
function rememberActiveTab(id){
  var vn='',p=document.getElementById(id);
  while(p&&p!==document.body&&p.id&&p.id.indexOf('view-')!==0){p=p.parentNode;}
  if(p&&p.id&&p.id.indexOf('view-')===0){vn=p.id.slice(5);}
  if(vn){try{localStorage.setItem('pp_tab_'+vn,id);}catch(e){}}
}
/* 切换视图后：若该板块上次停在某个标签页（如六级），则自动还原到那个标签 */
function applyStoredTab(viewName){
  var saved=null;try{saved=localStorage.getItem('pp_tab_'+viewName);}catch(e){}
  if(!saved)return;
  var viewEl=document.getElementById('view-'+viewName);
  var pane=document.getElementById(saved);
  if(!viewEl||!pane)return;
  var q=pane,inside=false;
  while(q&&q!==document.body){if(q===viewEl){inside=true;break}q=q.parentNode;}
  if(!inside)return;
  var tabBtn=null;
  viewEl.querySelectorAll('.tab').forEach(function(t){
    var oc=(t.getAttribute('onclick')||'');
    if(oc.indexOf("'"+saved+"'")>=0||oc.indexOf('"'+saved+'"')>=0)tabBtn=t;
  });
  if(tabBtn){switchTab(tabBtn,saved);}
  else{
    viewEl.querySelectorAll('.tab-pane').forEach(function(pp){pp.classList.remove('active')});
    pane.classList.add('active');
  }
}

function getTasks(){return DB.get('tasks',[])}
function saveTasks(t){DB.set('tasks',t)}
function renderTasks(){
  var ts=getTasks();var today=todayKey();
  var todayTasks=ts.filter(function(t){return t.date===today});
  refreshHomeStats();
  var box=document.getElementById('todayTasks');
  if(!todayTasks.length){box.innerHTML='<p style="color:var(--hint);font-size:13px">今天还没有任务，添加第一个吧</p>';return}
  box.innerHTML=todayTasks.map(function(t,i){
    return '<div style="display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px dashed var(--border)">'+
      '<input type="checkbox" '+(t.done?'checked':'')+' onchange="toggleTask(\''+t.id+'\')" style="width:15px;height:15px;flex-shrink:0">'+
      '<span style="flex:1;font-size:13px;color:var(--text);'+(t.done?'text-decoration:line-through;color:var(--hint)':'')+';cursor:pointer" onclick="toggleTask(\''+t.id+'\')">'+escapeHtml(t.text)+'</span>'+
      '<button class="btn btn-sm" style="font-size:10px;padding:2px 6px;color:var(--hint);flex-shrink:0" onclick="delTask(\''+t.id+'\')" title="删除该任务">删</button>'+
    '</div>'
  }).join('');
}
function addTask(){
  var inp=document.getElementById('newTaskInput');var v=inp.value.trim();
  if(!v)return;
  var ts=getTasks();ts.push({id:Date.now()+'_'+Math.random().toString(36).slice(2,7),text:v,done:false,date:todayKey()});
  saveTasks(ts);inp.value='';renderTasks();refreshHomeStats();flash('已将这件小事收进匣中');
}
function toggleTask(id){
  var ts=getTasks();
  ts.forEach(function(t){if(String(t.id)===String(id)){t.done=!t.done;if(t.done)t.doneDate=t.date;else delete t.doneDate;}});
  saveTasks(ts);renderTasks();refreshHomeStats();
}
function delTask(id){
  var ts=getTasks();ts=ts.filter(function(t){return String(t.id)!==String(id)});saveTasks(ts);renderTasks();
  refreshHomeStats();flash('该任务已移除');
}
function addPresetTask(text){
  var ts=getTasks();ts.push({id:Date.now()+'_'+Math.random().toString(36).slice(2,7),text:text,done:false,date:todayKey()});
  saveTasks(ts);renderTasks();refreshHomeStats();flash('已添加：'+text);
}

var CHECKINS=[{k:'cet',n:'四级学习打卡'},{k:'word',n:'背单词25个'},{k:'exercise',n:'运动30分钟'},{k:'journal',n:'今日复盘'},{k:'sleep',n:'11点前睡觉'}];
function getCheckins(){return DB.get('checkins',{})}
function saveCheckins(c){DB.set('checkins',c)}
function getCheckinDefs(){
  var d=DB.get('checkinDefs',null);
  if(!d||!d.length){
    d=CHECKINS.map(function(it){return {id:it.k,n:it.n}});
    saveCheckinDefs(d);
  }
  return d;
}
function saveCheckinDefs(d){DB.set('checkinDefs',d);}
function renderCheckins(){
  var c=getCheckins();var today=todayKey();
  var todayC=c[today]||{};
  var defs=getCheckinDefs();
  var box=document.getElementById('checkinList');
  box.innerHTML=defs.map(function(it,i){
    return '<div style="display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px dashed var(--border)">'+
      '<input type="checkbox" '+(todayC[it.id]?'checked':'')+' onchange="toggleCheckin(\''+it.id+'\')" style="width:15px;height:15px;flex-shrink:0">'+
      '<span contenteditable="true" data-ci="'+i+'" onblur="saveCheckinName('+i+',this)" style="flex:1;font-size:13px;cursor:text;outline:none">'+escapeHtml(it.n)+'</span>'+
      '<button class="btn btn-sm" style="font-size:10px;padding:2px 6px;color:var(--hint)" onclick="delCheckinDef('+i+')">删</button>'+
    '</div>'
  }).join('');
  refreshHomeStats();
}
/* 首页仪表盘三项统计：今日打卡 / 本周完成率 / 今日任务，全部由真实数据实时算出。
   每次打卡、加减任务、勾选任务后都会被重新调用，保证数字跟着用户操作自动更新。 */
function refreshHomeStats(){
  var c=getCheckins();var defs=getCheckinDefs();var today=todayKey();
  var n=defs.length;
  /* 今日打卡 done/n */
  var tc=c[today]||{};
  var done=Object.keys(tc).filter(function(k){return tc[k]}).length;
  var te=document.getElementById('todayCheckin');if(te)te.textContent=done+'/'+n;
  /* 连续天数 */
  var firstId=(defs&&defs.length&&defs[0].id)?defs[0].id:'cet';
  var streak=calcStreak(firstId);
  var si=document.getElementById('streakInfo');if(si)si.textContent='连续 '+streak+' 天';
  /* 本周完成率：近7天累计 打卡数/(项目数×7) */
  var total=n*7,wd=0;
  for(var i=0;i<7;i++){
    var d=new Date();d.setDate(d.getDate()-i);
    var key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    var dc=c[key]||{};
    wd+=Object.keys(dc).filter(function(k){return dc[k]}).length;
  }
  var we=document.getElementById('weekCheckinCount');
  if(we)we.textContent=wd+'/'+total;
  /* 今日任务：今天的待办件数 */
  var todayTasks=(getTasks()||[]).filter(function(t){return t.date===today&&!t.done}).length;
  var tt=document.getElementById('todayTaskCount');if(tt)tt.textContent=todayTasks;
  /* 实时同步：近7天打卡日历 + 本周完成率（任何数据改动后自动重绘，无需刷新页） */
  try{ if(typeof renderCheckinCalendar==='function') renderCheckinCalendar(); }
  catch(e){}
}
function saveCheckinName(i,el){
  var d=getCheckinDefs();if(!d[i])return;
  var v=el.textContent.trim();if(v)d[i].n=v;
  saveCheckinDefs(d);
}
function delCheckinDef(i){
  uiConfirm('要移除这条打卡记录吗？',function(){
    var d=getCheckinDefs();d.splice(i,1);saveCheckinDefs(d);renderCheckins();
  });
}
function addCheckinDef(){
  var inp=document.getElementById('newCheckinInput');if(!inp)return;
  var v=inp.value.trim();if(!v){uiAlert('请先输入打卡项内容');return;}
  var d=getCheckinDefs();d.push({id:'u'+Date.now(),n:v});saveCheckinDefs(d);
  inp.value='';renderCheckins();
}
function toggleCheckin(k){
  var c=getCheckins();var today=todayKey();
  if(!c[today])c[today]={};
  c[today][k]=!c[today][k];saveCheckins(c);renderCheckins();
}
function calcStreak(k){
  var c=getCheckins();var d=new Date();var n=0;
  while(true){
    var key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    if(c[key]&&c[key][k]){n++;d.setDate(d.getDate()-1)}else break;
  }
  return n;
}

function getWords(){return DB.get('words',[])}
function saveWords(w){DB.set('words',w)}

