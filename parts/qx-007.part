function getJournals(){return DB.get('journals',{})}
function saveJournals(j){DB.set('journals',j)}
function loadJournal(){
  var js=getJournals();var today=todayKey();
  document.getElementById('journalDate').textContent='('+today+')';
  var j=js[today]||{done:'',learn:'',improve:'',tomorrow:'',free:''};
  document.getElementById('jDone').value=j.done||'';
  document.getElementById('jLearn').value=j.learn||'';
  document.getElementById('jImprove').value=j.improve||'';
  document.getElementById('jTomorrow').value=j.tomorrow||'';
  document.getElementById('jFree').value=j.free||'';
  renderJournalHistory();
}
function saveJournal(){
  var js=getJournals();var today=todayKey();
  js[today]={done:document.getElementById('jDone').value,learn:document.getElementById('jLearn').value,improve:document.getElementById('jImprove').value,tomorrow:document.getElementById('jTomorrow').value,free:document.getElementById('jFree').value,savedAt:new Date().toISOString()};
  saveJournals(js);
  document.getElementById('journalSaveHint').textContent='已保存 '+new Date().toLocaleTimeString();
  renderJournalHistory();
  var c=getCheckins();if(!c[today])c[today]={};c[today].journal=true;saveCheckins(c);renderCheckins();
  flash('已将今日这段时光收进匣中');
}
function renderJournalHistory(){
  var js=getJournals();
  var keys=Object.keys(js).sort().reverse();
  var box=document.getElementById('journalHistory');
  if(!keys.length){box.innerHTML='<p style="color:var(--hint);font-size:13px">还没有历史记录</p>';return}
  box.innerHTML=keys.slice(0,14).map(function(k){
    var j=js[k];
    return '<div style="padding:12px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px"><div style="font-weight:600;color:var(--primary);font-size:13px;margin-bottom:6px">'+k+'</div>'+(j.done?'<div style="font-size:12px;margin-bottom:4px"><strong>完成：</strong>'+j.done+'</div>':'')+(j.learn?'<div style="font-size:12px;margin-bottom:4px"><strong>学到：</strong>'+j.learn+'</div>':'')+(j.improve?'<div style="font-size:12px;margin-bottom:4px;color:var(--coral)"><strong>改进：</strong>'+j.improve+'</div>':'')+(j.tomorrow?'<div style="font-size:12px;margin-bottom:4px"><strong>明天：</strong>'+j.tomorrow+'</div>':'')+(j.free?'<div style="font-size:12px;color:var(--muted);white-space:pre-wrap;border-top:1px dashed var(--border);padding-top:6px;margin-top:6px">'+j.free+'</div>':'')+'</div>'
  }).join('');
}

/* 每日运动打卡：更多默认选项 + 用户自定义可编辑（存入本地，实时刷新） */
function defaultWorkoutDefs(){
  return [
    {id:'jump',n:'跳绳'},{id:'yoga',n:'瑜伽垫跟练'},{id:'stretch',n:'拉伸'},
    {id:'run',n:'跑步'},{id:'strength',n:'力量训练'},{id:'cycle',n:'骑行'},
    {id:'walk',n:'散步'},{id:'hiit',n:'HIIT'},{id:'badminton',n:'羽毛球'},
    {id:'diet',n:'饮食达标'}
  ];
}
function workoutOptions(){
  var defs=defaultWorkoutDefs();
  try{
    var custom=DB.get('workoutCustom',[])||[];
    custom.forEach(function(n,i){ defs.push({id:'custom_'+i,n:String(n).slice(0,8)}); });
  }catch(e){}
  return defs;
}
function renderWorkoutButtons(){
  var box=document.getElementById('workoutBtns');if(!box)return;
  try{
    var c=getCheckins(),today=todayKey(),tc=(c&&c[today])||{};
    var opts=workoutOptions();
    box.innerHTML=opts.map(function(o){
      var isDiet=o.id==='diet';
      /* 兼容旧数据：运动类只要「exercise」聚合键为真即视为已打卡 */
      var on=isDiet?!!tc['diet']:(!!tc[o.id]||!!tc['exercise']);
      var bg=isDiet?(on?'rgba(139,105,20,.16)':'var(--bg)'):(on?'rgba(122,115,99,.12)':'var(--bg)');
      var bd=isDiet?(on?'var(--primary-mid)':'var(--border)'):(on?'var(--teal)':'var(--border)');
      var col=isDiet?((on?'var(--primary)':'var(--text)')):(on?'var(--text)':'var(--text)');
      return '<span onclick="toggleWorkout(\''+o.id+'\')" title="点一下即打卡" style="cursor:pointer;user-select:none;padding:6px 12px;border-radius:14px;font-size:12.5px;border:1px solid '+bd+';background:'+bg+';color:'+col+'">'+(on?'✓ ':'')+escapeHtml(o.n)+'</span>';
    }).join('')+
      '<span onclick="addWorkoutCustom()" title="添加你自己的运动项目" style="cursor:pointer;user-select:none;padding:6px 12px;border-radius:14px;font-size:12.5px;border:1px dashed var(--primary-mid);background:var(--bg);color:var(--primary)">＋ 自定义</span>';
    showWorkoutStreak();
  }catch(e){}
}
function addWorkoutCustom(){
  try{
    var n=prompt('添加你自己的运动项目（例如：Keep跟练、HIIT、羽毛球、游泳、爬楼梯…）');
    if(n==null)return;
    n=(n||'').trim();
    if(!n){flash('请输入运动项目名称');return;}
    var c=DB.get('workoutCustom',[])||[];
    c.push(n.slice(0,8));DB.set('workoutCustom',c);
    renderWorkoutButtons();
    flash('已添加自定义运动：「'+n.slice(0,8)+'」');
  }catch(e){}
}
function showWorkoutStreak(){
  try{
    var el=document.getElementById('workoutStreak');if(!el)return;
    var s=calcStreak('exercise');
    el.innerHTML='<span class="streak">连续 '+s+' 天运动</span>';
  }catch(e){}
}
function toggleWorkout(k){
  var c=getCheckins();var today=todayKey();
  if(!c[today])c[today]={};
  var isDiet=(k==='diet');
  c[today][k]=!c[today][k];
  /* 同步「运动」聚合键：今天任一运动类打过卡，exercise=true，与首页习惯及连续统计保持一致 */
  if(!isDiet){
    var any=false;var keys=workoutOptions().map(function(o){return o.id;}).filter(function(x){return x!=='diet';});
    for(var j=0;j<keys.length;j++){ if(c[today][keys[j]]) any=true; }
    c[today]['exercise']=!!any;
  }
  saveCheckins(c);
  renderWorkoutButtons();
  flash(isDiet?'今日饮食记录已更新':'今日运动 +1，妥帖收存');
}
(function renderWorkoutBoot(){
  function boot(){try{renderWorkoutButtons();}catch(e){}}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);
  else boot();
})();

function countLen(obj){if(!obj)return 0;try{return Object.keys(obj).length;}catch(e){return 0;}}
function dataSummary(){
  var s={
    '计划任务':countLen(getTasks()),
    '每日打卡':countLen(getCheckins()),
    '单词本':countLen(getWords()),
    '错题本':countLen(getWrongs()),
    '书单':countLen(getBooks()),
    '播客':countLen(getPodcasts()),
    '札记':countLen(getJournals())
  };
  var out=[],keys=Object.keys(s);
  for(var i=0;i<keys.length;i++){if(s[keys[i]]>0)out.push(keys[i]+' '+s[keys[i]]+' 条');}
  return out.length?out.join(' · '):'（暂无记录）';
}
function exportData(){
  var data={app:'栖匣',author:'尹平平',site:(location.origin+location.pathname.replace(/index\.html$/,'/')),tasks:getTasks(),checkins:getCheckins(),words:getWords(),wrongs:getWrongs(),books:getBooks(),pods:getPodcasts(),journals:getJournals(),exportDate:new Date().toISOString(),source:'centrove'};
  var blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  var url=URL.createObjectURL(blob);
  var a=document.createElement('a');a.href=url;a.download='栖匣-备份-'+todayKey()+'.json';a.click();
  setTimeout(function(){URL.revokeObjectURL(url);},1500);
  /* 让用户直接看到导出了哪些内容 */
  uiAlert('✅ 已导出你的个人数据备份（JSON 文件已下载）\n\n本次包含：'+dataSummary()+'\n\n请妥善保存此文件。换设备或清缓存后，点「导入数据」即可一键恢复全部内容。');
}
function importData(e){
  var f=e.target.files[0];if(!f)return;
  var r=new FileReader();
  r.onload=function(){
    var d=null;
    try{d=JSON.parse(r.result);}catch(err){}
    if(!d||typeof d!=='object'||Array.isArray(d)){
      try{uiAlert('⚠️ 导入失败\n\n文件格式不正确或已损坏，你的原有数据未受影响。请选择由本产品「导出数据备份」生成的 JSON 文件。');}catch(e2){}
      return;
    }
    /* 1) 导入前自动生成当前全部数据快照备份（仅保留最近一份，存在本地，不出账号） */
    try{
      var snap={},i;for(i=0;i<localStorage.length;i++){var k=localStorage.key(i);try{snap[k]=localStorage.getItem(k);}catch(e3){}}
      localStorage.setItem('pp_backup_latest',JSON.stringify(snap));
    }catch(e4){}
    /* 2) 让用户选择 合并导入（推荐） / 覆盖全部数据 / 取消 */
    showImportChoice(d);
  };
  r.readAsText(f);
}
function showImportChoice(d){
  var o=document.createElement('div');
  o.style.cssText='position:fixed;inset:0;background:rgba(20,16,12,.5);z-index:16;display:flex;align-items:center;justify-content:center;padding:20px';
  o.innerHTML='<div style="background:var(--card);border:1px solid var(--border);border-radius:18px;max-width:360px;width:100%;padding:24px 20px 18px;text-align:center;box-shadow:0 16px 60px rgba(0,0,0,.4)">'+
    '<div style="font-size:18px;font-weight:800;color:var(--head-deep,var(--primary));letter-spacing:1px;margin-bottom:8px">选择导入方式</div>'+
    '<div style="font-size:12.5px;color:var(--muted);line-height:1.8;margin-bottom:14px">导入前的全部数据已自动备份到本机。请选择如何放入：</div>'+
    '<button id="qxImMerge" class="btn btn-primary" style="width:100%;margin-bottom:8px;padding:11px">合并导入（推荐）</button>'+
    '<button id="qxImOver" class="btn" style="width:100%;margin-bottom:8px;background:transparent;color:var(--text);border-color:var(--border-strong)">覆盖全部数据</button>'+
    '<button id="qxImCancel" class="btn" style="width:100%;background:transparent;color:var(--hint)">取消</button>'+
    '</div>';
  document.body.appendChild(o);
  function close(){try{o.parentNode&&o.parentNode.removeChild(o);}catch(e){}}
  function arrmix(a,b){
    var out=(a&&Array.isArray(a))?a.slice():[];var seen={};
    out.forEach(function(x){try{seen[typeof x==='object'?(x&&x.id?x.id:JSON.stringify(x)):String(x)]=1;}catch(e){}});
    var nb=(b&&Array.isArray(b))?b:[];nb.forEach(function(x){var key;try{key=typeof x==='object'?(x&&x.id?x.id:JSON.stringify(x)):String(x);}catch(e){key=String(x);}if(!seen[key]){out.push(x);seen[key]=1;}});
    return out;
  }
  function apply(merge){
    function save(key,val){try{localStorage.setItem(key,val);}catch(e){}}
    if(merge){
      Object.keys(d).forEach(function(key){
        var sv=null;try{sv=localStorage.getItem(key);}catch(e){}
        var nv=d[key];
        if(sv!=null){
          var existing=null;try{existing=JSON.parse(sv);}catch(e){existing=null;}
          if(Array.isArray(nv)&&Array.isArray(existing)){save(key,JSON.stringify(arrmix(existing,nv)));}
          else{save(key,nv);}
        }else{save(key,nv);}
      });
    }else{
      Object.keys(d).forEach(function(key){save(key,d[key]);});
    }
    try{renderAll();}catch(e){}
    close();
    try{uiAlert('✅ 导入成功（'+(merge?'合并':'覆盖')+'）\n\n'+dataSummary()+'\n\n导入前的数据已自动备份到本机，可放心使用。');}catch(e){}
  }
  o.querySelector('#qxImMerge').onclick=function(){close();apply(true);};
  o.querySelector('#qxImOver').onclick=function(){close();apply(false);};
  o.querySelector('#qxImCancel').onclick=function(){close();};
}

function renderAll(){renderTasks();renderCheckins();renderWords();renderWrongs();renderBooks();renderPodcasts();renderCheckinCalendar();renderTimeBlocks();renderPomo();renderInspire();renderDecisions();renderGrateful();renderGoal100();renderShelf();renderBigQuote();renderQuadrant();renderPlans();renderGoals();renderReading();renderCet6Reading();renderEssay();loadEditable();loadCheckboxes();initDefaultCountdowns();renderCountdowns();renderHoliday();renderLifeMeters();renderSportHeatmap();renderMovieQuote();renderMovies();renderPrepareProgress();renderHabits();renderHabitHeatmap();}

/* 开学准备进度（准大一新生专属清单 · 已并入原校园生活开学季清单，开学后自动归档清理） */
var PREPARE_ITEMS=[
  /* 证件与档案 */
  {k:"id_card",t:"身份证原件及正反面复印件 2 份"},
  {k:"household",t:"户口迁移（如需）· 户口本本人页复印件"},
  {k:"admission",t:"录取通知书、准考证、学生档案袋"},
  {k:"photos",t:"一寸/两寸蓝白底证件照各 8 张 + 电子版"},
  {k:"party_migrate",t:"团员证 + 转团组织关系（学籍档案自带或邮寄）"},
  {k:"loan_receipt",t:"助学贷款回执单（如已办理）"},
  /* 缴费与银行卡 */
  {k:"bank_card",t:"用于缴学费的银行卡 / 校园卡关联"},
  {k:"phone_plan",t:"确认手机号归属地、套餐与校园网政策"},
  /* 生活与学习用品 */
  {k:"luggage",t:"24/26 寸行李箱 + 压缩袋 + 小锁"},
  {k:"bedding",t:"按学校尺寸准备床垫/被子/枕头（可到校再买）"},
  {k:"stationery",t:"笔记本电脑、U 盘、插线板、台灯"},
  {k:"daily",t:"洗漱用品、拖鞋、衣架、脸盆、水杯、收纳盒"},
  {k:"charger",t:"充电器 / 充电宝 / 排插"},
  {k:"medicine",t:"常用药（感冒 / 肠胃 / 创可贴）"},
  {k:"clothes",t:"应季衣物 + 一套正装/白衬衫（社团面试用）"},
  /* 到校安排 */
  {k:"express",t:"大件行李发快递到校，预约到校自提"},
  {k:"plan",t:"提前了解专业培养方案与保研/考研路径"}
];
function renderPrepareProgress(){
  var box=document.getElementById('prepareList');if(!box)return;
  var done={};try{done=JSON.parse(localStorage.getItem('pp_prepare_done')||'{}')||{};}catch(e){done={};}
  box.innerHTML='';
  PREPARE_ITEMS.forEach(function(item){
    var isDone=!!done[item.k];
    var el=document.createElement('div');
    el.className='check'+(isDone?' done':'');
    el.style.cssText='padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--card);margin:0;cursor:pointer;transition:all .15s';
    el.innerHTML='<input type="checkbox" '+ (isDone?'checked':'') +' style="pointer-events:none;width:16px;height:16px;accent-color:var(--primary)"><span style="font-size:13px;color:'+(isDone?'var(--hint)':'var(--text)')+'">'+escapeHtml(item.t)+'</span>';
    el.onclick=function(){togglePrepare(item.k);};
    box.appendChild(el);
  });
  var total=PREPARE_ITEMS.length;
  var completed=Object.keys(done).filter(function(k){return done[k];}).length;
  var pct=Math.round(completed/total*100);
  document.getElementById('preparePercent').textContent=pct+'%';
  document.getElementById('prepareBar').style.width=pct+'%';
}
function togglePrepare(k){
  var done={};try{done=JSON.parse(localStorage.getItem('pp_prepare_done')||'{}')||{};}catch(e){done={};}
  done[k]=!done[k];
  localStorage.setItem('pp_prepare_done',JSON.stringify(done));
  renderPrepareProgress();
}
/* 开学准备：入学后自动归档（一次性内容，避免长期占用首页） */
function archivePrepare(manual){
  try{localStorage.setItem('pp_prepare_archived','1');}catch(e){}
  var card=document.getElementById('prepareCard');
  if(card){card.style.display='none';}
  if(manual)uiAlert('✅ 已收起\n\n开学准备清单已归档。数据仍安全保留，随时可在「系统设置→重新开启开学清单」中找回。');
}
function restorePrepare(){
  try{localStorage.removeItem('pp_prepare_archived');}catch(e){}
  var card=document.getElementById('prepareCard');
  if(card){card.style.display='';}
  renderPrepareProgress();
  uiAlert('已重新开启开学准备清单。');
}
function applyPrepareAutoClean(){
  /* 自动归档：距首次使用超过 2 个学年，或用户主动点名"我已入学"时收起 */
  var card=document.getElementById('prepareCard');if(!card)return;
  var archived='1';
  try{archived=localStorage.getItem('pp_prepare_archived')||'0';}catch(e){}
  if(archived==='1'){card.style.display='none';return;}
  try{
    var first=new Date(localStorage.getItem('pp_firstUseDate')||todayKey());
    var months=(Date.now()-first.getTime())/86400000/30;
    if(months>24){card.style.display='none';}
  }catch(e){}
}

