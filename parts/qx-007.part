function renderWords(){
  var ws=getWords();var today=todayKey();
  var todayW=ws.filter(function(w){return w.date===today});
  document.getElementById('wordProgress').textContent=todayW.length+'/25';
  var box=document.getElementById('wordList');
  if(!todayW.length){
    box.innerHTML='<div style="padding:16px;background:var(--bg);border-radius:8px;text-align:center">'+
      '<p style="color:var(--hint);font-size:15px;margin-bottom:8px">今日还没添加单词 · 点击"载入今日25词"自动推荐四级高频词</p>'+
      '<p style="font-size:13px;color:var(--hint)">词库共100+词，每日按日期循环推荐25词，含熟词生义+巧记+真题例句+有道标准发音</p>'+
    '</div>';
    return;
  }
  box.innerHTML=todayW.map(function(w,i){
    var bank=w.bank?WORD_BANK.find(function(b){return b.w===w.word}):null;
    var detail='';
    if(bank){
      detail='<div style="font-size:14px;color:var(--muted);margin-top:6px;line-height:1.8">'+
        '<div style="color:var(--coral);margin-bottom:2px">'+bank.less+'</div>'+
        '<div style="color:var(--teal);margin-bottom:2px">'+bank.trick+'</div>'+
        '<div style="color:var(--primary-mid)">例:'+bank.ex+'</div>'+
        '<a href="'+bank.audio+'" target="_blank" rel="noopener noreferrer" style="font-size:13px;color:var(--primary)">标准发音↗</a>'+
      '</div>';
    }
    return '<div style="padding:10px 12px;border-bottom:1px solid var(--border);font-size:16px">'+
      '<div style="display:flex;justify-content:space-between;align-items:center">'+
        '<div><strong style="font-size:17px">'+w.word+'</strong> <span style="color:var(--muted);font-size:14px">'+(bank?bank.m:'')+'</span></div>'+
        '<div style="display:flex;gap:4px;align-items:center">'+
          '<span class="tag '+(w.done?'tag-teal':'tag-gray')+'">'+(w.done?'已记':'待记')+'</span>'+
          '<button class="btn btn-sm" style="font-size:10px;padding:2px 6px" onclick="toggleWordDone('+i+')">'+(w.done?'撤销':'完成')+'</button>'+
          '<button class="btn btn-sm" style="font-size:10px;padding:2px 6px" onclick="delWord('+i+')">删</button>'+
        '</div>'+
      '</div>'+detail+
    '</div>';
  }).join('');
}
function addWord(){
  var inp=document.getElementById('newWordInput');var v=inp.value.trim().toLowerCase();
  if(!v){flash('请输入单词');return}
  /* 智能纠错：只允许英文字母 */
  if(!/^[a-z]+$/i.test(v)){flash('单词只能含英文字母');return}
  /* 去重检查 */
  var ws=getWords();var today=todayKey();
  if(ws.some(function(w){return w.word===v&&w.date===today})){flash('今日已添加过该词');return}
  /* 匹配词库 */
  var bank=WORD_BANK.find(function(b){return b.w===v});
  ws.push({word:v,done:false,date:today,addDate:today,bank:!!bank});
  saveWords(ws);inp.value='';renderWords();flash(bank?'已添加(匹配词库，含释义/巧记/例句/发音)':'已添加(自定义词)');
}
function loadPresetWords(){
  /* 按日期循环推荐25词：词库按 25 个一组分块轮换，保证每天不重复 */
  var groups=Math.max(1,Math.ceil(WORD_BANK.length/25));
  var dayIndex=Math.floor(Date.now()/86400000)%groups;
  var start=(dayIndex*25)%WORD_BANK.length;
  var preset=WORD_BANK.slice(start,start+25);
  if(preset.length<25){preset=preset.concat(WORD_BANK.slice(0,25-preset.length));}
  var ws=getWords()||[];var today=todayKey();
  var existing=(ws.filter(function(w){return w.date===today})||[]).map(function(w){return w.word});
  var added=0;
  preset.forEach(function(b){
    if(existing.indexOf(b.w)===-1){
      ws.push({word:b.w,done:false,date:today,addDate:today,bank:true});
      added++;
    }
  });
  saveWords(ws);renderWords();
  if(added>0){flash('已载入 '+added+' 个今日推荐词（词库共 '+WORD_BANK.length+' 词，按日轮换）');}
  else{flash('今日 25 词已全部载入，直接开始记忆吧');}
}
function toggleWordDone(i){
  var ws=getWords();var today=todayKey();
  var todayW=ws.filter(function(w){return w.date===today});
  if(todayW[i]){todayW[i].done=!todayW[i].done;saveWords(ws);renderWords()}
}
function delWord(i){
  var ws=getWords();var today=todayKey();
  var todayW=ws.filter(function(w){return w.date===today});
  if(todayW[i]){
    var realIdx=ws.indexOf(todayW[i]);
    ws.splice(realIdx,1);saveWords(ws);renderWords();
  }
}
function markWordDone(){
  var ws=getWords();var today=todayKey();
  ws.forEach(function(w){if(w.date===today)w.done=true});
  saveWords(ws);renderWords();flash('今日单词已标记完成');
}

/* 听写模式 */
var dictIdx=0;
function dictationMode(){
  var box=document.getElementById('dictationBox');
  box.style.display='block';
  dictIdx=0;
  nextDictation();
}
function nextDictation(){
  var ws=getWords();var today=todayKey();
  var todayW=ws.filter(function(w){return w.date===today&&!w.done});
  if(!todayW.length){document.getElementById('dictationWord').innerHTML='没有可听写的单词';return}
  if(dictIdx>=todayW.length)dictIdx=0;
  var w=todayW[dictIdx];
  var bank=WORD_BANK.find(function(b){return b.w===w.word});
  document.getElementById('dictationWord').innerHTML='<strong>释义：</strong>'+(bank?escapeHtml(bank.m):escapeHtml(w.word))+' '+(bank?'<button class="btn btn-sm" style="margin-left:8px" onclick="playWordAudio()">听发音</button>':'');
  document.getElementById('dictationInput').value='';
  document.getElementById('dictationResult').innerHTML='';
  document.getElementById('dictationInput').focus();
}
function playWordAudio(word){
  var w=word||(function(){
    var ws=getWords();var today=todayKey();
    var todayW=ws.filter(function(x){return x.date===today&&!x.done});
    return todayW[dictIdx]?todayW[dictIdx].word:'';
  })();
  if(!w)return;
  var bank=WORD_BANK.find(function(b){return b.w===w});
  var url=bank?bank.audio:'https://dict.youdao.com/dictvoice?audio='+w+'&type=2';
  window.open(url,'_blank');
}
function checkDictation(){
  var ws=getWords();var today=todayKey();
  var todayW=ws.filter(function(w){return w.date===today&&!w.done});
  if(!todayW[dictIdx])return;
  var correct=todayW[dictIdx].word;
  var inp=document.getElementById('dictationInput').value.trim().toLowerCase();
  if(inp===correct.toLowerCase()){
    document.getElementById('dictationResult').innerHTML='<span style="color:var(--teal)">正确！</span>';
    setTimeout(function(){dictIdx++;nextDictation()},1000);
  }else{
    /* 智能纠错：提示差异 */
    var diff='拼写错误，正确：<strong>'+correct+'</strong>';
    if(inp.length<correct.length)diff+=' (少了'+(correct.length-inp.length)+'个字母)';
    else if(inp.length>correct.length)diff+=' (多了'+(inp.length-correct.length)+'个字母)';
    document.getElementById('dictationResult').innerHTML='<span style="color:var(--coral)">'+diff+'</span>';
  }
}

function getWrongs(){return DB.get('wrongs',[])}
