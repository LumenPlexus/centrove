r(--border)">18</div><div title="2026-08-19" style="aspect-ratio:1;border-radius:4px;background:#EFE8D8;display:flex;align-items:center;justify-content:center;color:var(--hint);font-size:9px;font-weight:400;border:1px solid var(--border)">19</div><div title="2026-08-20" style="aspect-ratio:1;border-radius:4px;background:#EFE8D8;display:flex;align-items:center;justify-content:center;color:var(--hint);font-size:9px;font-weight:400;border:1px solid var(--border)">20</div><div title="2026-08-21" style="aspect-ratio:1;border-radius:4px;background:#EFE8D8;display:flex;align-items:center;justify-content:center;color:var(--hint);font-size:9px;font-weight:400;border:1px solid var(--border)">21</div><div title="2026-08-22" style="aspect-ratio:1;border-radius:4px;background:#EFE8D8;display:flex;align-items:center;justify-content:center;color:var(--hint);font-size:9px;font-weight:700;border:2px solid var(--primary)">22</div></div>
