  <script>
    /* ── 首屏同步定主题：在 CSS 首次绘制前就设置 data-theme，杜绝日/夜加载时的闪白/蓝块 ── */
    (function(){
      var t=null;
      /* 只用本次会话记忆的主题：默认日间，夜间仅在当前会话里生效，重新打开即回日间 */
      try{ t=sessionStorage.getItem('pp_theme_v2'); }catch(e){ t=null; }
      if(t!=='dark'){ t='light'; }
      document.documentElement.setAttribute('data-theme', t);
      /* 启动即同步主题图标与状态栏色，避免月亮/太阳图标与当前主题不符而产生"切换不及时"感 */
      try{ if(window.updateThemeIcon){updateThemeIcon();} }catch(e){}
    })();
    /* 注册 Service Worker：支持安装到桌面 App；首次联网打开后，在支持
       Service Worker 的浏览器里可离线打开（见 sw.js 顶部如实说明）。
       部署新版后自动接管并刷新一次，用户再次打开链接即看到最新内容。 */
    /* Logo 兜底：pwa/logo.png 若因缓存/路径/网络/微信内拦截等问题加载失败，
       立即用内联 PNG 替换，保证任何环境都不裂图。 */
    var LOGO_DATA_URI='data:image/png;base64,