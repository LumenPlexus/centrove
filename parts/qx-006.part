    <div class="bottom-nav-item" data-bv="study" onclick="switchView(&#39;study&#39;);setBottomActive(this)">
      <svg style="width:20px;height:20px;display:block;flex-shrink:0;min-width:20px;max-width:20px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
