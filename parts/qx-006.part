              <tr><td style="padding:8px 10px;border:1px solid var(--border)">历史</td><td style="padding:8px 10px;border:1px solid var(--border)"><b>河西走廊</b></td><td style="padding:8px 10px;border:1px solid var(--border)">以「路」串起两千年文明，历史地理绝美</td><td style="padding:8px 10px;border:1px solid var(--border)"><a href="https://search.bilibili.com/all?keyword=%E6%B2%B3%E8%A5%BF%E8%B5%B0%E5%BB%8A%E7%BA%AA%E5%BD%95%E7%89%87" target="_blank" rel="noopener noreferrer">B站↗</a></td></tr>
              <tr><td style="padding:8px 10px;border:1px solid var(--border)">科学</td><td style="padding:8px 10px;border:1px solid var(--border)"><b>宇宙时空之旅 COSMOS</b></td><td style="padding:8px 10px;border:1px solid var(--border)">把仰望星空变成人生体验，格局直接打开</td><td style="padding:8px 10px;border:1px solid var(--border)"><a href="https://search.bilibili.com/all?keyword=COSMOS%20%E5%AE%87%E5%AE%99%E6%97%B6%E7%A9%BA%E4%B9%8B%E6%97%85" target="_blank" rel="noopener noreferrer">B站↗</a></td></tr>
              <tr><td style="padding:8px 10px;border:1px solid var(--border)">自然</td><td style="padding:8px 10px;border:1px solid var(--border)"><b>美丽中国</b></td><td style="padding:8px 10px;border:1px solid var(--border)">BBC 团队拍的祖国山河，重新认识脚下大地</td><td style="padding:8px 10px;border:1px solid var(--border)"><a href="https://search.bilibili.com/all?keyword=%E7%BE%8E%E4%B8%BD%E4%B8%AD%E5%9B%BD%E7%BA%AA%E5%BD%95%E7%89%87" target="_blank" rel="noopener noreferrer">B站↗</a></td></tr>
              <tr><td style="padding:8px 10px;border:1px solid var(--border)">社会</td><td style="padding:8px 10px;border:1px solid var(--border)"><b>人生七年</b></td><td style="padding:8px 10px;border:1px solid var(--border)">56 年跟拍一群人，看懂阶层与选择</td><td style="padding:8px 10px;border:1px solid var(--border)"><a href="https://search.bilibili.com/all?keyword=%E4%BA%BA%E7%94%9F%E4%B8%83%E5%B9%B4%20%E7%BA%AA%E5%BD%95%E7%89%87" target="_blank" rel="noopener noreferrer">B站↗</a></td></tr>
