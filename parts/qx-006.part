          <tr><td><strong>4-6月</strong></td><td>全国大学生数学竞赛（CMC）</td><td>国家级</td><td>高数/数学专业组</td><td>保研强加分</td><td><a href="https://www.cms.org.cn/" target="_blank" rel="noopener noreferrer">cms.org.cn ↗</a></td></tr>
          <tr><td><strong>5-7月</strong></td><td>"互联网+"大学生创新创业大赛</td><td>国家级</td><td>项目BP+路演</td><td>保研顶级加分项</td><td><a href="https://cy.ncss.org.cn/" target="_blank" rel="noopener noreferrer">cy.ncss.org.cn ↗</a></td></tr>
          <tr><td><strong>6-9月</strong></td><td>全国大学生节能减排社会实践与科技竞赛</td><td>国家级</td><td>节能减排作品</td><td>能源/环境类加分</td><td><a href="https://www.jienengjianpai.org/" target="_blank" rel="noopener noreferrer">jienengjianpai.org ↗</a></td></tr>
          <tr><td><strong>9-10月</strong></td><td>全国大学生数学建模竞赛（CUMCM）</td><td>国家级</td><td>3天建模论文</td><td>保研核心加分项</td><td><a href="https://www.mcm.edu.cn/" target="_blank" rel="noopener noreferrer">mcm.edu.cn ↗</a></td></tr>
          <tr><td><strong>9-11月</strong></td><td>"挑战杯"课外学术科技作品竞赛</td><td>国家级</td><td>学术论文+答辩</td><td>保研顶级加分</td><td><a href="https://www.tiaozhanbei.net/" target="_blank" rel="noopener noreferrer">tiaozhanbei.net ↗</a></td></tr>
          <tr><td><strong>10-12月</strong></td><td>ACM-ICPC国际大学生程序设计竞赛</td><td>国际级</td><td>5小时编程解题</td><td>计算机保研顶级</td><td><a href="https://icpc.global/" target="_blank" rel="noopener noreferrer">icpc.global ↗</a></td></tr>
