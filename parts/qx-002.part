   try { if (typeof window.toggleTbMore === 'function') window.toggleTbMore(); } catch (e3) {}
        return;
      }
    } catch (e) {}
    showInstallSheet();
  };
  window.installApp = window.openInstall; // 兼容旧调用名

  var sheetInjected = false;
  function injectSheetStyle() {
    if (sheetInjected) return; sheetInjected = true;
    var css =
      '.cios{position:fixed!important;left:0!important;right:0!important;top:0!important;bottom:0!important;z-index:120000!important;background:rgba(45,34,22,.5)!important;display:flex!important;align-items:flex-end!important;justify-content:center!important;opacity:0;transition:opacity .18s;}\n' +
      '.cios.show{opacity:1}\n' +
      '.cios-box{width:100%;max-width:540px;background:var(--card,#fffdf8);border-radius:20px 20px 0 0;box-shadow:0 -10px 40px rgba(0,0,0,.28);padding:18px 18px calc(18px + env(safe-area-inset-bottom));max-height:86vh;overflow-y:auto;transform:translateY(26px);transition:transform .2s;}\n' +
      '.cios.show .cios-box{transform:none}\n' +
      '.cios h3{margin:2px 0 12px;font-size:17px;color:var(--head,#4A3427);font-weight:700;line-height:1.4}\n' +
      '.cios-card{background:var(--bg,#F4EDDF);border:1px solid var(--border,#E0D4BE);border-radius:12px;padding:11px 13px;margin-bottom:10px;font-size:13.5px;line-height:1.8;color:var(--muted,#6E5B44)}\n' +
      '.cios-card b{color:var(--primary,#8A5A2B)}\n' +
      '.cios-warn{background:#FFF6DE;border-color:#E9C96B;color:#6B5220}\n' +
      '.cios-btn{display:block;width:100%;text-align:center;padding:12px;margin:4px 0 11px;border:none;border-radius:12px;background:var(--primary,#7A5330);color:#fff;font-size:15px;font-weight:600}\n' +
      '.cios-btn.ghost{background:var(--bg,#F0E7D5);color:var(--primary,#7A5330);border:1px solid var(--border,#D8C8A8)}\n' +
      '.cios-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}\n' +
      '.cios-x{border:none;background:none;font-size:18px;color:var(--muted,#8A7658);cursor:pointer;padding:0;line-height:1}';
    var st = document.createElement('style');
    st.textContent = css;
    document.head.appendChild(st);
  }
  function showInstallSheet() {
    injectSheetStyle();
    var weixin = inWeixin(), ios = isIos(), standalone = isStandalone();
    var html = '<div class="cios-box"><div class="cios-top"><h3>把栖匣安装到桌面 / 主屏幕</h3><button class="cios-x" onclick="closeInstallSheet()" aria-label="关闭">✕</button></div>';
    if (standalone) {
      html += '<div class="cios-card">✅ 你现在已经以 <b>App 全屏方式</b> 使用栖匣（没有浏览器地址栏）。如还需再加一台设备，用下面的方法即可。</div>';
    }
    // 浏览器支持系统一键安装时（Chrome / Edge / 安卓系），第一优先给"一键安装"
    if (window.installPrompt && typeof window.installPrompt.prompt === 'function') {
      html += '<button class="cios-btn" onclick="try{var p=window.installPrompt;p.prompt();try{p.userChoice.then(function(){window.installPrompt=null;});}catch(e){}window.closeInstallSheet();}catch(e){alert(\'该浏览器暂不支持一键安装，请按下方手动方法操作\')}">⬇ 一键安装到桌面（无需手动步骤）</button>';
    }
    if (weixin) {
      html += '<div class="cios-card cios-warn"><b>当前在微信里，无法直接添加。</b><br>最快做法：点本页右上角 <b>「···」→「在浏览器中打开」</b>，再用下方针对浏览器的方法添加（一般 3 步内搞定）。想自己处理链接？点下方按钮复制，粘贴到 Safari / Chrome 打开再添加。</div>';
      html += '<button class="cios-btn" onclick="return copyThisLink()">📋 复制链接（粘贴到浏览器打开）</button>';
    } else if (ios) {
      html += '<button class="cios-btn ghost" onclick="return copyThisLink()">📋 复制链接，用 Safari 打开</button>';
      html += '<div class="cios-card"><b>iPhone / iPad（Safari）：</b><br>① 用 Safari 打开本页；<br>② 点底部<b>「分享」按钮 ⤴</b>；<br>③ 选<b>「添加到主屏幕」</b>；<br>④ 点右上角<b>「添加」</b>，桌面即出现栖匣图标，之后全屏像 App 一样使用。</div>';
    } else {
      if (isDesktop()) {
        html += '<div class="cios-card"><b>电脑（Chrome / Edge）：</b>点右上角或地址栏右侧的<b>「安装」图标</b> → 点「安装」即可；页面顶部若已出现「一键安装」，点它最快。</div>';
      } else {
        var br = browserName();
        var steps = {
          quark: '<b>夸克浏览器：</b>① 先点页面<b>屏幕下方 / 右下角的菜单（☰ 三条杠）</b>，在菜单里找「<b>工具箱 → 添加到桌面</b>」或「<b>添加到主屏幕</b>」；② 若菜单里没有，就<b>长按地址栏里的网址</b>，从弹出的菜单里选「<b>创建快捷方式 / 添加到桌面</b>」；③ 都没有？先进夸克<b>设置 → 常用设置</b>，把<b>「网页快捷方式」开关打开</b>再试。说明：夸克这类浏览器不允许网页自动一键安装，只能用它自己这个入口创建快捷方式（真正能网页一键安装的是 Chrome / Edge）。',
          uc: '<b>UC浏览器：</b>点中间菜单键 →<b>「收藏网址」→「手机桌面」</b>。',
          qq: '<b>QQ浏览器：</b>点右下角<b>「三横线」→「工具箱 → 添加快捷方式 → 手机桌面」</b>。',
          huawei: '<b>华为浏览器：</b>点页面右下角<b>「∷ / 四个点」→「添加至桌面」</b>；或在「我的 → 书签 / 历史」里长按网址 → 添加至桌面。</b>',
          samsung: '<b>三星浏览器：</b>右上角<b>「⋯」→「添加至主屏幕」→「添加」</b>。',
          edge: '<b>Edge / Chrome（手机）：</b>右上角<b>「⋮」→「安装此网站 / 添加到主屏幕」</b>→ 安装。',
          firefox: '<b>Firefox（手机）：</b>点菜单 →<b>「Add to Home Screen」</b>→ 改好名称 → Add。',
          chrome: '<b>Chrome / Edge / 安卓系统浏览器（手机）：</b>右上角<b>「⋮」→「安装应用 / 添加到主屏幕」</b>→ 确认名称；安卓上有时会自动弹出安装提示，点「安装」即可。'
        };
        var s = steps[br] || steps.chrome;
        html += '<div class="cios-card">' + s + '</div>';
      }
      html += '<button class="cios-btn ghost" onclick="return copyThisLink()">📋 复制链接，换到支持一键的浏览器 / 设备打开</button>';
    }
    html += '<button class="cios-btn" onclick="closeInstallSheet()">知道了</button></div>';
    var ov = document.createElement('div');
    ov.className = 'cios';
    ov.id = 'ciSheet';
    ov.innerHTML = html;
    document.body.appendChild(ov);
    requestAnimationFrame(function () { ov.classList.add('show'); });
    ov.addEventListener('click', function (e) { if (e.target === ov) window.closeInstallSheet(); });
  }
  window.closeInstallSheet = function () {
    var el = document.getElementById('ciSheet');
    if (el) { el.classList.remove('show'); setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 220); }
  };
})();
</script>
<div id="brandSplash" style="position: fixed; inset: 0px; z-index: 40; background: radial-gradient(70% 55% at 50% 30%, rgba(198,164,112,.26), transparent 60%), linear-gradient(172deg,#FEFBF4 0%,#F7F0E0 52%,#F1E7D0 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.55s; cursor: pointer; opacity: 1; overflow:hidden;">
  <!-- 栖匣启动屏：暖米白 × 赭金 × 深棕，与产品主界面同色调体系，明亮不暗沉 -->
  <div style="position:absolute;inset:0;opacity:.5;background:radial-gradient(rgba(110,79,55,.11) 1.2px,transparent 1.2px);background-size:24px 24px;pointer-events:none"></div>
  <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
    <span style="position:absolute;inset:-10px;border:1.5px solid rgba(178,132,70,.58);border-radius:50%;animation:bins .9s .15s both,srr 3.6s ease-in-out 1s infinite"></span>
    <span style="position:absolute;inset:7px;border:1.5px dashed rgba(178,132,70,.48);border-radius:50%;animation:bins .9s .28s both,srr 4.6s ease-in-out 1.3s infinite reverse"></span>
    <div style="position:absolute;inset:-14px;border-radius:50%;background:radial-gradient(circle,rgba(198,164,112,.5),rgba(198,164,112,0) 70%);filter:blur(8px);animation:bins .6s both"></div>
    <img src="pwa/logo-chest20260911.png" alt="栖匣" draggable="false" style="width:104px;height:104px;border-radius:30px;transform:none;opacity:0;animation:bins .7s .12s forwards,bf 3.6s ease-in-out 1.2s infinite;position:relative" onerror="logoFallback(this)"></div>
  <div style="font-family:'Noto Serif SC','Songti SC','STSong',serif;font-size:46px;font-weight:800;color:#4A3427;letter-spacing:12px;margin-top:30px;opacity:0;animation:bins .9s .45s forwards">栖匣</div>
  <div style="font-size:13px;letter-spacing:6px;color:#8A6236;margin-top:10px;opacity:0;animation:bins .9s .62s forwards">一只匣 · 安放成长</div>
  <div style="margin-top:20px;height:1px;width:60px;background:linear-gradient(90deg,transparent,#C2A15E,transparent);opacity:0;animation:bins .9s .78s forwards"></div>
  <div style="margin-top:18px;font-family:'Noto Serif SC','Songti SC','STSong',serif;font-size:16px;color:#5C4030;letter-spacing:5px;opacity:0;animation:bins .9s .92s forwards">收纳诸事，步履向前</div>
  <div style="margin-top:22px;display:flex;gap:0;align-items:flex-end;opacity:0;animation:bins .9s 1.08s forwards">
    <span style="display:flex;gap:7px;align-items:flex-end">
      <span style="width:14px;height:26px;border-radius:4px;background:#6E4F37"></span>
      <span style="width:14px;height:38px;border-radius:4px;background:#6E4F37"></span>
      <span style="width:14px;height:50px;border-radius:4px;background:#4A3427"></span>
      <span style="width:1px;height:54px;background:#C2A15E"></span>
    </span>
  </div>
  <div style="margin-top:16px;font-size:12px;color:rgba(110,79,55,.72);letter-spacing:2px;max-width:84%;text-align:center;line-height:2;opacity:0;animation:bins .9s 1.26s forwards">把你想认真对待的每件事，都收进一只只属于你的匣子<br>数据只存本地 · 私密安全 · 免安装免登录</div>
  <div style="position:absolute;bottom:58px;font-size:12px;letter-spacing:3px;color:rgba(110,79,55,.55);opacity:0;animation:bins .9s 1.5s forwards">轻触任意处 · 进入</div>
  <style>@keyframes bins{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}@keyframes bf{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-7px) rotate(-1deg)}}@keyframes srr{0%,100%{transform:scale(.94);opacity:.4}50%{transform:scale(1.05);opacity:1}}</style>
</div>
<script>
/* 品牌启动屏：
   ① 每次打开都优雅亮相约 2.5 秒（可轻触跳过），保证「一点开链接就有品牌闪屏」的体感；
   ② 首次进入（未看过导览）时，闪屏结束自动弹出产品导览，并锁定为「入座」流程——
      必须点「入座·栖匣」才关闭、才能查看完整内容；
   ③ 非首访用户，闪屏结束后直接进入产品，不再重复打扰。 */
(function(){
  function bs(){var e=document.getElementById('brandSplash');return e||null;}
  function firstVisit(){
    try{return localStorage.getItem('pp_pano_seen')!=='1' && localStorage.getItem('pp_quickstart_ok')!=='1';}catch(e){return false;}
  }
  function chrome(hide){
    /* 强隐/恢复顶栏与底部导航：用 hidden 属性做到 DOM 级不渲染，再以内联样式双保险，任何 WebView/CSS 异常下都必然生效 */
    var nodes=[document.querySelector('.topbar'),document.querySelector('.bottom-nav')];
    nodes.forEach(function(n){ if(!n)return;
      if(hide){ n.setAttribute('hidden',''); n.style.display='none'; }
      else{ n.removeAttribute('hidden'); n.style.display=''; }
    });
  }
  function dismiss(e){
    if(!e)return;
    document.documentElement.classList.remove('state-splash'); /* 闪屏结束：恢复顶栏 */
    chrome(false);
    e.style.opacity='0';
    setTimeout(function(){e.style.display='none'; afterSplash(); },420);
  }
  function afterSplash(){
    /* 首次访问：自动弹出产品导览，锁定为「入座」流程 */
    if(firstVisit()){
      try{
        var p=document.getElementById('pano');
        if(p) p.classList.add('seat-lock');  /* 锁定：必须点「入座」才关 */
        if(typeof openPano==='function') openPano();
      }catch(err){}
    }else{
      /* 闪屏结束后定位到当前界面：
         若地址栏带合法板块 hash（例如从外部链接返回、浏览器后退/前进、或点了带 #view 的链接），
         则回到对应板块而非首页；若为彻底冷启动（地址无 hash 或为 #view-home），仍展示首页。 */
      try{
        var _hh=''+(location.hash||'');
        _hh=_hh.replace(/^#view-/,'');
        var _hasHash=_hh&&_hh!=='home'&&document.getElementById('view-'+_hh);
        if(typeof switchView==='function'){ switchView(_hasHash?_hh:'home'); }
      }catch(e){ try{if(typeof switchView==='function')switchView('home');}catch(e2){} }
    }
  }
  function show(){
    var e=bs();if(!e)return;
    document.documentElement.classList.add('state-splash'); /* 闪屏期间隐藏顶栏 */
    chrome(true);   /* 内联强隐顶栏+底栏，确保闪屏期间不出现 */
    e.style.display='flex';e.style.opacity='1';
    e.setAttribute('data-gone','');
    /* 轻触任意处跳过闪屏（不影响后续导览/直接进入逻辑） */
    e.onclick=function(){dismiss(e);};
    /* 标准闪屏时长 3 秒（约1.5秒内容完全呈现，留足阅读时间），轻触可跳过；
       结束时按首访与否决定弹导览或直接进产品 */
    setTimeout(function(){ if(!e.getAttribute('data-gone')){e.setAttribute('data-gone','1');dismiss(e);} },3000);
  }
  show();
})();
</script>
<div class="app">

    <div class="topbar" hidden>
    <button class="icon-btn mobile-toggle" onclick="toggleSidebar()" title="打开全部板块">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=" 2"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
    <div class="tb-brand" onclick="switchView('home');setBottomActive(null,'home')" style="cursor:pointer" title="回到今日概览">
      <img src="pwa/logo-chest20260911.png" alt="栖匣" class="tb-logo" onerror="logoFallback(this)"><span class="tb-name">栖匣</span>
    </div>
    <div class="tb-slogan">心有所栖 · 匣纳成长</div>
    <div class="tools">
      <!-- 顶栏（搜索 + 帮助 + 产品导览 + 夜间 + 更多，共五键，精简去重；“换一批灵感”已并入各卡片内按钮，不再占顶栏入口） -->
      <button class="icon-btn" onclick="tbSearchGo()" title="搜索板块与内容" aria-label="全局搜索">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>
      <button class="icon-btn" onclick="switchView('help')" title="帮助中心" aria-label="帮助中心">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </button>
      <button class="icon-btn" onclick="openPano()" title="查看产品导览" aria-label="查看产品导览">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle><line x1="7" y1="4.4" x2="12" y2="2"></line></svg>
      </button>
      <button class="icon-btn" id="themeToggleBtn" onclick="toggleTheme()" title="切换日间 / 夜间模式" aria-label="切换日间 / 夜间模式">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="themeIconMoon"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="themeIconSun" style="display:none"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      </button>
      <!-- 更多工具：换一批灵感 / 产品导览 / 分享 / 导出 / 导入 / PDF / 设置 / 关于 / 重置（分组展示，点击空白处收起） -->
      <div class="tb-more" id="tbMore">
        <button class="icon-btn tb-more-dots" id="tbMoreBtn" type="button" data-hint="更多工具" title="更多工具" aria-label="更多工具">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2.5" fill="currentColor"/><circle cx="12" cy="12" r="2.5" fill="currentColor"/><circle cx="12" cy="19" r="2.5" fill="currentColor"/></svg>
        </button>
        <div class="tb-more-menu" id="tbMoreMenu">
          <!-- 更多工具已去重：仅保留顶栏所没有的独有功能；全局搜索/帮助/产品导览/换一批灵感均在顶栏或卡片内，不再重复罗列 -->
          <div class="tb-more-label">数据与工具</div>
          <button class="tb-more-item" onclick="openInstall();toggleTbMore()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="2" width="10" height="20" rx="2"></rect><circle cx="12" cy="18" r="1"></circle><path d="M9 8l3-3 3 3"></path><line x1="12" y1="9" x2="12" y2="15"></line></svg>
            安装到桌面 / 下载应用
          </button>
          <button class="tb-more-item" onclick="shareProduct();toggleTbMore()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.51"></line></svg>
            分享给朋友
          </button>
          <button class="tb-more-item" onclick="exportAll();toggleTbMore()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            导出数据备份
          </button>
          <button class="tb-more-item" onclick="document.getElementById(&apos;importFileMenu&apos;).click();toggleTbMore()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            导入数据
          </button>
          <button class="tb-more-item" onclick="exportCurrentPDF();toggleTbMore()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><polyline points="9 15 12 18 15 15"></polyline></svg>
            导出 PDF
          </button>
          <button class="tb-more-item" onclick="if(typeof exportWeekPNG==='function'){exportWeekPNG();}toggleTbMore()">
