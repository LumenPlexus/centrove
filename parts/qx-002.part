<script>
/* ── 三点菜单·独立启动器 ──
   放在按钮正下方、最靠前执行。不依赖任何外部/后续脚本：
   即使下方超大主脚本因数据等任何原因报错中断，这里已定义 setTbMore/toggleTbMore
   并挂好委托监听，右上角菜单也必定可点。防重复绑定：__tbmoreReady。 */
(function(){
  if(window.__tbmoreReady)return;
  window.__tbmoreReady=true;
  /* 层级修复：把菜单移出 .topbar（其 z-index:20 会形成层叠上下文，把菜单 9995 封顶造成被遮挡），
     改为挂到 body 顶层，配合高 z-index 确保任何情况下都不被盖住。 */
  (function(){
    var _m=document.getElementById('tbMoreMenu');
    if(_m && _m.parentNode && _m.parentNode!==document.body){ try{ document.body.appendChild(_m); }catch(e){} }
  })();
  function set(open){
    var m=document.getElementById('tbMoreMenu'),b=document.getElementById('tbMoreBtn');
    if(!m)return;
    if(open){m.classList.add('show');m.style.display='flex';if(b)b.classList.add('is-open');}
    else{m.classList.remove('show');m.style.display='none';if(b)b.classList.remove('is-open');}
  }
  window.setTbMore=set;
  window.toggleTbMore=function(){var m=document.getElementById('tbMoreMenu');set(!(m&&m.classList.contains('show')));};
  /* 直接绑定在按钮上（比全文档委托更稳，任何 WebView 都能命中）；
     用防抖避免触屏设备 "touchend → click" 重复触发导致"开了又关"。 */
  var lastTs=0;
  function fire(){
    var now=Date.now();
    if(now-lastTs<300)return;
    lastTs=now;
    (window.toggleTbMore||function(){} )();
  }
  var _b=document.getElementById('tbMoreBtn');
  if(_b){
    _b.addEventListener('click',fire);
    _b.addEventListener('pointerup',fire);
    _b.addEventListener('touchend',fire);   /* 兜底：个别 WebView 只派 touch */
  }
  window.__tbmoreModern=true;
})();
</script>
