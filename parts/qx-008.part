dth;b.classList.add('spinning');
}
/* ═══════ 今日财商知识（首页每日随机·不重复·有用） ═══════ */
var MONEY_TIPS=[
  {t:'先存后花，而不是花剩才存',d:'每月生活费到账，先划出 10%–20% 进一个「碰不到」的账户（或单独银行卡），剩下的才用来花。哪怕一个月只存 100 块，一年也有 1200，还养成了不月光的习惯。今天做：把下月要存的钱先转走。'},
  {t:'警惕「9.9 包邮」的拿铁因子',d:'每天一杯奶茶、每样「便宜」的小东西，加起来可能吃掉你 1/3 生活费。记账一周你会发现：真正的大头往往不是大件，而是无数「无所谓」的小花销。今天做：记一天账，看看钱花哪了。'},
  {t:'复利是世界第八大奇迹',d:'每月存 200，年化 4%，大学毕业时（4年）大约能攒下 1 万+。早开始一年，结果差很多。大学生时间最多，正是定投习惯的黄金期。今天做：算算你每月能稳定存多少。'},
  {t:'免费的东西，往往最贵',d:'「免费试用」到期自动扣费、「砍一刀」耗光你时间、校园贷「零门槛」背后是高利。任何「先免费后收费/先收费后服务」都要先问：退出机制是什么？今天做：检查手机有没有「免密支付/自动续费」并关掉不必要的。'},
  {t:'买「需要的」不买「想要的」',d:'下单前问自己：没有它，我的生活会不会变差？如果需要，再等 24 小时——大部分「想要」的冲动会在一天后消失。今天做：把购物车里一样东西延迟一天再决定。'},
  {t:'学生证是隐藏优惠卡',d:'电影、景区、博物馆、铁路、不少软件（办公/设计/云存储）都有教育优惠，甚至免费。用学生邮箱认证能省不少。今天做：查查你常用的 1 个软件有没有教育版。'},
  {t:'兼职先防骗，再谈赚钱',d:'「刷单返利」「押金兼职」「培训贷」基本是坑。正规兼职不收押金、不让你先垫钱。校园勤工助学岗最稳。今天做：把「任何要先交钱的兼职」拉黑。'},
  {t:'记账不是为了省，是为了看清',d:'不用记到每一分，记大类就行：饮食/交通/学习/娱乐/其他。一个月后你就知道钱去哪了，砍掉哪类最不心疼。今天做：建一个只分 5 类的记账表。'},
  {t:'应急金比理财更重要',d:'先攒够「3 个月生活费」的应急金（放活期/货币基金，随时能取），再去想基金股票。没应急金就进场，一次意外就会让你割肉离场。今天做：算算你的应急金还差多少。'},
  {t:'别碰看不懂的投资',d:'有人拉你「稳赚」「内部消息」，99% 是杀猪盘或传销。记住：高收益必然高风险，承诺保本高息的，大概率是骗局。今天做：把「承诺保本且收益>6%」的项目一律当诈骗看。'},
  {t:'信用是无形资产',d:'花呗/白条按时还，别逾期——逾期上征信，影响以后房贷车贷。额度不是你的钱，是借的。今天做：查一下自己有没有未还清的账单，设个还款提醒。'},
  {t:'技能是最稳的「理财」',d:'与其纠结怎么用 100 块生钱，不如投资自己：考个有用的证、学门能接单的技能（PPT/剪辑/外语/编程），未来变现能力远超理财收益。今天做：列一个「能换钱的小技能」清单。'},
  {t:'比价 30 秒，省下的都是赚的',d:'大件（电脑/手机/教材）买前用比价工具看历史价格，避开「先涨后降」的伪促销。二手教材、闲鱼好物也能省一半。今天做：下次买东西前先比价。'},
  {t:'「沉没成本」别纠结',d:'办了用不上的健身卡、买了不好用的课，已经花的钱回不来。别因为「钱都交了」继续往里搭时间。及时止损也是省钱。今天做：放弃一件你早就不该继续的事。'},
  {t:'学会看「真实价格」',d:'分期免息才划算，分期收手续费的实际年利率可能 15%+；「满 300 减 50」逼你多买，算下来单价未必低。今天做：下次看到「分期/满减」，先算真实到手价。'},
  {t:'室友拼单，省运费也省单价',d:'纸巾、洗衣液、零食这类消耗品，和室友拼单买大包装，单价低还省运费。但别为了拼单买用不完的量。今天做：看看宿舍有什么能一起囤的。'},
  {t:'用书代替报班',d:'想学的大部分技能，图书馆/公开课/B站都有免费或极便宜的资源。先免费学到 80 分，再决定要不要花大钱报班。今天做：找一门你想学技能的免费资源。'},
  {t:'「收入-储蓄=支出」公式',d:'大部分人用「收入-支出=储蓄」，结果总是存不下。反过来：发钱先定储蓄目标，剩下的才是能花的。今天做：把公式反过来试一个月。'},
  {t:'小心「校园贷」换皮',d:'「培训分期」「美容分期」「手机分期」本质都是贷，利率和违约金可能很高。任何要你签「分期协议」的，先让爸妈看一眼。今天做：把「签分期前必须问爸妈」设为铁律。'},
  {t:'钱要花在「杠杆」上',d:'能放大你未来能力的钱（好书、好课、健康、人脉）值得花；纯消费（炫耀性吃喝穿）要克制。今天做：回顾上月开销，标出哪些是「杠杆型」。'}
];
function renderFinanceKnowledge(){
  var el=document.getElementById('dailyFinance');
  if(!el)return;
  var day=Math.floor(Date.now()/86400000);
  /* 按日期选，保证同日同内容；%length 自然轮换，隔天不同，长期看不重复 */
  var tip=MONEY_TIPS[day%MONEY_TIPS.length];
  el.innerHTML='<strong>'+tip.t+'</strong><br>'+tip.d+'<br><span style="font-size:11px;color:var(--hint)">每天一条财商常识 · 按日期轮换不重复</span>';
}

/* ═══════ 今日知识 · 标签页展示（健康 / 认知 / 社会 / 财商） ═══════ */
var _knowledgeIdx={health:0,cognition:0,life:0,finance:0};
var _knowledgeActive='health';
var _KNOWLEDGE_MAP={
  health:{arr:LAWS,tag:'每日一记',tagClass:'tag-teal',src:'健康小知识'},
  cognition:{arr:COGNITIONS,tag:'思维升级',tagClass:'tag-blue',src:'认知升级'},
  life:{arr:LIFE_TIPS,tag:'打破信息差',tagClass:'tag-coral',src:'社会常识'},
  finance:{arr:MONEY_TIPS,tag:'财商启蒙',tagClass:'tag-gold',src:'财商知识'}
};
function renderKnowledge(type){
  var c=_KNOWLEDGE_MAP[type]; if(!c) return;
  var idx=_knowledgeIdx[type] || 0;
  var item=c.arr[idx % c.arr.length];
  var body=document.getElementById('knowledgeBody'); if(!body) return;
  body.innerHTML='<strong>'+item.t+'</strong><br>'+item.d+'<br><span style="font-size:11px;color:var(--hint)">出处：'+(item.src||c.src)+' · 按日期轮换不重复</span>'+
    '<div style="margin-top:10px"><span class="tag '+c.tagClass+'">'+c.tag+'</span></div>';
}
function switchKnowledge(type){
  _knowledgeActive=type;
  document.querySelectorAll('.k-tab').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-k')===type);});
  renderKnowledge(type);
}
function pickKnowledgeIndices(seedFn){
  return {
    health:seedFn(LAWS.length),
    cognition:seedFn(COGNITIONS.length),
    life:seedFn(LIFE_TIPS.length),
    finance:seedFn(MONEY_TIPS.length)
  };
}

var _breathOn=false;
function breathe(){
  var dot=document.getElementById('breathDot');
  var tip=document.getElementById('breathTip');
  if(!dot)return;
  _breathOn=!_breathOn;
  if(_breathOn){
    dot.style.transform='scale(1.6)';
    if(tip)tip.textContent='屏住…然后慢慢呼气';
    setTimeout(function(){if(_breathOn){dot.style.transform='scale(1)';if(tip)tip.textContent='呼气～ 再来一次就点我';_breathOn=false;}},4000);
  }else{
    dot.style.transform='scale(1)';
    if(tip)tip.textContent='点一下，开始吸气';
  }
}
var FUN_PICKS=['背 20 个单词，然后心安理得刷会儿手机','去操场走两圈，晒晒太阳','整理一下桌面和书包，心情会好','给家里人发条消息','看一集喜欢的剧，别 guilt','做一组拉伸，肩颈会感谢你','写三行今天的小确幸','什么都不做，发呆 10 分钟也行'];
function funPick(){
  var el=document.getElementById('funRandom');
  if(!el)return;
  el.textContent=FUN_PICKS[Math.floor(Math.random()*FUN_PICKS.length)];
}

/* 主题已固定为默认配色，不再提供切换 */

/* ═══════ 周报 PNG 导出（设置里用） ═══════ */
function exportWeekPNG(){
  var d=new Date();
  var mon=new Date(d);mon.setDate(d.getDate()-d.getDay()+1);
  var sun=new Date(mon);sun.setDate(mon.getDate()+6);
  var label=mon.getMonth()+1+'月'+mon.getDate()+'日 - '+sun.getMonth()+1+'月'+sun.getDate()+'日';
  var tasks=getTasks?getTasks():[];
  var weekTasks=tasks.filter(function(t){return t.date>=todayKey(mon)&&t.date<=todayKey(sun)});
  var done=weekTasks.filter(function(t){return t.done}).length;
  var all=weekTasks.length;
  var checkins=[];
  try{var cl=JSON.parse(localStorage.getItem('pp_checkins')||'{}');for(var k in cl){if(k>=todayKey(mon)&&k<=todayKey(sun))checkins.push(cl[k]);}}catch(e){}
  var cw=document.createElement('canvas');cw.width=900;cw.height=1100;
  var ctx=cw.getContext('2d');
  /* 圆角矩形：老式安卓/微信 WebView 无 ctx.roundRect，需手绘路径兜底，否则导出直接抛错·点击无反应 */
  function rr(x,y,w,h,r){
    ctx.beginPath();
    ctx.moveTo(x+r,y);
    ctx.arcTo(x+w,y,x+w,y+h,r);
    ctx.arcTo(x+w,y+h,x,y+h,r);
    ctx.arcTo(x,y+h,x,y,r);
    ctx.arcTo(x,y,x+w,y,r);
    ctx.closePath();
  }
  function rrFill(x,y,w,h,r){ if(ctx.roundRect){ctx.beginPath();ctx.roundRect(x,y,w,h,r);} else{rr(x,y,w,h,r);} ctx.fill(); }
  /* 背景 */
  var g=ctx.createLinearGradient(0,0,0,1100);g.addColorStop(0,'#4A3427');g.addColorStop(1,'#6E4F37');
  ctx.fillStyle=g;ctx.fillRect(0,0,900,1100);
  ctx.fillStyle='#fff';ctx.font='bold 44px sans-serif';ctx.textAlign='center';
  ctx.fillText('栖匣 · 本周报告',450,90);
  ctx.font='26px sans-serif';ctx.fillStyle='rgba(255,255,255,.8)';
  ctx.fillText(label,450,140);
  /* 统计卡 */
  ctx.fillStyle='rgba(255,255,255,.12)';
  var cards=[['本周任务',all+' 件'],['已完成',done+' 件'],['完成率',all?(Math.round(done/all*100))+'%':'0%'],['打卡天数',checkins.length+' 天']];
  for(var i=0;i<4;i++){
    var x=60+i*200,y=200,w=170,h=120;
    rrFill(x,y,w,h,14);
    ctx.fillStyle='rgba(255,255,255,.75)';ctx.font='22px sans-serif';ctx.fillText(cards[i][0],x+w/2,y+52);
    ctx.fillStyle='#fff';ctx.font='bold 40px sans-serif';ctx.fillText(cards[i][1],x+w/2,y+100);
  }
  /* 本周任务明细 */
  ctx.fillStyle='#fff';ctx.font='bold 28px sans-serif';ctx.textAlign='left';ctx.fillText('本周任务明细',60,390);
  ctx.font='24px sans-serif';
  if(weekTasks.length){
    weekTasks.slice(0,10).forEach(function(t,i){
      ctx.fillStyle=t.done?'rgba(255,255,255,.5)':'rgba(255,255,255,.9)';
      ctx.fillText((t.done?'✓ ':'○ ')+t.text,80,435+i*52);
    });
  }else{
    ctx.fillStyle='rgba(255,255,255,.6)';ctx.fillText('本周还没有记录任务，下周加油！',80,435);
  }
  /* 金句 */
  var q=QUOTES&&QUOTES[(Math.floor(Date.now()/86400000))%QUOTES.length]||'坚持就是胜利';
  ctx.fillStyle='rgba(255,255,255,.85)';ctx.font='italic 24px sans-serif';ctx.textAlign='center';
  ctx.fillText('“'+q+'”',450,980);
  ctx.fillStyle='rgba(255,255,255,.5)';ctx.font='20px sans-serif';
  ctx.fillText('生成时间：'+new Date().toLocaleString(),450,1030);
  /* 显示页内预览：WebView 里 <a download> 常不触发，改为本地全屏看图，
     支持「保存图片」下载与「长按/分享」保存，任何环境都有响应 */
  try{
    var imgData=cw.toDataURL('image/png');
    var box=document.getElementById('pprImgBox');
    if(!box){
      box=document.createElement('div');box.id='pprImgBox';
      box.style.cssText='position:fixed;inset:0;z-index:99999;background:rgba(24,16,10,.86);display:none;flex-direction:column;align-items:center;padding:14px 10px 22px;overflow:auto;-webkit-overflow-scrolling:touch';
      box.innerHTML='<div style="width:100%;max-width:420px;display:flex;align-items:center;gap:10px;color:#fff;margin-bottom:10px"><b style="flex:1">🖼 本周报告图</b><button id="pprClose" style="background:transparent;border:1px solid rgba(255,255,255,.4);color:#fff;border-radius:9px;padding:7px 14px;font-size:13px;flex-shrink:0">关闭</button></div>'+
        '<img id="pprImg" alt="本周报告图" style="width:100%;max-width:400px;border-radius:14px;box-shadow:0 8px 30px rgba(0,0,0,.45);pointer-events:none">'+
        '<div style="width:100%;max-width:420px;margin-top:12px;display:flex;flex-direction:column;gap:9px">'+
          '<button id="pprDl" style="background:#fff;color:#4A3427;border:none;border-radius:11px;padding:12px;font-size:15px;font-weight:600">保存图片</button>'+
          '<div style="color:rgba(255,255,255,.85);font-size:12.5px;text-align:center;line-height:1.7">若未自动下载，请<b>长按上方图片</b>选择「保存 / 分享」，或点「保存图片」调起系统下载。</div>'+
        '</div>';
      document.body.appendChild(box);
      box.addEventListener('click',function(e){if(e.target===box){box.style.display='none';}});
      document.getElementById('pprClose').onclick=function(){box.style.display='none';};
      var dl=document.getElementById('pprDl');
      dl.onclick=function(){
        try{
          var a=document.createElement('a');a.href=imgData;a.download='栖匣-本周报告-'+todayKey()+'.png';
          document.body.appendChild(a);a.click();setTimeout(function(){try{document.body.removeChild(a);}catch(e){}},300);
          flash('已尝试保存；若未下载，请长按预览图保存');
        }catch(e){flash('请在预览中长按图片保存');}
      };
    }
    var pi=document.getElementById('pprImg');
    pi.src=imgData;pi.style.opacity='0';pi.onload=function(){pi.style.opacity='1';};
    box.style.display='flex';box.scrollTop=0;
    flash('本周报告图已生成，可长按图片保存或分享');
  }catch(e2){
    try{flash('本周报告图生成失败，请稍后重试');}catch(e3){}
  }
}
function todayKey(dt){
  var d=dt||new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}

/* 今日金句卡渲染 */
function renderDailyQuoteCard(){
  var q=QUOTES&&QUOTES[(Math.floor(Date.now()/86400000))%QUOTES.length];
  var el=document.getElementById('dailyQuoteCard');
  if(el&&q)el.innerHTML='“'+q+'”';
  renderDailyEncourage();
  refreshMind(false);
}

/* ═══════ 首页「轻松上手」：分类导航，大板块 → 细分板块 ═══════ */
/* 全部板块：与侧边栏一一对应，按大板块分组，点击展开进入其细分板块 */
var NAV_ALL=[{
  g:'锚愿匣 · 目标与行动',items:[['quadrant','🗂','轻重缓急'],['plans','🗓','行进罗盘'],['goals','🎯','目标拆解'],['life','🧭','生涯蓝图']]
},{
  g:'时栖录 · 时间与打卡',items:[['habits','✅','习惯养成'],['timer','🍅','心流计时']]
},{
  g:'学业栖仓 · 学业成长',items:[['study','📘','学业精进'],['exam','⏳','考试规划'],['contest','🏆','竞赛科研'],['paper','📝','论文写作'],['tpl','🧩','专项模板'],['campus','🎒','校园生活']]
},{
  g:'职途匣 · 职业与技能',items:[['career','💼','职业发展'],['growth','📈','个人提升']]
},{
  g:'安养隅 · 生活与健康',items:[['health','💪','运动健康'],['mind','🧠','心灵成长'],['safety','🛡','平安护航']]
},{
  g:'时光贮格 · 记录与成长',items:[['journal','📖','时光札记'],['stats','📊','成长档案']]
},{
  g:'灵拾槽 · 阅读与休闲',items:[['creative','💡','灵感看板'],['shelf','📚','书海拾贝'],['podcast','🎧','耳畔星河'],['movie','🎬','幕间观澜'],['vision','👁️','眼界珍藏'],['fun','😄','轻松一下']]
},{
  g:'贮金格 · 理财与副业',items:[['finance','💰','理财管理'],['save','🪙','省钱技巧'],['earn','💸','搞钱副业'],['shop','🛒','购物指南'],['perk','🛡','助学帮扶']]
},{
  g:'慧诀匣 · 工具与查询',items:[['tools','🛠','高效方法'],['ai','🤖','智造工坊']]
},{
  g:'设置 · 栖匣系统',items:[['agent','🤖','栖匣 助手'],['settings','⚙️','系统设置'],['changelog','📜','更新日志'],['about','ℹ️','关于产品'],['help','❓','帮助中心']]
}];
/* 复用侧边栏已有的线性图标，避免首页另用 emoji 造成风格割裂；
   直接从 DOM 取，保证「改侧边栏图标 → 首页自动同步」。 */
var _navIconCache={};
function navIconFor(view){
  if(_navIconCache[view]!==undefined) return _navIconCache[view];
  var n=document.querySelector('.nav-item[data-view="'+view+'"] svg');
  _navIconCache[view]=n?n.outerHTML:'';
  return _navIconCache[view];
}
/* 常用模块偏好：首次入座后引导挑选最常用板块；首页「轻松上手」据此聚焦展示，其余板块仍可在
   侧边栏/「显示全部板块」中随时找到（满足“隐藏但不消失、想用自会点进去”）。设置里可随时重选。 */
var PREF_KEY='pp_pref_modules', PREF_DONE='pp_pref_done', PREF_MODE='pp_pref_mode';
var PREF_SYS={agent:1,settings:1,changelog:1,about:1,help:1};  /* 系统类板块：不属于可选“常用”，恒常展示 */
function prefModules(){try{var a=JSON.parse(localStorage.getItem(PREF_KEY)||'[]');return Array.isArray(a)?a:[];}catch(e){return[];}}
function prefMode(){try{return localStorage.getItem(PREF_MODE)||'fav';}catch(e){return'fav';}}
function prefDoneFlag(){try{return localStorage.getItem(PREF_DONE)==='1';}catch(e){return false;}}
function savePref(arr,mode){try{localStorage.setItem(PREF_KEY,JSON.stringify(arr||[]));localStorage.setItem(PREF_MODE,mode||'fav');localStorage.setItem(PREF_DONE,'1');}catch(e){}}
function focusModeAll(){ savePref(prefModules(),'all'); renderFocus(); }
function focusModeFav(){ savePref(prefModules(),'fav'); renderFocus(); }
function updatePrefStatus(){
  try{
    var s=document.getElementById('prefStatus');if(!s)return;
    var sel=prefModules(),done=prefDoneFlag();
    if(!done){s.textContent='尚未挑选 · 默认展示全部板块';}
    else if(sel.length===0){s.textContent='已选择“展示全部板块”';}
    else{s.textContent='已选 '+sel.length+' 个常用模块 · 首页优先展示';}
  }catch(e){}
}
function renderFocus(){
  var cont=document.getElementById('focusStart');if(!cont)return;
  var sel=prefModules(), mode=prefMode(), done=prefDoneFlag();
  var favOnly=done && mode==='fav' && sel.length>0;
  var html='';
  /* 模式工具条：聚焦常用 vs 展示全部 + 随时调整 */
  html+='<div class="focus-toolbar">'
    +'<span class="ft-label">'+(favOnly?('只显示你常用 '+sel.length+' 个 · 其余已藏入侧边栏'):'已显示全部板块 · 也可只看常用')+'</span>'
    +'<span class="ft-btns">';
  if(favOnly){ html+='<button class="ft-btn" onclick="focusModeAll()">显示全部板块</button>'; }
  else if(done){ html+='<button class="ft-btn" onclick="focusModeFav()">只看常用</button>'; }
  html+='<button class="ft-btn ghost" onclick="openModulePick()">调整常用</button>';
  html+='</span></div>';
  /* 两级导航：先一组「大板块」，点击展开进入其「细分板块」；聚焦模式只渲染已选常用，系统板块恒常保留 */
  for(var si=0;si<NAV_ALL.length;si++){
    var sec=NAV_ALL[si];
    var isSys=!!PREF_SYS[sec.items[0]&&sec.items[0][0]];
    var items=[];var k;
    for(k=0;k<sec.items.length;k++){
      if(isSys || !favOnly || sel.indexOf(sec.items[k][0])>=0){ items.push(sec.items[k]); }
    }
    if(items.length===0){ continue; }   /* 聚焦模式下整组无常用模块 → 整组隐藏 */
    html+='<div class="focus-group'+(si===0?' open':'')+'">'
      +'<button class="fg-head" role="button" aria-expanded="'+(si===0?'true':'false')+'" onclick="toggleFocusGroup(this)">'
      +'<span class="fg-caret">'+((si===0)?'–':'+')+'</span>'
      +'<span class="fg-name">'+sec.g+'</span>'
      +(isSys?'':'<span class="fg-count">'+items.length+' 个板块</span>')
      +'</button>'
      +'<div class="fg-body"><div class="focus-grid">';
    for(var j=0;j<items.length;j++){
      var it=items[j];
      var _ic=navIconFor(it[0]);
      html+='<div class="focus-board" data-go="'+it[0]+'" tabindex="0" role="button" onclick="switchView(\''+it[0]+'\')" title="前往『"+it[2]+"』"><span class="fb-ico'+( _ic?' fb-svg':'')+'">'+(_ic||it[1])+'</span><span class="fb-na">'+it[2]+'</span></div>';
    }
    html+='</div></div></div>';
  }
  cont.innerHTML=html;
  cont.style.display='block';
  updatePrefStatus();
  applyHeroCollapse(); applyFocusCollapse(); applySidebarFilter();
}
/* 模块偏好选择浮层 */
function openModulePick(){
  var el=document.getElementById('modulePick');if(!el)return;
  var m=document.getElementById('modulePickMask');if(!m)return;
  var wrap=document.getElementById('modulePickBody');if(!wrap)return;
  var sel=prefModules();
  var groups=[];
  for(var gi=0;gi<NAV_ALL.length;gi++){ if(!PREF_SYS[NAV_ALL[gi].items[0]&&NAV_ALL[gi].items[0][0]]){ groups.push(NAV_ALL[gi]); } }
  var html='';
  for(var g2=0;g2<groups.length;g2++){
    var sec=groups[g2];
    html+='<div class="mp-group"><div class="mp-gname">'+sec.g+'</div><div class="mp-grid">';
    for(var j=0;j<sec.items.length;j++){
      var it=sec.items[j];
      var on=sel.indexOf(it[0])>=0;
      var _ic=navIconFor(it[0]);
      html+='<div class="mp-chip'+(on?' on':'')+'" data-v="'+it[0]+'" role="button" tabindex="0" onclick="mpChip(this)"><span class="mp-ic'+( _ic?' svg':'')+'">'+(_ic||it[1])+'</span><span class="mp-na">'+it[2]+'</span><span class="mp-tick">✓</span></div>';
    }
    html+='</div></div>';
  }
  wrap.innerHTML=html;
  var cnt=document.getElementById('modulePickCount');if(cnt)cnt.textContent=sel.length;
  m.classList.add('show'); el.classList.add('show');
  try{document.body.style.overflow='hidden';}catch(e){}
}
function closeModulePick(){
  var el=document.getElementById('modulePick'),m=document.getElementById('modulePickMask');
  if(m)m.classList.remove('show'); if(el)el.classList.remove('show');
  try{document.body.style.overflow='';}catch(e){}
}
function mpChip(el){ if(!el)return; el.classList.toggle('on'); var cnt=document.getElementById('modulePickCount'); if(cnt)cnt.textContent=document.querySelectorAll('.mp-chip.on').length; }
function mpSelectAll(){ document.querySelectorAll('#modulePick .mp-chip').forEach(function(c){c.classList.add('on');}); var cnt=document.getElementById('modulePickCount'); if(cnt)cnt.textContent=document.querySelectorAll('#modulePick .mp-chip').length; }
function mpClear(){ document.querySelectorAll('#modulePick .mp-chip').forEach(function(c){c.classList.remove('on');}); var cnt=document.getElementById('modulePickCount'); if(cnt)cnt.textContent=0; }
function mpConfirm(showAll){
  var sel=[];document.querySelectorAll('#modulePick .mp-chip.on').forEach(function(e){sel.push(e.getAttribute('data-v'));});
  savePref(sel, showAll?'all':'fav');
  closeModulePick(); renderFocus();
  try{window.flash&&window.flash(showAll?'已展示全部板块':'已按你的选择整理首页常用模块');}catch(e){}
}
/* 首页品牌主视觉区：可折叠（记住用户选择） */
function heroCollapsed(){try{return localStorage.getItem('pp_hero_collapsed')==='1';}catch(e){return false;}}
function applyHeroCollapse(){
  var b=document.getElementById('heroBody'),t=document.getElementById('heroToggle');
  if(!b)return; var col=heroCollapsed();
  b.style.display=col?'none':'';
  if(t){t.innerHTML=col?'▸ 展开':'▾ 收起';t.setAttribute('aria-expanded',col?'false':'true');}
}
function toggleHeroCollapse(){ try{localStorage.setItem('pp_hero_collapsed',heroCollapsed()?'0':'1');}catch(e){localStorage.setItem('pp_hero_collapsed','1');} applyHeroCollapse(); }
/* 首页「轻松上手 · 分类导航」区域：可折叠（记住用户选择） */
function focusCollapsed(){try{return localStorage.getItem('pp_focus_collapsed')==='1';}catch(e){return false;}}
function applyFocusCollapse(){
  var b=document.getElementById('focusBody'),t=document.getElementById('focusToggle');
  if(!b)return; var col=focusCollapsed();
  b.style.display=col?'none':'';
  if(t){t.innerHTML=col?'▸ 展开':'▾ 收起';t.setAttribute('aria-expanded',col?'false':'true');}
}
function toggleFocusCollapse(){ try{localStorage.setItem('pp_focus_collapsed',focusCollapsed()?'0':'1');}catch(e){localStorage.setItem('pp_focus_collapsed','1');} applyFocusCollapse(); }
/* 侧边栏联动常用偏好：只看常用时隐藏未选模块（系统设置类恒常保留），并隐藏无可见项的分组标题 */
function applySidebarFilter(){
  try{
    var sel=prefModules(),done=prefDoneFlag(),mode=prefMode();
    var favOnly=done && mode==='fav' && sel.length>0;
    var sb=document.getElementById('sidebar'); if(!sb)return;
    var items=sb.querySelectorAll('.nav-item');
    for(var i=0;i<items.length;i++){
      var v=items[i].getAttribute('data-view');
      items[i].classList.toggle('nav-hidden', !!favOnly && !!v && !PREF_SYS[v] && sel.indexOf(v)<0);
    }
    var secs=sb.querySelectorAll('.nav-section');
    for(var s=0;s<secs.length;s++){
      var sec=secs[s],any=false,node=sec.nextElementSibling;
      while(node&&node.classList&&!node.classList.contains('nav-section')){
        if(node.classList.contains('nav-item')&&!node.classList.contains('nav-hidden')){any=true;break;}
        node=node.nextElementSibling;
      }
      sec.classList.toggle('nav-hidden',!any);
    }
  }catch(e){}
}
/* 手风琴：点大板块展开/收起其细分板块（同一时间只开一个，聚焦不铺开） */
function toggleFocusGroup(btn){
  var grp=btn.parentNode;
  var wasOpen=grp.classList.contains('open');
  var all=document.querySelectorAll('#focusStart .focus-group');
  for(var i=0;i<all.length;i++){
    all[i].classList.remove('open');
    var h=all[i].querySelector('.fg-head');
    if(h){h.setAttribute('aria-expanded','false');var ca=h.querySelector('.fg-caret');if(ca)ca.textContent='+';}
  }
  if(!wasOpen){
    grp.classList.add('open');
    btn.setAttribute('aria-expanded','true');
    var care=btn.querySelector('.fg-caret');if(care)care.textContent='–';
  }
}
/* 事件委托：保证「轻松上手」板块卡片在移动端/触摸下也能稳定跳转（不依赖内联 onclick） */
(function(){
  function focusGo(e){
    var t=(e.target&&e.target.closest)?e.target.closest('.focus-board[data-go]'):null;
    if(!t)return;
    /* 板块已自带内联 onclick 直达 switchView（与侧边栏一致，最稳）；这里只当没有内联处理时才兜底，
       避免同一点击触发两次跳转造成扰动。 */
    if(t.onclick)return;
    var v=t.getAttribute('data-go');if(!v)return;
    if(e.type==='keydown'){if(e.key!=='Enter'&&e.key!==' '){return;}e.preventDefault();}
    else{e.preventDefault();}
    try{if(window.switchView)window.switchView(v);}catch(err){}
  }
  document.addEventListener('click',focusGo);
  document.addEventListener('keydown',focusGo);
})();
/* ═══════ 首页「轻松上手」 ═══════ */
function init(){


  var d=new Date();
  var _td=document.getElementById('todayDate');if(_td)_td.textContent=d.getFullYear()+'年'+(d.getMonth()+1)+'月'+d.getDate()+'日 星期'+'日一二三四五六'[d.getDay()];
  var q=QUOTES[(Math.floor(Date.now()/86400000))%QUOTES.length];
  var _dq=document.getElementById('dailyQuote');if(_dq)_dq.textContent='“'+q+'”';

  
    
    
  
  /* 今日知识：按日期统一初始化，保持每天一致 */
  var daySeed=Math.floor(Date.now()/86400000);
  _knowledgeIdx=pickKnowledgeIndices(function(len){return daySeed%len;});
  switchKnowledge('health');

  var fin=FINANCES[daySeed%FINANCES.length];
  document.getElementById('financeTip').innerHTML='<strong>'+fin.t+'</strong> — '+fin.d;

  var shop=SHOPS[Math.floor(Math.random()*SHOPS.length)];
  var ds=document.getElementById('dailyShop');if(ds)ds.innerHTML='<strong>'+shop.t+'</strong><br>'+shop.d;

  renderAll();
  applyExpiry();
  applyPrepareAutoClean();
  renderPodcasts2();
  renderPitfall();
  renderDrivingQ();
  renderInspire();
  renderDecisions();
  renderGrateful();
  renderGoal100();
  initDefaultCountdowns();
  mobileHint();
  loadTodayGoal();
  renderMood();
  renderBlessInputs();
  renderBlessMood();
  renderBlessStreak();
  renderSoundBtns();
  renderNotes();
  nextSoftLine();
  renderFinanceKnowledge();
  renderTpl();
  renderDailyQuoteCard();
  /* 冷启动一律回到首页：闪屏结束后固定展示「今日概览」，不再恢复上次所在板块与滚动位置 */
  
  /* 返回轻提示：每天一句不重复的暖心鼓励，等闪屏结束(约3.4s)后直接渲染一次、停留约4.2秒可看清，
     不再经 flash 双重渲染、也不被启动屏遮挡 */
  try{
    if(localStorage.getItem('pp_last_view')){
      setTimeout(function(){try{
        var GREETS=[
          '回来啦——今天想在哪个板块安放一点新东西？',
          '欢迎回来，愿你今天稳稳往前挪一小步。',
          '匣子已经为你打开，想记点什么，随时开始。',
          '不必逼自己一天完成所有事，今天推进最重要的一件就好。',
          '把心里那件盘旋的事，先写进匣子吧。',
          '每一天都是新的留白，正等着你落笔。',
          '慢一点没关系，别停下来就好。',
          '今天的你，也值得为自己留下一行字。',
          '说点什么、记点什么，都由你来做主。',
          '愿今天的你，比昨天更清楚自己要去哪里。'
        ];
        var _gi=Math.floor(Date.now()/86400000)%GREETS.length;
        var _mf=document.getElementById('flash');
        if(_mf){
          _mf.textContent=GREETS[_gi];
          _mf.classList.remove('is-ok','is-warn','is-err');
          _mf.classList.add('show');
          if(_mf.__ppT)clearTimeout(_mf.__ppT);
          _mf.__ppT=setTimeout(function(){_mf.classList.remove('show');},4200);
        }else if(typeof flash==='function'){ flash(GREETS[_gi]); }
      }catch(e){}},3500);
    }
  }catch(e){}
  
  /* 关注方向引导：还原用户上次选的推荐模块 */
  try{renderFocus();}catch(e){}
  /* 支出记账本 */
  try{renderExpenses();}catch(e){}
}
/* init() 已移至脚本块末尾：必须等 BOOKS_LIB / BIGQUOTES / renderPodcasts2 / renderPitfall 等
   全部数据数组与函数定义完毕后再执行，否则 renderShelf/renderBigQuote 会因引用未赋值变量而抛错，
   导致书架金句、今日金句、避坑提醒、播客笔记全部空白。 */

/* ═══════ 增量板块：暑假作息表 + 打卡日历 + 番茄钟 + 灵感看板 + 书架金句 + 设置 ═══════ */

/* 暑假版今日时间块作息表（来源：Yolo 知识库精华） */
var TIME_BLOCKS=[
  {t:'06:30',n:'起床+喝水+拉伸',tag:'生活',color:'#4A3427'},
  {t:'07:00',n:'早餐+听新闻/播客',tag:'生活',color:'#4A3427'},
  {t:'07:40',n:'英语晨读/单词背诵',tag:'学习',color:'#6E4F37'},
  {t:'08:30',n:'第一节专业课预习+笔记',tag:'学习',color:'#6E4F37'},
  {t:'10:00',n:'课间休息+远眺护眼',tag:'休息',color:'#6B7267'},
  {t:'10:20',n:'第二节专业课/公共课',tag:'学习',color:'#6E4F37'},
  {t:'12:00',n:'午餐（七分饱）',tag:'生活',color:'#4A3427'},
  {t:'12:40',n:'午休/冥想20分钟',tag:'休息',color:'#6B7267'},
  {t:'14:00',n:'下午实验/作业/自习',tag:'学习',color:'#6E4F37'},
  {t:'16:00',n:'社团活动/小组讨论',tag:'社交',color:'#A9803F'},
  {t:'17:30',n:'运动健身（跑步/瑜伽/球类）',tag:'运动',color:'#B07F63'},
  {t:'18:30',n:'晚餐+洗澡+洗衣',tag:'生活',color:'#4A3427'},
  {t:'19:30',n:'晚自习/深度阅读/论文写作',tag:'学习',color:'#6E4F37'},
  {t:'21:00',n:'技能充电（编程/外语/考证）',tag:'成长',color:'#8A6D48'},
  {t:'21:45',n:'放松时间（音乐/聊天/追剧）',tag:'休闲',color:'#B0855A'},
  {t:'22:30',n:'今日复盘+明日计划+感恩日记',tag:'复盘',color:'#C9A24E'},
  {t:'23:00',n:'放下手机·准备入睡',tag:'睡眠',color:'#6B7267'}
];
function getTimeBlocks(){
  var d=DB.get('timeBlocks',null);
  /* 默认留白：一上来就强行排满一张"作息表"反而让人有压力，绝大多数人做不到。
     仅当用户自己主动添加时段时才展示。旧版预置的 20 段作息自动不再预填。 */
  if(!d||!d.length)return [];
  /* 迁移：若本地仍是旧版预置作息，判定为"未自定义"，改为留白 */
  if(d.length===TIME_BLOCKS.length&&d.every(function(b,i){return b&&TIME_BLOCKS[i]&&b.t===TIME_BLOCKS[i].t&&b.n===TIME_BLOCKS[i].n;})){
    saveTimeBlocks([]);
    return [];
  }
  return d;
}
function saveTimeBlocks(a){DB.set('timeBlocks',a);}
function renderTimeBlocks(){
  var box=document.getElementById('timeBlockGrid');if(!box)return;
  var list=getTimeBlocks();
  if(!list.length){
    box.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:18px 10px;color:var(--hint);font-size:13px;background:var(--bg);border:1px dashed var(--border);border-radius:10px">今天还没安排时段。想到 1-2 件对你重要的事，就在下方添加，别一次排满。</div>';
    return;
  }
  box.innerHTML=list.map(function(b,i){
    return '<div style="border:1px solid var(--border);border-radius:8px;padding:10px;background:var(--card);position:relative;min-width:0">'+
      '<button class="btn btn-sm" style="position:absolute;top:5px;right:5px;font-size:11px;padding:1px 5px;color:var(--hint);background:transparent;border:none;cursor:pointer" onclick="delTimeBlock('+i+')">×</button>'+
      '<div contenteditable="true" data-tb="t" data-tb-idx="'+i+'" onblur="saveTimeBlock('+i+')" style="font-size:11px;color:var(--hint);font-weight:600;cursor:text;outline:none;padding-right:14px">'+escapeHtml(b.t)+'</div>'+
      '<div contenteditable="true" data-tb="n" data-tb-idx="'+i+'" onblur="saveTimeBlock('+i+')" style="font-size:12px;color:var(--text);margin-top:4px;line-height:1.4;cursor:text;outline:none">'+escapeHtml(b.n)+'</div>'+
      '<span contenteditable="true" data-tb="tag" data-tb-idx="'+i+'" onblur="saveTimeBlock('+i+')" style="display:inline-block;background:transparent;color:var(--hint);border:1px dashed var(--border);margin-top:6px;font-size:10px;padding:2px 8px;border-radius:10px;cursor:text;outline:none">'+escapeHtml(b.tag)+'</span>'+
    '</div>';
  }).join('');
}
function saveTimeBlock(i){
  var list=getTimeBlocks();if(!list[i])return;
  var box=document.getElementById('timeBlockGrid');if(!box)return;
  box.querySelectorAll('[data-tb-idx="'+i+'"]').forEach(function(el){
    var k=el.getAttribute('data-tb');var v=el.textContent.trim();
    if(k==='t'&&!v)return;
    list[i][k]=v;
  });
  saveTimeBlocks(list);
}
function delTimeBlock(i){
  uiConfirm('要移除这个时间段吗？',function(){
    var list=getTimeBlocks();list.splice(i,1);saveTimeBlocks(list);renderTimeBlocks();
  });
}
function addTimeBlock(){
  var t=document.getElementById('tbTime'),n=document.getElementById('tbTask'),tag=document.getElementById('tbTag');
  if(!t||!n)return;
  if(!t.value.trim()||!n.value.trim()){uiAlert('请填写时间和任务内容');return;}
  var list=getTimeBlocks();
  list.push({t:t.value.trim(),n:n.value.trim(),tag:(tag&&tag.value.trim())||'自定义',color:'#7C5B38'});
  saveTimeBlocks(list);
  t.value='';n.value='';if(tag)tag.value='';
  renderTimeBlocks();
}

/* 打卡近7天日历 + 本周完成率 */
var backfillKey=null;
function renderCheckinCalendar(){
  var box=document.getElementById('checkinCalendar');if(!box)return;
  var c=getCheckins();var today=new Date();
  var defs=getCheckinDefs();
  var days=[];
  for(var i=6;i>=0;i--){
    var d=new Date(today);d.setDate(d.getDate()-i);
    var key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    var dc=c[key]||{};
    var done=Object.keys(dc).filter(function(k){return dc[k]}).length;
    var isToday=i===0;
    days.push({key:key,done:done,isToday:isToday,wd:'日一二三四五六'[d.getDay()],day:d.getDate()});
  }
  /* 回填日期滑出7天窗口则自动清除选择 */
  if(backfillKey!==null&&!days.some(function(dd){return dd.key===backfillKey}))backfillKey=null;
  box.innerHTML=days.map(function(d){
    var pct=defs.length?d.done/defs.length:0;
    var sel=d.key===backfillKey;
    var bg=d.isToday?'var(--primary)':sel?'rgba(122,115,99,.16)':'var(--bg)';
    var color=d.isToday?'var(--cal-on,#fff)':'var(--text)';
    var dotColor=pct===1?'var(--teal)':pct>=0.5?'var(--primary-mid)':'var(--border-strong)';
    var on=d.isToday?'':' style="cursor:pointer" onclick="setBackfill(\''+d.key+'\')" title="点击可补回那天的打卡"';
    return '<div'+(d.isToday?' class="cal-today"':'')+' style="flex:1;min-width:36px;text-align:center;padding:6px 4px;border-radius:6px;background:'+bg+';border:1px solid '+(d.isToday?'var(--primary)':sel?'var(--teal)':'var(--border)')+'"'+on+'>'+
      '<div style="font-size:10px;color:'+(d.isToday?'var(--cal-on,#fff)':'var(--hint)')+'">'+d.wd+'</div>'+
      '<div style="font-size:13px;color:'+color+';font-weight:600;margin:2px 0">'+d.day+'</div>'+
      '<div style="width:8px;height:8px;border-radius:50%;background:'+dotColor+';margin:0 auto"></div>'+
      '<div style="font-size:9px;color:'+(d.isToday?'var(--cal-on,#fff)':'var(--hint)')+';margin-top:2px">'+d.done+'/'+defs.length+'</div>'+
    '</div>';
  }).join('');
  /* 补卡面板 */
  if(backfillKey!==null){
    var dc2=c[backfillKey]||{};
    var p=backfillKey.split('-');
    var label=(p.length===3)?p[1]+'月'+p[2]+'日':'该日';
    var chips=defs.map(function(it){
      var on=dc2[it.id]===true;
      return '<span onclick="toggleBackfill(\''+it.id+'\')" style="cursor:pointer;user-select:none;display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:14px;font-size:12.5px;border:1px solid '+(on?'var(--teal)':'var(--border)')+';background:'+(on?'rgba(122,115,99,.1)':'var(--bg)')+';color:var(--text)">'+(on?'✓':'☐')+escapeHtml(it.n)+'</span>';
    }).join('');
    box.innerHTML+='<div style="margin-top:12px;padding:12px;border-radius:10px;background:linear-gradient(135deg,#EFE8D8,#F1EBDD);border:1px solid #E2D8C4">'+
      '<div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px">'+
        '<b style="font-size:13px;color:var(--primary)">补卡 · '+label+'</b>'+
        '<span style="font-size:11.5px;color:var(--muted)">点一下即勾/取消该项</span>'+
      '</div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:6px">'+chips+'</div>'+
      '<button class="btn btn-sm" style="margin-top:10px;color:var(--hint)" onclick="setBackfill(null)">收起补卡</button>'+
    '</div>';
  }
  /* 本周完成率 */
  var total=0,done=0;
  days.forEach(function(d){var dc=c[d.key]||{};total+=defs.length;done+=Object.keys(dc).filter(function(k){return dc[k]}).length;});
  var bar=document.getElementById('weekProgress');
  var text=document.getElementById('weekProgressText');
  if(bar)bar.style.width=(total>0?Math.round(done/total*100):0)+'%';
  if(text)text.textContent='本周打卡 '+done+'/'+total+' · 完成率 '+(total>0?Math.round(done/total*100):0)+'%'+' · 点过去某天可补卡';
}
function setBackfill(key){backfillKey=key;renderCheckinCalendar();}
function toggleBackfill(k){
  if(!backfillKey)return;
  var c=getCheckins();if(!c[backfillKey])c[backfillKey]={};
  c[backfillKey][k]=!c[backfillKey][k];
  saveCheckins(c);renderCheckinCalendar();refreshHomeStats();
}

/* 番茄钟 */
var pomoTimer=null,pomoRemain=25*60,pomoMode_=25,pomoRunning=false;
/* 番茄钟 → 习惯联动：把"关联习惯"下拉与当前习惯列表同步 */
function refreshPomoHabitOpts(){
  var sel=document.getElementById('pomoHabitSel');if(!sel)return;
  var cur=sel.value;
  var habits=getHabits();
  sel.innerHTML='<option value="">关联习惯（可选）· 完成后 +1 专注</option>'+habits.map(function(h,i){
    return '<option value="'+i+'">'+escapeHtml(h.name)+(((h.focus||0)>0)?('（已专注 '+(h.focus||0)+' 次）'):'')+'</option>';
  }).join('');
  if(cur!==''&&habits[Number(cur)])sel.value=cur;
}
function renderPomo(){
  var el=document.getElementById('pomoBig');if(!el)return;
  var m=Math.floor(pomoRemain/60),s=pomoRemain%60;
  el.textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  var c=DB.get('pomoCount',{});var today=todayKey();
  var n=c[today]||0;
  var pc=document.getElementById('pomoCount');if(pc)pc.textContent=n;
  /* 中断原因饼图 */
  var br=DB.get('pomoBreaks',{});var sum=0;
  Object.keys(br).forEach(function(k){sum+=br[k]||0});
  var svg=document.getElementById('pomoChart');if(!svg)return;
  if(sum===0){svg.innerHTML='<text x="160" y="90" text-anchor="middle" fill="#6B7267" font-size="12">暂无中断记录 · 开始第一个番茄</text>';var bl0=document.getElementById('pomoBreaks');if(bl0)bl0.innerHTML='';return}
  var colors={手机:'#B07F63',消息:'#7C5B38',困倦:'#6E4F37',被打扰:'#C9A24E',走神:'#A9803F',吃饭:'#6B7267'};
  var cx=100,cy=90,r=70,startAngle=-Math.PI/2;
  var paths='';
  Object.keys(br).forEach(function(k){
    var v=br[k]||0;if(v===0)return;
    var ang=(v/sum)*Math.PI*2;
    var x1=cx+r*Math.cos(startAngle),y1=cy+r*Math.sin(startAngle);
    var x2=cx+r*Math.cos(startAngle+ang),y2=cy+r*Math.sin(startAngle+ang);
    var large=ang>Math.PI?1:0;
    paths+='<path d="M'+cx+','+cy+' L'+x1+','+y1+' A'+r+','+r+' 0 '+large+' 1 '+x2+','+y2+' Z" fill="'+(colors[k]||'#888')+'" stroke="#fff" stroke-width="2"/>';
    startAngle+=ang;
  });
  paths+='<circle cx="'+cx+'" cy="'+cy+'" r="30" fill="#fff"/>';
  paths+='<text x="'+cx+'" y="'+(cy-4)+'" text-anchor="middle" fill="#4A3427" font-size="20" font-weight="600">'+sum+'</text>';
  paths+='<text x="'+cx+'" y="'+(cy+12)+'" text-anchor="middle" fill="#6B7267" font-size="10">次中断</text>';
  /* 图例 */
  var lx=200,ly=20;
  Object.keys(br).forEach(function(k){
    var v=br[k]||0;if(v===0)return;
    paths+='<rect x="'+lx+'" y="'+ly+'" width="10" height="10" fill="'+(colors[k]||'#888')+'"/>';
    paths+='<text x="'+(lx+16)+'" y="'+(ly+9)+'" fill="#1A1A1A" font-size="11">'+k+' '+v+'次</text>';
    ly+=18;
  });
  svg.innerHTML=paths;
  var bl=document.getElementById('pomoBreaks');
  if(bl){
    var html='共记录 <strong>'+sum+'</strong> 次中断 · 今日番茄数 '+(c[today]||0);
    var bk=Object.keys(br).filter(function(k){return (br[k]||0)>0;});
    if(bk.length){
      html+='<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px">'+bk.map(function(k){
        return '<span style="display:inline-flex;align-items:center;gap:4px;background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:2px 8px;font-size:12px">'+escapeHtml(k)+' ×'+br[k]+' <span style="cursor:pointer;color:var(--coral);font-weight:700" title="删除该条记录（仅误点时使用）" onclick="pomoDelBreak(\''+k.replace(/'/g,"\\'")+'\')">✕</span></span>';
      }).join('')+'</div>';
    }
    bl.innerHTML=html;
  }
}
function pomoToggle(){
  if(pomoRunning){
    clearInterval(pomoTimer);pomoRunning=false;
    var btn=document.querySelector('#view-timer .btn-primary');if(btn)btn.textContent='继续';
    var ov=document.getElementById('pomoFullscreen');if(ov)ov.style.display='none';
  }else{
    pomoRunning=true;
    var btn=document.querySelector('#view-timer .btn-primary');if(btn)btn.textContent='暂停';
    /* 全屏专注覆盖层 */
    var ov=document.getElementById('pomoFullscreen');
    if(ov){
      ov.style.display='flex';
      var taskName=document.getElementById('pomoTaskInput')?document.getElementById('pomoTaskInput').value.trim():'';
      var tn=document.getElementById('pomoFsTask');if(tn)tn.textContent=taskName||'深度专注中';
    }
    pomoTimer=setInterval(function(){
      pomoRemain--;
      if(pomoRemain<=0){
        clearInterval(pomoTimer);pomoRunning=false;
        var c=DB.get('pomoCount',{});var today=todayKey();
        c[today]=(c[today]||0)+1;DB.set('pomoCount',c);
        /* 习惯联动：若关联了某个习惯，则其「专注次数」+1 */
        var sel=document.getElementById('pomoHabitSel');
        if(sel&&sel.value!==''){
          var hi=Number(sel.value),habits=getHabits();
          if(habits[hi]){habits[hi].focus=(habits[hi].focus||0)+1;saveHabits(habits);renderHabits();refreshPomoHabitOpts();}
        }
        var ov=document.getElementById('pomoFullscreen');if(ov)ov.style.display='none';
        uiAlert('番茄完成！休息5分钟，站起来走走');
        pomoRemain=pomoMode_*60;
        var b=document.querySelector('#view-timer .btn-primary');if(b)b.textContent='开始专注';
        renderPomo();refreshHomeStats();
      }else{
        renderPomo();
        /* 同步全屏倒计时 */
        var fs=document.getElementById('pomoFsTime');if(fs){
          var m=Math.floor(pomoRemain/60),s=pomoRemain%60;
          fs.textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;
        }
      }
    },1000);
  }
}
function pomoReset(){
  /* 重置后 → 按钮显示"开始专注"（不是"继续"） */
  clearInterval(pomoTimer);pomoRunning=false;pomoRemain=pomoMode_*60;
  var btn=document.querySelector('#view-timer .btn-primary');if(btn)btn.textContent='开始专注';
  renderPomo();
}
function pomoMode(m){clearInterval(pomoTimer);pomoRunning=false;pomoMode_=m;pomoRemain=m*60;renderPomo();}
function pomoBreak(reason){
  var br=DB.get('pomoBreaks',{});
  br[reason]=(br[reason]||0)+1;
  DB.set('pomoBreaks',br);
  renderPomo();
  flash('已记录中断：'+reason);
}
function pomoBreakCustom(){
  var inp=document.getElementById('pomoBreakCustom');if(!inp)return;
  var v=inp.value.trim();if(!v){flash('请先输入中断原因');return;}
  pomoBreak(v);inp.value='';
}
function pomoDelBreak(reason){
  var br=DB.get('pomoBreaks',{});
  if(!br[reason]){renderPomo();return;}
  delete br[reason];
  // 顺手清理所有值为 0 的脏键，确保彻底
  Object.keys(br).forEach(function(k){ if(!br[k]||br[k]<=0) delete br[k]; });
  DB.set('pomoBreaks',br);
  renderPomo();
  flash('已移除「'+reason+'」中断记录');
}
function pomoClearBreaks(){
  DB.set('pomoBreaks',{});
  renderPomo();
  flash('已清空全部中断记录');
}

/* 灵感收集器 */
function getInspire(){return DB.get('inspire',[])}
function renderInspire(){
  var list=document.getElementById('inspireList');if(!list)return;
  var is=getInspire();
  if(!is.length){list.innerHTML='<p style="color:var(--hint);font-size:13px">还没有灵感 · 随时记下脑子里冒出的想法</p>';return}
  list.innerHTML=is.map(function(it,i){
    return '<div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px">'+
      '<div style="font-size:13px;color:var(--text);margin-bottom:4px">'+it.text+'</div>'+
      '<div style="display:flex;justify-content:space-between;align-items:center">'+
        '<span style="font-size:10px;color:var(--hint)">'+it.date+'</span>'+
        '<button class="btn btn-sm" style="font-size:10px;padding:2px 8px" onclick="delInspire('+i+')">删</button>'+
      '</div></div>';
  }).join('');
}
function addInspire(){
  var inp=document.getElementById('inspireInput');var v=inp.value.trim();
  if(!v)return;
  var is=getInspire();is.unshift({text:v,date:todayKey()+' '+new Date().toTimeString().slice(0,5)});
  DB.set('inspire',is);inp.value='';renderInspire();flash('已记录灵感');
}
function delInspire(i){var is=getInspire();is.splice(i,1);DB.set('inspire',is);renderInspire()}

/* 决策日记 */
function getDecisions(){return DB.get('decisions',[])}
function renderDecisions(){
  var box=document.getElementById('decList');if(!box)return;
  var ds=getDecisions();
  if(!ds.length){box.innerHTML='<p style="color:var(--hint);font-size:13px">还没有决策记录 · 每做一次犹豫的决策都写下来</p>';return}
  box.innerHTML=ds.map(function(d,i){
    return '<div style="background:var(--bg);border-radius:8px;padding:12px;margin-bottom:8px">'+
      '<div style="font-weight:600;color:var(--primary);margin-bottom:6px">'+d.title+' <span style="font-size:10px;color:var(--hint);font-weight:400">'+d.date+'</span></div>'+
      '<div class="grid grid-2" style="gap:8px">'+
        '<div style="font-size:12px;color:var(--teal)"><strong>利：</strong>'+d.pro+'</div>'+
        '<div style="font-size:12px;color:var(--coral)"><strong>弊：</strong>'+d.con+'</div>'+
      '</div>'+
      '<button class="btn btn-sm" style="margin-top:6px;font-size:10px;padding:2px 8px" onclick="delDecision('+i+')">删除</button>'+
    '</div>';
  }).join('');
}
function addDecision(){
  var t=document.getElementById('decTitle');var p=document.getElementById('decPro');var c=document.getElementById('decCon');
  if(!t.value.trim())return;
  var ds=getDecisions();ds.unshift({title:t.value.trim(),pro:p.value.trim(),con:c.value.trim(),date:todayKey()});
  DB.set('decisions',ds);t.value=p.value=c.value='';renderDecisions();flash('已记录决策');
}
function delDecision(i){var ds=getDecisions();ds.splice(i,1);DB.set('decisions',ds);renderDecisions()}

/* 感恩日记 */
function getGrateful(){return DB.get('grateful',[])}
function renderGrateful(){
  var box=document.getElementById('gratefulList');if(!box)return;
  var gs=getGrateful();
  if(!gs.length){box.innerHTML='<p style="color:var(--hint);font-size:13px">还没有记录 · 每天写3件感恩的事，6周后幸福感显著提升</p>';return}
  box.innerHTML=gs.slice(0,7).map(function(g,i){
    return '<div style="background:var(--bg);border-radius:6px;padding:8px 10px;margin-bottom:6px;font-size:12px">'+
      '<div style="color:var(--hint);font-size:10px;margin-bottom:2px">'+g.date+'</div>'+
      '<div style="color:var(--text);white-space:pre-wrap">'+g.text+'</div>'+
    '</div>';
  }).join('');
}
function saveGrateful(){
  var inp=document.getElementById('gratefulInput');var v=inp.value.trim();
  if(!v)return;
  var gs=getGrateful();gs.unshift({text:v,date:todayKey()});
  DB.set('grateful',gs);inp.value='';renderGrateful();flash('感恩已存');
}

/* 人生100个目标 */
function getGoal100(){return DB.get('goal100',[])}
function renderGoal100(){
  var box=document.getElementById('goal100List');if(!box)return;
  var gs=getGoal100();
  if(!gs.length){box.innerHTML='<p style="color:var(--hint);font-size:13px">还没有目标 · 把"想做的事"具体写下来，写下的目标实现率高42%</p>';return}
  var catColors={学业:'#6E4F37',职业:'#4A3427',体验:'#B07F63',财富:'#7C5B38',健康:'#6E4F37',其他:'#6B7267'};
  box.innerHTML=gs.map(function(g,i){
    return '<div style="display:flex;align-items:center;gap:8px;background:var(--bg);padding:8px 10px;border-radius:6px">'+
      '<span class="tag" style="background:'+(catColors[g.cat]||'#888')+'10;color:'+(catColors[g.cat]||'#888')+';flex-shrink:0">'+g.cat+'</span>'+
      '<span style="font-size:13px;flex:1">'+g.text+'</span>'+
      '<button class="btn btn-sm" style="font-size:10px;padding:2px 8px" onclick="toggleGoal100('+i+')">'+(g.done?'已完成':'待完成')+'</button>'+
      '<button class="btn btn-sm" style="font-size:10px;padding:2px 8px" onclick="delGoal100('+i+')">删</button>'+
    '</div>';
  }).join('');
}
function addGoal100(){
  var inp=document.getElementById('goal100Input');var cat=document.getElementById('goal100Cat');
  if(!inp.value.trim())return;
  var gs=getGoal100();gs.push({text:inp.value.trim(),cat:cat.value,done:false});
  DB.set('goal100',gs);inp.value='';renderGoal100();flash('目标已加入');
}
function toggleGoal100(i){var gs=getGoal100();gs[i].done=!gs[i].done;DB.set('goal100',gs);renderGoal100()}
function delGoal100(i){var gs=getGoal100();gs.splice(i,1);DB.set('goal100',gs);renderGoal100()}

/* 书架 + 今日金句（前8本为公版/经典，点进去直接读全文） */
var BOOKS_LIB=[
  {t:'《论语》',a:'孔子',cat:'国学',link:'https://www.gushiwen.cn/guwen/lunyu.aspx',desc:'儒家经典 · 二十篇全文 · 古诗文网',quotes:['学而不思则罔，思而不学则殆','己所不欲，勿施于人']},
  {t:'《道德经》',a:'老子',cat:'国学',link:'https://www.daodejing.org/',desc:'道家根本经典 · 81章全文 · 逐章译文',quotes:['上善若水，水善利万物而不争','千里之行，始于足下']},
