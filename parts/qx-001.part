[data-theme="dark"] tr[style*="background:#EFE8D8"]:not([data-pp-tip]):not([data-pp-warn]):not([data-pp-ok]):not([data-pp-note]),tr[style*="background:#EFE8D8"] td,tr[style*="background:#EFE8D8"] th{background:var(--primary-light)!important;color:var(--text)!important}
/* 夜间：输入框聚焦不再转浅色白底，保持深色 */
[data-theme="dark"] input:focus,[data-theme="dark"] textarea:focus,[data-theme="dark"] select:focus{background:var(--card)!important;border-color:var(--primary-mid)!important}
/* 夜间：引导横幅与浅色渐变卡片（gradient 内白底不受上面的 background:#F 兜底覆盖）转暗 */
[data-theme="dark"] #guideBanner{background:linear-gradient(120deg,#211D17,#2B2419)!important;border-color:var(--border)!important;border-left-color:var(--primary-mid)!important;color:var(--text)!important}
[data-theme="dark"] .card[style*="FFF8EF"]{background:linear-gradient(135deg,#2b2517,#272019)!important;border-color:#6E5A2C!important}
/* 夜间：首页「今日目标」柔卡（data-goalcard）统一转暗，保持浅改后的优雅观感 */
[data-theme="dark"] [data-goalcard]{background:linear-gradient(135deg,#2B2517,#272019 60%,#221C12)!important;border-color:#6E5A2C!important;border-left-color:var(--primary-mid)!important}
[data-theme="dark"] [data-goalcard] div,[data-theme="dark"] [data-goalcard] b{color:var(--text)!important}
/* 夜间：轻松上手方向卡统一转暗，消除刺眼白卡 */
[data-theme="dark"] #focusCard .card{background:var(--card)!important;border-color:var(--border)!important}
[data-theme="dark"] #focusCard .card div{color:var(--text)!important}
[data-theme="dark"] #focusCard .card div[style*="font-size:20px"]{color:inherit!important}
[data-theme="dark"] .card[style*="gradient(135deg,#EFE8D8"]{background:linear-gradient(135deg,#2B2419,#2B2419)!important;border-color:var(--border)!important}
[data-theme="dark"] .card.daily-card,[data-theme="dark"] div[style*="background:#FFFFFF"][style*="border-left:4px"]:not([data-pp-tip]):not([data-pp-warn]):not([data-pp-ok]):not([data-pp-note]){background:var(--card)!important;color:var(--text)!important}[data-theme="dark"] div[style*="background:#EFE8D8"]:not([data-pp-tip]):not([data-pp-warn]):not([data-pp-ok]):not([data-pp-note]){background:var(--card)!important;color:var(--text)!important}[data-theme="dark"] div[style*="background:#EFE8D8"]:not([data-pp-tip]):not([data-pp-warn]):not([data-pp-ok]):not([data-pp-note]){background:var(--card)!important;color:var(--text)!important}
/* 夜间：漏网的硬编码彩色文字提亮（黛青 #7C5B38、赭金 #8A6A2D） */
[data-theme="dark"] [style*="color:#7C5B38"],[data-theme="dark"] [style*="color: #7C5B38"]{color:var(--coral,#C2A15E)!important}
[data-theme="dark"] [style*="color:#8A6A2D"],[data-theme="dark"] [style*="color: #8A6A2D"]{color:#C9B37A!important}
/* 夜间：浅绿色系内联背景(#F1EBDD 等)与免费横幅(rgb 近白渐变)转暗，消除刺眼浅底 */
[data-theme="dark"] #freeBanner{background:linear-gradient(90deg,#2B2419,#33291F)!important;border-color:var(--border)!important;color:#E2D8C4!important}
[data-theme="dark"] #freeBanner strong{color:#fff!important}
[data-theme="dark"] #mobileSidebarHint{background:var(--card)!important;border-color:var(--border)!important;color:var(--text)!important}
/* 夜间：产品导览对比板块（CSS 类背景不受内联兜底覆盖）统一转暗，消除亮块 */
[data-theme="dark"] .pano-cp.no{background:#26201A!important;border-color:#3A3026!important;box-shadow:none!important}
[data-theme="dark"] .pano-cp.no h4{color:#9CC0BA!important}
[data-theme="dark"] .pano-cp.no ul{color:#A99B8A!important}
[data-theme="dark"] .pano-cp.yes{background:linear-gradient(150deg,#2B2419,#272019 45%,#241F17)!important;border-color:#594C38!important;box-shadow:none!important;color:#EDE3D2!important}
[data-theme="dark"] .pano-cp.yes ul{color:#CDBFAB!important}
[data-theme="dark"] .pano-cp .tag,[data-theme="dark"] .pano-cp.yes .tag{color:#C2A15E!important}
[data-theme="dark"] .pano-cp.no .tag{color:#A0927E!important}
[data-theme="dark"] .pano-cp li::before{background:#C9A45E!important}
[data-theme="dark"] .pano-cp.yes li::before{background:#B08A44!important}
/* 夜间：开学准备进度卡兜底转暗 */
[data-theme="dark"] #prepareCard{background:linear-gradient(135deg,#2B2419,#2B2419)!important;border-color:#3A3026!important}
/* 夜间：欢迎语/闪屏浮层转暗，避免白块刺眼 */
[data-theme="dark"] #flash{background:rgba(42,35,24,.94)!important;color:#E8DEC9!important;border-color:#594C38!important}
