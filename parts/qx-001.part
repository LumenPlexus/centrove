:not([data-pp-warn]):not([data-pp-ok]):not([data-pp-note]){color:var(--text)!important}
/* ═══ 栖匣 · 全景导览（pano）固定日间模式 ═══
   产品导览是品牌介绍长页，始终锁定「暖木匣纸」日间配色，
   不跟随用户切换的日/夜主题，保证图文清晰、品牌色准确一致。 */
.pano,.pano *{color-scheme:light}


/* ── 底部导航栏（移动端） ── */
.bottom-nav{display:none;position:fixed;bottom:0;left:0;right:0;z-index:19;
  background:var(--card);border-top:1px solid var(--border);
  padding-bottom:env(safe-area-inset-bottom,0px);
  justify-content:space-around;align-items:center;height:56px;
  box-shadow:0 -2px 8px rgba(0,0,0,.05);}
.bottom-nav-item{display:flex;flex-direction:column;align-items:center;gap:1px;flex:1;min-width:0;max-width:80px;
  padding:6px 12px 4px;border-radius:8px;cursor:pointer;transition:all .15s;
  color:var(--muted);font-size:10px;line-height:1.2;-webkit-tap-highlight-color:transparent;
  min-width:52px;text-align:center;flex:1;}
.bottom-nav-item svg{width:22px!important;height:22px!important;stroke-width:2;flex-shrink:0;display:block;}
.bottom-nav-item.active{color:var(--primary);font-weight:600;}
.bottom-nav-item:active{transform:scale(.92);}
@media(max-width:768px){
  .bottom-nav{display:flex!important;}
  .main{padding-bottom:calc(76px + env(safe-area-inset-bottom, 0px))!important;}
  .sidebar{padding-bottom:calc(84px + env(safe-area-inset-bottom, 0px))!important;}
  #sidebar{padding-bottom:calc(84px + env(safe-area-inset-bottom, 0px))!important;}
}

/* ── 顶部提示条：手机端显示（样式走内联，对齐 original 原版） ── */
.nav-guide-bar{display:none;align-items:center;gap:8px;cursor:pointer;position:relative;transition:opacity .3s;}
@media(max-width:768px){.nav-guide-bar{display:flex!important;}}

/* ── 隐私说明条 ── */
.privacy-note{margin:10px 16px 0;padding:8px 12px;border-radius:8px;
  background:rgba(74,58,40,.04);border:1px solid rgba(74,58,40,.12);
  font-size:11.5px;color:var(--muted);line-height:1.6;display:flex;align-items:flex-start;gap:6px;}
.privacy-note .pn-icon{flex-shrink:0;font-size:14px;margin-top:1px;}
.privacy-note a{color:var(--primary-mid);}

/* 色块样式已移除 — 恢复原始虚线标签 */

/* ── 新增板块通用样式 ── */
.view-new .card{transition:transform .15s,box-shadow .15s;}
.view-new .card:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg);}
.countdown-item{display:flex;flex-direction:column;padding:15px 16px;border-radius:14px;
  background:var(--bg);border:1px solid var(--border);margin-bottom:10px;transition:all .15s;}
.countdown-item:hover{background:var(--primary-light);transform:translateY(-1px);box-shadow:var(--shadow-sm,0 1px 4px rgba(0,0,0,.06));}
.cd-icon{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;font-size:16px;color:#fff;font-weight:700;margin-top:1px;}
.cd-namecon{flex:1;min-width:0;}
.cd-name{font-size:15px;font-weight:700;line-height:1.45;color:var(--text);
  word-break:break-word;overflow-wrap:break-word;white-space:normal;}  /* 标题完整显示，不截断 */
.cd-del{flex-shrink:0;background:none;border:none;color:var(--hint);cursor:pointer;font-size:18px;
  line-height:1;padding:2px 5px;margin:-2px -3px 0 0;border-radius:8px;}
.cd-del:hover{color:var(--coral);background:rgba(0,0,0,.04);}
.cd-count{display:flex;align-items:baseline;justify-content:center;gap:6px;margin:12px 0 0;padding:12px 14px;
  border-radius:12px;background:linear-gradient(135deg,rgba(110,79,55,.12),rgba(110,79,55,.04));
  color:var(--primary);box-shadow:inset 0 1px 0 rgba(255,255,255,.6);}
.cd-count .lbl{font-size:13px;font-weight:600;color:var(--primary);letter-spacing:1px;}
.cd-count .num{font-size:32px;font-weight:800;line-height:1;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
  font-variant-numeric:tabular-nums;letter-spacing:.5px;}
.cd-count .unit{font-size:13px;font-weight:600;color:var(--primary);letter-spacing:1px;}
.cd-count.today{background:linear-gradient(135deg,rgba(46,139,116,.14),rgba(46,139,116,.05));color:var(--teal);}
.cd-count.today .num{font-size:17px;font-weight:800;color:var(--teal);}
.cd-meta{display:flex;align-items:center;gap:10px;margin-top:11px;padding-top:10px;
  border-top:1px dashed var(--border);flex-wrap:wrap;}
.cd-date{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:var(--text);
  font-variant-numeric:tabular-nums;letter-spacing:.4px;white-space:nowrap;font-weight:600;}
.cd-date svg{flex-shrink:0;color:var(--primary)}
.cd-type{font-size:11px;line-height:1;color:var(--primary);background:var(--primary-light,#f2ede3);
  border-radius:20px;padding:4px 10px;flex-shrink:0;font-weight:600;letter-spacing:.3px;}
@media(max-width:380px){.countdown-item{padding:12px}.cd-icon{width:38px;height:38px}.cd-name{font-size:14px}.cd-count .num{font-size:27px}.cd-count.today .num{font-size:15px}}
.habit-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;
  background:var(--bg);border:1px solid var(--border);margin-bottom:6px;transition:all .15s;}
.habit-item.done{background:linear-gradient(135deg,rgba(122,115,99,.08),rgba(122,115,99,.04));
  border-color:var(--teal);}
.habit-check{width:22px;height:22px;border-radius:50%;border:2px solid var(--border-strong);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;transition:all .15s;}
.habit-check.checked{background:var(--teal);border-color:var(--teal);color:#fff;}
.habit-info{flex:1;min-width:0;}
.habit-name{font-size:13px;font-weight:500;color:var(--text);}
.habit-streak{font-size:10px;color:var(--hint);}
.achievement-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;
  border-radius:20px;font-size:12px;font-weight:500;margin:4px;border:1.5px solid;
  transition:transform .15s;cursor:default;}
.achievement-badge.unlocked{opacity:1;}
.achievement-badge.locked{opacity:.35;filter:grayscale(1);}
.achievement-badge:hover{transform:scale(1.05);}
.stat-card{text-align:center;padding:16px 12px;border-radius:12px;
  background:var(--bg);border:1px solid var(--border);}
.stat-num{font-size:28px;font-weight:700;color:var(--primary);line-height:1.2;}
.stat-label{font-size:11px;color:var(--hint);margin-top:4px;}
.stat-hint{font-size:10px;color:var(--muted);margin-top:2px;opacity:.85;}
.heat-grid{display:grid;gap:3px;user-select:none;grid-template-columns:repeat(7,1fr)}
.heat-cell{aspect-ratio:1;border-radius:3px;transition:background .3s,opacity .2s;background:var(--heat-0)}
.heat-cell.heat-0{background:var(--heat-0)}
.heat-cell.heat-1{background:var(--heat-1)}
.heat-cell.heat-2{background:var(--heat-2)}
.heat-cell.heat-3{background:var(--heat-3)}
.heat-cell.heat-4{background:var(--heat-4)}
.timeline-event{position:relative;padding-left:20px;padding-bottom:16px;
  border-left:2px solid var(--border);margin-left:8px;}
.timeline-event:last-child{border-left-color:transparent;}
.timeline-dot{position:absolute;left:-7px;top:4px;width:12px;height:12px;
  border-radius:50%;background:var(--primary);border:2px solid var(--card);}
.timeline-title{font-size:13px;font-weight:600;color:var(--text);}
.timeline-desc{font-size:12px;color:var(--muted);margin-top:3px;}
.timeline-time{font-size:10px;color:var(--hint);}

/* ── 深色模式切换按钮（太阳/月亮） ── */
.theme-toggle{display:flex;align-items:center;gap:4px;padding:7px 10px;border-radius:var(--radius-sm);
  cursor:pointer;color:var(--muted);border:1px solid var(--border);transition:background-color .12s,color .12s,transform .06s;font-size:0;user-select:none;touch-action:manipulation;}
.theme-toggle:active{transform:scale(.85);background:var(--primary-light);color:var(--primary);}
.theme-toggle:hover{background:var(--primary-light);color:var(--primary);}
.theme-toggle svg{width:16px!important;height:16px!important;min-width:16px!important;max-width:16px!important;min-height:16px!important;max-height:16px!important;display:inline-block!important;}

/* ── 入团入党星星图标（跟随文字色，不额外加色） ── */
.star-icon{color:var(--text);fill:currentColor;}
.star-icon-outline{color:var(--text);fill:none;stroke:currentColor;stroke-width:1.5;}

/* ── 导出PDF时标题栏绿色渐变增强 ── */
.pdf-green-header{background:linear-gradient(135deg,#6E4F37 0%,#4A3427 100%)!important;
  padding:18px 20px!important;border-radius:14px!important;color:#fff!important;
  margin-bottom:20px!important;box-shadow:0 4px 16px rgba(122,115,99,.18)!important;}

/* ── 手机端顶栏防溢出：标语完整显示，字号随宽度自动缩小，绝不截断 ── */
@media(max-width:480px){
  .topbar{overflow-x:auto;overflow-y:hidden;}
  .topbar .title{font-size:14px;white-space:nowrap;overflow:visible;text-overflow:clip;flex-shrink:0;gap:5px}
  .topbar .tb-badge{font-size:8px;padding:2px 5px;flex-shrink:1}
}

/* ── 平板适配 ── */
@media(min-width:769px) and (max-width:1024px){
  .sidebar{width:190px;}
  .topbar{left:190px;}
  .main{margin-left:190px;}
}


/* ═══════ v7 顶栏响应式：桌面端原版 / 手机端精简 ══════ */
/* 手机端(<768px)：分享/导出等图标也保留显示，顶栏放不下时横向滑动 */
@media(max-width:768px){
  .tb-share-btn,.tb-export-btn{display:flex!important;}
  .mobile-only-tool{display:flex!important;align-items:center;gap:4px;padding:4px 8px;border-radius:var(--radius-sm);
    color:var(--muted);border:1px solid var(--border);background:transparent;cursor:pointer;transition:all .15s;}
  .mobile-only-tool:hover{background:var(--primary-light);color:var(--primary);border-color:var(--primary-mid);}
  .mobile-only-tool svg{width:15px;height:15px;}
  /* 手机端隐藏quote文字节省空间 */
  .topbar .quote{display:none;}
  /* 手机端菜单项中的分享/导出显示 */
  .mobile-menu-item{display:flex!important;}
}
/* 桌面端(>=768px)：隐藏手机专用的夜间按钮 */
@media(min-width:769px){
  .mobile-only-tool{display:none!important;}
  .mobile-menu-item{display:none!important;}
}
/* 默认隐藏手机菜单项（未被media query覆盖时） */
.mobile-menu-item{display:none;}

</style>
<!-- ═══════ 栖匣｜木匣纸上 · 全局设计语言 ═══════
     概念：一方暖木匣，摊开在老纸桌上的时光。
     主色换木 · 背景换纸 · 点缀用老化黄铜 · 警示用陶土，一色到底不再彩虹。 -->
<style id="qixia-theme">
/* ═══════════════════════════════════════════════════════════════════
   栖匣 · 「暖木匣纸」设计工艺层（在权威配色之上做质感与版式）
   概念：一方暖胡桃木匣，摊开在陈年宣纸上的时光。
   气质关键词：木感 · 纸感 · 宋韵衬线 · 留白 · 老黄铜点睛 · 反模板。
   全文去「AI 模板感」：不用纯色平铺、不用胶囊圆角堆砌、不用荧光投影。
   ═══════════════════════════════════════════════════════════════════ */
:root{
  --font-display:"Noto Serif CJK SC","Source Han Serif SC","Songti SC","STSong","SimSun",serif;
  --font-body:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
}

/* ── 体与纸：正文无衬线清爽，行距舒展；背景铺陈年纸粒 + 极淡暖木晕 ── */
body{
  font-family:var(--font-body);
  line-height:1.72;
  background-color:var(--bg);
  background-image:
    radial-gradient(1180px 560px at 12% -6%, rgba(110,79,55,.065), transparent 60%),
    radial-gradient(1080px 540px at 104% 8%, rgba(160,128,60,.05), transparent 55%),
    radial-gradient(900px 520px at 50% 116%, rgba(176,97,62,.05), transparent 55%),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0.045'/></feComponentTransfer></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  background-size:auto,auto,auto,150px 150px;
  background-attachment:fixed;
}
[data-theme="dark"] body{
  background-image:
    radial-gradient(1180px 560px at 12% -6%, rgba(194,155,110,.07), transparent 60%),
    radial-gradient(1080px 540px at 104% 8%, rgba(160,128,60,.05), transparent 55%),
    radial-gradient(900px 520px at 50% 116%, rgba(210,136,98,.05), transparent 55%),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0.05'/></feComponentTransfer></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  background-size:auto,auto,auto,150px 150px;
  background-attachment:fixed;
}

/* ── 版头：编辑式「宋韵」——顶置实木引条 + 细水线收底，大字衬线 ── */
.page-head{border-bottom:none;padding:4px 0 16px;margin-bottom:26px}
.page-head::before{
  content:"";position:absolute;left:0;top:-2px;height:3px;width:60px;border-radius:3px;
  background:linear-gradient(90deg,var(--gold-strong),var(--gold) 65%,transparent);
}
.page-head::after{
  content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;
  background:linear-gradient(90deg,var(--border-strong),var(--border) 42%,transparent);
}
.page-head h1{font-family:var(--font-display);font-size:27px;letter-spacing:1.5px;color:var(--head-deep);font-weight:650;line-height:1.3}
.page-head p{font-size:13px;color:var(--muted);letter-spacing:.4px}

/* ── 板块导语：一段安放文字，竖木引条 + 纸底横纹 ── */
.section-intro{
  font-size:12.5px;line-height:1.85;color:var(--ink-soft);
  padding:12px 16px 11px;border-left:3px solid var(--gold);
  border-radius:0 12px 12px 0;margin-bottom:18px;
  background:linear-gradient(90deg,var(--accent-soft),transparent 92%);
  font-family:var(--font-display);
}

/* ── 卡片：米纸卡 + 顶部高光水线，克制圆角，暖影分层（去荧光） ── */
.card{
  background:linear-gradient(180deg,var(--card),var(--bg)); 
  border-radius:16px;border:1px solid var(--border);
  box-shadow:0 1px 2px rgba(74,58,40,.04),0 10px 24px -12px rgba(74,58,40,.22);
}
.card::before{
  content:"";position:absolute;left:18px;right:18px;top:0;height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);
}
.card h3{color:var(--head-deep)}
.card h4{color:var(--primary-mid)}

/* ── 顶栏：米纸 + 细底影，日期待字距；徽标为木质拉手 ── */
.topbar{background:linear-gradient(180deg,#FFFDF7,var(--card) 4%,#F7F0E1);border-bottom:1px solid rgba(120,96,66,.10);box-shadow:0 1px 0 rgba(74,58,40,.03),0 8px 22px -18px rgba(74,58,40,.25);letter-spacing:.02em}
html.state-splash .topbar,html.state-pano .topbar,html.state-splash .bottom-nav,html.state-pano .bottom-nav{display:none!important;background:none;box-shadow:none;border-bottom-color:transparent}
.topbar[hidden],.bottom-nav[hidden]{display:none!important}
.topbar .title{letter-spacing:.12em}
.topbar .date{letter-spacing:.5px}
.topbar .tb-badge{background:linear-gradient(135deg,#6E4F37,#7A583E);color:#FBF3E4;box-shadow:inset 0 1px 0 rgba(255,255,255,.14)}

/* ── 侧栏：湿木楸文——暖纸木托与「抽屉拉手式」激活 ── */
.sidebar{background:linear-gradient(180deg,#F1EADA,#EBE2CE);border-right:1px solid var(--border-strong)}
.sidebar .logo{color:var(--primary-strong);letter-spacing:.16em;font-weight:800}
.nav-section{
  font-family:var(--font-display);font-size:10.5px;letter-spacing:1.5px;color:var(--hint);
  border-top:1px solid var(--border);padding-top:11px;margin-top:6px;
}
.nav-item{color:var(--ink-soft);border-radius:9px}
.nav-item:hover{background:rgba(110,79,55,.08);color:var(--primary-strong)}
.nav-item.active{
  background:linear-gradient(90deg,#6E4F37,#7A583E);color:#FBF3E4;
  box-shadow:0 5px 14px -6px rgba(74,58,40,.35);font-weight:600;
}

/* ── 指标 / 数字：宋韵大字 + 木色数值 + 黄铜点缀 ── */
.metric{background:linear-gradient(165deg,var(--card),var(--bg));border-radius:14px;padding:16px 17px;border:1px solid var(--border)}
.metric .label{font-family:var(--font-display);font-size:12px;letter-spacing:1px;color:var(--hint)}
.metric .value{font-family:var(--font-display);font-size:28px;color:var(--primary)}
.stat-num{font-family:var(--font-display);color:var(--primary)}
.cd-count{color:var(--primary)}
.stat-card{background:linear-gradient(165deg,var(--card),var(--bg));border-radius:14px;border:1px solid var(--border)}

/* ── 按钮：主按钮＝刷木，次按钮＝纸面描线 ── */
.btn{border-radius:10px}
.btn-white{background:linear-gradient(180deg,#FBF4E6,#F0E5CF);border-color:#E6D7BC;color:#5C4030;font-weight:600;box-shadow:inset 0 1px 0 rgba(255,255,255,.6)}
.btn-white:hover{background:linear-gradient(180deg,#FFF9EC,#F6EAD4);border-color:#D9C5A4;color:#4A3427}
.btn-primary,.btn-primary:hover{
  background:linear-gradient(140deg,#7A583E,#5C4030);border-color:#4A3427;color:#FCF4E4;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 4px 12px -3px rgba(74,58,40,.3);
}
.btn-teal{background:linear-gradient(140deg,#B08A54,#8A6A3A);border-color:#7C5B38;color:#FCF4E4}

/* ── Tabs：下划线为核桃木实线 ── */
.tab.active{border-bottom-color:var(--primary)}

/* ── 表格表头：米纸底，宋韵小字 ── */
th{color:var(--hint);font-weight:600;letter-spacing:.6px}

/* ── 表单聚焦：核桃木描边 + 采光纸底 ── */
input:focus,textarea:focus,select:focus{border-color:var(--primary);background:#FFFDF4;box-shadow:0 0 0 3px var(--accent-soft)}

/* ── 便签 / 进度 ── */
.progress{height:7px;border-radius:4px;background:var(--bg);border:1px solid var(--border)}
.progress .bar{background:linear-gradient(90deg,#9A784C,#6E4F37)}

/* ── 片刻动效：板块切换时卡片轻缓上浮，桌面悬停微抬（克制不喧哗） ── */
@keyframes qxRise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.view.active>.card,.view.active>.section-intro,.view.active>.grid,.view.active .mind-card{animation:qxRise .42s cubic-bezier(.22,.61,.36,1) both}
@media (hover:hover){
  .view.active .card:hover{transform:translateY(-2px);box-shadow:0 14px 30px -14px rgba(74,58,40,.28)}
  .view.active .card{transition:transform .2s ease,box-shadow .2s ease}
}

/* ── 夜间「墨匣」精修：暖墨木底，剔除一切绿色幽灵 ── */
[data-theme="dark"] body{background-color:var(--bg)}
[data-theme="dark"] .page-head::before{background:linear-gradient(90deg,var(--gold),var(--gold-light) 70%,transparent)}
[data-theme="dark"] .page-head::after{background:linear-gradient(90deg,#57493A,var(--border) 45%,transparent)}
[data-theme="dark"] .page-head h1{color:var(--head-deep)}
[data-theme="dark"] .page-head p{color:var(--muted)}
[data-theme="dark"] .card{background:linear-gradient(180deg,var(--card),#241F19);box-shadow:0 1px 2px rgba(0,0,0,.35),0 12px 26px -12px rgba(0,0,0,.55)}
[data-theme="dark"] .card::before{background:linear-gradient(90deg,transparent,rgba(255,255,255,.05),transparent)}
[data-theme="dark"] .sidebar{background:linear-gradient(180deg,#2B2620,#241F19);border-right-color:var(--border)}
[data-theme="dark"] .nav-section{border-top-color:var(--border)}
[data-theme="dark"] .nav-item:hover{background:rgba(194,155,110,.10);color:#E0C79E}
[data-theme="dark"] .nav-item.active{background:linear-gradient(90deg,#5C4430,#6E4F37);color:#F0E7D8;box-shadow:0 5px 14px -6px rgba(0,0,0,.5)}
[data-theme="dark"] .topbar{background:linear-gradient(180deg,#4A3929,var(--card) 8%,#3A2C20);box-shadow:0 1px 0 rgba(0,0,0,.18),0 8px 24px -18px rgba(0,0,0,.55)}
[data-theme="dark"] .topbar .theme-toggle,[data-theme="dark"] #btnGuide{color:#D6C9B4;border-color:#57493A}
[data-theme="dark"] .topbar .theme-toggle:hover{background:var(--primary-light);color:#E8D5B8;border-color:#8A6A3A}
[data-theme="dark"] .tb-more-menu{background:linear-gradient(180deg,#2A2118,#241B13);border-color:#493B2A}
[data-theme="dark"] .tb-more-item{color:#E0D6C4}
[data-theme="dark"] .tb-more-item:hover{background:rgba(200,160,92,.14);color:#E8D5B8}
[data-theme="dark"] .btn-primary{background:linear-gradient(140deg,#5C4430,#3E2F24);border-color:#6E4F37;color:#F0E7D8}
[data-theme="dark"] .btn-teal{background:linear-gradient(140deg,#6E5A32,#56441F);border-color:#7A6236;color:#F0E7D8}
[data-theme="dark"] input:focus,textarea:focus,select:focus{background:var(--card);border-color:var(--primary);box-shadow:0 0 0 3px var(--accent-soft)}
[data-theme="dark"] #freeBanner{background:linear-gradient(90deg,#3A3126,#4A3A2C);border-color:var(--border);color:var(--ink)}
[data-theme="dark"] .topbar .tb-badge{background:linear-gradient(135deg,#6E4F37,#8A6A3A);color:#F0E7D8}

/* ═══ 栖匣 · 模块分区多色系统（对应反馈「界面区分再清楚一些 / 色系有点单调」）═══
   每个模块家族拥有独立强调色；浅/深主题自适应；只做增量，不破坏原「暖木匣纸」设计语言。 */
/* 学窗暖金 · 学业/考试/论文/竞赛/计划/目标 */
#view-study,#view-exam,#view-paper,#view-contest,#view-plans,#view-goals,#view-college{--m:#B07A2E;--m-deep:#86541E;--m-soft:rgba(176,122,46,.13)}
:root[data-theme="dark"] #view-study,:root[data-theme="dark"] #view-exam,:root[data-theme="dark"] #view-paper,:root[data-theme="dark"] #view-contest,:root[data-theme="dark"] #view-plans,:root[data-theme="dark"] #view-goals,:root[data-theme="dark"] #view-college{--m:#DEB04A;--m-deep:#BA8C34;--m-soft:rgba(222,176,74,.15)}
/* 成长橄榄 · 职业/成长/模板/工具/AI */
#view-career,#view-growth,#view-tpl,#view-tools,#view-ai,#view-agent,#view-creative{--m:#7A8A4A;--m-deep:#5A6732;--m-soft:rgba(122,138,74,.13)}
:root[data-theme="dark"] #view-career,:root[data-theme="dark"] #view-growth,:root[data-theme="dark"] #view-tpl,:root[data-theme="dark"] #view-tools,:root[data-theme="dark"] #view-ai,:root[data-theme="dark"] #view-agent,:root[data-theme="dark"] #view-creative{--m:#AFC07A;--m-deep:#8A9958;--m-soft:rgba(175,192,122,.15)}
/* 生活琥珀 · 校园/生活/休闲 */
#view-campus,#view-party,#view-safety,#view-life,#view-habits,#view-shelf,#view-movie,#view-fun,#view-vision,#view-podcast,#view-journal{--m:#C2703D;--m-deep:#96492A;--m-soft:rgba(194,112,61,.13)}
:root[data-theme="dark"] #view-campus,:root[data-theme="dark"] #view-party,:root[data-theme="dark"] #view-safety,:root[data-theme="dark"] #view-life,:root[data-theme="dark"] #view-habits,:root[data-theme="dark"] #view-shelf,:root[data-theme="dark"] #view-movie,:root[data-theme="dark"] #view-fun,:root[data-theme="dark"] #view-vision,:root[data-theme="dark"] #view-podcast,:root[data-theme="dark"] #view-journal{--m:#E0935E;--m-deep:#B96A3A;--m-soft:rgba(224,147,94,.15)}
/* 健康陶土 · 健康/心理 */
#view-health,#view-mind{--m:#B0573A;--m-deep:#8A4028;--m-soft:rgba(176,87,58,.13)}
:root[data-theme="dark"] #view-health,:root[data-theme="dark"] #view-mind{--m:#E08A6A;--m-deep:#B76548;--m-soft:rgba(224,138,106,.15)}
/* 财商古铜 · 财务/省钱/副业 */
#view-finance,#view-save,#view-earn,#view-shop,#view-perk{--m:#A5793C;--m-deep:#7A5628;--m-soft:rgba(165,121,60,.13)}
:root[data-theme="dark"] #view-finance,:root[data-theme="dark"] #view-save,:root[data-theme="dark"] #view-earn,:root[data-theme="dark"] #view-shop,:root[data-theme="dark"] #view-perk{--m:#D8B27A;--m-deep:#AE894F;--m-soft:rgba(216,178,122,.15)}
/* 专注檀棕 · 计时/习惯 */
#view-timer,#view-habits{--m:#96764A;--m-deep:#6D5331;--m-soft:rgba(150,118,74,.14)}
:root[data-theme="dark"] #view-timer,:root[data-theme="dark"] #view-habits{--m:#CFA97C;--m-deep:#A97F4F;--m-soft:rgba(207,169,124,.15)}
/* 兜底：凡未被上表点名的视图（首页/总览/统计/帮助/关于等）用品牌核桃木 */
#view-home,#view-quadrant,#view-stats,#view-help,#view-about,#view-settings,#view-changelog{--m:#6B4D33;--m-deep:#523A26;--m-soft:rgba(107,77,51,.11)}

/* 版头：彩色引条 + 图标着色，让每个板块一眼可辨 */
#view-home .page-head::before,
#view-quadrant .page-head::before,#view-career .page-head::before,#view-study .page-head::before,#view-exam .page-head::before,#view-paper .page-head::before,#view-contest .page-head::before,#view-plans .page-head::before,#view-goals .page-head::before,#view-college .page-head::before,
#view-growth .page-head::before,#view-tpl .page-head::before,#view-tools .page-head::before,#view-ai .page-head::before,#view-agent .page-head::before,#view-creative .page-head::before,
#view-campus .page-head::before,#view-party .page-head::before,#view-safety .page-head::before,#view-life .page-head::before,#view-habits .page-head::before,#view-shelf .page-head::before,#view-movie .page-head::before,#view-fun .page-head::before,#view-vision .page-head::before,#view-podcast .page-head::before,#view-journal .page-head::before,
#view-health .page-head::before,#view-mind .page-head::before,
#view-finance .page-head::before,#view-save .page-head::before,#view-earn .page-head::before,#view-shop .page-head::before,#view-perk .page-head::before,
#view-timer .page-head::before,
#view-stats .page-head::before,#view-help .page-head::before,#view-about .page-head::before,#view-settings .page-head::before,#view-changelog .page-head::before{
  width:74px;height:4px;background:linear-gradient(90deg,var(--m),var(--m-deep));
}
#view-home .page-head h1,#view-quadrant .page-head h1,#view-career .page-head h1,#view-study .page-head h1,#view-exam .page-head h1,#view-paper .page-head h1,#view-contest .page-head h1,#view-plans .page-head h1,#view-goals .page-head h1,#view-college .page-head h1,#view-growth .page-head h1,#view-tpl .page-head h1,#view-tools .page-head h1,#view-ai .page-head h1,#view-agent .page-head h1,#view-creative .page-head h1,#view-campus .page-head h1,#view-party .page-head h1,#view-safety .page-head h1,#view-life .page-head h1,#view-habits .page-head h1,#view-shelf .page-head h1,#view-movie .page-head h1,#view-fun .page-head h1,#view-vision .page-head h1,#view-podcast .page-head h1,#view-journal .page-head h1,#view-health .page-head h1,#view-mind .page-head h1,#view-finance .page-head h1,#view-save .page-head h1,#view-earn .page-head h1,#view-shop .page-head h1,#view-perk .page-head h1,#view-timer .page-head h1,#view-stats .page-head h1,#view-help .page-head h1,#view-about .page-head h1,#view-settings .page-head h1,#view-changelog .page-head h1{position:relative;padding-left:16px}
#view-home .page-head h1::before,#view-quadrant .page-head h1::before,#view-career .page-head h1::before,#view-study .page-head h1::before,#view-exam .page-head h1::before,#view-paper .page-head h1::before,#view-contest .page-head h1::before,#view-plans .page-head h1::before,#view-goals .page-head h1::before,#view-college .page-head h1::before,#view-growth .page-head h1::before,#view-tpl .page-head h1::before,#view-tools .page-head h1::before,#view-ai .page-head h1::before,#view-agent .page-head h1::before,#view-creative .page-head h1::before,#view-campus .page-head h1::before,#view-party .page-head h1::before,#view-safety .page-head h1::before,#view-life .page-head h1::before,#view-habits .page-head h1::before,#view-shelf .page-head h1::before,#view-movie .page-head h1::before,#view-fun .page-head h1::before,#view-vision .page-head h1::before,#view-podcast .page-head h1::before,#view-journal .page-head h1::before,#view-health .page-head h1::before,#view-mind .page-head h1::before,#view-finance .page-head h1::before,#view-save .page-head h1::before,#view-earn .page-head h1::before,#view-shop .page-head h1::before,#view-perk .page-head h1::before,#view-timer .page-head h1::before,#view-stats .page-head h1::before,#view-help .page-head h1::before,#view-about .page-head h1::before,#view-settings .page-head h1::before,#view-changelog .page-head h1::before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:5px;border-radius:3px;background:var(--m)}
#view-home .page-head h1 svg,#view-quadrant .page-head h1 svg,#view-career .page-head h1 svg,#view-study .page-head h1 svg,#view-exam .page-head h1 svg,#view-paper .page-head h1 svg,#view-contest .page-head h1 svg,#view-plans .page-head h1 svg,#view-goals .page-head h1 svg,#view-college .page-head h1 svg,#view-growth .page-head h1 svg,#view-tpl .page-head h1 svg,#view-tools .page-head h1 svg,#view-ai .page-head h1 svg,#view-agent .page-head h1 svg,#view-creative .page-head h1 svg,#view-campus .page-head h1 svg,#view-party .page-head h1 svg,#view-safety .page-head h1 svg,#view-life .page-head h1 svg,#view-habits .page-head h1 svg,#view-shelf .page-head h1 svg,#view-movie .page-head h1 svg,#view-fun .page-head h1 svg,#view-vision .page-head h1 svg,#view-podcast .page-head h1 svg,#view-journal .page-head h1 svg,#view-health .page-head h1 svg,#view-mind .page-head h1 svg,#view-finance .page-head h1 svg,#view-save .page-head h1 svg,#view-earn .page-head h1 svg,#view-shop .page-head h1 svg,#view-perk .page-head h1 svg,#view-timer .page-head h1 svg,#view-stats .page-head h1 svg,#view-help .page-head h1 svg,#view-about .page-head h1 svg,#view-settings .page-head h1 svg,#view-changelog .page-head h1 svg{color:var(--m)}

/* 板块导语：色带导语卡，顶部清晰色块 —— 板块区分一眼可辨 */
#view-home .section-intro,#view-quadrant .section-intro,#view-career .section-intro,#view-study .section-intro,#view-exam .section-intro,#view-paper .section-intro,#view-contest .section-intro,#view-plans .section-intro,#view-goals .section-intro,#view-college .section-intro,#view-growth .section-intro,#view-tpl .section-intro,#view-tools .section-intro,#view-ai .section-intro,#view-agent .section-intro,#view-creative .section-intro,#view-campus .section-intro,#view-party .section-intro,#view-safety .section-intro,#view-life .section-intro,#view-habits .section-intro,#view-shelf .section-intro,#view-movie .section-intro,#view-fun .section-intro,#view-vision .section-intro,#view-podcast .section-intro,#view-journal .section-intro,#view-health .section-intro,#view-mind .section-intro,#view-finance .section-intro,#view-save .section-intro,#view-earn .section-intro,#view-shop .section-intro,#view-perk .section-intro,#view-timer .section-intro,#view-stats .section-intro,#view-help .section-intro,#view-about .section-intro,#view-settings .section-intro,#view-changelog .section-intro{
  position:relative;overflow:hidden;
  background:linear-gradient(90deg,color-mix(in srgb,var(--m-soft) 55%,transparent),transparent 82%);
  border-left:3px solid color-mix(in srgb,var(--m) 70%,transparent);
  border-radius:0 12px 12px 0;padding:13px 16px 12px;margin-bottom:20px;
}
#view-home .section-intro strong,#view-career .section-intro strong,#view-study .section-intro strong,#view-exam .section-intro strong,#view-paper .section-intro strong,#view-growth .section-intro strong,#view-campus .section-intro strong,#view-life .section-intro strong,#view-health .section-intro strong,#view-finance .section-intro strong,#view-save .section-intro strong,#view-timer .section-intro strong{color:var(--m-deep)}

/* 卡片：标题下加一端彩色短引条 + 图标着色，整版更鲜活又不喧宾夺主 */
#view-career .card h3,#view-study .card h3,#view-exam .card h3,#view-paper .card h3,#view-contest .card h3,#view-plans .card h3,#view-goals .card h3,#view-college .card h3,#view-growth .card h3,#view-tpl .card h3,#view-tools .card h3,#view-ai .card h3,#view-agent .card h3,#view-creative .card h3,#view-campus .card h3,#view-party .card h3,#view-safety .card h3,#view-life .card h3,#view-habits .card h3,#view-shelf .card h3,#view-movie .card h3,#view-fun .card h3,#view-vision .card h3,#view-podcast .card h3,#view-journal .card h3,#view-health .card h3,#view-mind .card h3,#view-finance .card h3,#view-save .card h3,#view-earn .card h3,#view-shop .card h3,#view-perk .card h3,#view-timer .card h3{position:relative;padding-bottom:13px}
#view-career .card h3::after,#view-study .card h3::after,#view-exam .card h3::after,#view-paper .card h3::after,#view-contest .card h3::after,#view-plans .card h3::after,#view-goals .card h3::after,#view-college .card h3::after,#view-growth .card h3::after,#view-tpl .card h3::after,#view-tools .card h3::after,#view-ai .card h3::after,#view-agent .card h3::after,#view-creative .card h3::after,#view-campus .card h3::after,#view-party .card h3::after,#view-safety .card h3::after,#view-life .card h3::after,#view-habits .card h3::after,#view-shelf .card h3::after,#view-movie .card h3::after,#view-fun .card h3::after,#view-vision .card h3::after,#view-podcast .card h3::after,#view-journal .card h3::after,#view-health .card h3::after,#view-mind .card h3::after,#view-finance .card h3::after,#view-save .card h3::after,#view-earn .card h3::after,#view-shop .card h3::after,#view-perk .card h3::after,#view-timer .card h3::after{content:"";position:absolute;left:0;bottom:0;width:40px;height:3px;border-radius:2px;background:linear-gradient(90deg,var(--m),var(--m-deep))}

/* ═══ 版头色系「穿透」到卡片正文（对应反馈：只有标题变色、下面内容没变色、显突兀）═══
   把板块强调色注入该板块内所有强调令牌，使正文的 标签/链接/数据/勾选/图标/焦点/选中 全部与该板块同色；
   系统框（顶栏/侧栏/底栏/品牌核桃木）保持统一，避免大面积涂色造成紊乱，浅深主题自动适配。 */
#view-career,#view-study,#view-exam,#view-paper,#view-contest,#view-plans,#view-goals,#view-college,
#view-growth,#view-tpl,#view-tools,#view-ai,#view-agent,#view-creative,
#view-campus,#view-party,#view-safety,#view-life,#view-habits,#view-shelf,#view-movie,#view-fun,#view-vision,#view-podcast,#view-journal,
#view-health,#view-mind,
#view-finance,#view-save,#view-earn,#view-shop,#view-perk,
#view-timer{
  --accent:var(--m);            /* 选中/焦点/勾选/标签/图标 → 板块色 */
  --accent-soft:var(--m-soft);  /* 浅底色/选区/扫光/链接浅底 → 板块浅色 */
  /* 注意：不整体改写 --primary，保持数字/正文/主按钮统一品牌核桃木，避免整版撞色显得奇怪 */
  /* 移除原先铺满整版上方的彩色虚幻色块(radial-gradient)，避免「配色覆盖整页、很方正」 */
}
/* 卡片标题行已由下方 40px 精致短引条点缀，不再铺整行虚线框，避免卡片显得方正生硬 */
/* 数字/数据用板块深色，既呼应板块又清晰 */
#view-career .stat-num,#view-study .stat-num,#view-exam .stat-num,#view-paper .stat-num,#view-contest .stat-num,#view-plans .stat-num,#view-goals .stat-num,#view-college .stat-num,#view-growth .stat-num,#view-tools .stat-num,#view-ai .stat-num,#view-agent .stat-num,#view-creative .stat-num,#view-campus .stat-num,#view-habits .stat-num,#view-health .stat-num,#view-mind .stat-num,#view-finance .stat-num,#view-save .stat-num,#view-earn .stat-num,#view-shop .stat-num,#view-perk .stat-num{color:var(--m-deep)}
/* 板块内标签用板块浅底，与全站标签统一造型 */
#view-career .tag,#view-study .tag,#view-exam .tag,#view-paper .tag,#view-contest .tag,#view-plans .tag,#view-goals .tag,#view-college .tag,#view-growth .tag,#view-tpl .tag,#view-tools .tag,#view-ai .tag,#view-agent .tag,#view-creative .tag,#view-campus .tag,#view-party .tag,#view-safety .tag,#view-life .tag,#view-habits .tag,#view-shelf .tag,#view-movie .tag,#view-fun .tag,#view-vision .tag,#view-podcast .tag,#view-journal .tag,#view-health .tag,#view-mind .tag,#view-finance .tag,#view-save .tag,#view-earn .tag,#view-shop .tag,#view-perk .tag,#view-timer .tag{color:var(--m-deep);background:var(--m-soft);border-color:color-mix(in srgb,var(--m) 35%,transparent)}
/* 内容板块内的标签与链接同板块色浅底，清晰而不刺眼 */
#view-career a[href],#view-study a[href],#view-exam a[href],#view-paper a[href],#view-contest a[href],#view-plans a[href],#view-goals a[href],#view-college a[href],#view-growth a[href],#view-tpl a[href],#view-tools a[href],#view-ai a[href],#view-agent a[href],#view-creative a[href],#view-campus a[href],#view-party a[href],#view-safety a[href],#view-life a[href],#view-habits a[href],#view-shelf a[href],#view-movie a[href],#view-fun a[href],#view-vision a[href],#view-podcast a[href],#view-journal a[href],#view-health a[href],#view-mind a[href],#view-finance a[href],#view-save a[href],#view-earn a[href],#view-shop a[href],#view-perk a[href],#view-timer a[href]{color:var(--m-deep);text-decoration-color:color-mix(in srgb,var(--m) 55%,transparent)}
#view-career a[href]:hover,#view-study a[href]:hover,#view-exam a[href]:hover,#view-paper a[href]:hover,#view-contest a[href]:hover,#view-plans a[href]:hover,#view-goals a[href]:hover,#view-college a[href]:hover,#view-growth a[href]:hover,#view-tpl a[href]:hover,#view-tools a[href]:hover,#view-ai a[href]:hover,#view-agent a[href]:hover,#view-creative a[href]:hover,#view-campus a[href]:hover,#view-party a[href]:hover,#view-safety a[href]:hover,#view-life a[href]:hover,#view-habits a[href]:hover,#view-shelf a[href]:hover,#view-movie a[href]:hover,#view-fun a[href]:hover,#view-vision a[href]:hover,#view-podcast a[href]:hover,#view-journal a[href]:hover,#view-health a[href]:hover,#view-mind a[href]:hover,#view-finance a[href]:hover,#view-save a[href]:hover,#view-earn a[href]:hover,#view-shop a[href]:hover,#view-perk a[href]:hover,#view-timer a[href]:hover{color:var(--m)}
</style>
<style id="qx-system">
/* ═══════════ 栖匣 · 系统统一层（令牌/分区/极简模式/移动端触控/长文可读性） ═══════════ */
/* 统一圆角与阴影：卡片12、按钮10；全部卡片走同一套暖影 */
.card,.metric,.stat-card,.box,.panel,.progress,.qg-modal{border-radius:12px}
.btn,.btn-primary,.btn-teal,.btn-white,.nav-item,.section-intro{border-radius:10px}
/* 长文可读性：正文/要点/单元格行高1.65，段落间距舒展，避免密密麻麻 */
.view p,.view li,.view td,.view th,.tip,.points p,.gtd-body li,.qg-desc{line-height:1.65}
.view p{margin:6px 0}
.view .card{margin-bottom:18px}
.view{padding-bottom:44px}
/* 强可读正文默认段距 */
.card p{font-size:14px;letter-spacing:.2px}

/* ── 分区系统：📖参考资料区(默认折叠) ｜ ✍️我的记录区 ── */
.ref-zone{border:1px dashed var(--border-strong);border-radius:12px;margin:0 0 20px;background:linear-gradient(180deg,var(--bg),transparent);overflow:hidden}
.ref-head{display:flex;align-items:center;gap:8px;width:100%;text-align:left;background:var(--bg);border:none;border-bottom:1px solid var(--border);padding:12px 16px;font-family:var(--font-display);font-size:14px;letter-spacing:1px;color:var(--ink-soft);cursor:pointer}
.ref-head::after{content:"收起 ▲";margin-left:auto;font-size:11px;letter-spacing:.3px;font-family:var(--font-body);color:var(--hint)}
.ref-zone.collapsed .ref-body{display:none}
.ref-zone.collapsed .ref-head::after{content:"展开 ▼"}
.ref-body{padding:12px 16px 14px}
.note-zone{border:1px solid var(--border);border-top:3px solid var(--primary);border-radius:12px;padding:14px 16px;margin:0 0 22px;background:linear-gradient(180deg,var(--card),var(--bg))}
.note-head{display:flex;align-items:center;gap:8px;font-family:var(--font-display);font-size:15px;letter-spacing:1px;color:var(--head-deep);margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid var(--border)}
/* 通用可折叠参考条（无边框的轻折叠） */
.qx-collapse{position:relative}
.qx-coll-h{display:flex;align-items:center;gap:8px;background:none;border:none;border-bottom:1px solid var(--border);width:100%;text-align:left;font-family:var(--font-display);font-size:14px;letter-spacing:1px;color:var(--ink-soft);padding:11px 2px;margin:0 0 10px;cursor:pointer}
.qx-coll-h::after{content:"▾";margin-left:auto;color:var(--hint);transition:transform .2s}
.qx-coll-h.open::after{transform:rotate(180deg)}
.qx-coll-h.open + * {display:block}

/* 空状态友好 */
.qx-empty{color:var(--hint);font-size:13.5px;text-align:center;padding:26px 12px;line-height:1.8;border:1px dashed var(--border);border-radius:12px;background:var(--bg);margin:4px 0 18px}
.qx-empty b{color:var(--ink-soft);font-weight:600}

/* ── 极简模式（P人/拖延/轻记录）：只留核心，收起参考与复杂板块 ── */
[data-mode="min"] .view:not([data-core]){display:none!important}
[data-mode="min"] .ref-zone{display:none}
[data-mode="min"] .nav-item[data-more]{display:none}
[data-mode="min"] .tb-more-item[data-more]{display:none}
[data-mode="min"] .pack-card,.qx-heavy{opacity:.55;pointer-events:none;user-select:none}
[data-mode="min"] .sidebar .nav-section{border-top-color:var(--iconfade,var(--border))}

/* ── 资讯板块统一免责小签 ── */
.qx-disclaim{font-size:12px;line-height:1.7;color:var(--hint);text-align:center;padding:12px 16px;margin:8px 0 26px;border-top:1px dashed var(--border);letter-spacing:.3px}

/* ── 移动端触控与表格提示 ── */
@media screen and (max-width:768px){
  button,a.clickable,.nav-item,.bottom-nav-item,input,select,textarea,label[for],.qx-coll-h,.ref-head{min-height:44px}
  .view table{width:100%}
  .qx-table-hint{display:block;font-size:11.5px;color:var(--hint);margin-top:6px}
}
.qx-table-hint{display:none}
/* 顶部做移动端快速操作按钮条（新手快速上手） */
.qx-quick{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px}
.qx-quick .quick-btn{flex:1 1 130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:14px 10px;border-radius:12px;background:linear-gradient(180deg,var(--card),var(--bg));border:1px solid var(--border);box-shadow:var(--shadow);cursor:pointer;color:var(--ink-soft);font-size:13px;transition:transform .16s ease,box-shadow .16s ease}
@media (hover:hover){.qx-quick .quick-btn:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}}
.qx-quick .quick-btn b{font-size:18px;color:var(--primary);font-family:var(--font-display)}
[data-theme="dark"] .qx-quick .quick-btn{background:linear-gradient(180deg,var(--card),#262019)}
[data-theme="dark"] .ref-zone{background:linear-gradient(180deg,#221E18,transparent)}
[data-theme="dark"] .ref-head,[data-theme="dark"] .qx-coll-h{background:#211C16;color:#B8A68C}
</style>
  <link rel="stylesheet" href="css/upgrade.css">
</head>
<body>
<script>
(function(){
  window.copyShareUrl=function(){
    var url=location.href;
    var done=function(){try{window.flash&&window.flash('链接已复制：'+url);}catch(e){alert('链接已复制：\n'+url);}};
    var fail=function(){try{window.flash&&window.flash('复制失败，请长按/手动复制地址栏链接');}catch(e){}};
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(url).then(done).catch(fail);
    }else{
      try{
        var ta=document.createElement('textarea');ta.value=url;document.body.appendChild(ta);ta.select();
        var ok=document.execCommand('copy');document.body.removeChild(ta);
        ok?done():fail();
      }catch(e){fail();}
    }
  };
})();
(function(){
  /* PWA 安装：支持一键安装的浏览器（Chrome/Edge 桌面）捕获安装提示，显示"安装到桌面"按钮 */
  var installPrompt=null;
  var nav=function(){try{return navigator;}catch(e){return{}};};
  function inWeixin(){try{return /MicroMessenger/i.test(navigator.userAgent||'');}catch(e){return false;}}
  function isStandalone(){try{return (window.matchMedia&&window.matchMedia('(display-mode: standalone)').matches)||window.navigator.standalone===true;}catch(e){return false;}}
  window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();installPrompt=e;renderInstall();});
  window.addEventListener('appinstalled',function(){installPrompt=null;renderInstall();});
  function platform(){
    try{
      var ua=(navigator.userAgent||'');
      if(/iPhone|iPad|iPod/i.test(ua))return 'ios';
      if(inWeixin())return 'weixin';
      if(/Android/i.test(ua))return 'android';
      if(window.chrome||/Edge\//.test(ua))return 'desktop-chrome';
      return 'browser';
    }catch(e){return 'browser';}
  }
  function installNow(){
    if(installPrompt){installPrompt.prompt();installPrompt.userChoice.then(function(){installPrompt=null;renderInstall();}).catch(function(){});return;}
    if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(location.href).then(function(){try{window.flash&&window.flash('链接已复制：点浏览器右上角「菜单→添加到主屏幕/桌面」');}catch(e){}});}
  }
  window.renderInstall=function(){
    var host=document.getElementById('installHost');if(!host)return;
    var host2=document.getElementById('installHost2');
    var p=platform();
    var btn='';
    if(installPrompt){
      btn='<button class="btn" style="background:var(--primary,#6B4D33);color:#fff;border:none;margin-bottom:8px" onclick="return installNow()">⚡ 一键安装到桌面 / 主屏幕</button>';
    }else if(p==='ios'&&!isStandalone()){
      btn='<button class="btn btn-sm" style="background:var(--primary);color:#fff;border:none" onclick="copyShareUrl()">📋 复制本页链接（iPhone/Safari 打开后→分享→添加到主屏幕）</button>';
    }else if((p==='android'||p==='weixin')&&!isStandalone()){
      btn='<button class="btn btn-sm" style="background:var(--primary);color:#fff;border:none" onclick="return copyShareUrl()">📋 复制本页链接（浏览器打开后→菜单→添加到主屏幕）</button>';
    }
    host.innerHTML=btn+'<div id="installState" style="font-size:12px;color:var(--muted);margin-top:6px">'+(isStandalone()?'✅ 你已将它作为 App 使用中（全屏打开，无浏览器地址栏）':(inWeixin()?'⚠️ 当前为微信内打开，安装请点右上角「···」→「在浏览器中打开」后再添加到主屏幕':'已就绪：点浏览器菜单「添加到主屏幕/桌面」即可像 App 一样使用'))+'</div>';
    if(host2)host2.innerHTML=installPrompt?('<button class="btn" style="background:var(--primary,#6B4D33);color:#fff;border:none;padding:9px 18px" onclick="return installNow()">⚡ 一键安装到桌面 / 主屏幕</button>'):'<span style="font-size:12px;color:var(--muted)">（此浏览器暂不支持一键安装，请直接用下面的手动步骤）</span>';
  };
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',function(){renderInstall();});}
  else{try{renderInstall();}catch(e){}}
  /* 定期刷新安装按钮状态，进入设置页一定能看到 */
  setInterval(function(){try{renderInstall();}catch(e){}},2500);
})();
</script>
<script>
/* ============================================================
   安装到桌面 / 下载应用（全环境统一入口，独立于 upgrade.js）
   - 有系统原生安装能力（Chrome/Edge/安卓下载场景）→ 直接弹系统安装框
   - 微信内置 / iOS Safari / 无系统按钮的浏览器 → 弹分步安装引导面板 + 可复制链接
   任何环境点击都一定有反应。
   ============================================================ */
(function () {
  'use strict';
  function inWeixin() { try { return /MicroMessenger/i.test(navigator.userAgent || ''); } catch (e) { return false; } }
  function isIos() {
    try {
      var ua = navigator.userAgent || '';
      return /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    } catch (e) { return false; }
  }
  function isStandalone() {
    try { return (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true; } catch (e) { return false; }
  }
  function browserName() {
    try {
      var ua = (navigator.userAgent || '').toLowerCase();
      if (/micromessenger/i.test(ua)) return 'wechat';
      if (/quark/i.test(ua)) return 'quark';
      if (/ucbrowser|ubrowser/i.test(ua)) return 'uc';
      if (/qqbrowser|mqqbrowser/i.test(ua)) return 'qq';
      if (/hwbrowser/i.test(ua)) return 'huawei';
      if (/samsungbrowser|samsung/i.test(ua)) return 'samsung';
      if (/edg\//i.test(ua) || /edgios/i.test(ua)) return 'edge';
      if (/firefox|fxios/i.test(ua)) return 'firefox';
      if (/chrome|crios/i.test(ua)) return 'chrome';
      return '';
    } catch (e) { return ''; }
  }
  function isDesktop() {
    try { return window.innerWidth >= 900 && (navigator.maxTouchPoints || 0) < 5; } catch (e) { return false; }
  }
  function copyText(t) {
    try { if (navigator.clipboard && window.isSecureContext) { return navigator.clipboard.writeText(t).then(function () { return true; }); } } catch (e) {}
    try {
      var ta = document.createElement('textarea');
      ta.value = t; ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      var ok = false; try { ok = document.execCommand('copy'); } catch (e2) {}
      document.body.removeChild(ta); return Promise.resolve(ok);
    } catch (e) { return Promise.resolve(false); }
  }
  window.copyThisLink = function () {
    var url = location.href;
    var hint = '链接已复制';
    function showFallback() {
      var box = document.getElementById('ciLinkBox');
      if (box) { box.style.display = 'block'; var i = box.querySelector('input'); if (i) i.select(); return false; }
      var safe = url.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
      var el = document.createElement('div');
      el.id = 'ciLinkBox';
      el.style.cssText = 'margin:10px 0 2px;padding:9px 10px;border:1px dashed #D8C8A8;border-radius:8px;background:#FFFDF5;text-align:left';
      el.innerHTML = '<div style="font-size:12px;color:var(--muted);line-height:1.6;margin-bottom:5px">当前浏览器拦截了自动复制。请<b>长按下面这行网址</b> → 点「拷贝 / 复制」，再粘贴到支持一键安装的浏览器打开：</div>' +
        '<input readonly value="' + safe + '" onclick="this.select()" style="width:100%;box-sizing:border-box;padding:8px;border:1px solid #D8C8A8;border-radius:6px;background:#fff;font-size:12px;letter-spacing:.2px;color:#3b2a18">';
      var btn = document.querySelector('#ciSheet button[onclick*="copyThisLink"]');
      if (btn && btn.parentNode) { btn.parentNode.insertBefore(el, btn.nextSibling); }
      else { var s = document.getElementById('ciSheet'); if (s && s.querySelector('.cios-box')) s.querySelector('.cios-box').appendChild(el); }
      var i2 = el.querySelector('input'); if (i2) i2.select();
    }
    var p = copyText(url);
    if (p && typeof p.then === 'function') {
      p.then(function (ok) {
        if (ok) { try { if (typeof window.flash === 'function') window.flash(hint); } catch (e) {} }
        else showFallback();
      });
    } else { showFallback(); }
    return false;
  };

  window.openInstall = function () {
    try {
      var p = window.installPrompt || null;
      if (p && typeof p.prompt === 'function') {
        p.prompt();
        try { p.userChoice.then(function () { window.installPrompt = null; try { if (typeof window.renderInstall === 'function') window.renderInstall(); } catch (e2) {} }).catch(function () {}); } catch (e2) {}
     