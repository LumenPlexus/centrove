                <tr><td style="border:1px solid var(--border);font-weight:600;color:#8B4513">高</td><td style="border:1px solid var(--border)"><input id="fx_t1" placeholder=""></td><td style="border:1px solid var(--border)"><input id="fx_u1" placeholder="min" style="width:60px"></td><td style="border:1px solid var(--border)"><input id="fx_d1" placeholder="✓"></td></tr>
                <tr><td style="border:1px solid var(--border);font-weight:600;color:#8B4513">高</td><td style="border:1px solid var(--border)"><input id="fx_t2" placeholder=""></td><td style="border:1px solid var(--border)"><input id="fx_u2" placeholder="min" style="width:60px"></td><td style="border:1px solid var(--border)"><input id="fx_d2" placeholder="✓"></td></tr>
                <tr><td style="border:1px solid var(--border);font-weight:600;color:#4A3427">中</td><td style="border:1px solid var(--border)"><input id="fx_t3" placeholder=""></td><td style="border:1px solid var(--border)"><input id="fx_u3" placeholder="min" style="width:60px"></td><td style="border:1px solid var(--border)"><input id="fx_d3" placeholder="✓"></td></tr>
                <tr><td style="border:1px solid var(--border);font-weight:600;color:#5F5E5A">低</td><td style="border:1px solid var(--border)"><input id="fx_t4" placeholder=""></td><td style="border:1px solid var(--border)"><input id="fx_u4" placeholder="min" style="width:60px"></td><td style="border:1px solid var(--border)"><input id="fx_d4" placeholder="✓"></td></tr>
