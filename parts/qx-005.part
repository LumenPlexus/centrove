n;text-overflow:ellipsis">即兴演讲</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b40262&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#43524A,#6B7A72);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">远见</div><div style="font-size:9px;opacity:.8;text-align:center">布赖恩·费瑟斯通豪</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">职业</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">远见</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b96046&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#43524A,#6B7A72);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">深度工作</div><div style="font-size:9px;opacity:.8;text-align:center">卡尔·纽波特</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">职业</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">深度工作</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b10872&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#3A4038,#6B7267);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">乌合之众</div><div style="font-size:9px;opacity:.8;text-align:center">古斯塔夫·勒庞</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">社会</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">乌合之众</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b55288&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#3A4038,#6B7267);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">社会性动物</div><div style="font-size:9px;opacity:.8;text-align:center">埃利奥特·阿伦森</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">社会</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">社会性动物</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b72184&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#92400E,#D97706);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">指数基金投资指南</div><div style="font-size:9px;opacity:.8;text-align:center">银行螺丝钉</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">理财</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">指数基金投资指南</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b64898&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#7A5426,#C2A15E);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">三体</div><div style="font-size:9px;opacity:.8;text-align:center">刘慈欣</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">文学</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">三体</div></div><div style="cursor:pointer" onclick="showBookDetail(&#39;b52186&#39;)"><div style="width:100%;aspect-ratio:3/4;background:linear-gradient(135deg,#7A5426,#C2A15E);border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:8px;box-shadow:2px 2px 8px rgba(0,0,0,.15);transition:transform .2s" onmouseover="this.style.transform=&#39;translateY(-4px)&#39;" onmouseout="this.style.transform=&#39;none&#39;"><div style="font-size:12px;font-weight:700;text-align:center;line-height:1.3;margin-bottom:6px">小王子</div><div style="font-size:9px;opacity:.8;text-align:center">圣埃克苏佩里</div><div style="width:30px;height:1px;background:rgba(255,255,255,.4);margin:6px 0"></div><div style="font-size:9px;opacity:.7">文学</div></div><div style="font-size:11px;color:var(--hint);margin-top:4px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">小王子</div></div></div>
      </div>

      <div class="card" style="margin-top:16px">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>添加我的书 · 想读什么加什么（自动保存）</h3>
        <p style="font-size:12px;color:var(--hint);margin-bottom:10px">第一步：点下方"去选书"进微信读书挑书（或复制任意阅读链接）；第二步：把书名（和链接）填进表单点"加入"；以后在精选书单里点封面→"点击阅读"直接开读。</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
          <a class="btn btn-sm btn-primary" href="https://weread.qq.com/" target="_blank" rel="noopener noreferrer">去选书 · 微信读书 ↗</a>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px">
          <input id="bookTitleIn" placeholder="书名（必填）" style="flex:2;min-width:150px">
          <input id="bookAuthorIn" placeholder="作者" style="flex:1;min-width:100px">
          <select id="bookCatIn" style="width:96px">
            <option value="学习">学习</option><option value="认知">认知</option><option value="心理">心理</option><option value="成长">成长</option><option value="沟通">沟通</option><option value="职业">职业</option><option value="社会">社会</option><option value="理财">理财</option><option value="文学">文学</option><option value="国学">国学</option>
          </select>
        </div>
        <input id="bookLinkIn" placeholder="阅读链接（选填，不填则自动跳微信读书搜索该书）" style="margin-bottom:8px">
        <input id="bookQuotesIn" placeholder="书中语录（选填，用逗号分隔多条）" style="margin-bottom:8px">
        <button class="btn btn-primary btn-sm" onclick="addBook()">加入我的书架</button>
        <span style="font-size:12px;color:var(--hint);margin-left:8px">加入后显示在上方"精选书单"里，永久保存、点封面即可阅读</span>
      </div>

      <div class="card" style="margin-top:16px;display:none" id="bookDetailBox">
        <h3 id="bookDetailTitle"></h3>
        <button class="btn btn-sm" style="float:right" onclick="document.getElementById(&#39;bookDetailBox&#39;).style.display=&#39;none&#39;">关闭</button>
        <div id="bookDetailContent" style="margin-top:12px"></div>
      </div>
          <div class="card" style="margin-top:16px">
        <h3>读书笔记（随手记 · 与书架联动）</h3>
        <p style="font-size:13px;color:var(--muted)">随手记录金句 / 观点 / 应用 / 行动，与书架联动。</p>
        <div style="margin-top:10px">
          <input id="bookNoteTitle" placeholder="书名" style="margin-bottom:8px">
          <textarea id="bookNoteText" placeholder="金句摘抄 / 核心观点 / 可应用场景 / 顿悟时刻" style="min-height:80px"></textarea>
          <div style="display:flex;gap:8px;margin-top:8px">
            <button class="btn btn-primary btn-sm" onclick="addBookNote()">保存笔记</button>
          </div>
        </div>
        <div id="bookNoteList" style="margin-top:12px"><p style="color:var(--hint);font-size:13px">还没有读书笔记</p></div>
      </div>
    </section>

    <!-- 数据设置 -->

    <section class="view" id="view-tpl">
<div class="section-intro">拿来即用的专项模板，省去你重复制作表格的时间。直接填、随时改，都是你自己的积累。</div>
      <div class="page-head">
        <h1><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="13" x2="15" y2="13"></line><line x1="9" y1="17" x2="15" y2="17"></line></svg>专项模板</h1>
        <p>考研 / 考公 / 法考 · 阶段计划 + 每日任务 + 复盘表</p>
      </div>
            <div id="tplContent" style="display: block;">
        <div class="tabs" style="display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap">
          <button class="btn btn-sm btn-primary" onclick="switchTpl(&#39;ky&#39;)">考研模板</button>
          <button class="btn btn-sm" onclick="switchTpl(&#39;gk&#39;)">考公模板</button>
          <button class="btn btn-sm" onclick="switchTpl(&#39;fk&#39;)">法考模板</button>
          <button class="btn btn-sm" onclick="switchTpl(&#39;fx&#39;)">通用模板</button>
          <button class="btn btn-sm" onclick="switchTpl(&#39;lw&#39;)">课程论文</button>
        </div>

        <!-- ═══════════ 考研 ═══════════ -->
        <div id="tplKy">
          <div class="card">
            <h3>📚 考研 · 全年四阶段作战计划</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">阶段</th><th style="padding:8px;border:1px solid var(--border)">时间</th><th style="padding:8px;border:1px solid var(--border)">每日任务</th><th style="padding:8px;border:1px solid var(--border)">月底自检</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>基础期</b></td><td style="padding:8px;border:1px solid var(--border)">3-6月</td><td style="padding:8px;border:1px solid var(--border)">单词80个/天+长难句5句；数学教材20页+例题；专业课第一遍通读</td><td style="padding:8px;border:1px solid var(--border)">单词过完1轮；数学过半；专业课框架图完成</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>强化期</b></td><td style="padding:8px;border:1px solid var(--border)">7-8月</td><td style="padding:8px;border:1px solid var(--border)">英语真题阅读2篇精做；数学真题按套刷；政治网课1节；专业课背诵</td><td style="padding:8px;border:1px solid var(--border)">英语真题到2015年；数学完成一轮；专业课背完一遍</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>冲刺期</b></td><td style="padding:8px;border:1px solid var(--border)">9-11月</td><td style="padding:8px;border:1px solid var(--border)">英语作文每周2篇；数学二刷三刷；政治背诵30页/天；专业课二轮</td><td style="padding:8px;border:1px solid var(--border)">英语刷完2遍；肖八完成；专业课真题过1遍</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>考前</b></td><td style="padding:8px;border:1px solid var(--border)">12月</td><td style="padding:8px;border:1px solid var(--border)">全真模拟；错题重刷；肖四背诵；调作息到考试节奏</td><td style="padding:8px;border:1px solid var(--border)">模拟3次以上；肖四大题背完</td></tr>
            </tbody></table>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>考研避坑指南（过来人的经验）</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li>❌ 不要"收藏即学会"：资料存了10个G，一个没看完=0</li>
              <li>❌ 不要比进度：别人二轮了不用慌，按自己节奏来</li>
              <li>❌ 不要三天打鱼：宁可每天6小时雷打不动，也别一天12小时歇三天</li>
              <li>✅ 英语单词每天不能断，断了就断崖</li>
              <li>✅ 数学真题至少刷2遍，错题本比新题重要</li>
              <li>✅ 每周日留半天复盘+休息，防 burnout</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>🎤 考研 · 复试面试避坑 + 准备清单</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li>✅ 中英文自我介绍各1分钟+3分钟版，背到脱口而出</li>
              <li>✅ 必准备3问：为什么选这个学校/专业？读研规划？本科代表经历？</li>
              <li>✅ 专业课问答：初试笔记过一遍+看导师近3年论文摘要</li>
              <li>❌ 别背"空话模板"（"我热爱学习"），用具体事例说话</li>
              <li>❌ 别答非所问：先复述问题再答，冷静慢说</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>🧰 考研 · 备考工具箱（免费为主）</h3>
            <div class="grid grid-2">
              <div>
                <h4>APP / 网站</h4>
                <ul style="font-size:13px;color:var(--muted);line-height:1.9">
                  <li><b>墨墨背单词</b>：艾宾浩斯自动排期，考研词库全</li>
                  <li><b>Anki</b>：自制错题卡，数学公式/专业课背诵神器</li>
                  <li><b>中国研究生招生信息网（研招网）</b>：报名+调剂唯一官方入口 yz.chsi.com.cn</li>
                  <li><b>B站</b>：唐迟阅读、徐涛政治、汤家凤数学，全程免费</li>
                </ul>
              </div>
              <div>
                <h4>每月重点资源</h4>
                <ul style="font-size:13px;color:var(--muted);line-height:1.9">
                  <li><b>3-5月</b>：目标院校官网下载近3年招生简章+专业课大纲</li>
                  <li><b>7-8月</b>：各科强化网课+真题第一轮</li>
                  <li><b>9月</b>：关注研招网招生简章变动+预报名</li>
                  <li><b>10月</b>：正式报名（只报一次，逾期不可补）</li>
                  <li><b>11月</b>：网上确认（拍照+证件，逾期不能考试）</li>
                  <li><b>12月</b>：打印准考证（多打几份备用）</li>
                </ul>
              </div>
            </div>
            <div class="callout callout-ok" style="margin-top:8px">信息差就是分数差：每年都有人因漏看"网上确定"错过考试。把研招网、目标院校研究生院官网加进浏览器收藏夹，每周刷一次。</div>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>🍱 考研党健康底线（别熬垮）</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li>每天睡够6.5小时，比多学2小时划算——睡眠是记忆固化时间</li>
              <li>每坐1小时起身3分钟，护腰也护专注力</li>
              <li>焦虑时别刷"考研倒计时"毒鸡汤，按计划走自己的</li>
              <li>每周留半天彻底休息，防 burnout（耗尽）比冲刺更重要</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>✏️ 我的周学习计划表（可填·可存·可打印）</h3>
            <p style="font-size:12px;color:var(--hint);margin-bottom:10px">填好点"保存"，下次打开还在；点"打印"可导出纸质版贴桌上。</p>
            <div id="kyWeekPlan">
              <table style="width:100%;border-collapse:collapse;font-size:13px">
                <tbody><tr style="background:#EFE8D8"><th style="padding:6px;border:1px solid var(--border);width:64px">星期</th><th style="padding:6px;border:1px solid var(--border)">上午（专注时段）</th><th style="padding:6px;border:1px solid var(--border)">下午</th><th style="padding:6px;border:1px solid var(--border)">晚上复盘</th></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周一</td><td style="border:1px solid var(--border)"><input id="ky_1a" placeholder="如 08-10 数学强化"></td><td style="border:1px solid var(--border)"><input id="ky_1p" placeholder="如 14-16 英语阅读"></td><td style="border:1px solid var(--border)"><input id="ky_1e" placeholder="错题整理"></td></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周二</td><td style="border:1px solid var(--border)"><input id="ky_2a" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_2p" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_2e" placeholder=""></td></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周三</td><td style="border:1px solid var(--border)"><input id="ky_3a" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_3p" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_3e" placeholder=""></td></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周四</td><td style="border:1px solid var(--border)"><input id="ky_4a" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_4p" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_4e" placeholder=""></td></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周五</td><td style="border:1px solid var(--border)"><input id="ky_5a" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_5p" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_5e" placeholder=""></td></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周六</td><td style="border:1px solid var(--border)"><input id="ky_6a" placeholder="真题模考"></td><td style="border:1px solid var(--border)"><input id="ky_6p" placeholder=""></td><td style="border:1px solid var(--border)"><input id="ky_6e" placeholder="本周总结"></td></tr>
                <tr><td style="padding:6px;border:1px solid var(--border);font-weight:600">周日</td><td style="border:1px solid var(--border)"><input id="ky_7a" placeholder="休整"></td><td style="border:1px solid var(--border)"><input id="ky_7p" placeholder="下周计划"></td><td style="border:1px solid var(--border)"><input id="ky_7e" placeholder=""></td></tr>
              </tbody></table>
            </div>
            <div style="display:flex;gap:10px;margin-top:10px">
              <button class="btn btn-primary btn-sm" onclick="saveTplForm('kyWeekPlan')">保存</button>
              <button class="btn btn-ghost btn-sm" onclick="printTpl('kyWeekPlan')">打印</button>
            </div>
          </div>
        </div>

        <!-- ═══════════ 考公 ═══════════ -->
        <div id="tplGk" style="display:none">
          <div class="card">
            <h3>🏛 考公 · 行测申论双线作战计划</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">阶段</th><th style="padding:8px;border:1px solid var(--border)">时间</th><th style="padding:8px;border:1px solid var(--border)">行测</th><th style="padding:8px;border:1px solid var(--border)">申论</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>打基础</b></td><td style="padding:8px;border:1px solid var(--border)">第1-2月</td><td style="padding:8px;border:1px solid var(--border)">言语/判断/数量/资料四模块听课+专项刷题（每天50题）</td><td style="padding:8px;border:1px solid var(--border)">了解题型；每周2篇小题练习</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>刷题期</b></td><td style="padding:8px;border:1px solid var(--border)">第3-4月</td><td style="padding:8px;border:1px solid var(--border)">每日一套真题（掐90分钟）；错题按模块整理</td><td style="padding:8px;border:1px solid var(--border)">大作文每周1篇；积累规范表达</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>冲刺期</b></td><td style="padding:8px;border:1px solid var(--border)">考前1月</td><td style="padding:8px;border:1px solid var(--border)">全真模拟（含涂卡）；攻薄弱模块</td><td style="padding:8px;border:1px solid var(--border)">背时政+素材；按考场时间写大作文</td></tr>
            </tbody></table>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>行测五大模块 · 提分策略</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">模块</th><th style="padding:8px;border:1px solid var(--border)">分值占比</th><th style="padding:8px;border:1px solid var(--border)">提分策略</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">常识判断</td><td style="padding:8px;border:1px solid var(--border)">20%</td><td style="padding:8px;border:1px solid var(--border)">平时积累为主，考前过时政，不强求</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">言语理解</td><td style="padding:8px;border:1px solid var(--border)">32%</td><td style="padding:8px;border:1px solid var(--border)">逻辑填空靠积累，片段阅读学"结构法"</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">数量关系</td><td style="padding:8px;border:1px solid var(--border)">13%</td><td style="padding:8px;border:1px solid var(--border)">只做擅长题型，其余蒙C保时间</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">判断推理</td><td style="padding:8px;border:1px solid var(--border)">25%</td><td style="padding:8px;border:1px solid var(--border)">图形推理刷题型库，逻辑判断学方法</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">资料分析</td><td style="padding:8px;border:1px solid var(--border)">10%</td><td style="padding:8px;border:1px solid var(--border)">最易拿分！练到90%正确率，背速算技巧</td></tr>
            </tbody></table>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>申论提分要点</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li>✅ 小题答案抄原文关键词，不自己发挥</li>
              <li>✅ 大作文用"总-分-总"结构，开头点题结尾升华</li>
              <li>✅ 每周积累10条规范表达（乡村振兴/民生/法治）</li>
              <li>✅ 字迹工整=隐形加分，练字20分钟/天</li>
              <li>❌ 别背万能模板，阅卷老师一眼识破</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>🎯 考公 · 面试（结构化）每日一练</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">题型</th><th style="padding:8px;border:1px solid var(--border)">答题框架</th><th style="padding:8px;border:1px solid var(--border)">高频真题</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>综合分析</b></td><td style="padding:8px;border:1px solid var(--border)">亮明观点→分析原因/影响→提对策→结合自身</td><td style="padding:8px;border:1px solid var(--border)">"对基层干部'躺平'现象怎么看"</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>组织计划</b></td><td style="padding:8px;border:1px solid var(--border)">事前→事中→事后</td><td style="padding:8px;border:1px solid var(--border)">"组织一次社区反诈宣传"</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>应急应变</b></td><td style="padding:8px;border:1px solid var(--border)">先稳现场→分情况→事后反思</td><td style="padding:8px;border:1px solid var(--border)">"群众在大厅情绪激动大吵，你怎么办"</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>人际沟通</b></td><td style="padding:8px;border:1px solid var(--border)">态度诚恳→换位思考→主动沟通</td><td style="padding:8px;border:1px solid var(--border)">"领导批评你工作不细致，你怎么办"</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>岗位认知</b></td><td style="padding:8px;border:1px solid var(--border)">为什么考→我能做什么→入职后怎么做</td><td style="padding:8px;border:1px solid var(--border)">"你报考本岗位的优势和不足"</td></tr>
            </tbody></table>
            <div style="background:#FFF8EF;border-radius:8px;padding:10px 14px;font-size:13px;color:var(--muted);margin-top:8px"><b>每日一练：</b>每天挑1题，对着手机录3分钟答题视频，回看找口头禅和眼神飘忽，练21天形成肌肉记忆。</div>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>🗺 考公 · 选岗策略（考得好不如报得巧）</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">策略</th><th style="padding:8px;border:1px solid var(--border)">怎么用</th><th style="padding:8px;border:1px solid var(--border)">效果</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>限制越多越好</b></td><td style="padding:8px;border:1px solid var(--border)">优先选"仅限应届+党员+专业对口"的岗，竞争比直线降</td><td style="padding:8px;border:1px solid var(--border)">报录比可从1000:1降到30:1</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>看历年进面分</b></td><td style="padding:8px;border:1px solid var(--border)">查近3年该岗进面分数线，对照自己模考水平</td><td style="padding:8px;border:1px solid var(--border)">避免"高分岗"炮灰</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>地域权衡</b></td><td style="padding:8px;border:1px solid var(--border)">家乡岗热、偏远岗冷，结合自身意愿选</td><td style="padding:8px;border:1px solid var(--border)">性价比优先</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>避开"三不限"</b></td><td style="padding:8px;border:1px solid var(--border)">不限专业/学历/户籍的岗神仙打架，非必要不报</td><td style="padding:8px;border:1px solid var(--border)">减少无谓内卷</td></tr>
            </tbody></table>
            <div class="callout callout-info" style="margin-top:8px"><b>报名节奏：</b>报名前3天别急着报（看每天报名人数统计选竞争小的时段），但也别拖到最后一天——万一审核不通过没时间改。</div>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>📅 考公 · 全年关键节点</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li><b>国考</b>：10月报名 → 11月底笔试 → 次年1月面试</li>
              <li><b>省考</b>：多在2-3月报名 → 3-4月笔试（联考省份同日）</li>
              <li><b>选调生</b>：11-12月报名（仅限应届，竞争小、起点高，重点关注！）</li>
              <li><b>事业单位</b>：各地全年分散，关注人社局官网</li>
              <li><b>应届身份</b>：毕业2年内未就业仍算应届，是考公最大红利，别轻易放弃</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>✏️ 我的选岗对比表（可填·可存·可打印）</h3>
            <p style="font-size:12px;color:var(--hint);margin-bottom:10px">把心仪岗位列出来横向对比，别凭感觉报。填好可保存/打印。</p>
            <div id="gkJobs">
              <table style="width:100%;border-collapse:collapse;font-size:13px">
                <tbody><tr style="background:#EFE8D8"><th style="padding:6px;border:1px solid var(--border)">岗位</th><th style="padding:6px;border:1px solid var(--border)">限制条件</th><th style="padding:6px;border:1px solid var(--border)">历年进面分</th><th style="padding:6px;border:1px solid var(--border)">我的胜算</th></tr>
                <tr><td style="border:1px solid var(--border)"><input id="gk_j1" placeholder="如 某市局-科员"></td><td style="border:1px solid var(--border)"><input id="gk_c1" placeholder="应届+法学"></td><td style="border:1px solid var(--border)"><input id="gk_s1" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_w1" placeholder="高/中/低"></td></tr>
                <tr><td style="border:1px solid var(--border)"><input id="gk_j2" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_c2" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_s2" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_w2" placeholder=""></td></tr>
                <tr><td style="border:1px solid var(--border)"><input id="gk_j3" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_c3" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_s3" placeholder=""></td><td style="border:1px solid var(--border)"><input id="gk_w3" placeholder=""></td></tr>
              </tbody></table>
            </div>
            <div style="display:flex;gap:10px;margin-top:10px">
              <button class="btn btn-primary btn-sm" onclick="saveTplForm('gkJobs')">保存</button>
              <button class="btn btn-ghost btn-sm" onclick="printTpl('gkJobs')">打印</button>
            </div>
          </div>
        </div>

        <!-- ═══════════ 法考 ═══════════ -->
        <div id="tplFk" style="display:none">
          <div class="card">
            <h3>⚖ 法考 · 客观题+主观题全程计划</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">阶段</th><th style="padding:8px;border:1px solid var(--border)">时间</th><th style="padding:8px;border:1px solid var(--border)">任务</th><th style="padding:8px;border:1px solid var(--border)">自检标准</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>先修轮</b></td><td style="padding:8px;border:1px solid var(--border)">3-4月</td><td style="padding:8px;border:1px solid var(--border)">刑法/民法精讲+真题；民诉/刑诉听精讲</td><td style="padding:8px;border:1px solid var(--border)">刑法民法正确率60%+</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>系统轮</b></td><td style="padding:8px;border:1px solid var(--border)">5-7月</td><td style="padding:8px;border:1px solid var(--border)">八科系统过一遍；每日刷题100道；背诵卷开背</td><td style="padding:8px;border:1px solid var(--border)">真题4000+完成；背诵卷过2遍</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><b>冲刺轮</b></td><td style="padding:8px;border:1px solid var(--border)">8-9月</td><td style="padding:8px;border:1px solid var(--border)">真题二刷错题；主观题案例练习；法条定位训练</td><td style="padding:8px;border:1px solid var(--border)">客观题模拟200分+；主观题每天1道</td></tr>
            </tbody></table>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>客观题八大科目 · 复习顺序建议</h3>
            <p style="font-size:13.5px;color:var(--muted);line-height:1.9"><b>第一梯队（拿分主力）</b>：刑法→民法→民诉→刑诉<br><b>第二梯队</b>：行政法→商经知<br><b>第三梯队（性价比）</b>：理论法→三国法（背多分，后期突击）</p>
            <div style="background:#EFE8D8;border-radius:8px;padding:10px 14px;font-size:13px;color:var(--muted);margin-top:8px"><b>每日刷题节奏：</b>早30道刑法/民法→午20道民诉/刑诉→晚30道行政/商经+复盘→周末各科轮一遍</div>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>主观题答题模板（案例题）</h3>
            <div style="background:#EFE8D8;border-radius:8px;padding:12px 16px;font-size:13px;color:var(--muted);line-height:1.9">
              <b>结构：结论→法律依据→案情分析→结论重申</b><br>
              ① <b>结论</b>：本案中张三构成/不构成XX罪；<br>
              ② <b>依据</b>：依据《刑法》第XX条，……（引用法条关键词）；<br>
              ③ <b>分析</b>：张三实施了……，符合/不符合该罪构成要件；<br>
              ④ <b>重申</b>：应以XX罪定罪处罚。<br><br>
              <b>练习频率</b>：每天1道刑法案例+1道民法案例，20天见效。
            </div>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>📌 法考 · 每日一题 + 学习避坑</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li>❌ 不要"只听不练"：听完课当天刷对应真题</li>
              <li>❌ 不要盲目刷题量：错题不复盘=白刷，每周重做一遍</li>
              <li>✅ 优先保"背多分"科目：理论法/三国法/商经知后期最快</li>
              <li>✅ 主观题从7月就开练，别等客观题考完</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>🎓 法考 · 主流老师推荐（按科目）</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
              <tbody><tr style="background:#EFE8D8"><th style="padding:8px;border:1px solid var(--border)">科目</th><th style="padding:8px;border:1px solid var(--border)">推荐老师</th><th style="padding:8px;border:1px solid var(--border)">特点</th></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">刑法</td><td style="padding:8px;border:1px solid var(--border)">柏浪涛 / 徐光华</td><td style="padding:8px;border:1px solid var(--border)">体系清晰、二选一即可</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">民法</td><td style="padding:8px;border:1px solid var(--border)">李建伟 / 张翔</td><td style="padding:8px;border:1px solid var(--border)">精讲细致，适合打基础</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">刑诉</td><td style="padding:8px;border:1px solid var(--border)">左宁 / 向高甲</td><td style="padding:8px;border:1px solid var(--border)">口诀好记</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">民诉</td><td style="padding:8px;border:1px solid var(--border)">戴鹏</td><td style="padding:8px;border:1px solid var(--border)">图表化，理解派首选</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">行政法</td><td style="padding:8px;border:1px solid var(--border)">李佳</td><td style="padding:8px;border:1px solid var(--border)">幽默通俗</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">商经知</td><td style="padding:8px;border:1px solid var(--border)">郄鹏恩</td><td style="padding:8px;border:1px solid var(--border)">结构强</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">理论法</td><td style="padding:8px;border:1px solid var(--border)">马峰 / 杜洪波</td><td style="padding:8px;border:1px solid var(--border)">背多分科目，后期突击</td></tr>
            </tbody></table>
            <div class="callout callout-warn" style="margin-top:8px">选老师遵循"一科一师、跟到底"，别中途换，也别贪多——资料在精不在全。B站均有免费精讲，先试听再决定。</div>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>📖 主观题 · 法条定位训练</h3>
            <ul style="font-size:13.5px;color:var(--muted);line-height:2">
              <li><b>主观题开卷</b>：可查《法律法规汇编》，但考场上翻不到=没带</li>
              <li><b>训练法</b>：每刷一道案例，先默想要引用的法条，再翻书定位，记"目录层级"而非全文</li>
              <li><b>高频法条</b>：刑法总则犯罪构成、民法典合同/侵权、行政处罚法、公司法重点条</li>
              <li><b>电子版</b>：电脑端用 Ctrl+F 搜关键词，平时就用电子法条练习，适应机考</li>
            </ul>
          </div>
          <div class="card" style="margin-top:14px">
            <h3>✏️ 我的法考打卡表（可填·可存·可打印）</h3>
            <p style="font-size:12px;color:var(--hint);margin-bottom:10px">每天勾一勾学了哪科，坚持看得见。填好可保存/打印。</p>
            <div id="fkTrack">
              <table style="width:100%;border-collapse:collapse;font-size:13px">
