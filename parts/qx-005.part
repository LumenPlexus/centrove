              <tr><td style="padding:8px;border:1px solid var(--border)">资料员</td><td style="padding:8px;border:1px solid var(--border)">查文献/数据，建共享文档</td><td style="padding:8px;border:1px solid var(--border)">第3天</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">撰写员</td><td style="padding:8px;border:1px solid var(--border)">写初稿，统一格式</td><td style="padding:8px;border:1px solid var(--border)">第7天</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)">汇报人</td><td style="padding:8px;border:1px solid var(--border)">做PPT+答辩演练</td><td style="padding:8px;border:1px solid var(--border)">第10天</td></tr>
