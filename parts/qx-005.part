              <tr><td style="padding:8px;border:1px solid var(--border)"><span class="tag tag-coral">高</span></td><td style="padding:8px;border:1px solid var(--border)">＿＿＿＿＿＿</td><td style="padding:8px;border:1px solid var(--border)">＿＿min</td><td style="padding:8px;border:1px solid var(--border)">□</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><span class="tag tag-blue">中</span></td><td style="padding:8px;border:1px solid var(--border)">＿＿＿＿＿＿</td><td style="padding:8px;border:1px solid var(--border)">＿＿min</td><td style="padding:8px;border:1px solid var(--border)">□</td></tr>
              <tr><td style="padding:8px;border:1px solid var(--border)"><span class="tag tag-gray">低</span></td><td style="padding:8px;border:1px solid var(--border)">＿＿＿＿＿＿</td><td style="padding:8px;border:1px solid var(--border)">＿＿min</td><td style="padding:8px;border:1px solid var(--border)">□</td></tr>
