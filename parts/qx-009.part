var _origInit = init;
init = function(){
  try{ _origInit(); }catch(e){ console.error('origInit',e); }
  try{ applySavedTheme(); }catch(e){}
  /* 还原桌面端侧边栏收起态（用户偏好持久化） */
  try{
    if(window.matchMedia&&window.matchMedia('(min-width:769px)').matches&&localStorage.getItem('pp_sidebar_collapsed')==='1'){
      document.body.classList.add('sidebar-collapsed');
    }
  }catch(e){}
  try{ renderExamCountdowns(); }catch(e){}
  try{ renderContestTimeline(); }catch(e){}
  try{ renderBaoyanTimeline(); }catch(e){}
  try{ renderHabits(); }catch(e){}
  try{ renderHabitHeatmap(); }catch(e){}
  try{ renderInterviewQuestions(); }catch(e){}
  try{ renderResumeTracks(); }catch(e){}
  try{ if(!document.getElementById('gpaRows').children.length) gpaAddRow(false); }catch(e){}
  try{ updateStats(); }catch(e){ console.error('updateStats',e); }
};





init();

/* ── 微信首次进入的一次性安抚提示（过了"将要访问"拦截页后马上显示一次） ── */
(function(){
  try{
    if(!/MicroMessenger/i.test(navigator.userAgent||''))return;
    var k='pp_wx_tip';
    var shown=localStorage.getItem(k);
    if(shown)return;
    try{ localStorage.setItem(k,'1'); }catch(e){}
    setTimeout(function(){
      try{
        var tip=document.getElementById('flashSplash')||document.getElementById('brandSplash');
        if(tip){ tip.style.display='flex'; }
        if(window.flash){
          window.flash('👋 欢迎进入栖匣！刚才那条「非官方网页」提示是微信的安全机制，第一次点「继续访问」即可，以后一般不再弹出。');
        }
      }catch(e){}
    },600);
  }catch(e){}
})();
</script>




<script>
function openQrPreview(img){
  var p=document.getElementById('qrPreview');
  var i=document.getElementById('qrPreviewImg');
  if(!p||!i)return;
  i.src=img.src||img.currentSrc||'';
  p.classList.add('show');
}
function closeQrPreview(){var p=document.getElementById('qrPreview');if(p)p.classList.remove('show');}
function saveQrPreview(){
  var i=document.getElementById('qrPreviewImg');
  if(!i||!i.src)return;
  var a=document.createElement('a');
  a.href=i.src;a.download='centrove-qr';
  document.body.appendChild(a);a.click();document.body.removeChild(a);
  try{closeQrPreview();flash('已保存/开始下载图片，去微信扫一扫或识别即可');}catch(e){}
}
document.addEventListener('keydown',function(e){if(e.key==='Escape')closeQrPreview();});

/* ═══════ 自动保存机制：编辑即存，防丢失 ═══════ */
(function(){
  var saveTimer=null;
  function autoSaveEdit(el){
    if(!el.dataset.autoSaveKey) return;
    clearTimeout(saveTimer);
    saveTimer=setTimeout(function(){
      localStorage.setItem('pp_edit_'+el.dataset.autoSaveKey, el.innerHTML);
    },500);
  }
  document.addEventListener('input', function(e){
    if(e.target.isContentEditable||e.target.contentEditable==='true'){
      autoSaveEdit(e.target);
    }
  }, true);
  /* 页面关闭前最后保存一次 */
  window.addEventListener('beforeunload', function(){
    document.querySelectorAll('[contenteditable=true],[contenteditable="true"]').forEach(function(el){
      if(el.dataset.autoSaveKey){
        localStorage.setItem('pp_edit_'+el.dataset.autoSaveKey, el.innerHTML);
      }
    });
  });
})();

/* ═══════ 定期自动备份 + 一键恢复（防丢失保险） ═══════ */
(function(){
  var DAY=function(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');};
  /* 快照：把非「界面偏好」的用户数据整体备份 */
  function snapshotAllData(){
    var out={};
    try{
      var keep=[];
      try{keep=(window._UI_PRESERVED&&window._UI_PRESERVED())||[];}catch(ke){}
      for(var i=0;i<localStorage.length;i++){
        var k=localStorage.key(i);
        if(keep.indexOf(k)>=0)continue;
        if(k.indexOf('pp_autobackup')===0)continue;
        out[k]=localStorage.getItem(k);
      }
    }catch(e){}
    return out;
  }
  function label(t){
    try{return new Date(t).toLocaleString('zh-CN',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'});}catch(e){return String(t||'');}
  }
  function updateInfo(t){
    var el=document.getElementById('autoBackupInfo');
    if(el&&t){el.textContent='✓ 最近自动备份：'+label(t)+'　·　保留最近 7 天，可随时一键恢复（本机存储，仅存你设备）';}
  }
  /* 执行一次自动备份 */
  window.performAutoBackup=function(force){
    if(force===undefined)force=false;
    var payload=snapshotAllData(),now=new Date();
    try{localStorage.setItem('pp_autobackup',JSON.stringify({t:now.toISOString(),d:payload}));}catch(e){}
    try{
      var hist=[],h=localStorage.getItem('pp_autobackup_history');
      if(h){try{hist=JSON.parse(h)||[];}catch(e){hist=[];}}
      hist.push({t:now.toISOString(),d:payload});
      while(hist.length>7)hist.shift();
      try{localStorage.setItem('pp_autobackup_history',JSON.stringify(hist));}
      catch(quotaErr){ /* 空间不足：逐条丢掉最旧的，直到能写入 */
        while(hist.length>0){hist.shift();try{localStorage.setItem('pp_autobackup_history',JSON.stringify(hist));break;}catch(x){continue;}}
      }
    }catch(e){}
    try{localStorage.setItem('pp_autobackup_last',now.toISOString());}catch(e){}
    updateInfo(now.toISOString());
    if(force){
      try{
        var _kb=(JSON.stringify(payload).length/1024).toFixed(1);
        var _cnt=Object.keys(payload).length;
        if(window.flash)flash('✓ 已备份到本机（此设备的浏览器存储，不上传任何服务器）· 含 '+_cnt+' 项填写数据，约 '+_kb+' KB，保留最近 7 天，可随时一键恢复');
      }catch(e){try{if(window.flash)flash('✓ 已立即备份到本机');}catch(x){}}
    }
    return true;
  };
  /* 从最近自动备份恢复 */
  window.restoreAutoBackup=function(){
    var raw=null;try{raw=localStorage.getItem('pp_autobackup');}catch(e){}
    if(!raw){window.uiAlert&&uiAlert('⚠️ 还没有可用自动备份\n\n只有产生过自动备份后才能恢复。可先点「立即备份一次」创建一个，或用「导出全部数据」手动备份。');return;}
    var bk=null;try{bk=JSON.parse(raw);}catch(e){}
    if(!bk||!bk.d||typeof bk.d!=='object'){window.uiAlert&&uiAlert('⚠️ 自动备份文件异常，无法恢复。\n建议改用「导出/导入」的 JSON 完整备份。');return;}
    function restoreAllData(map){
      var keep=[];
      try{keep=(window._UI_PRESERVED&&window._UI_PRESERVED())||[];}catch(ke){}
      try{
        var del=[];
        for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(keep.indexOf(k)>=0)continue;if(k.indexOf('pp_autobackup')===0)continue;del.push(k);}
        for(var j=0;j<del.length;j++)localStorage.removeItem(del[j]);
        for(var m in map){if(keep.indexOf(m)<0&&m.indexOf('pp_autobackup')!==0)localStorage.setItem(m,map[m]);}
      }catch(e){}
    }
    if(window.uiConfirm){uiConfirm('确定用『最近自动备份（'+label(bk.t)+'）』覆盖当前数据吗？\n仅恢复你的填写内容与记录，不影响产品框架。',function(){restoreAllData(bk.d);try{location.reload();}catch(e){}});}
  };
  /* 启动：同一天已备份则仅更新提示，否则立即自动备份一次 */
  try{
    var last=localStorage.getItem('pp_autobackup_last');
    if(last&&new Date(last).getFullYear()+'-'+String(new Date(last).getMonth()+1).padStart(2,'0')+'-'+String(new Date(last).getDate()).padStart(2,'0')===DAY()){
      var cur=null;try{var rr=localStorage.getItem('pp_autobackup');if(rr)cur=JSON.parse(rr);}catch(e){}
      updateInfo(cur&&cur.t?cur.t:last);
    }else{
      performAutoBackup(false);
    }
  }catch(e){}
})();

</script>
