[data-theme="dark"] #mobileSidebarHint{background:var(--card)!important;border-color:var(--border)!important;color:var(--text)!important}
[data-theme="dark"] #mobileSidebarHint span[style*="676760"]{color:var(--muted)!important}
[data-theme="dark"] .tag-gold{background:rgba(184,134,11,.18);color:#F0CE6E}
[data-theme="dark"] .tag-gray{background:rgba(95,94,90,.2);color:var(--muted)}
[data-theme="dark"] .bm-qr-note{background:rgba(122,115,99,.15);color:#E2D8C4;border-color:var(--teal-mid)}
[data-theme="dark"] #privBox{background:rgba(122,115,99,.16)!important;border-color:var(--teal-mid)!important;color:var(--text)!important}
[data-theme="dark"] #timetablePalette .btn{box-shadow:0 0 0 1px rgba(255,255,255,.06)}
@media(prefers-color-scheme:dark){}
[data-theme="dark"] .card[style*="135deg"][style*="#6E4F37"]{background:linear-gradient(135deg,#5C4030,#3A271A)!important}
</style>

<!-- ═══════ v2.6 增强：复制链接 / 页脚署名 / 隐私与承载力首屏提示 / 热力图与考试说明 ═══════ -->
<script>
(function(){
  function flashOk(m){try{window.flash&&window.flash(m);}catch(e){}}
  function legacyCopy(t,ok){try{var ta=document.createElement('textarea');ta.value=t;ta.style.cssText='position:fixed;left:-9999px;opacity:0';document.body.appendChild(ta);ta.select();try{document.execCommand('copy');}catch(e){}document.body.removeChild(ta);flashOk(ok||'已复制');}catch(e){flashOk('复制失败，请手动选择复制');}}
  function copyText(t,ok){try{if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(t).then(function(){flashOk(ok||'已复制');},function(){legacyCopy(t,ok)});}else{legacyCopy(t,ok);}}catch(e){legacyCopy(t,ok);}}
  window.copyProductLink=function(){copyText('https://lumenplexus.github.io/centrove/','已复制产品链接，直接发给朋友即可打开');
    return false;};

  /* 页脚署名：致敬作者 + 防抄袭明示 + 隐私数据说明 */
  function footer(){
    var main=document.querySelector('.main');if(!main||main.querySelector('.pp-credit'))return;
    var _n=new Date(),_Y=_n.getFullYear(),_MM=String(_n.getMonth()+1).padStart(2,'0');
    var f=document.createElement('div');f.className='pp-credit';
    f.style.cssText='position:relative;margin-top:26px;padding:30px 18px 20px;text-align:center;border-radius:20px;overflow:hidden;background:linear-gradient(160deg,var(--primary-light) 0%,var(--surface) 100%);border:1px solid var(--border);box-shadow:var(--shadow-sm)';
    f.innerHTML=
      '<div style="position:absolute;left:26px;right:26px;top:0;height:2px;background:linear-gradient(90deg,rgba(124,100,60,0) 0%,rgba(124,100,60,.30) 25%,rgba(124,100,60,.30) 75%,rgba(124,100,60,0) 100%);border-radius:0 0 4px 4px;opacity:.55"></div>'+
      '<div style="position:absolute;left:-40px;top:-40px;width:190px;height:190px;border-radius:50%;background:radial-gradient(circle,rgba(179,133,70,.12),rgba(255,255,255,0) 70%)"></div>'+
      '<div style="position:absolute;right:-56px;bottom:-56px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(179,133,70,.12),rgba(255,255,255,0) 70%)"></div>'+
      '<div style="position:absolute;top:12px;left:16px">'+
        '<span style="font-size:11px;letter-spacing:3px;color:var(--hint)">栖匣｜收纳成长诸事，步步趋近心中所向</span>'+
      '</div>'+
      '<div style="position:relative;margin:14px auto 0;width:66px;height:66px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1.5px solid var(--primary);background:var(--card);box-shadow:0 0 0 6px var(--primary-light);overflow:hidden">'+
        '<img src="pwa/logo-chest20260911.png" alt="栖匣" style="width:60px;height:60px;border-radius:50%;display:block" onerror="logoFallback(this)">'+
      '</div>'+
      '<div style="margin-top:13px;font-size:22px;font-weight:800;letter-spacing:4px;color:var(--primary-strong)">栖匣<span style="font-size:12.5px;letter-spacing:3px;font-weight:400;color:var(--hint)"> · 心有所栖 · 匣纳成长</span></div>'+
      '<div style="margin:10px auto 6px;font-size:14px;color:var(--text);line-height:1.85;max-width:520px">你见过很多工具。<br>而这一页，为长期记录成长的人而造。</div>'+
      '<div style="margin:6px auto 16px;max-width:560px;display:flex;flex-direction:column;gap:9px;text-align:left;font-size:12.5px;color:var(--muted);line-height:1.7">'+
        '<div style="display:flex;gap:9px;align-items:flex-start;padding:11px 13px;border-radius:11px;background:var(--card);border:1px solid var(--border-strong)"><span style="font-size:15px">🗂️</span><span><b style="color:var(--primary-strong)">一页收纳，长期不乱</b>——数十个板块，从入学规划到职业方向，全在这里。</span></div>'+
        '<div style="display:flex;gap:9px;align-items:flex-start;padding:11px 13px;border-radius:11px;background:var(--card);border:1px solid var(--border-strong)"><span style="font-size:15px">🔒</span><span><b style="color:var(--primary-strong)">只存你手，退出即散</b>——无账号、无云端、无后台，关掉页面，谁都不知道你的记录。</span></div>'+
        '<div style="display:flex;gap:9px;align-items:flex-start;padding:11px 13px;border-radius:11px;background:var(--card);border:1px solid var(--border-strong)"><span style="font-size:15px">♻️</span><span><b style="color:var(--primary-strong)">年份在走，信息不陈旧</b>——考试、政策、活动逐年自新，永远跟你学校的年历一起走。</span></div>'+
      '</div>'+
      '<div style="font-size:12.5px;color:var(--muted)">设计 · 开发 · <b style="font-size:15px;color:var(--primary-strong)">尹平平</b> · 独立原创</div>'+
      '<div style="margin:16px auto;width:60%;height:1px;background:linear-gradient(90deg,rgba(0,0,0,0),var(--border-strong),rgba(0,0,0,0))"></div>'+
      ''+
      '<div style="padding:13px 15px;border-radius:13px;background:var(--card);border:1px solid var(--border-strong);font-size:12px;color:var(--muted);line-height:1.85;text-align:left;margin-top:14px">🔎 <b style="color:var(--text)">时效说明：</b>站内考试 / 报名 / 活动 / 政策等参考信息，均整理自各官方权威来源，核验于 <b style="color:var(--primary-strong);text-decoration:underline" id="ppReviewDate">'+_Y+' 年 '+_MM+' 月</b>；本声明随新学年 <b style="color:var(--primary-strong);font-weight:800">自动更新</b>，使用前请以各官方当年最新通知为准。</div>'+
      '<div style="margin-top:13px;font-size:10.5px;color:var(--hint);line-height:1.7">© '+_Y+' 尹平平 · 栖匣 · 心有所栖 · 匣纳成长 · 保留所有权利 · 受《中华人民共和国著作权法》保护，未获书面授权禁止整站复制、搬运或另作商业用途。唯一正版地址即当前链接。</div>';
    main.appendChild(f);
  }

  /* 隐私透明 + 多人在线承载说明：已合并进新版4步导览步骤1的「隐私透明声明」+「关于栖匣」，
     不再单独弹顶栏横幅，避免首发时多套引导叠加、抢占首屏。函数保留备手动调用。 */
  function priv(){
    return;
    /* 点击「知道了」后永久收起，不再重复打扰：优先 localStorage 持久标记，并做异常兜底 */
    try{if(typeof localStorage==='undefined')return;}catch(e){return;}
    try{if(localStorage.getItem('pp_priv_done'))return;}catch(e){return;}
    var main=document.querySelector('.main');if(!main)return;
    var box=document.createElement('div');box.id='privBox';
    box.style.cssText='margin:10px 16px 0;padding:9px 12px;border-radius:10px;background:var(--teal-light);border:1px solid var(--border-strong);color:var(--teal);font-size:12.5px;line-height:1.75';
    box.innerHTML='🔒 <b>隐私透明：</b>本应用是纯前端应用，<b>后台/作者看不到你的任何记录，也不上传、不收集任何数据</b>（一切只存在你的浏览器）。<b>承载能力：</b>纯静态网页、无后端服务器，<b>多少人同时打开都各用各的、互相不影响、不卡顿</b>。 <span id="privDismiss" style="cursor:pointer;font-weight:700;text-decoration:underline;white-space:nowrap">知道了 ✕</span>';
    main.insertBefore(box, main.firstChild);
    var d=document.getElementById('privDismiss');
    if(d)d.addEventListener('click',function(){var p=document.getElementById('privBox');if(p)p.remove();try{localStorage.setItem('pp_priv_done','1');}catch(e){}});
  }

  /* 「今日三件事」旧版上手指引：已完成使命，其“安放焦虑/锚定长线/拆分行动”内核由新版4步导览步骤2承接，
     不再自动插入卡片，避免与导览叠层。函数保留备手动调用。 */
  function quickstart(){
    return;
    try{if(typeof localStorage==='undefined'||localStorage.getItem('pp_quickstart_ok'))return;}catch(e){return;}
    var main=document.querySelector('.main');if(!main)return;
    if(document.getElementById('qsBox'))return;
    var box=document.createElement('div');box.id='qsBox';
    box.style.cssText='position:relative;margin:10px 16px 2px;padding:13px 15px;border-radius:13px;background:linear-gradient(135deg,var(--primary-light),var(--card));border:1px solid var(--border-strong);font-size:13px;line-height:1.7;color:var(--text)';
    box.innerHTML=
      '<div style="font-weight:700;font-size:14.5px;color:var(--text)">👋 刚进来，别急着逛完<span style="font-weight:400;opacity:.78;font-size:12.5px">——今天只慢慢做成这三件事</span></div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:9px">'+
        '<button onclick="window.qsGo(\'timer\')" style="justify-content:center;align-items:center;display:inline-flex;gap:5px;padding:7px 13px;border-radius:9px;border:1px solid var(--primary-mid);background:var(--card);color:var(--text);font-size:12.5px;cursor:pointer">1 · ⏱️ 先专注25分钟</button>'+
        '<button onclick="window.qsGo(\'creative\')" style="justify-content:center;align-items:center;display:inline-flex;gap:5px;padding:7px 13px;border-radius:9px;border:1px solid var(--primary-mid);background:var(--card);color:var(--text);font-size:12.5px;cursor:pointer">2 · 💡 记一条灵感</button>'+
        '<button onclick="window.qsGo(\'journal\')" style="justify-content:center;align-items:center;display:inline-flex;gap:5px;padding:7px 13px;border-radius:9px;border:1px solid var(--primary-mid);background:var(--card);color:var(--text);font-size:12.5px;cursor:pointer">3 · 📝 做完再复盘</button>'+
      '</div>'+
      '<div style="margin-top:9px;opacity:.8;font-size:11.5px;color:var(--text)">顺序是有讲究的：先专注做成一件小事，做的时候冒出想法就顺手记下，等今天收尾了再复盘这一天——复盘放在最后，才不会"什么都没做就急着交作业"。剩下的 30 多个板块<span style="font-weight:600">不用一次看完</span>——哪天想用了，再从侧边栏按需点开即可，不看也不影响。所有内容都能改、都能撤，数据只存在你自己的设备里。</div>'+
      '<span style="position:absolute;top:9px;right:13px;cursor:pointer;font-size:11px;opacity:.6;color:var(--hint);background:none;border:0" onclick="window.qsGo(\'\')">跳过 ✕</span>';
    main.insertBefore(box, main.firstChild);
  }
  function qsGo(v){
    /* 点击「记灵感 / 写复盘 / 做专注」行动按钮：只跳转到对应板块，卡片保留，等待用户主动「跳过」 */
    if(v){if(typeof switchView==='function')switchView(v);else{try{location.hash='#view-'+v;}catch(e){}}return;}
    /* 点击「跳过 ✕」：才真正关闭卡片并永久标记，不再打扰 */
    try{localStorage.setItem('pp_quickstart_ok','1');}catch(e){}
    var b=document.getElementById('qsBox');if(b)b.remove();
  }
  /* 暴露到全局：让“新手上手”3个按钮在行内 onclick 中可直接调用，修复「点了没反应」 */
  window.qsGo=qsGo;

  function init(){footer();quickstart();priv();}

  /* ── 防盗用 / 溯源（防止被别人整站复制、套皮、冒名发布）────────────────── */
  (function antiTheft(){
    try{
      /* 1) 破框防盗：若本页被人用 iframe 套进“壳”里展示（跨域），主动跳出，避免被拿来当自己的 */
      if(window.self!==window.top){
        var blocked=false;
        try{ blocked=(window.top.location.host!==location.host); }
        catch(e){ blocked=true; }
        if(blocked){
          try{ window.top.location=window.self.location.href; }
          catch(e2){ try{window.location.href='about:blank';}catch(e3){} }
        }
      }
    }catch(e){}
    try{
      /* 2) 溯源指纹：埋一条作者痕迹到 DOM 与 localStorage，判定“是否官方原版”可据此比对 */
      var tag=document.createElement('div');
      tag.className='pp-trace';
      tag.style.cssText='display:none';
      tag.setAttribute('data-author','尹平平');
      tag.setAttribute('data-app','centrove');
      tag.setAttribute('data-copyhost',location.host);
      tag.setAttribute('data-birth',new Date().toISOString().slice(0,19));
      document.body.appendChild(tag);
    }catch(e){}
    try{
      /* 3) 控制台声明作者（视觉化的原创印记） */
      if(window.console&&console.info){console.info('%c栖匣 %c原创作者：尹平平 · 请尊重原创著作权','color:#6E4F37;font-weight:bold;font-size:14px','color:#C2A15E;font-size:11px');}
    }catch(e){}
  })();
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
})();
</script>

<!-- ═══════ v2.7 移动端表格横向滚动（修复中文竖向拆字） + 外链复制兜底 ═══════ -->
<style>
  /* 所有表格在窄屏下允许横向滑动，单元格不再被挤压成"单字竖排"；
     但"综测/升学/材料清单"等含长文本的表格必须允许换行，否则内容被截断（"每门i"/"挑2-3"）。 */
  @media (max-width:768px){
    .view table{display:block;width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;border-collapse:collapse}
    /* 默认允许换行，避免长文本列被截断 */
    .view table th,.view table td{white-space:normal;word-break:break-word}
    /* 时间表/倒计时/打卡等"纯短格子"表格保留不换行，保持紧凑工整 */
    #timetable td,#timetable th,
    .grid table th,.grid table td{white-space:nowrap;word-break:keep-all}
    /* 一周时间表：必须保持表格语义（display:table），否则格子点不了、无法填色 */
    #timetable{display:table;overflow:visible}
    #timetable td,#timetable th{white-space:normal;word-break:break-word}
  }
  .view table{max-width:100%}
  /* 竞答表格：给"认证/入口"列留足空间 */
  .view table td:first-child,.view table th:first-child{white-space:normal;min-width:72px}
  .tbl-scroll-hint{display:none;font-size:11px;color:var(--hint);margin:2px 2px 8px;text-align:right;user-select:none}
  @media (max-width:768px){ .tbl-scroll-hint.on{display:block} }
</style>
<script>
(function(){
  /* 宽表格横向滚动提示：仅当该表格在窄屏下确实横向溢出时，才在表格上方追加「左右滑动查看完整表格」小字 */
  function hintTables(){
    var hintEl=document.getElementById('qxTblHint');
    if(!hintEl){hintEl=document.createElement('div');hintEl.id='qxTblHint';hintEl.className='tbl-scroll-hint';document.body.appendChild(hintEl);}
    var tables=document.querySelectorAll('.view.active table');
    var target=null;
    if(window.innerWidth<=768){
      for(var i=0;i<tables.length;i++){
        var t=tables[i];if(t.className&&/timetable/.test(t.className||''))continue;
        try{if(t.scrollWidth>t.clientWidth+4){target=t;break;}}catch(e){}
      }
    }
    if(target){
      hintEl.classList.add('on');
      // 将提示插到目标表格同卡片内的表格正上方（若已有则不重复）
      if(hintEl.dataTarget!==target){hintEl.dataTarget=target;hintEl.textContent='↔ 左右滑动查看完整表格';}
      var p=target.parentNode;if(p&&p.firstChild!==hintEl&&!p.querySelector('.tbl-scroll-hint')){p.insertBefore(hintEl,target);}
    }else{hintEl.classList.remove('on');hintEl.dataTarget=null;}
  }
  window.qxHintTables=hintTables;
  var t0=null;
  document.addEventListener('DOMContentLoaded',function(){clearTimeout(t0);t0=setTimeout(hintTables,400);});
  // 板块切换/窗口缩放后重新计算
  document.addEventListener('click',function(){clearTimeout(t0);t0=setTimeout(hintTables,250);});
  window.addEventListener('resize',function(){clearTimeout(t0);t0=setTimeout(hintTables,200);});
  // 切换视图后调用
  var ov=window.switchView;
  window.switchView=function(){clearTimeout(t0);var r=ov&&ov.apply(window,arguments);t0=setTimeout(hintTables,300);return r;};
  // 兜底：动态渲染的表格（切换下拉/视角后）也会被识别
  var ti=setInterval(function(){if(window.innerWidth<=768)hintTables();},1400);
})();
</script>
<script>
(function(){
  /* 外链统一处理：所有链接"点击即打开"，不弹复制面板、不拦截跳转。
     1) http 明文链接一律自动升级为 https（微信 WebView 会拦截 http ，升级后即可直接打开）；
     2) 微信内点击外链 → 直接在本页跳转打开（不再提示"切换系统浏览器"）；
     3) 普通浏览器 → 保留原 target=_blank 新标签打开。
     链接的本体始终是"我原来的网址"，从不改写成中转/跳转地址，长按复制得到的也是原网址。 */
  function isWeixin(){return /MicroMessenger/i.test(navigator.userAgent||'');}
  function fix(){
    try{
      var links=document.querySelectorAll('a[href]');
      for(var i=0;i<links.length;i++){
        var a=links[i];if(a.getAttribute('data-extok'))continue;
        var h=(a.getAttribute('href')||'').trim();
        if(h.indexOf('http://')===0){h='https://'+h.slice(7);a.setAttribute('href',h);}
        if(/^https?:\/\//.test(h)){
          a.setAttribute('data-extok','1');
          /* 外链打开统一由全局安全处理器接管（新窗口/新标签，本应用页始终存活可返回）；
             不再在此处做 location 整页跳转，避免点击外链后整站退出。 */
        }
      }
    }catch(e){}
  }
  fix();
  setInterval(fix,3000);
  /* 外链的「安全打开 / 安全直达」已统一收口到前面（约 7149 段）的全局点击处理器：
     普通浏览器新标签直达官方站；微信/QQ 等内嵌浏览器弹「安全直达」面板（复制+搜索），
     规避白屏与风险弹窗。此处不再单独注册捕获阶段处理器，以免与全局处理器冲突、
     导致点击外链时无限递归爆栈（此前外链点击打不开的根因）。 */
})();
</script>

<style>
/* 今日知识 · 四个分类标签：统一分段式胶囊，图标居中、同尺寸、对齐基线（兼容浅/深主题） */
.knowledge-tabs{display:flex;gap:8px;flex-wrap:nowrap;margin-bottom:14px}
.k-tab{
  flex:1 1 0;min-width:0;display:flex;flex-direction:column;align-items:center;gap:5px;
  padding:10px 4px 8px;border-radius:12px;border:1px solid transparent;
  background:transparent;color:var(--muted,#8C7863);cursor:pointer;font-family:inherit;
  font-size:12px;line-height:1;transition:background .18s ease,color .18s ease,border-color .18s ease,transform .14s ease;
}
.k-tab svg{width:22px;height:22px;color:var(--muted,#8C7863);transition:color .18s ease}
.k-tab span{font-size:12px;font-weight:600;letter-spacing:.02em}
.k-tab:hover{background:rgba(179,133,70,.10);color:var(--text,#4A3427)}
.k-tab:hover svg{color:#8A6A3A}
.k-tab.active{
  background:linear-gradient(140deg,#6E4F37,#57422F);border-color:#6E4F37;
  color:#F5ECD8;box-shadow:0 6px 16px rgba(74,58,40,.22);
}
.k-tab.active svg{color:#F0D9A8}
[data-theme="dark"] .k-tab{color:#B8A98E;border-color:#332A20}
[data-theme="dark"] .k-tab svg{color:#B8A98E}
[data-theme="dark"] .k-tab:hover{background:rgba(200,160,92,.12);color:#E8D5B8}
[data-theme="dark"] .k-tab.active{background:linear-gradient(140deg,#7A5B39,#5C4430);border-color:#8A6A3A;color:#F0E7D8}
[data-theme="dark"] .k-tab.active svg{color:#F0D9A8}
/* 今日心语刷新按钮 */
.mind-refresh{font-size:12.5px;border:1px solid var(--border,#E5DBC8);background:var(--card,#fff);color:var(--primary,#4A3427);padding:5px 12px;border-radius:999px;cursor:pointer;font-family:inherit;transition:background .2s,color .2s}
.mind-refresh:hover{background:var(--primary-light,#F1EBDD)}
.mind-refresh.spinning{animation:spinr .45s ease}
@keyframes spinr{from{transform:rotate(0)}to{transform:rotate(360deg)}}
/* ═══════════ 产品介绍弹窗 · 重构版（现代高级 · 品牌蓝绿 · 系统无衬线字体） ═══════════ */
.pano-mask{position:fixed;inset:0;background:rgba(28,22,14,.62);z-index:14;opacity:0;pointer-events:none;transition:opacity .35s ease}
.pano{position:fixed;inset:0;z-index:16;color:#33291F;overflow-y:auto;overscroll-behavior:contain;opacity:0;pointer-events:none;transition:opacity .45s ease;line-height:1.8;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Segoe UI",sans-serif;
  background:
    radial-gradient(1000px 520px at 6% -8%,rgba(194,174,150,.12),transparent 58%),
    radial-gradient(900px 480px at 100% 4%,rgba(173,124,63,.10),transparent 55%),
    radial-gradient(1100px 640px at 50% 112%,rgba(194,174,150,.08),transparent 55%),
    linear-gradient(180deg,#FAF7F0 0%,#FFFBF5 30%,#FCF9F3 62%,#F5F0E6 100%)}
.pano.show,.pano-mask.show{opacity:1;pointer-events:auto}
/* ── 封面首屏（轻透高级：留白呼吸·暖木匣纸点缀，与全站风格一致） ── */
.pano-hero{position:relative;min-height:auto;padding:30px 20px 46px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;overflow:hidden;border-radius:26px 26px 42px 42px;border:1px solid rgba(168,132,72,.26);outline:1px solid rgba(111,79,55,.08);outline-offset:-7px;color:#4A3A2C;box-shadow:0 26px 60px rgba(74,58,40,.14)}
.pano-hero::before{content:"";position:absolute;inset:0;z-index:0;background:
  radial-gradient(720px 380px at 10% -14%,rgba(177,159,110,.16),transparent 62%),
  radial-gradient(680px 400px at 100% -6%,rgba(148,120,58,.13),transparent 60%),
  radial-gradient(900px 560px at 50% 132%,rgba(168,132,72,.12),transparent 56%),
  linear-gradient(168deg,#F3ECDC 0%,#F7F1E3 38%,#F4F0E2 72%,#EDEFE2 100%)}
.pano-hero::after{content:"";position:absolute;right:-90px;top:-90px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(148,120,58,.14),transparent 62%);z-index:0}
.pano-hero>*{position:relative;z-index:1}
.pano-hero .glow{position:absolute;left:-70px;bottom:-80px;transform:none;width:360px;height:230px;background:radial-gradient(60% 60% at 50% 50%,rgba(168,132,72,.10),transparent 68%);z-index:0}
.pano-hero .eyebrow{font-size:12px;letter-spacing:.42em;color:#A07D3E;text-indent:.42em;margin:26px 0 20px;animation:panoUp .7s .1s both;text-transform:uppercase;background:rgba(168,132,72,.10);border:1px solid rgba(168,132,72,.32);display:inline-block;padding:7px 16px;border-radius:999px}
/* ── 封面首屏：创意顶部造型（非单一平直边，垂坠丝带 Logo 印章 + 波浪上沿 + 漂浮装饰） ── */
.pt-topscallop{position:absolute;top:0;left:0;right:0;height:30px;z-index:0;opacity:.8;background:
  radial-gradient(24px 18px at 6% 2px,rgba(168,132,72,.16) 49%,transparent 51%),
  radial-gradient(24px 18px at 16% 2px,rgba(158,132,84,.13) 49%,transparent 51%),
  radial-gradient(24px 18px at 26% 2px,rgba(168,132,72,.16) 49%,transparent 51%),
  radial-gradient(24px 18px at 36% 2px,rgba(158,132,84,.13) 49%,transparent 51%),
  radial-gradient(24px 18px at 46% 2px,rgba(168,132,72,.16) 49%,transparent 51%),
  radial-gradient(24px 18px at 56% 2px,rgba(158,132,84,.13) 49%,transparent 51%),
  radial-gradient(24px 18px at 66% 2px,rgba(168,132,72,.16) 49%,transparent 51%),
  radial-gradient(24px 18px at 76% 2px,rgba(158,132,84,.13) 49%,transparent 51%),
  radial-gradient(24px 18px at 86% 2px,rgba(168,132,72,.16) 49%,transparent 51%),
  radial-gradient(24px 18px at 96% 2px,rgba(158,132,84,.13) 49%,transparent 51%)}
.pt-sash{position:relative;z-index:1;display:inline-flex;align-items:center;gap:10px;margin:0 auto 20px;background:linear-gradient(120deg,#5B4532,#4A3A2C 60%,#5B4532);color:#F5F1E4;padding:6px 20px 7px 7px;border-radius:0 0 14px 14px;box-shadow:0 8px 20px rgba(40,48,42,.22);animation:panoUp .7s .02s both}
.pt-sash::before{content:"";position:absolute;left:-9px;top:0;width:9px;height:9px;background:radial-gradient(circle at top left,#5B4532 60%,transparent 60%);}
.pt-sash::after{content:"";position:absolute;right:-9px;top:0;width:9px;height:9px;background:radial-gradient(circle at top right,#5B4532 60%,transparent 60%);}
.pt-seal{display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:7px;background:linear-gradient(135deg,#E0C188,#A9803F);color:#3A2C0F;font-weight:800;font-size:13px;box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 4px 10px rgba(0,0,0,.20)}
.pt-name{font-weight:700;font-size:12.5px;letter-spacing:.3em;text-indent:.3em;color:#F5F1E4}
.pt-name-premium{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:9px 16px;justify-content:center;align-items:center;margin:2px 0 20px;max-width:620px}
.pm-pair{display:flex;align-items:baseline;gap:8px}
.pm-pair b{font-family:Georgia,'Times New Roman',serif;font-weight:600;font-size:14px;letter-spacing:.16em;color:#A0813F}
.pm-pair i{font-style:normal;font-size:11px;letter-spacing:.16em;text-indent:.16em;color:#7B8379}
.pm-x{color:#93A08B;font-family:Georgia,serif;font-size:12px}
.pm-verse{flex-basis:100%;font-size:12.5px;line-height:1.9;color:#5C645C;letter-spacing:.04em;margin-top:2px}
.pm-verse em{font-style:normal;color:#A0813F;letter-spacing:.1em}
.pt-sash i{width:26px;height:1px;background:linear-gradient(90deg,rgba(255,255,255,.6),transparent)}
.pt-deco{position:absolute;z-index:0;border-radius:50%;border:1px solid rgba(109,136,115,.25);pointer-events:none}
.pt-deco::after{content:"";position:absolute;inset:4px;border-radius:50%;border:1px dashed rgba(173,124,63,.22)}
.pt-deco.d1{width:46px;height:46px;left:8%;top:34%;animation:panofloat 5s ease-in-out infinite}
.pt-deco.d2{width:30px;height:30px;right:9%;top:28%;border-color:rgba(173,124,63,.26);animation:panofloat 6s .8s ease-in-out infinite}
.pt-deco.d3{width:20px;height:20px;left:14%;bottom:26%;border-color:rgba(245,158,11,.3);animation:panofloat 4.6s .4s ease-in-out infinite}
@keyframes panofloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.pano-hero h1.pano-h1{margin:0;font-weight:700;font-family:"Noto Serif SC","Songti SC","STSong",serif;font-size:clamp(27px,4.4vw,46px);line-height:1.42;letter-spacing:.04em;color:#33291F;animation:panoUp .7s .22s both;text-shadow:0 2px 14px rgba(120,110,80,.12)}
.pano-hero h1 .thin{font-weight:400;color:#8C7863;display:inline-block;margin-top:4px}
.pano-h1 .pano-grow{font-style:normal;color:#6A4E1F;position:relative;white-space:nowrap;text-shadow:0 2px 12px rgba(160,120,50,.16)}
.pano-h1 .pano-grow::after{content:"";position:absolute;left:3%;right:6%;bottom:4px;height:14px;background:linear-gradient(90deg,rgba(184,142,60,0),rgba(184,142,60,.38),rgba(184,142,60,.22),rgba(184,142,60,0));border-radius:99px;z-index:-1}
.pano-hero .dek{font-size:clamp(15px,2.4vw,17.5px);color:#4A5A56;max-width:640px;margin:28px auto 0;line-height:2.1;animation:panoUp .7s .34s both;text-shadow:none}
.pano-hero .dek b,.pano-hero .dek em{color:#6A4E1F;font-weight:700}
.pano-hero .hr-dot{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:34px;animation:panoUp .7s .46s both}
.pano-hero .hr-dot i{width:46px;height:2px;background:linear-gradient(90deg,transparent,rgba(148,120,58,.7));border-radius:2px}
.pano-hero .hr-dot i.rt{background:linear-gradient(90deg,rgba(148,120,58,.7),transparent)}
.pano-hero .hr-dot .dm{color:#8A6A2D;font-size:12px;letter-spacing:8px;text-indent:8px}
.pano-stats{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:760px;margin:42px auto 0;animation:panoUp .7s .58s both}
.pano-stats span{display:flex;align-items:center;justify-content:center;gap:9px;flex:1 1 150px;max-width:220px;background:rgba(255,252,242,.75);border:1px solid rgba(140,118,70,.32);box-shadow:0 6px 18px rgba(80,75,55,.10);padding:14px 10px;border-radius:999px;font-size:12.5px;color:#4A5A56;letter-spacing:.5px;text-align:center;line-height:1.4}
.pano-stats b{color:#8A6A2D;font-size:22px;font-weight:800;letter-spacing:.5px;line-height:1;font-family:Georgia,"Times New Roman",serif}
/* 导览入场动画：默认可见底色，动画仅作增强；动画不生效时内容也不隐藏 */
@keyframes panoUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
/* 正文容器：桌面大屏用更宽的画布，抵消空旷感 */
.pano-inner{max-width:min(1120px,100%);margin:0 auto;padding:0 clamp(18px,4vw,46px) 40px;position:relative;z-index:2}
/* 平板/电脑：封面纵向占满视口，内容垂直居中，消除“内容堆在上方、下方一大片空”的空洞感 */
@media(min-width:769px){
  .pano-inner{max-width:min(1260px,100%)}
  .pano-hero{min-height:calc(100vh - 96px)}
  .pano-lead{max-width:780px}      /* 桌面适度放宽说明文，减少两侧空隙 */
  .pano-feat{max-width:1120px}     /* 桌面特性网格更好地铺满有效区域 */
  .pano-matrix{max-width:1120px}
}
/* 导览在桌面/平板端与左侧导航栏完全对齐：内容居中于“边栏右侧”的有效区域，
   避免左侧文字被边栏遮住、右侧因全窗居中而空出一大块（对应 .main 的 margin-left 偏移） */
@media(min-width:1025px){#pano{left:184px}}                                 /* 桌面默认：边栏 184px */
@media(min-width:769px) and (max-width:1024px){#pano{left:190px}}           /* 平板：边栏 190px */
@media(min-width:1240px){#pano{left:210px}}                                 /* 宽屏：边栏 210px */
body.sidebar-collapsed #pano{left:0}                                        /* 边栏收起时导览占满全宽 */
.pano-sec{padding:64px 0 10px;position:relative}
.pano-sec>h2,.pano-sec-ctr>h2{animation:panoUp .6s .05s both}
/* 章节眉标 */
.pano-no{display:flex;align-items:center;gap:12px;color:#4A3427;font-size:12px;letter-spacing:.26em;text-transform:uppercase;font-weight:700}
.pano-no .rn{font-family:Georgia,"Times New Roman",serif;font-style:italic;font-size:22px;font-weight:700;color:#B08A44;letter-spacing:0}
.pano-no::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,#C9A45E,#E5DBC8);margin:0 4px}
.pano-sec-ctr{text-align:center}
.pano-sec-ctr .pano-no{justify-content:center}
.pano-sec-ctr .pano-no::after{display:none}
.pano-h2{font-weight:600;font-family:"Noto Serif SC","Songti SC","STSong",serif;font-size:clamp(23px,3.7vw,32px);margin:20px 0 16px;line-height:1.5;letter-spacing:.03em;color:#33291F}
.pano-h2 em{font-style:normal;color:#6E4F37}
.pano-lead{color:#6E6353;font-size:15px;max-width:680px;line-height:2.1;margin:0 auto}
/* 它是什么 · 四重承诺 */
.pano-feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:14px;margin:36px auto 0;max-width:960px;text-align:left}
.pano-ft{background:#FFFFFF;border:1px solid #EBDCC2;border-radius:15px;padding:22px 20px 20px;box-shadow:0 10px 26px rgba(74,58,40,.06);transition:.25s}
.pano-ft:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(74,58,40,.12)}
.pano-ft .fi{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:11px;background:linear-gradient(140deg,#FDF6E8,#F5EFE2);font-size:19px;margin-bottom:12px}
.pano-ft b{display:block;color:#33291F;font-size:14px;font-weight:800;letter-spacing:.01em;margin-bottom:6px}
.pano-ft p{color:#8C7863;font-size:12.5px;line-height:1.85;margin:0}
.pano-lead b,.pano-lead strong{color:#4A3427;font-weight:700}
/* 分隔线 */
.pano-rule{display:flex;align-items:center;justify-content:center;gap:14px;margin:38px 0 0;color:#B08A44}
.pano-rule .ln{flex:0 0 30px;height:2px;background:linear-gradient(90deg,transparent,#C9A45E);border-radius:2px}
.pano-rule .ln.r{background:linear-gradient(90deg,#C9A45E,transparent)}
.pano-rule .d{font-size:13px;color:#B08A44;letter-spacing:6px;text-indent:6px}
/* 大引言 */
.pano-quote{margin:72px 0 6px;text-align:center;position:relative;padding:56px 40px;background:linear-gradient(150deg,#FBF4E6,#F6EDD8);border:1px solid rgba(173,124,63,.16);border-radius:20px;box-shadow:0 28px 56px rgba(74,58,40,.08)}
.pano-quote::before{content:"“";position:absolute;left:34px;top:6px;font-size:90px;line-height:1;color:rgba(173,124,63,.14);font-family:Georgia,serif}
.pano-quote p{font-size:clamp(20px,3.4vw,27px);color:#33291F;line-height:2;max-width:640px;margin:0 auto;letter-spacing:.03em;font-weight:700}
.pano-quote .by{display:block;margin-top:26px;color:#6E4F37;font-size:11.5px;letter-spacing:.36em;text-transform:uppercase}
/* 能力卡片 */
.pano-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin-top:32px}
.pano-card{background:#FFFFFF;border:1px solid #EBDCC2;border-radius:16px;padding:28px 24px 24px;box-shadow:0 10px 28px rgba(74,58,40,.06);transition:.3s;cursor:default;position:relative;overflow:hidden}
.pano-card::before{content:"";position:absolute;left:0;top:0;height:3px;width:100%;background:linear-gradient(90deg,#C9A45E,#6E4F37);opacity:0;transition:.4s}
.pano-card:hover{transform:translateY(-5px);box-shadow:0 22px 44px rgba(74,58,40,.12)}
.pano-card:hover::before{opacity:1}
.pano-card .ic{width:48px;height:48px;border-radius:12px;background:linear-gradient(140deg,#4A3427,#C9A45E);display:flex;align-items:center;justify-content:center;color:#FFFFFF;font-size:22px;line-height:1;box-shadow:0 10px 20px rgba(74,58,40,.26)}
.pano-card .chip{position:absolute;right:16px;top:18px;font-size:10px;color:#6E4F37;border:1px solid rgba(122,115,99,.28);padding:2px 10px;letter-spacing:.14em;background:rgba(122,115,99,.06);border-radius:6px}
.pano-card h4{font-size:17px;color:#33291F;margin:16px 0 8px;font-weight:700;letter-spacing:.02em}
.pano-card p{font-size:13px;color:#677A6E;line-height:1.95;margin:0}
/* 对比卡片 */
.pano-compare{margin-top:32px;display:grid;grid-template-columns:1fr 1fr;gap:18px}
.pano-cp{padding:30px 28px 26px;position:relative;transition:.3s;border-radius:16px}
.pano-cp.no{background:#FCF8EC;border:1px solid #E2D9C0;box-shadow:0 10px 26px rgba(100,90,60,.07)}
.pano-cp.yes{background:linear-gradient(150deg,#FBF6E8,#F7F0DF 45%,#F4EDDB);border:1px solid #CFC29A;color:#33291F;box-shadow:0 22px 44px rgba(100,86,40,.10)}
.pano-cp h4{font-size:18px;margin:8px 0 2px;letter-spacing:.02em;font-weight:800}
.pano-cp .tag{font-size:10.5px;letter-spacing:.22em;color:#6E4F37;font-weight:700;text-transform:uppercase}
.pano-cp.yes .tag{color:#8A6A2D}
.pano-cp.no .tag{color:#8C7863}
.pano-cp ul{list-style:none;margin:16px 0 0;padding:0}
.pano-cp.no ul{color:#8C7863}
.pano-cp.yes ul{color:#6B5E51}
.pano-cp li{padding-left:18px;position:relative;font-size:13.8px;line-height:2.1}
.pano-cp li::before{content:"";position:absolute;left:0;top:1.05em;width:8px;height:8px;border-radius:3px;transform:rotate(45deg);background:#C9A45E}
.pano-cp.yes li::before{background:#B08A44}
/* 持续回报 */
.pano-habit{margin-top:32px;display:grid;grid-template-columns:repeat(auto-fit,minmax(235px,1fr));gap:16px}
.pano-hb{background:#FFFFFF;border:1px solid #EBDCC2;border-radius:16px;padding:28px 22px 24px;box-shadow:0 10px 26px rgba(74,58,40,.06);text-align:center;transition:.28s}
.pano-hb:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(74,58,40,.12)}
.pano-hb .medal{width:58px;height:58px;margin:0 auto 14px;border-radius:50%;background:linear-gradient(140deg,#4A3427,#C9A45E);color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;box-shadow:0 10px 22px rgba(173,124,63,.36)}
.pano-hb h5{color:#33291F;font-size:15.5px;margin:0 0 8px;font-weight:800;letter-spacing:.02em}
.pano-hb p{color:#8C7863;font-size:12.8px;line-height:1.9;margin:0}
/* 设计理念 · 栖 / 匣 */
.pano-concept{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:36px auto 0;max-width:880px;text-align:left}
.pano-cv{display:flex;gap:16px;align-items:flex-start;background:#FFFFFF;border:1px solid #E7DED0;border-radius:18px;padding:26px 24px;box-shadow:0 12px 30px rgba(110,79,55,.07);transition:.28s}
.pano-cv:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(110,79,55,.13)}
.pano-cv .cv-char{flex:none;display:flex;align-items:center;justify-content:center;width:74px;height:92px;border-radius:16px;background:linear-gradient(150deg,#F4EBDD,#EBE1CE);border:1px solid #E8DCC6;font-family:"Kaiti SC","KaiTi","STKaiti",serif;font-size:34px;font-weight:700;color:#6E4F37;line-height:1;box-shadow:inset 0 1px 0 #fff}
.pano-cv[data-side="匣"] .cv-char{color:#5C4030;background:linear-gradient(150deg,#F0E4D2,#E7DAC2)}
.pano-cv .cv-body h5{color:#33291F;font-size:15.5px;font-weight:800;letter-spacing:.03em;margin:2px 0 8px}
.pano-cv .cv-body p{color:#6E5E4E;font-size:13px;line-height:1.95;margin:0}
@media (max-width:560px){.pano-concept{grid-template-columns:1fr}.pano-cv .cv-char{width:60px;height:74px;font-size:28px}}
/* 原则 */
.pano-nolist{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:12px;margin-top:32px}
.pano-ni{background:#FFFFFF;border:1px solid #EBDCC2;border-radius:14px;padding:18px 20px;font-size:13.8px;color:#6E6353;line-height:1.85;transition:.25s;cursor:default;box-shadow:0 8px 22px rgba(74,58,40,.08)}
.pano-ni:hover{border-color:#C9A45E;box-shadow:0 10px 24px rgba(173,124,63,.12);transform:translateY(-2px)}
.pano-ni .x{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:rgba(122,115,99,.1);color:#6E4F37;font-weight:700;margin-right:10px;font-size:12px;flex:none}
/* 适合谁 */
.pano-who{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:32px}
.pano-wi{background:#FFFFFF;border:1px solid #EBDCC2;border-radius:16px;padding:22px 24px;box-shadow:0 8px 24px rgba(74,58,40,.08);transition:.25s;position:relative;border-top:3px solid #C9A45E}
.pano-wi:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(74,58,40,.12)}
.pano-wi b{display:block;color:#4A3427;font-size:15px;margin-bottom:8px;font-weight:800;letter-spacing:.02em}
.pano-wi span{color:#677A6E;font-size:13.5px;line-height:1.95}
/* 上手步骤 */
.pano-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:16px;margin-top:32px}
.pano-step{background:#FFFFFF;border:1px solid #EBDCC2;border-radius:16px;padding:28px 26px;box-shadow:0 10px 26px rgba(74,58,40,.06);transition:.28s}
.pano-step:hover{transform:translateY(-4px);box-shadow:0 18px 38px rgba(74,58,40,.12)}
.pano-step .num{width:44px;height:44px;border-radius:11px;background:linear-gradient(140deg,#4A3427,#C9A45E);color:#FFFFFF;font-weight:800;display:flex;align-items:center;justify-content:center;font-size:19px;margin-bottom:16px;box-shadow:0 10px 20px rgba(173,124,63,.3)}
.pano-step h5{color:#33291F;font-size:15.5px;margin:0 0 8px;font-weight:800;letter-spacing:.02em}
.pano-step p{color:#8C7863;font-size:13px;line-height:1.95;margin:0}
/* ── 收官 CTA · 回到产品本身「栖匣」 —— 暖木留白，与全站色调统一 ── */
.pano-cta{margin:84px 0 0;padding:78px 40px 64px;border-radius:30px;position:relative;overflow:hidden;text-align:center;color:#33291F;
  background:
    radial-gradient(720px 470px at 88% -16%,rgba(201,168,95,.10),transparent 62%),
    radial-gradient(700px 460px at 8% -10%,rgba(110,79,55,.10),transparent 60%),
    radial-gradient(900px 540px at 50% 132%,rgba(110,79,55,.08),transparent 58%),
    linear-gradient(168deg,#F8F2E8 0%,#FAF7F0 40%,#F5EFE2 100%);
  border:1px solid rgba(173,124,63,.22);box-shadow:0 34px 72px rgba(74,58,40,.13)}
/* 底纹：极淡暖木网格 */
.pano-cta::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
  background:
    repeating-linear-gradient(180deg,rgba(110,79,55,.04) 0 1px,transparent 1px 46px),
    radial-gradient(62% 56% at 50% 122%,rgba(110,79,55,.10),transparent 60%)}
.pano-cta::after{content:"";position:absolute;top:-1px;left:50%;transform:translateX(-50%);width:60%;height:2px;
  background:linear-gradient(90deg,transparent,rgba(173,124,63,.85),rgba(173,124,63,.25),rgba(173,124,63,.85),transparent);z-index:2}
.pano-cta>*{position:relative;z-index:2;max-width:760px;margin-left:auto;margin-right:auto}

/* 品牌印记：用栖匣标准 logo 取代朱印 */
.ct-mark img{width:74px;height:74px;border-radius:22px;display:block;margin:0 auto 24px;
  box-shadow:0 14px 30px rgba(74,58,40,.16),0 0 0 1px rgba(173,124,63,.22)}

/* 眉标 */
.ct-eyebrow{display:flex;align-items:center;justify-content:center;gap:12px;margin:0 0 22px;color:#8A6A2D;font-size:12px;letter-spacing:.48em;text-transform:uppercase}

/* 主标：宋体 · 大字 */
.ct-title{font-family:"Noto Serif SC","Songti SC","Source Han Serif SC","STSong","SimSun",serif;font-weight:900;
  font-size:clamp(32px,6vw,50px);letter-spacing:.06em;line-height:1.36;color:#33291F;margin:0 0 12px}
.ct-title em{font-style:normal;color:#B08A44;position:relative;white-space:nowrap}
.ct-title em::after{content:"";position:absolute;left:2%;right:2%;bottom:5px;height:15px;
  background:linear-gradient(90deg,rgba(201,168,95,0),rgba(201,168,95,.5),rgba(201,168,95,.25),rgba(201,168,95,0));
  border-radius:99px;z-index:-1}

/* 引语 */
.ct-lead{color:#6E6353;font-size:15px;max-width:600px;margin:8px auto 24px;line-height:2.15}
.ct-lead b,.ct-lead em{color:#4A3427;font-style:normal;font-weight:700}

/* 承诺：暖木脚注 */
.ct-vows{max-width:520px;margin:6px auto 26px;padding:16px 22px;text-align:left;border-radius:12px;
  background:rgba(255,255,255,.74);border-left:3px solid rgba(173,124,63,.5);
  box-shadow:0 10px 22px rgba(74,58,40,.08)}
.ct-vows div{display:flex;align-items:center;gap:11px;font-size:13.5px;color:#5C4A3A;line-height:1.95}
.ct-vows .vt{width:5px;height:5px;border-radius:50%;background:#6E4F37;flex-shrink:0;box-shadow:0 0 0 3px rgba(173,124,63,.12)}

/* 签名横线 */
.ct-sign{margin:6px auto 30px;color:#9C8F7E;font-size:12.5px;letter-spacing:.12em}
.ct-sign .ln{display:inline-block;width:116px;border-bottom:1.5px dashed rgba(173,124,63,.35);margin:0 12px;vertical-align:middle}

/* 按钮 */
.pano-cta .btns{display:flex;gap:14px;justify-content:center;align-items:center;flex-wrap:wrap}
.pano-cta .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:15px 34px;font-size:15px;
  cursor:pointer;pointer-events:auto;min-width:190px;letter-spacing:.06em;border-radius:13px;font-weight:700;font-family:inherit}
.pano-cta .btn.btn-primary{background:linear-gradient(120deg,#6E4F37,#6E4F37);color:#fff;border:none;
  box-shadow:0 18px 38px rgba(110,79,55,.25),inset 0 1px 0 rgba(255,255,255,.35)}
.pano-cta .btn.btn-primary:hover{transform:translateY(-2px);box-shadow:0 24px 46px rgba(110,79,55,.32),inset 0 1px 0 rgba(255,255,255,.5)}
.pano-cta .btn.btn-primary .arr{font-size:16px;display:inline-block;transition:transform .25s}
.pano-cta .btn.btn-primary:hover .arr{transform:translateX(4px)}
.pano-btn-ghost{display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.9);color:#4A3427;
  border:1.5px solid rgba(173,124,63,.55);padding:14.5px 26px;cursor:pointer;font-size:14px;font-family:inherit;transition:.25s;
  pointer-events:auto;letter-spacing:.06em;border-radius:13px}
.pano-btn-ghost:hover{background:#fff;border-color:#C9A45E;transform:translateY(-2px)}

/* 角注 */
.pano-note{text-align:center;color:#9C8F7E;font-size:11.5px;letter-spacing:.34em;margin:72px 0 0;text-transform:uppercase}
@media (max-width:560px){
  .pano-cta{padding:54px 20px 50px}
  .pano-cta .btns{flex-direction:column;align-items:stretch}
  .pano-cta .btn{min-width:auto}
  .ct-seal{width:64px;height:64px}
  .ct-seal .sm{letter-spacing:.22em}
  .ct-sign .ln{width:64px;margin:0 8px}
}
.pano-close{position:sticky;top:20px;margin-left:auto;margin-right:28px;margin-top:20px;width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.95);border:1px solid rgba(74,58,40,.14);box-shadow:0 8px 24px rgba(74,58,40,.14);color:#4A3A2C;font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.28s;z-index:6;pointer-events:auto}
.pano-close:hover{background:#FFFFFF;transform:rotate(90deg);color:#4A3427;box-shadow:0 12px 28px rgba(74,58,40,.24)}
/* ── 分步导览顶部进度条 ── */
.pano-progress{position:sticky;top:-1px;z-index:8;background:rgba(255,255,255,.96);border-bottom:1px solid #EBDCC2;margin:0 -40px 8px;padding:12px 40px 10px}
.pano-pp{display:flex;align-items:center;gap:14px;max-width:980px;margin:0 auto}
.pano-pp .step{flex:1;text-align:center}
.pano-pp .dots{display:flex;gap:6px;justify-content:center;align-items:center}
.pano-pp .dot{width:9px;height:9px;border-radius:50%;background:#D2C5AA;cursor:pointer;transition:.3s;border:none;padding:0}
.pano-pp .dot.on{background:#C9A45E;width:26px;border-radius:999px}
.pano-pp .dot.done{background:#6E4F37}
.pano-pp .pnum{font-size:12px;color:#6E6353;font-weight:700;white-space:nowrap}
.pano-pp .pnum b{color:#C9A45E;font-size:15px;font-family:Georgia,serif}
.pano-pp .pfrac{height:4px;flex:1;background:#EBDCC2;border-radius:999px;overflow:hidden;max-width:220px}
.pano-pp .pfill{height:100%;background:linear-gradient(90deg,#C9A45E,#6E4F37);border-radius:999px;width:0;transition:width .5s ease}
/* 底部 ＝上一屏 / 下一屏＝ 导航 */
.pano-nav{position:sticky;bottom:16px;z-index:8;display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:880px;margin:44px auto 10px;padding:14px 18px;background:rgba(255,255,255,.98);border:1px solid #EBDCC2;border-radius:16px;box-shadow:0 14px 34px rgba(74,58,40,.14)}
.pano-nav .n-prev{background:#FDF6E8;color:#6E6353;border:1px solid #EBDCC2}
.pano-nav .n-prev:hover{background:#F5EFE2}
.pano-nav .n-next{background:linear-gradient(135deg,#4A3427,#C9A45E);color:#fff;border:none;box-shadow:0 10px 24px rgba(173,124,63,.3)}
.pano-nav .n-next:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(173,124,63,.38)}
.pano-nav button{cursor:pointer;font-family:inherit;font-size:13.5px;padding:11px 22px;border-radius:10px;transition:.25s;font-weight:700;letter-spacing:.03em}
.pano-nav .n-cnt{font-size:12.5px;color:#7A6D5C;flex:1;text-align:center}
.pano-nav .n-cnt b{color:#C9A45E}
@media(max-width:560px){.pano-progress{margin:0 -20px 8px;padding:10px 20px 8px}.pano-nav{flex-wrap:wrap}.pano-nav .n-cnt{order:3;flex-basis:100%}.pano-nav button{flex:1}}
.pano::-webkit-scrollbar{width:10px}
.pano::-webkit-scrollbar-thumb{background:linear-gradient(#A98A5A,#6E4F37);border-radius:5px;border:2px solid transparent;background-clip:padding-box}
@media (max-width:560px){.pano-hero{padding:20px 22px 50px;min-height:auto}.pano-compare{grid-template-columns:1fr}.pano-inner{padding:0 20px 60px}.pano-cta{padding:48px 22px}.pano-cta .btns{flex-direction:column;align-items:stretch}.pano-cta .btn{min-width:auto}.pano-grid{grid-template-columns:1fr 1fr}}
/* 入座底栏：首次进入导览时固定在底部，引导用户「入座」后才进入产品 */
.pano-seatbar{position:sticky;bottom:0;margin-top:10px;display:flex;justify-content:center;padding:16px 0 8px;background:linear-gradient(180deg,rgba(255,253,248,0),var(--card) 42%);z-index:6}
.pano-seatbar .btn-seat{font-size:15px;padding:12px 28px;letter-spacing:1px;box-shadow:0 8px 24px rgba(74,58,40,.18)}
/* 首次「入座」导览也保留 ✕ 关闭键：随时能退出，避免浮层盖住顶栏导致“点了没反应” */
#pano.seat-lock .pano-close{display:flex;background:rgba(255,250,240,.9);border:1px solid rgba(111,79,55,.22);color:#4A3A2C;box-shadow:0 10px 26px rgba(74,58,40,.18)}
#pano.seat-lock .pano-close:hover{background:#FFF8EA;transform:scale(1.05)}
[data-theme="dark"] .mind-refresh{background:#312A20;color:#C9B38A;border-color:#4F4433}
[data-theme="dark"] .mind-refresh:hover{background:#382F24}
</style>
<script>
/* ═══════ 栖匣 · 全景导览展示逻辑 ═══════ */
var __panoPrevTheme=null;  /* 记录导览打开前的主题，便于退出时还原 */
function openPano(){
  /* 产品导览 #pano：品牌长页沉浸式导览。恒为日间暖纸风格，不受日夜模式影响 */
  var p=document.getElementById('pano');var m=document.getElementById('panoMask');
  document.documentElement.classList.add('state-pano'); /* 导览期间隐藏顶栏 */
  /* 恒定日间：打开导览时临时切回 light，使所有 [data-theme=dark] 覆盖失效，关闭时还原 */
  try{
    if(__panoPrevTheme==null)__panoPrevTheme=document.documentElement.getAttribute('data-theme')||'light';
    document.documentElement.setAttribute('data-theme','light');
  }catch(e){}
  if(p)p.classList.add('show');if(m)m.classList.add('show');
  try{document.body.style.overflow='hidden';}catch(e){}
  try{if(p&&p.querySelector('.pano-inner'))p.querySelector('.pano-inner').scrollTop=0;}catch(e){}
  /* 入座流程：首次进入（带 seat-lock）时，注入「入座」按钮，只有关闭按钮隐藏 */
  if(p&&p.classList.contains('seat-lock')){ ensureSeatBar(); }
}
function closePano(force){
  var p=document.getElementById('pano');
  if(p&&p.classList.contains('seat-lock')&&!force)return;  /* 锁定中：非强制（非「入座」）不关 */
  document.documentElement.classList.remove('state-pano'); /* 导览结束：恢复顶栏 */
  /* 还原导览打开前的主题（用户原选择日间则回日间、夜间则回夜间） */
  try{
    if(__panoPrevTheme){document.documentElement.setAttribute('data-theme',__panoPrevTheme);__panoPrevTheme=null;}
  }catch(e){}
  if(p)p.classList.remove('show');
  var m=document.getElementById('panoMask');if(m)m.classList.remove('show');
  try{document.body.style.overflow='';}catch(e){}
}
function panoGo(dest){
  if(dest==='about'||dest==='home'){
    closePano(true);
    setTimeout(function(){try{switchView(dest)}catch(e){}},100);
  }
}
/* 入座底栏（首次进入导览时注入一次） */
function ensureSeatBar(){
  var p=document.getElementById('pano');if(!p)return;
  if(p.querySelector('.pano-seatbar'))return;
  var bar=document.createElement('div');bar.className='pano-seatbar';
  bar.innerHTML='<button class="btn btn-primary btn-seat" data-pano="seat">✦ 入座 · 栖匣，开始使用</button>';
  var inner=p.querySelector('.pano-inner');if(inner)inner.appendChild(bar);else p.appendChild(bar);
}
/* 点击「入座」：标记已看过导览，解除锁定，关闭导览进入产品 */
function seatPano(){
  try{localStorage.setItem('pp_pano_seen','1');localStorage.setItem('pp_quickstart_ok','1');}catch(e){}
  var p=document.getElementById('pano');if(p)p.classList.remove('seat-lock');
  closePano(true);
  /* 首次「入座」进入产品后：接着引导挑选常用模块（只触发一次） */
  maybeOpenPrefPick();
}
/* 事件委托：统一接管导览内所有按钮，避免个别按钮不响应 */
function panoWire(){
  var p=document.getElementById('pano');if(!p)return;
  if(p.getAttribute('data-wired'))return;
  p.setAttribute('data-wired','1');
  p.addEventListener('click',function(ev){
    var t=ev.target.closest('[data-pano]');if(!t)return;
    var act=t.getAttribute('data-pano');
    if(act==='seat'){seatPano();return;}
    /* 关闭/跳转始终可用：不再被首次「入座」锁死，并在关闭时记录“已看过”，
       避免导览浮层每次重开盖住顶栏导致“点了没反应” */
    if(act==='close'){
      try{localStorage.setItem('pp_pano_seen','1');localStorage.setItem('pp_quickstart_ok','1');}catch(e){}
      if(p)p.classList.remove('seat-lock');
      closePano(true);
      /* 首次关闭导览进入产品后：同样补一次「常用模块偏好」引导 */
      maybeOpenPrefPick();
      return;
    }
    if(act==='home'||act==='about')panoGo(act);
  });
}
/* ── 导览为单屏长页：自由滚动浏览；关闭/跳转由 panoWire 处理 ── */
function panoBoot(){
  var p=document.getElementById('pano');if(!p)return;
  var m=document.getElementById('panoMask');
  if(m)m.addEventListener('click',function(){if(p.classList.contains('seat-lock'))return;closePano();});
  document.addEventListener('keydown',function(ev){if(ev.key==='Escape'){if(p.classList.contains('seat-lock'))return;closePano();}});
  panoWire();
  /* 注意：首次访客的导览弹出改由品牌启动屏 afterSplash 统一触发（锁定「入座」）。
     这里不再自动弹，避免与闪屏流程重复或抢跑。 */
}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',panoBoot);}else{panoBoot();}
</script>

<!-- ═══════════ 栖匣 · 全景导览（浅色高级产品介绍长页） ═══════════ -->
<div class="pano-mask" id="panoMask"></div>
<div class="pano" id="pano" role="dialog" aria-modal="true" aria-label="栖匣全景导览">
  <button class="pano-close" data-pano="close" title="关闭导览">✕</button>
  <div class="pano-inner">

    <!-- 封面首屏 (步骤 1) -->
    <section class="pano-hero" data-step="0">
      <span class="pt-topscallop" aria-hidden="true"></span>
      <div class="pt-sash"><span class="pt-seal" style="background:none;box-shadow:none;padding:0;width:40px;height:40px;border-radius:12px;overflow:hidden"><img src="pwa/logo-chest20260911.png" alt="栖匣" style="width:40px;height:40px;display:block" onerror="logoFallback(this)"></span><span class="pt-name">栖匣</span><i></i></div>
      <i class="pt-deco d1" aria-hidden="true"></i><i class="pt-deco d2" aria-hidden="true"></i><i class="pt-deco d3" aria-hidden="true"></i>
      <div class="glow"></div>
      <div class="pt-name-premium">
        <span class="pm-verse">一「栖」一「匣」：收纳成长诸事，锚定方向，落实眼前规划。<em>—— 栖匣，致每一位精进者</em></span>
      </div>
      <h1 class="pano-h1">把每一天，好好<em class="pano-grow">安放</em><br class="pano-hbr"><span class="thin">来有所栖，去有所成</span></h1>
      <p class="dek"><em style="font-style:normal"><b>学业栖仓 · 锚愿匣 · 时栖录 · 贮金格 · 灵拾槽 · 安养隅——三四十个成长模块，分格收纳、各归其位，都收进这一只匣</b></em>，互相咬合、随点滴沉淀，主要面向大学生群体，同样支持更长周期的个人成长记录。零安装、零登录，数据只留在你自己设备里。<br>告别十几个 App 来回切换的疲惫，一点开就能用，用完即安心。</p>
      <div class="hr-dot"><i></i><span class="dm">◆ ◆</span><i class="rt"></i></div>
      <div class="pano-stats">
        <span><b>35+</b> 能力模块</span>
        <span><b>0</b> 安装 · 0 登录</span>
        <span><b>100%</b> 数据留在本机</span>
        <span><b>365</b> 天随时相伴</span>
      </div>
    </section>

    <!-- 定位：价值主张 (步骤 2) -->
    <section class="pano-sec pano-sec-ctr" data-step="1">
      <div class="pano-no"><span class="rn">壹</span><span>它为什么无可取代 · 你所得到的</span></div>
      <h2 class="pano-h2">它不是又一个工具，<br>而是让成长<em>步步趋近所向</em>的栖身之处</h2>
      <p class="pano-lead">市面上有背单词的、记笔记的、管时间的、记钱的……但从来没有一座中枢，能同时接住你的<b>学业、目标、时间、金钱、健康，以及成长、阅读与职业</b>，还让它们互相咬合。栖匣，是唯一一个把它们<b>收拢到一处</b>的地方——这正是它存在的理由。</p>
      <div class="pano-feat">
        <div class="pano-ft"><span class="fi">⚡</span><b>双击即用 · 零安装零门槛</b><p>一个网页即是全部，点开就能用，不用下载、不用配置。</p></div>
        <div class="pano-ft"><span class="fi">🔒</span><b>数据留在本机 · 不收集隐私</b><p>不注册、不联网上传，一切只存在你自己的浏览器里。</p></div>
        <div class="pano-ft"><span class="fi">📱</span><b>手机电脑 · 处处顺手打开</b><p>跨端同页，还能「加到桌面」当 App 全屏使用。</p></div>
        <div class="pano-ft"><span class="fi">🛡️</span><b>离线可用 · 首次联网打开后</b><p>在支持此功能的浏览器（Chrome/Edge/Safari 等）里，联网打开过一次后，断网也能继续查看已载入的内容与数据。</p></div>
      </div>
      <div class="pano-rule"><span class="ln"></span><span class="d">❦</span><span class="ln r"></span></div>
    </section>

    <!-- 之前 vs 之后 (步骤 3) -->
    <section class="pano-sec" data-step="2">
      <div class="pano-no"><span class="rn">贰</span><span>没有它 vs 有它 · 两种大学的活法</span></div>
      <h2 class="pano-h2">同样的时间，<em>不同的落点</em></h2>
      <div class="pano-compare">
        <div class="pano-cp no">
          <div class="tag">没有它的日子里</div>
          <h4 style="color:#4A5A52">事情总在脑子里打转</h4>
          <ul>
            <li>说要每天背单词，临睡前却发现"明天再说"的念头又赢了</li>
            <li>四六级、期末、实习的节点挤在一起，一个也没先准备好</li>
            <li>月底望着账单发愁，这一个月其实都没认真记过账</li>
            <li>读到的好句子、冒出的好点子，转头就忘了该存进哪里</li>
            <li>"我得上进"反复起念，落到"今天就做这一件"却说不出来</li>
          </ul>
        </div>
        <div class="pano-cp yes">
          <div class="tag">有了它之后</div>
          <h4>事情各归其位，走得踏实</h4>
          <ul>
            <li>目标拆成今天的一小步，勾掉一项就多一分笃定</li>
            <li>考试与求职的日子排进同一张时间表，先做哪件事一眼看清</li>
            <li>每天三十秒记一笔，钱花在哪，心里就有了底</li>
            <li>灵感随手收进看板，习惯攒成一条连续的记录</li>
            <li>不靠一时硬撑，靠每天稳稳往前的一小步</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 一天时间轴 (步骤 4) -->
    <section class="pano-sec" data-step="3">
      <div class="pano-no"><span class="rn">叁</span><span>它陪你的这一天 · 具体能做什么</span></div>
      <h2 class="pano-h2">从早到晚，<em>它都有你的位置</em></h2>
      <div class="pano-steps">
        <div class="pano-step"><div class="num">晨</div><h5>写下今天最重要的一件事</h5><p>今日任务帮你锚定方向——做完它，今天就是赢。</p></div>
        <div class="pano-step"><div class="num">昼</div><h5>专注与积累并行</h5><p>番茄专注学习、时间块安排节奏，顺手收下今日知识与一句心语。</p></div>
        <div class="pano-step"><div class="num">暮</div><h5>复盘、记账、排明日</h5><p>睡前两分钟记下今天，四象限为明天排好，越用越省心。</p></div>
      </div>
      <div class="pano-rule"><span class="ln"></span><span class="d">❦</span><span class="ln r"></span></div>
    </section>

    <!-- 大引言 (步骤 5) -->
    <div class="pano-quote" data-step="4">
      <p>真正的自由，不是想做什么就做什么，<br>而是能把每一天，都落在实处、握在自己手里。</p>
      <span class="by">— 栖匣 的设计哲学 —</span>
    </div>

    <!-- 八大能力 (步骤 6) -->
    <section class="pano-sec pano-sec-ctr" data-step="5">
      <div class="pano-no"><span class="rn">肆</span><span>八大力 · 你能亲手掌握什么</span></div>
      <h2 class="pano-h2">八大支柱，<em>托起你的大学生活</em></h2>
      <div class="pano-grid" style="text-align:left">
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">🎓</div><h4>学业精进</h4><p>绩点与专业筑基，到英语、数学、考级与保研考研，拆成一步步可执行的计划。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">⏳</div><h4>时间管理</h4><p>四象限轻重缓急、番茄专注、一周时间块，把一天排得明明白白。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">🎯</div><h4>目标拆解</h4><p>大目标→里程碑→今天做什么，三步拆解，每天都能看见进度。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">💼</div><h4>职业与升学</h4><p>保研考研路径、竞赛科研、简历模板、求职渠道，一站式准备好未来。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">💰</div><h4>理财记账</h4><p>记账本、省钱技巧、消费指南、副业启蒙，让每一分钱都知道去向。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">❤️</div><h4>健康管理</h4><p>健康打卡、运动热力图、情绪记录，照顾身体，也照顾好自己。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">💡</div><h4>灵感珍藏</h4><p>灵感看板、决策复盘、人生一百目标，好想法在此沉淀、不轻易丢失。</p></div>
        <div class="pano-card"><span class="chip">Ready</span><div class="ic">🌱</div><h4>自我成长</h4><p>周度档案与全景回看，一年后你会感谢今天认真留下的每一笔。</p></div>
      </div>
      <div class="pano-rule"><span class="ln"></span><span class="d">❦</span><span class="ln r"></span></div>
    </section>

    <!-- 为什么设计它 · 设计理念 (步骤 7) -->
    <section class="pano-sec pano-sec-ctr" data-step="6">
      <div class="pano-no"><span class="rn">伍</span><span>产品的理念 · 为什么会有它</span></div>
      <p class="pano-lead">目标很多，计划也不少，真正难的，是先把它们安放妥帖、再一步步往前走。栖匣就是那只替你安放成长的地方——把学业、时间、理财、健康、阅读与职业，都收进一处、各归其位；迷茫、疲惫这些心情，也被稳稳接住。你尽管往前走，剩下的，匣子替你在记。</p>
      <p class="pano-lead" style="margin-top:10px">自律不只有一种模样：不必等待心绪完全安顿才开始行动，整理规划与向前推进可以同步发生。它拒绝高压内卷式的一味催促，也不鼓励停滞与等待——收纳是载体，行动与规划同样重要。</p>
      <div class="pano-concept">
        <div class="pano-cv" data-side="栖">
          <span class="cv-char">栖</span>
          <div class="cv-body">
            <h5>心绪 · 状态 · 落脚安放</h5>
            <p>心绪与状态，可以在此落脚安放。迷茫、停顿、疲惫都是成长里的常态；未完成的计划，只是一份待续的记录，不代表失败。</p>
          </div>
        </div>
        <div class="pano-cv" data-side="匣">
          <span class="cv-char">匣</span>
          <div class="cv-body">
            <h5>收纳 · 咬合 · 点滴沉淀</h5>
            <p>收纳学业、目标、时间、金钱、健康、阅读与职业……把成长的一条条线索收拢到一处，互相咬合，随日常点滴积累沉淀。</p>
          </div>
        </div>
      </div>
      <div class="pano-habit">
        <div class="pano-hb"><div class="medal">燃</div><h5>越用回报越多</h5><p>连续打卡出勋章，坚持汇成热力图，一年后是你自己的成绩单。</p></div>
        <div class="pano-hb"><div class="medal">册</div><h5>周度成长档案</h5><p>每周自动汇总进度与亮点，复盘不再无从下手，看得见自己在长大。</p></div>
        <div class="pano-hb"><div class="medal">镜</div><h5>全景回看</h5><p>一年后的你回看今天，会发现每一笔认真都算数——比任何鸡汤都管用。</p></div>
        <div class="pano-hb"><div class="medal">心</div><h5>日拱一卒</h5><p>不追求一天蜕变，只求每天向前一小步，持续沉淀自我。</p></div>
      <