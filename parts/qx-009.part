
    if(gbox)gbox.textContent='BMI '+gbmi;
    var weeksEl=document.getElementById('planWeeks');
    var weeks=weeksEl?parseInt(weeksEl.textContent)||12:12;
    var pace=((wv-gv)/weeks).toFixed(2);
    if(pb)pb.textContent='每周约'+pace+'公斤';
  } else {
    if(gbox)gbox.textContent='待测算';
  }
  markMetricPlaceholders();
}
document.addEventListener('blur',function(e){
  var id=e.target&&e.target.id;
  if(id==='userHeight'||id==='curWeight'||id==='goalWeight'||id==='planWeeks'||id==='cetGoalInput'||id==='cetBaseInput'||id==='cet6GoalInput'||id==='cet6BaseInput'){
    try{
      var data={};
      ['userHeight','curWeight','goalWeight','planWeeks','cetGoalInput','cetBaseInput','cet6GoalInput','cet6BaseInput'].forEach(function(i){
        var el=document.getElementById(i);
        if(el){data[i]=(el.tagName==='INPUT')?el.value:el.textContent;}
      });
      localStorage.setItem('userMetrics',JSON.stringify(data));
    }catch(e){}
    calcBmi();
  }
},true);
try{
  var data={};try{data=JSON.parse(localStorage.getItem('userMetrics')||'{}')||{};}catch(e){data={};}
  Object.keys(data).forEach(function(id){
    var el=document.getElementById(id);
    if(el&&data[id]){
      if(el.tagName==='INPUT'){el.value=data[id];}
      else{el.textContent=data[id];}
    }
  });
  setTimeout(calcBmi,200);
}catch(e){}



function closeMoreMenu(){ setTbMore(false); }
function toggleMoreMenu(e){
  if(e)e.stopPropagation();
  var menu=document.getElementById('moreMenuDropdown');
  if(menu){
    var isHidden=menu.style.display==='none'||!menu.style.display;
    menu.style.display=isHidden?'block':'none';
  }
}
/* 点击其他地方关闭更多菜单 */
document.addEventListener('click', function(e){
  var menu=document.getElementById('moreMenuDropdown');
  var btn=document.getElementById('btnMore');
  if(menu&&btn&&!btn.contains(e.target)&&!menu.contains(e.target)){
    menu.style.display='none';
  }
});

/* ═══════ 自动保存机制：所有 data-key 字段 blur 即存 ═══════ */
function saveEditable(el){
  if(!el||!el.dataset||!el.dataset.key)return;
  var key=el.dataset.key;
  var val=el.textContent||el.innerText||'';
  try{
    var all=JSON.parse(localStorage.getItem('autoSaveEditable')||'{}');
    all[key]={v:val,t:Date.now()};
    localStorage.setItem('autoSaveEditable',JSON.stringify(all));
  }catch(e){}
}
function loadEditable(){
  var all={};
  try{all=JSON.parse(localStorage.getItem('autoSaveEditable')||'{}');}catch(e){}
  document.querySelectorAll('[data-key]').forEach(function(el){
    var key=el.dataset.key;
    if(all[key]&&all[key].v){
      el.textContent=all[key].v;
    }
  });
}
/* 时间胶囊：动态添加自定义月份/时段行 */
var _capsuleSeq=0;
function addCapsuleMonth(){
  try{_capsuleSeq=parseInt(localStorage.getItem('cap_seq')||'0')+1;localStorage.setItem('cap_seq',String(_capsuleSeq));}catch(e){_capsuleSeq++;}
  var label=window.prompt('给这一行起个名字（例如：'+new Date().getFullYear()+'年暑假 / 实习期 / 大四下学期）：','自定义期'+_capsuleSeq);
  if(label===null)return;label=label.trim();if(!label)label='自定义期'+_capsuleSeq;
  var row=document.getElementById('capsuleAddRow');
  var tr=document.createElement('tr');
  var safe=String(_capsuleSeq);
  tr.innerHTML='<td style="white-space:nowrap;font-weight:600">'+label+' <span class="cap-del" style="cursor:pointer;color:var(--coral);margin-left:4px" onclick="this.parentNode.parentNode.remove()">✕</span></td>'+
    '<td contenteditable="true" data-key="capc-'+safe+'-thing" style="cursor:text;background:var(--bg)"></td>'+
    '<td contenteditable="true" data-key="capc-'+safe+'-thank" style="cursor:text;background:var(--bg)"></td>'+
    '<td contenteditable="true" data-key="capc-'+safe+'-msg" style="cursor:text;background:var(--bg)"></td>';
  if(row&&row.parentNode){row.parentNode.insertBefore(tr,row);}
  flash('已添加「'+label+'」，可直接点击填写，输入后自动保存');
}
document.addEventListener('blur',function(e){
  if(e.target&&e.target.dataset&&e.target.dataset.key){
    saveEditable(e.target);
    // 轻提示
    if(typeof flash==='function'){flash('已自动保存');}
  }
},true);
document.addEventListener('input',function(e){
  // 输入时静默保存（避免每按一键都flash）
  if(e.target&&e.target.dataset&&e.target.dataset.key){
    clearTimeout(window._autoSaveTimer);
    window._autoSaveTimer=setTimeout(function(){
      saveEditable(e.target);
    },500);
  }
},true);
/* ── 复选框自动保存（data-key 的 checkbox，勾选即存本地，仅本机可见）── */
function loadCheckboxes(){
  var all={};try{all=JSON.parse(localStorage.getItem('pp_checkbox_v1')||'{}');}catch(e){all={};}
  document.querySelectorAll('input[type="checkbox"][data-key]').forEach(function(cb){
    var k=cb.getAttribute('data-key');
    cb.checked=!!all[k];
  });
}
document.addEventListener('change',function(e){
  var cb=e.target;
  if(cb&&cb.type==='checkbox'&&cb.dataset&&cb.dataset.key){
    var all={};try{all=JSON.parse(localStorage.getItem('pp_checkbox_v1')||'{}');}catch(e){all={};}
    all[cb.dataset.key]=cb.checked?1:0;
    try{localStorage.setItem('pp_checkbox_v1',JSON.stringify(all));}catch(e){}
  }
},true);
/* 可编辑指标卡：未填写时用浅色小字占位（“点击填写”不再被放大成主数字，观感更整洁） */
function markMetricPlaceholders(){
  document.querySelectorAll('.metric .value[contenteditable]').forEach(function(v){
    var t=(v.textContent||'').trim();
    v.classList.toggle('ph',t===''||t==='点击填写'||t==='—');
  });
}
document.addEventListener('input',function(e){
  var tg=e.target;
  if(tg&&tg.closest&&tg.closest('.metric .value[contenteditable]'))markMetricPlaceholders();
},true);
document.addEventListener('blur',function(e){
  var tg=e.target;
  if(tg&&tg.closest&&tg.closest('.metric .value[contenteditable]'))markMetricPlaceholders();
},true);
/* 点开即清占位符：带“点击填写”等占位的可编辑卡，聚焦后自动清空，
   用户直接输入即可，不必先手动删除占位文字（适用所有同类指标框） */
document.addEventListener('focusin',function(e){
  var tg=e.target;
  if(tg&&tg.closest&&tg.closest('.metric .value[contenteditable]')){
    var t=(tg.textContent||'').trim();
    if(t===''||t==='点击填写'||t==='—'){
      tg.textContent='';
      if(tg.id==='userHeight'||tg.id==='curWeight'||tg.id==='goalWeight'||tg.id==='planWeeks'){calcBmi();}
    }
    markMetricPlaceholders();
  }
},true);
try{markMetricPlaceholders();}catch(e){}
function clearTable(tableId){
  uiConfirm('确定要清空整张表格吗？此操作不可撤销。',function(){
    var t=document.getElementById(tableId);
    if(!t)return;
    t.querySelectorAll('[contenteditable="true"]').forEach(function(c){
      c.textContent='';
      if(c.dataset.key)saveEditable(c);
    });
    flash('已清空');
  });
}
function exportTable(tableId){
  var t=document.getElementById(tableId);
  if(!t)return;
  var rows=[];
  t.querySelectorAll('tr').forEach(function(tr){
    var cells=[];
    tr.querySelectorAll('th,td').forEach(function(td){
      cells.push(td.textContent.replace(/\n/g,' ').trim());
    });
    rows.push(cells.join('\t'));
  });
  var blob=new Blob([rows.join('\n')],{type:'text/csv;charset=utf-8'});
  var a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download=tableId+'-'+todayKey()+'.csv';
  a.click();
  flash('已导出CSV');
}
// 页面加载时调用
document.addEventListener('DOMContentLoaded',loadEditable);
// 兜底：DOMContentLoaded已触发时也调用一次
setTimeout(loadEditable,100);


/* ═══════ 专业倒数日系统 ═══════ */
/* 倒数日历史上写在无前缀的 myCountdowns，而全站搜索、数据备份、示例播种
   都只认带 pp_ 前缀的 pp_countdowns。两边各写各的，结果是：
   用户添加的倒数日在搜索里永远搜不到，播种的示例在首页又看不见。
   这里统一到 pp_countdowns，并把旧键里的数据一次性并过来。 */
function getCountdowns(){
  try{
    var s=localStorage.getItem('pp_countdowns');
    var arr=null;
    if(s){ try{ arr=JSON.parse(s); }catch(e){ arr=null; } }
    if(!(arr&&arr.length!==undefined)) arr=null;
    var old=null;
    try{ var os=localStorage.getItem('myCountdowns'); if(os) old=JSON.parse(os); }catch(e){}
    if(old&&old.length){
      arr=arr||[];
      var seen={};
      arr.forEach(function(c){ seen[(c.name||'')+'|'+(c.date||'')]=1; });
      old.forEach(function(c){
        var k=(c.name||'')+'|'+(c.date||'');
        if(!seen[k]){ arr.push(c); seen[k]=1; }
      });
      saveCountdowns(arr);          /* 合并结果落回新键，并顺手废掉旧键 */
      return arr;
    }
    return arr||[];
  }catch(e){ return []; }
}
function saveCountdowns(arr){
  try{
    localStorage.setItem('pp_countdowns',JSON.stringify(arr));
    localStorage.removeItem('myCountdowns');   /* 旧键作废，杜绝两份数据再次打架 */
  }catch(e){}
}
function renderCountdowns(){
  var list=getCountdowns();
  var box=document.getElementById('countdownList');
  if(!box)return;
  if(!list.length){
    box.innerHTML='<div style="grid-column:1/-1;text-align:center;padding:30px;color:var(--hint);font-size:13px">还没有倒数日 · 在下方添加你的第一个重要事件</div>';
  }else{
    box.innerHTML=list.map(function(item,i){
      var target=new Date(item.date+'T00:00:00');
      var today=new Date();
      today.setHours(0,0,0,0);
      var diff=Math.round((target-today)/86400000);
      var bigText,bigColor,progress,bgTone;
      if(diff>0){
        bigText=diff+'<span style="font-size:18px;font-weight:400"> 天</span>';
        if(diff<=7){bigColor='var(--coral)';bgTone='var(--card)';}
        else if(diff<=30){bigColor='var(--primary)';bgTone='var(--card)';}
        else{bigColor='var(--primary)';bgTone='var(--card)';}
        // 进度条：以填表日到目标日为100%
        var totalDays=item.totalDays||Math.max(diff,1);
        var passed=totalDays-diff;
        progress=Math.max(0,Math.min(100,Math.round(passed/totalDays*100)));
      }else if(diff===0){
        bigText='就是<br>今天';bigColor='var(--teal)';bgTone='var(--card)';progress=100;
      }else{
        bigText=Math.abs(diff)+'<span style="font-size:18px;font-weight:400"> 天前</span>';
        bigColor='var(--muted)';bgTone='var(--bg)';progress=100;
      }
      return '<div style="border:1px solid var(--border);border-radius:14px;padding:14px;background:'+bgTone+';position:relative;overflow:hidden">'+
        '<div style="position:absolute;top:0;left:0;height:3px;width:'+progress+'%;background:'+bigColor+';transition:width .3s"></div>'+
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">'+
          '<span contenteditable="true" data-cd-idx="'+i+'" data-cd-field="name" style="font-weight:600;font-size:14px;color:var(--text);cursor:text;flex:1">'+item.name+'</span>'+
          '<button class="btn btn-sm" onclick="delCountdown('+i+')" style="padding:2px 6px;font-size:11px;background:transparent;border:none;color:var(--hint);cursor:pointer">×</button>'+
        '</div>'+
        '<div style="display:flex;align-items:center;gap:10px">'+
          '<div style="font-size:36px;font-weight:800;color:'+bigColor+';line-height:1;letter-spacing:-1px">'+bigText+'</div>'+
          '<div style="flex:1;font-size:11px;color:var(--muted)">'+
            '<div>📅 <span style="white-space:nowrap">'+item.date+'</span></div>'+
            '<div style="margin-top:2px">进度 '+progress+'%</div>'+
            '<input type="date" value="'+item.date+'" onchange="updateCountdownDate('+i+',this.value)" style="margin-top:4px;font-size:11px;border:1px solid var(--border);border-radius:4px;padding:2px 4px;width:100%">'+
          '</div>'+
        '</div>'+
      '</div>';
    }).join('');
  }
  // 更新今日metric
  var next=list.filter(function(x){var d=new Date(x.date+'T00:00:00');var t=new Date();t.setHours(0,0,0,0);return d>=t;}).sort(function(a,b){return new Date(a.date)-new Date(b.date);});
  var nextEl=document.getElementById('nextCountdown');
  var nextNameEl=document.getElementById('nextCountdownName');
  if(next.length){
    var d=new Date(next[0].date+'T00:00:00');var t=new Date();t.setHours(0,0,0,0);
    var diff=Math.round((d-t)/86400000);
    if(nextEl)nextEl.textContent=diff+'天';
    if(nextNameEl)nextNameEl.textContent=next[0].name+' · '+next[0].date;
  }else{
    if(nextEl)nextEl.textContent='--';
    if(nextNameEl)nextNameEl.textContent='未设置';
  }
  // 更新今日日期metric
  var td=new Date();
  if(document.getElementById('todayDateMetric')){
    document.getElementById('todayDateMetric').textContent=td.getMonth()+1+'月'+td.getDate()+'日';
    document.getElementById('todayWeekday').textContent='星期'+'日一二三四五六'[td.getDay()];
  }
}
function examPreset(){
  var n=document.getElementById('newCountdownName'),d=document.getElementById('newCountdownDate');
  if(!n||!d)return;
  n.value='期末考试月 · 冲刺';
  var t=new Date();t.setDate(t.getDate()+61);
  d.value=t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0');
  n.focus();
  flash('已预填期末冲刺，改好日期后点「添加倒数日」');
}
function addCountdown(){
  var nameInput=document.getElementById('newCountdownName');
  var dateInput=document.getElementById('newCountdownDate');
  if(!nameInput||!dateInput)return;
  var name=nameInput.value.trim();
  var date=dateInput.value;
  if(!name||!date){uiAlert('请填写事件名称和日期');return;}
  var today=new Date();today.setHours(0,0,0,0);
  var target=new Date(date+'T00:00:00');
  var totalDays=Math.max(1,Math.round((target-today)/86400000));
  var arr=getCountdowns();
  arr.push({name:name,date:date,totalDays:totalDays});
  saveCountdowns(arr);
  renderCountdowns();
  nameInput.value='';dateInput.value='';
  flash('这个日子已收进匣中');
}
function delCountdown(i){
  uiConfirm('要移除这个倒数日吗？',function(){
    var arr=getCountdowns();arr.splice(i,1);saveCountdowns(arr);renderCountdowns();
  });
}
function updateCountdownDate(i,newDate){
  var arr=getCountdowns();if(!arr[i])return;
  arr[i].date=newDate;
  var today=new Date();today.setHours(0,0,0,0);
  var target=new Date(newDate+'T00:00:00');
  arr[i].totalDays=Math.max(1,Math.round((target-today)/86400000));
  saveCountdowns(arr);renderCountdowns();
}
document.addEventListener('blur',function(e){
  if(e.target&&e.target.dataset&&e.target.dataset.cdIdx!==undefined){
    var i=parseInt(e.target.dataset.cdIdx);
    var field=e.target.dataset.cdField;
    var arr=getCountdowns();
    if(arr[i]){arr[i][field]=e.target.textContent;saveCountdowns(arr);}
  }
},true);
// 默认倒数日：不预置任何示例，由用户按需自行添加
function initDefaultCountdowns(){
  var arr=getCountdowns();
  // 兼容旧版：若本地仍残留旧示例（英语四级考试/开学报到/暑假结束），自动清理，交给用户自行添加
  if(arr&&arr.length){
    var oldSeeds=['英语四级考试','开学报到','暑假结束','华北电力','华北电力大学','满18岁','18岁','满 18 岁','9月28','9月28日','2008-09-28'];
    var filtered=arr.filter(function(it){return !oldSeeds.some(function(s){return it.name.indexOf(s)>=0});});
    if(filtered.length!==arr.length){saveCountdowns(filtered);}
  }
}


/* ═══════ 运动可视化热力图 ═══════ */
function getSportLog(){try{var s=localStorage.getItem('sportLog');return s?JSON.parse(s):{};}catch(e){return {};}}
function saveSportLog(o){try{localStorage.setItem('sportLog',JSON.stringify(o));}catch(e){}}
function logSport(intensity){
  var log=getSportLog();
  var key=todayKey();
  log[key]={intensity:intensity,time:Date.now()};
  saveSportLog(log);
  renderSportHeatmap();
  flash('又一段旅途，妥帖收存');
}
function clearSportLog(){
  uiConfirm('清空所有运动记录？',function(){
    saveSportLog({});
    renderSportHeatmap();
    flash('已清空');
  });
}
function renderSportHeatmap(){
  var box=document.getElementById('sportHeatmap');
  if(!box)return;
  var log=getSportLog();
  var today=new Date();
  var days=[];
  for(var i=29;i>=0;i--){
    var d=new Date(today);d.setDate(d.getDate()-i);
    var key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    days.push({key:key,log:log[key],isToday:i===0,day:d.getDate()});
  }
  box.innerHTML=days.map(function(d){
    var bg='var(--heat-empty,#EFE8D8)';
    var txtColor='var(--hint)';
    var txt='--';
    if(d.log){
      if(d.log.intensity==='heavy'){bg='var(--heat-heavy,#6E4F37)';txt='大';txtColor='var(--heat-text,#fff)';}
      else if(d.log.intensity==='medium'){bg='var(--heat-medium,#6E4F37)';txt='中';txtColor='var(--heat-text,#fff)';}
      else{bg='var(--heat-light,#DCC9A8)';txt='轻';txtColor='var(--heat-text,#fff)';}
    }
    return '<div title="'+d.key+'" style="aspect-ratio:1;border-radius:4px;background:'+bg+';display:flex;align-items:center;justify-content:center;color:'+txtColor+';font-size:9px;font-weight:'+(d.isToday?'700':'400')+';border:'+(d.isToday?'2px solid var(--primary)':'1px solid var(--border)')+'">'+(d.log?txt:d.day)+'</div>';
  }).join('');
  // 统计
  var count=Object.keys(log).length;
  var mcEl=document.getElementById('sportMonthCount');
  if(mcEl){
    var monthCount=0;
    var m=today.getMonth();
    Object.keys(log).forEach(function(k){
      var d=new Date(k+'T00:00:00');
      if(d.getMonth()===m)monthCount++;
    });
    mcEl.textContent=monthCount;
  }
  var tEl=document.getElementById('sportTotal');if(tEl)tEl.textContent=count;
  // 连续天数
  var streak=0;
  for(var i=0;i<30;i++){
    var d=new Date(today);d.setDate(d.getDate()-i);
    var key=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    if(log[key])streak++;else break;
  }
  var sEl=document.getElementById('sportStreak');if(sEl)sEl.textContent=streak;
}

/* ═══════════ 影视·观世界 ═══════════ */
var MOVIE_QUOTES=[
  {q:'希望是美好的，也许是人间至善，而美好的事物永不消逝。',src:'《肖申克的救赎》',scene:'安迪写给瑞德的信',e:'希望不是空想，是支撑你每天行动的理由。失去希望的人最先被打败。',apply:'低谷时提醒自己：把眼光放长到3年后，现在熬的每一天都在靠近它。'},
