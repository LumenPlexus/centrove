<style>
[data-theme="dark"] .card[style*="#EFE8D8"], [data-theme="dark"] .card[style*="#F1EBDD"], [data-theme="dark"] .card[style*="#FFF8EF"], [data-theme="dark"] .card[style*="#FDEFE2"], [data-theme="dark"] .card[style*="#FFF5F0"], [data-theme="dark"] .card[style*="#F1EADE"], [data-theme="dark"] .card[style*="#EDE5D4"], [data-theme="dark"] .mind-card{background:var(--card)!important;border-color:var(--border)!important}
[data-theme="dark"] .mind-card div, [data-theme="dark"] .mind-card h3, [data-theme="dark"] .mind-card span, [data-theme="dark"] .mind-card p, [data-theme="dark"] .mind-card strong,
[data-theme="dark"] .card[style*="#F1EADE"] div, [data-theme="dark"] .card[style*="#F1EADE"] h3, [data-theme="dark"] .card[style*="#F1EADE"] span,
[data-theme="dark"] .card[style*="#EDE5D4"] div, [data-theme="dark"] .card[style*="#EDE5D4"] h3, [data-theme="dark"] .card[style*="#EDE5D4"] span{color:var(--text)!important}
[data-theme="dark"] .editable-table td[contenteditable="true"]:focus{background:rgba(212,178,124,.12)!important;color:var(--text)!important}
