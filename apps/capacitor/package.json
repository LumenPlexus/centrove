{
  "name": "qixia-mobile",
  "version": "1.0.0",
  "description": "栖匣 · 心有所栖 · 匣纳成长（Android 移动端）",
  "private": true,
  "main": "index.js",
  "scripts": {
    "sync:web": "node scripts/copy-web.js",
    "assets": "npx capacitor-assets generate",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android",
    "android:build": "npm run sync:web && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "capacitor-assets": "^3.0.4"
  }
}